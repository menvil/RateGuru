APP_NAME=RateGuru
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rateguru
DB_USERNAME=rateguru
DB_PASSWORD=rateguru

# Fast local fallback without PostgreSQL:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_CONTACT_TO=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MEDIA_PUBLIC_DISK=public
MEDIA_PURGE_GRACE_DAYS=7
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_AUDIT_LOCK_TTL_SECONDS=3660
MEDIA_AUDIT_RUN_RETENTION=30

# Days an author-deleted post stays restorable before the retention purge may
# permanently remove it. Product retention — distinct from media grace above.
POST_AUTHOR_DELETE_RETENTION_DAYS=30

# Days a purely author-deleted leaf comment is retained before daily cleanup.
COMMENT_AUTHOR_DELETE_RETENTION_DAYS=30

# Retention for FINALIZED moderation removals. Empty = disabled: finalized
# moderation content is retained indefinitely until explicitly enabled.
# Ordinary reversible Hidden content never purges regardless of this value.
MODERATION_CONTENT_RETENTION_DAYS=

# Which deployment target of infrastructure/config/deployment-targets.json this
# runtime serves (staging-main, tits-guru, ...). Static per target: it lives in
# that target's shared .env and deployments never rewrite it. Empty locally.
# The release ID and commit are NOT set here — they are read from the release
# artifact's own release.json. See infrastructure/runbooks/sentry-observability.md.
APP_DEPLOYMENT_TARGET=

# Sentry backend error and performance monitoring. Empty DSN = disabled, which
# is the correct local and CI setting: the application boots and behaves
# identically with Sentry switched off. Never commit a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Backend errors are never sampled away.
SENTRY_SAMPLE_RATE=1.0
# Empty disables tracing. staging-main runs 1.0; production targets start at 0.10.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_METRICS=false

# Laravel Nightwatch, installed for the Phase 6B side-by-side evaluation
# against Sentry. Off everywhere except a target that opts in: with
# NIGHTWATCH_ENABLED=false the package registers nothing, needs no token, and
# the application boots and behaves identically. Nightwatch also needs a local
# agent process, which only staging-main runs — see
# infrastructure/runbooks/nightwatch-evaluation.md. Never commit a real token.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
# The application sends events to the local agent here, and the agent binds to
# the same address. It must always be a loopback address.
NIGHTWATCH_INGEST_URI=127.0.0.1:2407
# staging-main runs 1.0 for its controlled acceptance window, then returns to
# 0.10. Nightwatch bills observed events, not requests, so a sampled request
# also brings its queries, cache events and jobs.
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.10
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
# Privacy posture, matching Sentry's: no request bodies, no mail recipients,
# no notification recipients. Do not flip these on a whim.
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
NIGHTWATCH_IGNORE_MAIL=true
NIGHTWATCH_IGNORE_NOTIFICATIONS=true
# Only relevant if the `nightwatch` channel is ever added to LOG_STACK, which
# Phase 6B deliberately does not do.
NIGHTWATCH_LOG_LEVEL=warning
