# RateGuru environment template — tits-guru
#
# The canonical runtime file lives on the host at
# <application_root>/shared/.env, is created once by an operator and is never
# written by any deploy, configure or recovery operation. This template is the
# reviewed declaration of WHICH KEYS that file must carry.
#
# Every deployment target's template declares the SAME KEYS IN THE SAME ORDER,
# enforced by tests/Feature/Architecture/DeploymentTargetRegistryTest.php:
# adding a key to one template without the other fails CI.
# This file also travels INSIDE every release artifact built from it, and that
# copy is what an ordinary deploy judges a host's .env against — because the
# tooling installed on a host may be older than the application being deployed
# onto it. Configure Target uses the repository copy;
# verify-environment-contract uses the host's installed copy for standalone
# inspection. Controlled restore and recovery alignment are exempt: they install
# an exact historical release beside historical state.
#
# So a new key travels: template -> CI -> every target's template -> every
# artifact built from then on -> a refusal on the next ordinary deploy to any
# host whose operator has not deliberately added it.
#
# Key names only, never values, and nothing ever writes the host's file.
#
# Values here are defaults and placeholders. An empty value means "the operator
# supplies it"; it does not mean the key is optional.

# --- Application ---------------------------------------------------------------
# Identity, environment class and the target this file belongs to.

APP_NAME=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_DEPLOYMENT_TARGET=tits-guru
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=
BCRYPT_ROUNDS=
BROADCAST_CONNECTION=

# --- Database ------------------------------------------------------------------
# Credentials for the role and database the registry declares for this
# target. install-target-database reads them from here and never writes them.

DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Cache / Redis -------------------------------------------------------------
# One Redis server per host, separated per target by REDIS_PREFIX and the
# database numbers below.

CACHE_STORE=
REDIS_CLIENT=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_CACHE_DB=
REDIS_PREFIX=

# --- Queue ---------------------------------------------------------------------
# The queue connection and the Redis settings that back it. The queue NAME
# is a registry property; what is configured here is how to reach it.

QUEUE_CONNECTION=redis
REDIS_QUEUE=
REDIS_QUEUE_CONNECTION=
REDIS_QUEUE_RETRY_AFTER=

# --- Filesystem / Media --------------------------------------------------------
# Where uploaded media is written and which disk serves it publicly, and the
# lifecycle the stored originals and derived variants follow.
#
# The lock settings are not tuning knobs to leave blank: variant generation and
# the purge each take a lock so two workers cannot derive or delete the same
# object at once, and a blank TTL is not a longer lock — it is an unreadable one.
# Every value here is the current contract rather than a suggestion.

FILESYSTEM_DISK=
MEDIA_PUBLIC_DISK=public
MEDIA_VARIANT_LOCK_WAIT_SECONDS=30
MEDIA_VARIANT_LOCK_TTL_SECONDS=60
MEDIA_PURGE_GRACE_DAYS=7
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_PURGE_LOCK_TTL_SECONDS=60
MEDIA_AUDIT_LOCK_TTL_SECONDS=3660
MEDIA_AUDIT_RUN_RETENTION=30

# --- Upload policy -------------------------------------------------------------
# The limits an upload is accepted or refused by, and the quality derived
# variants are written at.
#
# These are deliberately explicit rather than left to the application's defaults:
# they are the operational policy of a brand — how large an image a visitor may
# send, and how much the server will spend re-encoding it — and the values below
# ARE those defaults, so making them visible changes nothing.
#
# MAX_PIXELS guards total area independently of the width and height limits: a
# 6000x6000 image passes both and is still 36 megapixels to decode.

UPLOAD_IMAGE_MAX_KB=5120
UPLOAD_IMAGE_MAX_WIDTH=6000
UPLOAD_IMAGE_MAX_HEIGHT=6000
UPLOAD_IMAGE_MAX_PIXELS=16000000
UPLOAD_IMAGE_JPEG_QUALITY=90
UPLOAD_IMAGE_PNG_COMPRESSION=6
UPLOAD_IMAGE_WEBP_QUALITY=90

# --- Content lifecycle ---------------------------------------------------------
# How long content outlives the account, or the decision, that removed it.
#
# A retention of 0 would delete immediately, and a blank one is not "forever" —
# it is whatever the application's own default happens to be, which is the thing
# a deployed target should not be left guessing at. The moderation retention is
# deliberately blank: it is the one value here that is a policy decision per
# brand rather than a platform default.

POST_AUTHOR_DELETE_RETENTION_DAYS=30
COMMENT_AUTHOR_DELETE_RETENTION_DAYS=30
MODERATION_CONTENT_RETENTION_DAYS=

# --- Import --------------------------------------------------------------------
# Whether a visitor may create a post from an external URL. Off by default, and
# off is a decision rather than an oversight: the importer fetches a
# caller-supplied address from the server, so enabling it widens what the host
# will connect to.

IMPORT_FROM_URL_ENABLED=false

# --- Rate limits ---------------------------------------------------------------
# Attempts per decay window, per action. The values below are the application's
# current defaults, made explicit because they are abuse policy and belong where
# an operator can see them — not because they are being changed.

RATE_LIMIT_UPLOAD_ATTEMPTS=5
RATE_LIMIT_UPLOAD_DECAY_SECONDS=600
RATE_LIMIT_COMMENT_ATTEMPTS=10
RATE_LIMIT_COMMENT_DECAY_SECONDS=60
RATE_LIMIT_REPORT_ATTEMPTS=10
RATE_LIMIT_REPORT_DECAY_SECONDS=600
RATE_LIMIT_VOTE_ATTEMPTS=60
RATE_LIMIT_VOTE_DECAY_SECONDS=60

# --- Sessions ------------------------------------------------------------------
# SESSION_SECURE_COOKIE stays true everywhere: every deployed target is
# served over HTTPS.

SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# --- Logging -------------------------------------------------------------------
# Channel, stack and verbosity. Nothing here enables a remote sink; see
# Sentry and Nightwatch below.

LOG_CHANNEL=
LOG_STACK=
LOG_LEVEL=

# --- Social login --------------------------------------------------------------
# Per-provider OAuth credentials. A provider is offered only when its own
# switch is enabled AND both of its keys are present.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Mail ----------------------------------------------------------------------
# Transport only. Which addresses are allowed to receive mail is an
# application concern, not an environment one.

MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_TO=

# --- Sentry --------------------------------------------------------------------
# One Sentry project serves every target; SENTRY_ENVIRONMENT carries the
# environment class and the target is distinguished by its own tag.

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.10
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_METRICS=false

# --- Nightwatch ----------------------------------------------------------------
# Disabled by default. The vendor default is enabled=true, so the key must
# be present and explicit rather than omitted.

NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_INGEST_URI=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.10
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
NIGHTWATCH_IGNORE_MAIL=true
NIGHTWATCH_IGNORE_NOTIFICATIONS=true
NIGHTWATCH_LOG_LEVEL=warning
