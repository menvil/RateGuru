#!/usr/bin/env bash

set -Eeuo pipefail

# RATEGURU_COMMON_FILE is only honored alongside RATEGURU_ALLOW_TEST_OVERRIDES
# =true — a stray environment variable surviving in a real root shell (a
# leftover export, a shared profile) can never silently redirect this script
# at an attacker- or operator-controlled file to source. This is a plain
# inline condition, not a call to common's rateguru_test_overrides_allowed():
# common has not been sourced yet at this point, so no function it defines
# exists to call. Production never sets either variable, so this resolves to
# the exact same installed path as before.
COMMON_FILE=/home/www/rateguru/bin/common

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]] \
    && [[ -n "${RATEGURU_COMMON_FILE:-}" ]]
then
    COMMON_FILE="${RATEGURU_COMMON_FILE}"
fi

# shellcheck disable=SC1090
source "${COMMON_FILE}"

parse_target_args health-check "$@"

# require_active_target validates the target ID, the whole registry, that the
# target exists, and that it is lifecycle=active — all before anything below
# builds a URL or calls curl. A planned target (e.g. tits-guru today) or an
# unknown one is rejected here, never reaching the network.
require_active_target "${TARGET_ID}"

BASE_URL="$(target_health_url "${TARGET_ID}")"
HOST_HEADER="$(target_health_host_header "${TARGET_ID}")"
LABEL="${TARGET_ID}"

HEALTH_URL="${BASE_URL%/}/up"

# The home page too. /up answers for the framework, the database and the cache
# store, but not for what a release can break on its own: a migration it needs
# and does not have, its built assets, a view that does not compile. Each of
# those fails every page while /up still answers, and the home page is the one
# every visitor gets.
HOME_URL="${BASE_URL%/}/"

ATTEMPTS=10
DELAY_SECONDS=2

http_status() {
    curl \
        --silent \
        --output /dev/null \
        --write-out '%{http_code}' \
        --max-time 5 \
        --header "Host: ${HOST_HEADER}" \
        "$1" \
        2>/dev/null || true
}

for ((attempt = 1; attempt <= ATTEMPTS; attempt++)); do
    HTTP_STATUS="$(http_status "${HEALTH_URL}")"

    if [[ "${HTTP_STATUS}" == "200" ]]; then
        HOME_STATUS="$(http_status "${HOME_URL}")"

        if [[ "${HOME_STATUS}" == "200" ]]; then
            log "${LABEL} health check passed: ${HEALTH_URL} and ${HOME_URL}"
            exit 0
        fi

        log "${LABEL} health check attempt ${attempt}/${ATTEMPTS}: ${HEALTH_URL} answered, but the home page failed with HTTP ${HOME_STATUS:-000}"
    else
        log "${LABEL} health check attempt ${attempt}/${ATTEMPTS} failed with HTTP ${HTTP_STATUS:-000}"
    fi

    sleep "${DELAY_SECONDS}"
done

fail "${LABEL} health check failed: ${HEALTH_URL} and ${HOME_URL}"
