#!/usr/bin/env bash

set -Eeuo pipefail

# RATEGURU_COMMON_FILE is only honored alongside RATEGURU_ALLOW_TEST_OVERRIDES
# =true — a stray environment variable surviving in a real root shell (a
# leftover export, a shared profile) can never silently redirect this script
# at an attacker- or operator-controlled file to source. This is a plain
# inline condition, not a call to common's rateguru_test_overrides_allowed():
# common has not been sourced yet at this point, so no function it defines
# exists to call. Production never sets either variable, so this resolves to
# the exact same installed path as before.
COMMON_FILE=/home/www/rateguru/bin/common

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]] \
    && [[ -n "${RATEGURU_COMMON_FILE:-}" ]]
then
    COMMON_FILE="${RATEGURU_COMMON_FILE}"
fi

# shellcheck disable=SC1090
source "${COMMON_FILE}"

# Gated test override for the one external binary rollback
# invokes by absolute path, mirroring deploy's own RATEGURU_HEALTH_CHECK_BIN/
# HEALTH_CHECK_BIN pattern exactly. Production value is unchanged; this exists
# purely so tests can run rollback's real pipeline end to end against a
# self-contained stub health-check instead of the real installed one. Gated
# the same way every other RATEGURU_* override is: a stray environment
# variable in a real root shell can never silently redirect this binary
# without the explicit opt-in flag.
HEALTH_CHECK_BIN_DEFAULT="/home/www/rateguru/bin/health-check"
HEALTH_CHECK_BIN="${HEALTH_CHECK_BIN_DEFAULT}"

# Where the restore guard lives — the same run root backup,
# backup-cycle and the restore primitives already resolve. Rollback reads it
# and nothing else under it.
RUN_ROOT_DEFAULT="/home/www/rateguru/run"
RUN_ROOT="${RUN_ROOT_DEFAULT}"

# How long the queue transition waits for the target queue program to reach
# RUNNING — deploy's own production budget, so a rollback and a deployment
# judge the same worker by the same clock. supervisorctl and runuser are
# resolved through PATH, as systemctl already is; only the wait tuning has
# gated value overrides (shrunk by tests, never by production).
QUEUE_WAIT_ATTEMPTS=10
QUEUE_RETRY_DELAY_SECONDS=1

if rateguru_test_overrides_allowed; then
    if [[ -n "${RATEGURU_HEALTH_CHECK_BIN:-}" ]]; then
        HEALTH_CHECK_BIN="${RATEGURU_HEALTH_CHECK_BIN}"
    fi

    if [[ -n "${RATEGURU_RUN_ROOT:-}" ]]; then
        RUN_ROOT="${RATEGURU_RUN_ROOT}"
    fi

    if [[ -n "${RATEGURU_ROLLBACK_QUEUE_WAIT_ATTEMPTS:-}" ]]; then
        QUEUE_WAIT_ATTEMPTS="${RATEGURU_ROLLBACK_QUEUE_WAIT_ATTEMPTS}"
    fi

    if [[ -n "${RATEGURU_ROLLBACK_QUEUE_RETRY_DELAY:-}" ]]; then
        QUEUE_RETRY_DELAY_SECONDS="${RATEGURU_ROLLBACK_QUEUE_RETRY_DELAY}"
    fi
fi

usage() {
    cat <<'USAGE'
Usage:

  rollback \
    --target TARGET_ID \
    (--release RELEASE_ID | --previous)
USAGE
}

# Everything below, down to (not including) the source guard at the bottom of
# this file, is constants and function definitions only — nothing runs until
# main is called. This is what lets tests source this whole section standalone
# (BASH_SOURCE[0] != $0 when sourced, so the guard never calls main on its
# own), call parse_rollback_args/resolve_target/perform_rollback directly for
# parsing- and resolution-only coverage, or call main explicitly for tests
# that legitimately need the full root-gated flow — the same technique
# infrastructure/scripts/deploy already established, chosen here over
# cleanup's run_apply()/run_verify() wrapper because rollback runs privileged
# filesystem mutation on every invocation, not just under a dedicated flag —
# require_root must stay the unconditional first action, unchanged from
# before this slice.

# --- target, destination and execution-mode parsing ---------------------------
#
# rollback cannot reuse common's parse_target_args directly — it has extra
# flags (--release, --previous) that function does not know about — so it
# runs its own loop for --target/--release/--previous. Every value-taking
# flag below validates its value through require_flag_value before
# assignment or shifting, so a missing, empty, or flag-shaped value fails
# closed with a message naming the specific flag, matching deploy's own
# contract exactly.

# require_flag_value <flag-name> <remaining-arg-count> <next-token>
#
# <remaining-arg-count> is "$#" from the caller's while loop, taken *before*
# any shift — i.e. it counts the flag itself plus everything after it, so
# "at least 2" means a following token genuinely exists. <next-token> is
# "${2-}" from the same call site (nounset-safe whether or not $2 exists).
require_flag_value() {
    local flag="$1" remaining="$2" value="${3-}"

    [[ "${remaining}" -ge 2 ]] || fail "${flag} requires a value"
    [[ -n "${value}" ]] || fail "${flag} requires a non-empty value"

    case "${value}" in
        -*) fail "${flag} requires a value, not another option: ${value}" ;;
    esac
}

parse_rollback_args() {
    TARGET_ID=""
    TARGET_SEEN=false
    RELEASE_ID=""
    RELEASE_SEEN=false
    USE_PREVIOUS=false
    PREVIOUS_SEEN=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ "${TARGET_SEEN}" != true ]] || fail "--target given more than once"
                require_flag_value "--target" "$#" "${2-}"
                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --release)
                [[ "${RELEASE_SEEN}" != true ]] || fail "--release given more than once"
                [[ "${PREVIOUS_SEEN}" != true ]] || fail "--release and --previous cannot be combined"
                require_flag_value "--release" "$#" "${2-}"
                RELEASE_ID="$2"
                RELEASE_SEEN=true
                shift 2
                ;;
            --previous)
                [[ "${PREVIOUS_SEEN}" != true ]] || fail "--previous given more than once"
                [[ "${RELEASE_SEEN}" != true ]] || fail "--release and --previous cannot be combined"
                USE_PREVIOUS=true
                PREVIOUS_SEEN=true
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${TARGET_SEEN}" == true ]] || fail "--target is required"

    if [[ "${RELEASE_SEEN}" != true ]] && [[ "${PREVIOUS_SEEN}" != true ]]; then
        fail "--release or --previous is required"
    fi
}

# --- target resolution (mirrors health-check/status/cleanup/deploy) ----------

resolve_target() {
    # require_active_target validates the target ID, the whole registry, that
    # the target exists, and that it is lifecycle=active — all before
    # target_root, the current/previous symlinks, the releases directory, the
    # deployment lock, history, systemctl, supervisorctl or health-check are
    # ever touched. main() already called require_root before this function
    # runs, so the full ordering is: root authorization -> lifecycle=planned
    # rejection -> (only if active) filesystem/lock work.
    require_active_target "${TARGET_ID}"

    TARGET_ROOT="$(target_root "${TARGET_ID}")"
    # The queue worker's identity, from the registry and nowhere else — the
    # same two helpers deploy resolves it with.
    RUNTIME_USER="$(target_runtime_user "${TARGET_ID}")"
    SUPERVISOR_PROGRAM="$(target_supervisor_program "${TARGET_ID}")"
    LABEL="${TARGET_ID}"
    HEALTH_CHECK_ARGS=(--target "${TARGET_ID}")
}

# --- release path safety -----------------------------------------------------
#
# Fail-closed validation for every release path this script ever reads as the
# current release, the previous release, or an explicit --release target —
# before any symlink is switched. current/previous remain ordinary symlinks;
# what is refused is an unsafe *target* of that symlink (escaping the
# releases root, a nested path, an invalid release ID, a release directory
# that is itself a symlink, or a missing target) — never the fact that
# current/previous are symlinks in the first place, which is expected and
# required.

validate_releases_root() {
    [[ -e "${RELEASES_ROOT}" ]] \
        || fail "releases root does not exist: ${RELEASES_ROOT}"

    [[ ! -L "${RELEASES_ROOT}" ]] \
        || fail "releases root must not be a symlink: ${RELEASES_ROOT}"

    [[ -d "${RELEASES_ROOT}" ]] \
        || fail "releases root must be a real directory: ${RELEASES_ROOT}"

    local canonical_target_root
    CANONICAL_RELEASES_ROOT="$(readlink -f "${RELEASES_ROOT}")"
    canonical_target_root="$(readlink -f "${TARGET_ROOT}")"

    [[ "$(dirname "${CANONICAL_RELEASES_ROOT}")" == "${canonical_target_root}" ]] \
        || fail "releases root does not canonically resolve under the target root: ${RELEASES_ROOT}"
}

# validate_release_directory <release_path> <label>
#
# <release_path> is a literal, single-hop path — never pre-resolved with
# `readlink -f` by the caller — so a release directory that is itself a
# symlink is caught here by name, rather than silently followed through to
# whatever it ultimately points at. Requires: exists; is a real directory;
# is not itself a symlink; is a direct child of RELEASES_ROOT; has a
# release-ID-shaped basename; and, after `readlink -f`, resolves to exactly
# itself — i.e. nothing anywhere in the chain lets it escape the releases
# root. Used identically for the current release, the previous release, and
# an explicit --release path.
validate_release_directory() {
    local release_path="$1"
    local label="$2"

    [[ -e "${release_path}" ]] \
        || fail "${label} release does not exist: ${release_path}"

    [[ ! -L "${release_path}" ]] \
        || fail "${label} release must not be a symlink: ${release_path}"

    [[ -d "${release_path}" ]] \
        || fail "${label} release must be a real directory: ${release_path}"

    [[ "$(dirname "${release_path}")" == "${RELEASES_ROOT}" ]] \
        || fail "${label} release is not a direct child of the releases root: ${release_path}"

    local release_id
    release_id="$(basename "${release_path}")"

    validate_release_id "${release_id}"

    # Compared against CANONICAL_RELEASES_ROOT (readlink -f of RELEASES_ROOT),
    # never the literal RELEASES_ROOT itself: on hosts where some prefix of
    # RELEASES_ROOT is itself a symlink (e.g. macOS aliasing /var to
    # /private/var), readlink -f on release_path resolves through it, and
    # comparing that against an un-resolved literal path would produce a
    # false "escapes the releases root" failure for a perfectly safe release.
    local canonical
    canonical="$(readlink -f "${release_path}")"

    [[ "${canonical}" == "${CANONICAL_RELEASES_ROOT}/${release_id}" ]] \
        || fail "${label} release escapes the releases root: ${release_path}"
}

# validate_pointer_release <link_path> <label>
#
# <link_path> (current or previous) must be a symlink. Its immediate
# (single-hop) target is read with plain `readlink` — never `readlink -f` —
# made absolute if it is not already, and handed to validate_release_directory
# unresolved further, so that function's own `-L` check is what catches a
# release directory that is itself a symlink. Prints the validated absolute
# path.
validate_pointer_release() {
    local link_path="$1"
    local label="$2"

    [[ -L "${link_path}" ]] \
        || fail "${label} symlink does not exist: ${link_path}"

    local immediate_target
    immediate_target="$(readlink "${link_path}")"

    case "${immediate_target}" in
        /*) ;;
        *) immediate_target="${TARGET_ROOT}/${immediate_target}" ;;
    esac

    validate_release_directory "${immediate_target}" "${label}"

    printf '%s\n' "${immediate_target}"
}

# --- target queue worker ------------------------------------------------------
#
# Laravel queue workers are long-lived: they keep the application code they
# booted with. A rollback that only moved `current` and reloaded PHP-FPM would
# leave them running the very release it rolled away from, for as long as they
# live. So a rollback ends exactly as a deployment does — the same
# registry-declared program (target_supervisor_program), the same runtime user
# (target_runtime_user), the same two cases, the same supervisorctl commands
# and the same bounded wait — and never touches any other Supervisor program.
#
# queue_program_running, wait_for_queue_program_running and issue_queue_restart
# are deploy's own, byte for byte, and RollbackTest holds them to it: two
# readings of Supervisor state would eventually disagree.

# queue_program_running — every process of the target program group is
# RUNNING according to supervisorctl. Deliberately strict: STARTING, BACKOFF,
# FATAL, EXITED and STOPPED are all "not running"; the committed program sets
# startsecs=3, so a STARTING process has not yet survived it.
queue_program_running() {
    local output

    output="$(supervisorctl status "${SUPERVISOR_PROGRAM}:*" 2>/dev/null)" || return 1
    [[ -n "${output}" ]] || return 1

    ! grep -qv 'RUNNING' <<<"${output}"
}

# wait_for_queue_program_running — bounded observation of the target program
# reaching RUNNING (QUEUE_WAIT_ATTEMPTS × QUEUE_RETRY_DELAY_SECONDS). An idle
# worker exits the moment it is signalled, and Supervisor's replacement sits in
# STARTING until it survives startsecs; a single immediate check would fail a
# healthy rollback on that. Strictly an observer of the target program.
wait_for_queue_program_running() {
    local attempt

    for ((attempt = 1; attempt <= QUEUE_WAIT_ATTEMPTS; attempt++)); do
        if queue_program_running; then
            return 0
        fi

        sleep "${QUEUE_RETRY_DELAY_SECONDS}"
    done

    # One final observation, so the last sleep is not wasted.
    queue_program_running
}

# activate_supervisor_worker — the worker was not RUNNING before this rollback
# (an operator stopped it, or it had already failed), so the rollback makes it
# RUNNING against the restored release with deploy's activation: reread parses
# the installed configuration, update registers or refreshes exactly the target
# program group, start covers a group registered but stopped, and the bounded
# wait requires RUNNING. SUPERVISOR_ACTIVATED_NOW is armed after reread (which
# starts nothing) and before update, so recovery stops only what this rollback
# may have started.
activate_supervisor_worker() {
    log "activating supervisor worker ${SUPERVISOR_PROGRAM} (it was not RUNNING before this rollback)"

    if ! supervisorctl reread >/dev/null; then
        FAILURE_STATUS="failed-supervisor-activation"
        fail "supervisorctl reread failed"
    fi

    SUPERVISOR_ACTIVATED_NOW=true

    if ! supervisorctl update "${SUPERVISOR_PROGRAM}" >/dev/null; then
        FAILURE_STATUS="failed-supervisor-activation"
        fail "supervisorctl update ${SUPERVISOR_PROGRAM} failed"
    fi

    if ! queue_program_running; then
        # Registered but not started, where update alone changes nothing.
        supervisorctl start "${SUPERVISOR_PROGRAM}:*" >/dev/null 2>&1 || true
    fi

    if ! wait_for_queue_program_running; then
        FAILURE_STATUS="failed-supervisor-activation"
        fail "supervisor worker ${SUPERVISOR_PROGRAM} did not reach RUNNING"
    fi

    log "supervisor worker ${SUPERVISOR_PROGRAM} RUNNING"
}

# issue_queue_restart RELEASE_DIR — writes Laravel's queue restart signal
# from RELEASE_DIR, as the runtime user. Returns the artisan exit status; the
# caller decides what a failure means — a failed rollback in the transition, a
# failed recovery in the exit handler.
issue_queue_restart() {
    local release_dir="$1"

    (
        cd "${release_dir}"

        runuser \
            -u "${RUNTIME_USER}" \
            -- "${PHP_BIN}" artisan queue:restart
    )
}

# perform_queue_transition — after the switch, the PHP-FPM reload and the HTTP
# health check, and before the success record: a rollback is successful only
# when both hold. The worker's state BEFORE the rollback, captured under the
# deployment lock in ORIGINAL_QUEUE_RUNNING, decides which:
#
#   not RUNNING — activate it, as above. No queue:restart afterwards: the
#   process was just started against the restored `current`.
#
#   RUNNING — no reread/update/start churn. `artisan queue:restart`, run from
#   the restored release as the runtime user, is MANDATORY: a worker that never
#   receives it keeps serving the release this rollback rolled away from. A
#   restored release without artisan cannot send it, and is refused for the
#   same reason — deploy skips the signal for such a release because there is
#   no Laravel queue to move, but here a worker is already running and only the
#   signal moves it.
#
# PID turnover is not a condition, exactly as in deploy: Laravel's restart is
# graceful, a worker finishes its current job before it exits, and Supervisor
# replaces it. What is required is the signal, and a program that is — or
# within the wait becomes again — RUNNING.
perform_queue_transition() {
    if [[ "${ORIGINAL_QUEUE_RUNNING}" != true ]]; then
        activate_supervisor_worker

        log "worker ${SUPERVISOR_PROGRAM} was freshly started against the restored release — no queue:restart signal needed"

        return 0
    fi

    log "supervisor worker ${SUPERVISOR_PROGRAM} already RUNNING — no supervisor registration/start churn"

    if [[ ! -f "${TARGET_RELEASE_PATH}/artisan" ]]; then
        FAILURE_STATUS="failed-queue-restart"
        fail "the restored release ${TARGET_RELEASE} has no artisan — the running worker cannot be signalled and would keep serving ${ORIGINAL_CURRENT_ID}"
    fi

    if ! issue_queue_restart "${TARGET_RELEASE_PATH}"; then
        FAILURE_STATUS="failed-queue-restart"
        fail "artisan queue:restart failed — the running worker would keep serving ${ORIGINAL_CURRENT_ID}"
    fi

    QUEUE_RESTART_ISSUED=true

    log "queue restart signal issued from ${TARGET_RELEASE}; Supervisor performs the eventual worker process replacement"

    if ! wait_for_queue_program_running; then
        FAILURE_STATUS="failed-queue-restart"
        fail "supervisor worker ${SUPERVISOR_PROGRAM} did not reach RUNNING within the wait budget after the queue restart signal"
    fi
}

# --- rollback recovery (a process-global EXIT trap, armed in perform_rollback
# below: links, PHP-FPM and the restored health check first, then the queue) --

restore_link_state() {
    local link_path="$1"
    local original_present="$2"
    local original_path="$3"
    local recovery_link="${link_path}.recovery"

    if [[ "${original_present}" == true ]]; then
        if [[ ! -d "${original_path}" ]]; then
            log "WARNING: original symlink target is unavailable: ${original_path}"
            return 1
        fi

        if ! ln -sfn "${original_path}" "${recovery_link}"; then
            return 1
        fi

        if ! mv -Tf "${recovery_link}" "${link_path}"; then
            rm -f "${recovery_link}" || true
            return 1
        fi
    elif ! rm -f "${link_path}"; then
        return 1
    fi

    return 0
}

restore_original_links() {
    local recovery_failed=false
    local current_restored=true

    if ! restore_link_state \
        "${CURRENT_LINK}" \
        true \
        "${ORIGINAL_CURRENT_PATH}"
    then
        current_restored=false
        recovery_failed=true
    fi

    if ! restore_link_state \
        "${PREVIOUS_LINK}" \
        "${ORIGINAL_PREVIOUS_PRESENT}" \
        "${ORIGINAL_PREVIOUS_PATH}"
    then
        recovery_failed=true
    fi

    if ! systemctl reload "${PHP_FPM_SERVICE}"; then
        recovery_failed=true
    fi

    # Recovery health-check uses the exact same target rollback was invoked
    # with (HEALTH_CHECK_ARGS, resolved once in resolve_target) — never a
    # second, independently-derived target.
    if [[ "${current_restored}" == true ]]; then
        if ! "${HEALTH_CHECK_BIN}" "${HEALTH_CHECK_ARGS[@]}"; then
            recovery_failed=true
        fi
    fi

    [[ "${recovery_failed}" == false ]]
}

# recover_queue_worker — after restore_original_links, returns the target's
# queue to the state it had before this rollback, the way deploy's recovery
# does:
#
#   * this rollback activated the program (it was not RUNNING before): stop
#     it again, so no worker keeps running a release the target no longer
#     serves. Like deploy, this stops the processes and leaves the program
#     registered.
#   * it was RUNNING and this rollback already signalled it: the workers were
#     told to reboot against what `current` pointed at, and some may already
#     have booted the abandoned release. Re-signal from the restored original
#     release — only once `current` provably points at it again — then require
#     RUNNING within the bounded wait.
#   * it was RUNNING and was never signalled: nothing was asked of it, and it
#     must still be RUNNING.
#
# Never a force-start, never another program. Returns non-zero, having said
# why, when the queue could not be put back as it was.
recover_queue_worker() {
    if [[ "${SUPERVISOR_ACTIVATED_NOW}" == true ]]; then
        log "rollback failed after supervisor activation; stopping ${SUPERVISOR_PROGRAM} (it was not RUNNING before this rollback)"

        if ! supervisorctl stop "${SUPERVISOR_PROGRAM}:*" >/dev/null 2>&1; then
            log "WARNING: unable to stop supervisor worker ${SUPERVISOR_PROGRAM} during recovery"

            return 1
        fi

        return 0
    fi

    [[ "${ORIGINAL_QUEUE_RUNNING}" == true ]] || return 0

    local recovered=true

    if [[ "${QUEUE_RESTART_ISSUED}" == true ]]; then
        if [[ "$(readlink -f "${CURRENT_LINK}")" != "$(readlink -f "${ORIGINAL_CURRENT_PATH}")" ]]; then
            recovered=false
            log "WARNING: current was not restored to ${ORIGINAL_CURRENT_ID}, so the queue restart signal was not re-issued from it — the workers follow whatever current now points at"
        elif [[ ! -f "${ORIGINAL_CURRENT_PATH}/artisan" ]]; then
            recovered=false
            log "WARNING: the restored release ${ORIGINAL_CURRENT_ID} has no artisan — the queue restart signal cannot be re-issued from it"
        else
            log "re-issuing the queue restart signal from the restored release ${ORIGINAL_CURRENT_PATH}"

            if ! issue_queue_restart "${ORIGINAL_CURRENT_PATH}"; then
                recovered=false
                log "WARNING: unable to re-issue the queue restart signal from the restored release"
            fi
        fi
    fi

    if ! wait_for_queue_program_running; then
        recovered=false
        log "WARNING: supervisor worker ${SUPERVISOR_PROGRAM} was RUNNING before this rollback but is not RUNNING after recovery — investigate manually"
    fi

    [[ "${recovered}" == true ]]
}

handle_rollback_exit() {
    local exit_code=$?

    trap - EXIT

    if (( exit_code != 0 )) \
        && [[ "${ROLLBACK_STARTED}" == true ]]
    then
        if [[ "${SWITCH_STARTED}" == true ]]; then
            local recovery_failed=false

            log "rollback failed; restoring original current and previous links"

            if ! restore_original_links; then
                recovery_failed=true
                log "WARNING: rollback recovery or restored health verification failed"
            fi

            if ! recover_queue_worker; then
                recovery_failed=true
            fi

            if [[ "${recovery_failed}" == true ]]; then
                log "ERROR: rollback recovery FAILED — ${LABEL} is not provably back on ${ORIGINAL_CURRENT_ID} with its queue as it was; inspect ${TARGET_ROOT} and the ${SUPERVISOR_PROGRAM} Supervisor program before any further deploy or rollback"
            else
                log "rollback recovery complete: ${LABEL} serves ${ORIGINAL_CURRENT_ID} again, with its queue as it was before this rollback"
            fi
        fi

        if [[ "${TERMINAL_HISTORY_WRITTEN}" == false ]]; then
            if append_history \
                "${TARGET_ROOT}" \
                "rollback-finished" \
                "${TARGET_RELEASE}" \
                "${FAILURE_STATUS}"
            then
                TERMINAL_HISTORY_WRITTEN=true
            else
                log "WARNING: unable to record failed rollback"
            fi
        fi
    fi

    rm -f \
        "${CURRENT_LINK}.new" \
        "${CURRENT_LINK}.recovery" \
        "${PREVIOUS_LINK}.new" \
        "${PREVIOUS_LINK}.recovery" \
        || true

    exit "${exit_code}"
}

# --- rollback pipeline --------------------------------------------------------

perform_rollback() {
    RELEASES_ROOT="${TARGET_ROOT}/releases"
    CURRENT_LINK="${TARGET_ROOT}/current"
    PREVIOUS_LINK="${TARGET_ROOT}/previous"

    acquire_deployment_lock "${TARGET_ROOT}"

    # Taken under the deployment lock and before any validation, link move or
    # history record: a target held after a restore has live data that may
    # belong to a different commit than `current` serves, and a rollback there
    # would move `current` to a THIRD commit that matches neither. Worse, it
    # would health-check the target and bring it back up, which is exactly what
    # the hold exists to prevent. Ended only by the controlled alignment deploy
    # and `restore-target --resume`, never by a rollback.
    assert_no_operation_hold "${TARGET_ID}" "${RUN_ROOT}" "a rollback"

    validate_releases_root

    ORIGINAL_CURRENT_PATH="$(validate_pointer_release "${CURRENT_LINK}" "current")"
    ORIGINAL_CURRENT_ID="$(basename "${ORIGINAL_CURRENT_PATH}")"

    ORIGINAL_PREVIOUS_PRESENT=false
    ORIGINAL_PREVIOUS_PATH=""

    # -e alone would miss a dangling symlink (a real, unsafe case
    # validate_pointer_release must still catch); -L alone would miss an
    # existing plain file or directory at PREVIOUS_LINK, silently treating it
    # as "absent" and letting the later atomic mv -Tf clobber it without ever
    # validating what was there. Either condition routes into
    # validate_pointer_release, whose own `-L` check is what actually rejects
    # a non-symlink previous — mirroring cleanup's protect_pointer_link.
    if [[ -e "${PREVIOUS_LINK}" ]] || [[ -L "${PREVIOUS_LINK}" ]]; then
        ORIGINAL_PREVIOUS_PRESENT=true
        ORIGINAL_PREVIOUS_PATH="$(validate_pointer_release "${PREVIOUS_LINK}" "previous")"
    fi

    if [[ "${USE_PREVIOUS}" == true ]]; then
        [[ "${ORIGINAL_PREVIOUS_PRESENT}" == true ]] \
            || fail "previous symlink does not exist"

        TARGET_RELEASE_PATH="${ORIGINAL_PREVIOUS_PATH}"
        TARGET_RELEASE="$(basename "${TARGET_RELEASE_PATH}")"
    else
        validate_release_id "${RELEASE_ID}"

        TARGET_RELEASE="${RELEASE_ID}"
        TARGET_RELEASE_PATH="${RELEASES_ROOT}/${TARGET_RELEASE}"

        validate_release_directory "${TARGET_RELEASE_PATH}" "explicit"
    fi

    # Compared canonically (readlink -f on both sides), not as literal
    # strings: ORIGINAL_CURRENT_PATH is the symlink's raw, single-hop target
    # (see validate_pointer_release), which can carry a trailing slash or a
    # symlinked path-prefix difference from the freshly-constructed
    # TARGET_RELEASE_PATH even when both genuinely name the same release
    # directory. A literal-string false negative here would let the swap
    # proceed and silently overwrite previous with what is already current,
    # discarding a real rollback point for no actual change to current.
    if [[ "$(readlink -f "${ORIGINAL_CURRENT_PATH}")" == "$(readlink -f "${TARGET_RELEASE_PATH}")" ]]; then
        fail "target release is already current"
    fi

    # Snapshot the target worker before anything changes, under the
    # deployment lock — a read-only status query, never reread/update/start.
    # It decides the queue transition after the switch, and what recovery
    # puts back if the rollback fails.
    ORIGINAL_QUEUE_RUNNING=false
    queue_program_running && ORIGINAL_QUEUE_RUNNING=true
    SUPERVISOR_ACTIVATED_NOW=false
    QUEUE_RESTART_ISSUED=false

    ROLLBACK_STARTED=false
    SWITCH_STARTED=false
    TERMINAL_HISTORY_WRITTEN=false
    FAILURE_STATUS="failed"

    trap handle_rollback_exit EXIT

    append_history \
        "${TARGET_ROOT}" \
        "rollback-started" \
        "${TARGET_RELEASE}" \
        "running"

    ROLLBACK_STARTED=true
    SWITCH_STARTED=true

    ln -sfn \
        "${ORIGINAL_CURRENT_PATH}" \
        "${PREVIOUS_LINK}.new"

    mv -Tf \
        "${PREVIOUS_LINK}.new" \
        "${PREVIOUS_LINK}"

    ln -sfn \
        "${TARGET_RELEASE_PATH}" \
        "${CURRENT_LINK}.new"

    mv -Tf \
        "${CURRENT_LINK}.new" \
        "${CURRENT_LINK}"

    systemctl reload "${PHP_FPM_SERVICE}"

    if ! "${HEALTH_CHECK_BIN}" "${HEALTH_CHECK_ARGS[@]}"; then
        FAILURE_STATUS="failed-health-check"
        fail "rollback health check failed; restoring ${ORIGINAL_CURRENT_ID}"
    fi

    # The workers follow the restored release before the rollback may be
    # called successful.
    perform_queue_transition

    log "${LABEL} rolled back to ${TARGET_RELEASE}"

    append_history \
        "${TARGET_ROOT}" \
        "rollback-finished" \
        "${TARGET_RELEASE}" \
        "success"

    TERMINAL_HISTORY_WRITTEN=true
}

# --- dispatch -----------------------------------------------------------

# require_root stays the first substantive action of a real invocation,
# unchanged from before this slice — rollback runs privileged filesystem
# mutation on every invocation, not only under a dedicated flag, so this is
# the production root-only contract, unweakened by anything above:
# parse_rollback_args, resolve_target and perform_rollback are all inert
# definitions until main calls them, in this exact order.
main() {
    require_root
    parse_rollback_args "$@"
    resolve_target
    perform_rollback
}

# A real invocation (`bash rollback ...` or `./rollback ...`) always has
# BASH_SOURCE[0] == $0, so main runs immediately here, exactly as today.
# Tests source this file instead — BASH_SOURCE[0] != $0 in that case, so main
# never auto-runs — then call parse_rollback_args/resolve_target/
# perform_rollback directly (bypassing require_root, for parsing/resolution/
# pipeline coverage that doesn't need real root) or invoke the script as a
# genuine subprocess (which does run main(), requiring root first, exactly as
# production).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
