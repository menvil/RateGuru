#!/usr/bin/env bash
#
# install-mail-capture — install/verify the shared staging mail-capture slice.
#
# Modes:
#   --check   Validate committed configuration, pinned versions, checksums and
#             architecture support. Read-only: makes NO changes to the system
#             (no downloads, no users, no files, no services).
#   --apply   Install and activate Mailpit (canonical) + Mailtrap Local (mirror)
#             from checksum-verified pinned release archives.
#
# Behavior:
#   * Compares each downloaded archive's SHA-256 against the committed pin in
#     SHA256SUMS and refuses to install on a mismatch; only pinned versions
#     are downloaded (never "latest").
#   * Never modifies the Laravel production environment.
#   * Idempotent: re-running restarts only what actually changed.
#   * Apply is transactional through runtime verification: the change is not
#     committed until both services are enabled, active and serving. On any
#     failure up to and including runtime health — download, checksum, unit
#     syntax, nginx -t, enable, restart, listeners, HTTP API, stability — the
#     previously installed files AND the previous service state (enabled and
#     active) are restored, and Nginx is re-validated and reloaded.

set -Eeuo pipefail
umask 022

# --- Locations --------------------------------------------------------------

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"
CONFIG_DIR="${REPO_ROOT}/infrastructure/config/mail-capture"
CHECKSUMS_FILE="${CONFIG_DIR}/SHA256SUMS"
SYSTEMD_SRC="${REPO_ROOT}/infrastructure/config/systemd"
NGINX_SRC="${REPO_ROOT}/infrastructure/config/nginx"

# Installed target locations.
BIN_MAILPIT="/usr/local/bin/staging-mailpit"
BIN_MAILTRAP="/usr/local/bin/staging-mailtrap-local"
ETC_DIR="/etc/staging-mail-capture"
ENV_MAILPIT="${ETC_DIR}/mailpit.env"
YML_MAILPIT_RELAY="${ETC_DIR}/mailpit-relay.yml"
YML_MAILTRAP="${ETC_DIR}/mailtrap-local.yml"
VERSIONS_DST="${ETC_DIR}/versions.env"
UNIT_DIR="/etc/systemd/system"
UNIT_MAILPIT="${UNIT_DIR}/staging-mailpit.service"
UNIT_MAILTRAP="${UNIT_DIR}/staging-mailtrap-local.service"
NGINX_AVAILABLE="/etc/nginx/sites-available"
NGINX_ENABLED="/etc/nginx/sites-enabled"
NGINX_MAILPIT_NAME="mailpit-staging"
NGINX_MAILTRAP_NAME="mailtrap-local-staging"

STATE_ROOT="/var/lib/staging-mail-capture"
STATE_MAILPIT="${STATE_ROOT}/mailpit"
STATE_MAILTRAP="${STATE_ROOT}/mailtrap-local"
BACKUP_ROOT="/var/backups/staging-mail-capture"

USER_MAILPIT="staging-mailpit"
USER_MAILTRAP="staging-mailtrap-local"

# --- Logging ----------------------------------------------------------------

log() {
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

fail() {
    printf '[%s] ERROR: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2
    exit 1
}

# --- Argument parsing -------------------------------------------------------

MODE=""

usage() {
    cat <<'USAGE'
Usage: install-mail-capture --check | --apply

  --check   Validate committed configuration only. No system changes.
  --apply   Install and activate the mail-capture services (requires root).
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)
            MODE="check"
            shift
            ;;
        --apply)
            MODE="apply"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            fail "unknown argument: $1"
            ;;
    esac
done

[[ -n "${MODE}" ]] || { usage >&2; fail "one of --check or --apply is required"; }

# --- Shared helpers ---------------------------------------------------------

require_root() {
    [[ "${EUID}" -eq 0 ]] || fail "this command must be executed as root"
}

detect_arch() {
    local machine
    machine="$(uname -m)"

    case "${machine}" in
        x86_64|amd64)
            printf 'amd64\n'
            ;;
        aarch64|arm64)
            printf 'arm64\n'
            ;;
        *)
            fail "unsupported architecture: ${machine} (supported: x86_64/amd64, aarch64/arm64)"
            ;;
    esac
}

require_linux() {
    [[ "$(uname -s)" == "Linux" ]] || fail "mail capture is only supported on Linux"
}

load_versions() {
    local versions_file="${CONFIG_DIR}/versions.env"
    [[ -r "${versions_file}" ]] || fail "missing pinned versions file: ${versions_file}"

    # shellcheck disable=SC1090
    source "${versions_file}"

    [[ -n "${MAILPIT_VERSION:-}" ]] || fail "MAILPIT_VERSION is not pinned"
    [[ -n "${MAILTRAP_LOCAL_VERSION:-}" ]] || fail "MAILTRAP_LOCAL_VERSION is not pinned"

    [[ "${MAILPIT_VERSION}" != "latest" ]] || fail "MAILPIT_VERSION must be pinned, not 'latest'"
    [[ "${MAILTRAP_LOCAL_VERSION}" != "latest" ]] || fail "MAILTRAP_LOCAL_VERSION must be pinned, not 'latest'"

    [[ "${MAILPIT_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
        || fail "MAILPIT_VERSION is not a valid semantic version: ${MAILPIT_VERSION}"
    [[ "${MAILTRAP_LOCAL_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
        || fail "MAILTRAP_LOCAL_VERSION is not a valid semantic version: ${MAILTRAP_LOCAL_VERSION}"
}

mailpit_archive() {
    printf 'mailpit-linux-%s.tar.gz\n' "$1"
}

mailtrap_archive() {
    printf 'mailtrap-local_%s_linux_%s.tar.gz\n' "${MAILTRAP_LOCAL_VERSION}" "$1"
}

expected_checksum() {
    # expected_checksum <archive-name>: look up the pinned digest in SHA256SUMS.
    awk -v archive="$1" '$2 == archive { print $1 }' "${CHECKSUMS_FILE}"
}

# --- Validation (side-effect free) -----------------------------------------

validate_config() {
    local arch="$1"

    local required=(
        "${CONFIG_DIR}/versions.env"
        "${CONFIG_DIR}/SHA256SUMS"
        "${CONFIG_DIR}/mailpit.env"
        "${CONFIG_DIR}/mailpit-relay.yml"
        "${CONFIG_DIR}/mailtrap-local.yml"
        "${SYSTEMD_SRC}/staging-mailpit.service"
        "${SYSTEMD_SRC}/staging-mailtrap-local.service"
        "${NGINX_SRC}/${NGINX_MAILPIT_NAME}"
        "${NGINX_SRC}/${NGINX_MAILTRAP_NAME}"
    )

    local path
    for path in "${required[@]}"; do
        [[ -r "${path}" ]] || fail "missing required committed file: ${path}"
    done

    # Every listener must remain loopback-only. Mailpit's own binds live in its
    # env file; its mirror relay TARGET lives in mailpit-relay.yml; Mailtrap
    # Local's binds are CLI flags in its systemd unit (its YAML holds only the
    # retention cap, no listener keys).
    local mailpit_env="${CONFIG_DIR}/mailpit.env"
    grep -Eq '^MP_SMTP_BIND_ADDR=127\.0\.0\.1:1025$' "${mailpit_env}" \
        || fail "mailpit.env does not bind SMTP to loopback 127.0.0.1:1025"
    grep -Eq '^MP_UI_BIND_ADDR=127\.0\.0\.1:8025$' "${mailpit_env}" \
        || fail "mailpit.env does not bind HTTP to loopback 127.0.0.1:8025"
    grep -Eq "^MP_SMTP_RELAY_CONFIG=${YML_MAILPIT_RELAY//./\\.}$" "${mailpit_env}" \
        || fail "mailpit.env does not reference the relay config ${YML_MAILPIT_RELAY}"

    # Mailtrap Local SMTP binds the 127.0.0.2 IPv4 loopback address (avoids the
    # 0.2.0 IPv6 [::1] expansion), so the relay TARGET must dial 127.0.0.2 too.
    local mailpit_relay="${CONFIG_DIR}/mailpit-relay.yml"
    grep -Eq '^host:[[:space:]]*127\.0\.0\.2$' "${mailpit_relay}" \
        || fail "mailpit-relay.yml relay host is not loopback 127.0.0.2"
    grep -Eq '^port:[[:space:]]*3535$' "${mailpit_relay}" \
        || fail "mailpit-relay.yml relay port is not 3535"

    local mailtrap_unit="${SYSTEMD_SRC}/staging-mailtrap-local.service"
    grep -Eq -- '--smtp-listen 127\.0\.0\.2:3535' "${mailtrap_unit}" \
        || fail "mailtrap-local unit does not bind SMTP to loopback 127.0.0.2:3535"
    grep -Eq -- '--http-listen 127\.0\.0\.1:3550' "${mailtrap_unit}" \
        || fail "mailtrap-local unit does not bind HTTP/API to loopback 127.0.0.1:3550"

    log "committed configuration is present and loopback-bound"
}

validate_checksums() {
    local arch="$1"
    local mp_archive mt_archive mp_sum mt_sum

    [[ -r "${CHECKSUMS_FILE}" ]] || fail "missing checksum file: ${CHECKSUMS_FILE}"

    mp_archive="$(mailpit_archive "${arch}")"
    mt_archive="$(mailtrap_archive "${arch}")"

    mp_sum="$(expected_checksum "${mp_archive}")"
    mt_sum="$(expected_checksum "${mt_archive}")"

    [[ "${mp_sum}" =~ ^[0-9a-f]{64}$ ]] \
        || fail "no valid SHA-256 pinned for ${mp_archive} in ${CHECKSUMS_FILE}"
    [[ "${mt_sum}" =~ ^[0-9a-f]{64}$ ]] \
        || fail "no valid SHA-256 pinned for ${mt_archive} in ${CHECKSUMS_FILE}"

    log "pinned checksums present for ${mp_archive} and ${mt_archive}"
}

# --- Download + verify ------------------------------------------------------

download() {
    # download <url> <dest>
    local url="$1" dest="$2"

    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error --max-time 120 --output "${dest}" "${url}"
    elif command -v wget >/dev/null 2>&1; then
        wget --quiet --timeout=120 --output-document="${dest}" "${url}"
    else
        fail "neither curl nor wget is available to download ${url}"
    fi
}

verify_archive() {
    # verify_archive <archive-path> <expected-sha256>
    local archive="$1" expected="$2" actual

    actual="$(sha256sum "${archive}" | awk '{ print $1 }')"

    [[ "${actual}" == "${expected}" ]] \
        || fail "checksum mismatch for ${archive}: expected ${expected}, got ${actual}"
}

# fetch_binary <name> <url> <archive> <binary-in-archive> <staged-out>
fetch_binary() {
    local name="$1" url="$2" archive="$3" inner="$4" staged_out="$5"
    local expected work

    expected="$(expected_checksum "${archive}")"
    [[ "${expected}" =~ ^[0-9a-f]{64}$ ]] \
        || fail "no pinned checksum for ${archive}"

    work="$(mktemp -d)"
    STAGING_DIRS+=("${work}")

    log "downloading ${name} ${archive}"
    download "${url}" "${work}/${archive}"

    log "verifying ${name} checksum"
    verify_archive "${work}/${archive}" "${expected}"

    tar -xzf "${work}/${archive}" -C "${work}"
    [[ -f "${work}/${inner}" ]] || fail "archive ${archive} does not contain ${inner}"

    install -m 0755 "${work}/${inner}" "${staged_out}"
}

# --- Apply-mode installation with rollback ---------------------------------

BACKUP_DIR=""
STAGING_DIRS=()
ROLLBACK_RESTORE=()   # files that existed before and were backed up
ROLLBACK_REMOVE=()    # files that did not exist before (remove on rollback)

# The apply is committed only once BOTH services have passed every runtime
# health check. Until then any failure restores files *and* runtime state.
APPLY_COMMITTED=false

# Change flags — drive daemon-reload and restart-only-changed.
CHANGED_MAILPIT_BIN=false
CHANGED_MAILTRAP_BIN=false
CHANGED_MAILPIT_SVC=false
CHANGED_MAILTRAP_SVC=false
CHANGED_UNIT=false
CHANGED_NGINX=false

files_differ() {
    # files_differ <src> <dst> -> true (0) if dst missing or content differs
    local src="$1" dst="$2"
    [[ -f "${dst}" ]] || return 0
    ! cmp -s "${src}" "${dst}"
}

record_target() {
    # record_target <dst>: snapshot for rollback before it is written
    local dst="$1"
    if [[ -e "${dst}" || -L "${dst}" ]]; then
        local backup_path="${BACKUP_DIR}${dst}"
        install -d -m 0700 "$(dirname "${backup_path}")"
        cp -a "${dst}" "${backup_path}"
        ROLLBACK_RESTORE+=("${dst}")
    else
        ROLLBACK_REMOVE+=("${dst}")
    fi
}

install_file() {
    # install_file <src> <dst> <mode>
    local src="$1" dst="$2" mode="$3"
    record_target "${dst}"
    install -o root -g root -m "${mode}" "${src}" "${dst}"
}

install_binary_atomic() {
    # install_binary_atomic <staged-src> <dst>
    local src="$1" dst="$2" tmp
    record_target "${dst}"
    tmp="${dst}.tmp.$$"
    install -o root -g root -m 0755 "${src}" "${tmp}"
    mv -f "${tmp}" "${dst}"
}

ensure_symlink() {
    # ensure_symlink <target> <link>
    local target="$1" link="$2"
    if [[ -L "${link}" && "$(readlink "${link}")" == "${target}" ]]; then
        return 0
    fi
    record_target "${link}"
    ln -sfn "${target}" "${link}"
    CHANGED_NGINX=true
}

cleanup_staging() {
    local dir
    for dir in "${STAGING_DIRS[@]:-}"; do
        [[ -n "${dir}" && -d "${dir}" ]] && rm -rf "${dir}"
    done
}

on_apply_error() {
    local code=$?
    trap - ERR EXIT
    log "apply failed (exit ${code})"
    if [[ "${APPLY_COMMITTED}" == false ]]; then
        # Failure of the rollback itself must not mask the original status.
        rollback || log "ERROR: rollback did not fully succeed (diagnostics above)"
    fi
    cleanup_staging
    exit "${code}"
}

create_user() {
    # create_user <name> <home>
    local name="$1" home="$2"
    if id "${name}" >/dev/null 2>&1; then
        return 0
    fi
    log "creating system user ${name}"
    useradd \
        --system \
        --no-create-home \
        --home-dir "${home}" \
        --shell /usr/sbin/nologin \
        "${name}"
}

# --- Runtime health verification (apply mode) ------------------------------
#
# Everything between the begin/end markers is a self-contained block: it needs
# only `log` and `fail` from above, so the behavioural tests can source the
# shipped code and run it against stubbed systemctl/ss/curl instead of
# re-implementing a copy of it.

# --- runtime health (begin) ---

# Bounded waits. The MAIL_CAPTURE_* overrides are a test seam for shortening
# the windows; any value that is not a positive integer falls back to the
# default, so a stray environment variable can never disable the gate.
RUNTIME_WAIT="${MAIL_CAPTURE_RUNTIME_WAIT:-30}"          # become healthy
RUNTIME_STABILITY_WAIT="${MAIL_CAPTURE_STABILITY_WAIT:-4}" # stay healthy
[[ "${RUNTIME_WAIT}" =~ ^[1-9][0-9]*$ ]] || RUNTIME_WAIT=30
[[ "${RUNTIME_STABILITY_WAIT}" =~ ^[1-9][0-9]*$ ]] || RUNTIME_STABILITY_WAIT=4

service_property() {
    # service_property <unit> <property>
    systemctl show "$1" --property="$2" --value 2>/dev/null || true
}

service_is_enabled() {
    # service_is_enabled <unit>: true only when the unit starts at boot. A
    # service that is active but disabled disappears on the next reboot, so it
    # must never pass the health gate.
    systemctl is-enabled --quiet "$1" >/dev/null 2>&1
}

service_restart_count() {
    # service_restart_count <unit>: NRestarts as a number (0 when unknown).
    local count
    count="$(service_property "$1" NRestarts)"
    [[ "${count}" =~ ^[0-9]+$ ]] || count=0
    printf '%s\n' "${count}"
}

service_is_running() {
    # service_is_running <unit>: active, and not mid-(re)start.
    local state sub
    state="$(service_property "$1" ActiveState)"
    sub="$(service_property "$1" SubState)"
    [[ "${state}" == "active" && ( "${sub}" == "running" || "${sub}" == "exited" ) ]]
}

wait_service_active() {
    # wait_service_active <unit> <timeout>: succeed only on a stable active
    # state; fail fast when the unit is failed, and fail on timeout when it is
    # stuck activating (auto-restart loop) or inactive.
    local unit="$1" timeout="$2" waited=0 state
    while (( waited < timeout )); do
        if service_is_running "${unit}"; then
            return 0
        fi
        state="$(service_property "${unit}" ActiveState)"
        if [[ "${state}" == "failed" ]]; then
            return 1
        fi
        sleep 1
        (( waited += 1 ))
    done
    return 1
}

wait_listener() {
    # wait_listener <host> <port> <timeout>: wait for a loopback TCP listener.
    # The listener list is captured first and matched separately: under
    # `set -o pipefail` a `ss | grep -q` pipeline reports failure whenever grep
    # short-circuits on a match and ss is killed by SIGPIPE.
    local host="$1" port="$2" timeout="$3" waited=0 listeners
    while (( waited < timeout )); do
        listeners="$(ss -ltnH "sport = :${port}" 2>/dev/null || true)"
        if grep -qE "[[:space:]]${host//./\\.}:${port}([[:space:]]|$)" <<<"${listeners}"; then
            return 0
        fi
        sleep 1
        (( waited += 1 ))
    done
    return 1
}

check_http_api() {
    # check_http_api <url>: single request, no retries.
    curl -fsS --noproxy '*' --max-time 5 "$1" >/dev/null 2>&1
}

wait_http_api() {
    # wait_http_api <url> <timeout>
    local url="$1" timeout="$2" waited=0
    while (( waited < timeout )); do
        check_http_api "${url}" && return 0
        sleep 1
        (( waited += 1 ))
    done
    return 1
}

dump_service_diagnostics() {
    # dump_service_diagnostics <unit>: full status + restart-loop properties +
    # recent UNFILTERED application journal (never hide bind/exec/restart lines).
    local unit="$1"
    log "diagnostics: ${unit}"
    systemctl status "${unit}" --no-pager --full 2>&1 | tail -n 30 || true
    log "  ActiveState=$(service_property "${unit}" ActiveState)" \
        "SubState=$(service_property "${unit}" SubState)" \
        "Result=$(service_property "${unit}" Result)" \
        "ExecMainStatus=$(service_property "${unit}" ExecMainStatus)" \
        "NRestarts=$(service_property "${unit}" NRestarts)"
    if command -v journalctl >/dev/null 2>&1; then
        log "  recent journal for ${unit}:"
        journalctl -u "${unit}" --no-pager --since '-2min' 2>&1 | tail -n 40 || true
    fi
}

assert_service_stable() {
    # assert_service_stable <unit> <api-url>: a slow restart loop can be active
    # and serving for a moment, so re-check after a stability window. The
    # service must still be running, must NOT have restarted in between, and
    # must still answer its API.
    local unit="$1" api="$2" before after

    before="$(service_restart_count "${unit}")"
    sleep "${RUNTIME_STABILITY_WAIT}"

    if ! service_is_running "${unit}"; then
        log "ERROR: ${unit} did not stay active for ${RUNTIME_STABILITY_WAIT}s" \
            "(ActiveState=$(service_property "${unit}" ActiveState)," \
            "SubState=$(service_property "${unit}" SubState))"
        return 1
    fi

    after="$(service_restart_count "${unit}")"
    if (( after > before )); then
        log "ERROR: ${unit} restarted during the ${RUNTIME_STABILITY_WAIT}s stability window" \
            "(NRestarts ${before} -> ${after}); it is in a restart loop"
        return 1
    fi

    if ! check_http_api "${api}"; then
        log "ERROR: ${unit} API ${api} stopped responding during the stability window"
        return 1
    fi

    return 0
}

ensure_service_healthy() {
    # ensure_service_healthy <unit> <api-url> <host:port>...
    local unit="$1" api="$2"
    shift 2
    local hostport host port enabled_state

    # Boot persistence first: active-but-disabled survives until the next
    # reboot and nothing else in this gate would notice.
    if ! service_is_enabled "${unit}"; then
        enabled_state="$(systemctl is-enabled "${unit}" 2>&1 || true)"
        log "ERROR: ${unit} is not enabled for boot (is-enabled: ${enabled_state:-unknown})"
        dump_service_diagnostics "${unit}"
        return 1
    fi

    if ! wait_service_active "${unit}" "${RUNTIME_WAIT}"; then
        log "ERROR: ${unit} did not reach a stable active state within ${RUNTIME_WAIT}s"
        dump_service_diagnostics "${unit}"
        return 1
    fi

    for hostport in "$@"; do
        host="${hostport%:*}"
        port="${hostport##*:}"
        if ! wait_listener "${host}" "${port}" "${RUNTIME_WAIT}"; then
            log "ERROR: ${unit} is not listening on ${hostport}"
            dump_service_diagnostics "${unit}"
            return 1
        fi
    done

    if ! wait_http_api "${api}" "${RUNTIME_WAIT}"; then
        log "ERROR: ${unit} API ${api} did not respond within ${RUNTIME_WAIT}s"
        dump_service_diagnostics "${unit}"
        return 1
    fi

    if ! assert_service_stable "${unit}" "${api}"; then
        dump_service_diagnostics "${unit}"
        return 1
    fi

    log "${unit} is enabled, stably active and serving ${api}"
    return 0
}

verify_runtime_health() {
    # Prove both services are actually up before the apply is committed.
    # Mailtrap Local is checked first (Mailpit relays to it), then Mailpit.
    # Disabled / failed / inactive / stuck activating / restart-looping /
    # missing a listener / silent API all fail the apply.
    log "verifying services are healthy at runtime"
    local failed=false

    ensure_service_healthy "staging-mailtrap-local.service" \
        "http://127.0.0.1:3550/api/v1/version" \
        "127.0.0.2:3535" "127.0.0.1:3550" \
        || failed=true

    ensure_service_healthy "staging-mailpit.service" \
        "http://127.0.0.1:8025/api/v1/info" \
        "127.0.0.1:1025" "127.0.0.1:8025" \
        || failed=true

    [[ "${failed}" == false ]] \
        || fail "mail-capture services are not healthy after apply (see diagnostics above)"

    log "runtime health verified for both services"
}
# --- runtime health (end) ---

# --- Rollback: files AND runtime state --------------------------------------
#
# Restoring files is not enough: systemd keeps the previously loaded units and
# the running processes, so a rollback that only touches disk leaves the broken
# configuration in memory (or the services down). This block therefore also
# reloads systemd, restores each service's boot and running state, and
# re-validates/reloads Nginx.
#
# Self-contained apart from `log` and the runtime-health helpers above, so the
# behavioural tests can source both blocks and exercise the shipped code.

# --- rollback (begin) ---

MAIL_UNITS=("staging-mailtrap-local.service" "staging-mailpit.service")

# Pre-apply runtime snapshot: "<unit>|<active|inactive>|<is-enabled output>".
SERVICE_STATE_BEFORE=()

capture_service_states() {
    # Snapshot both services BEFORE anything is touched, so a failed activation
    # can be undone completely rather than only on disk.
    SERVICE_STATE_BEFORE=()

    local unit active enabled
    for unit in "${MAIL_UNITS[@]}"; do
        active=inactive
        systemctl is-active --quiet "${unit}" >/dev/null 2>&1 && active=active

        enabled="$(systemctl is-enabled "${unit}" 2>/dev/null || true)"
        [[ -n "${enabled}" ]] || enabled="unknown"

        SERVICE_STATE_BEFORE+=("${unit}|${active}|${enabled}")
        log "pre-apply state: ${unit} (active=${active}, enabled=${enabled})"
    done
}

restore_service_enablement() {
    # restore_service_enablement <unit> <recorded is-enabled output>
    local unit="$1" enabled="$2"

    case "${enabled}" in
        enabled|enabled-runtime)
            systemctl enable "${unit}" >/dev/null 2>&1
            ;;
        disabled)
            systemctl disable "${unit}" >/dev/null 2>&1
            ;;
        masked|masked-runtime)
            systemctl mask "${unit}" >/dev/null 2>&1
            ;;
        *)
            # static / indirect / generated / not-found / unknown: there is no
            # prior enablement that enable|disable|mask could restore.
            return 0
            ;;
    esac
}

restore_service_activation() {
    # restore_service_activation <unit> <active|inactive>: put the service back
    # into its pre-apply running state using the RESTORED unit and config, and
    # confirm it actually got there.
    local unit="$1" want="$2"

    if [[ "${want}" == active ]]; then
        systemctl restart "${unit}" >/dev/null 2>&1 || true
        systemctl is-active --quiet "${unit}" >/dev/null 2>&1
    else
        systemctl stop "${unit}" >/dev/null 2>&1 || true
        ! systemctl is-active --quiet "${unit}" >/dev/null 2>&1
    fi
}

restore_runtime_state() {
    # Re-apply every recorded boot/running state. Returns non-zero if any part
    # of the runtime could not be restored.
    local entry unit rest active enabled status=0

    for entry in "${SERVICE_STATE_BEFORE[@]:-}"; do
        [[ -n "${entry}" ]] || continue
        unit="${entry%%|*}"
        rest="${entry#*|}"
        active="${rest%%|*}"
        enabled="${rest#*|}"

        if ! restore_service_enablement "${unit}" "${enabled}"; then
            log "ERROR: rollback could not restore the boot state (${enabled}) of ${unit}"
            status=1
        fi

        if ! restore_service_activation "${unit}" "${active}"; then
            log "ERROR: rollback could not return ${unit} to its previous ${active} state"
            status=1
        fi
    done

    return "${status}"
}

restore_nginx_runtime() {
    # Only meaningful when this run replaced Nginx files.
    [[ "${CHANGED_NGINX}" == true ]] || return 0

    log "validating restored nginx configuration"
    if ! nginx -t >/dev/null 2>&1; then
        log "ERROR: restored nginx configuration is invalid; nginx was NOT reloaded"
        nginx -t 2>&1 | tail -n 20 || true
        return 1
    fi

    if ! systemctl is-active --quiet nginx >/dev/null 2>&1; then
        log "nginx is not running; the restored configuration applies on next start"
        return 0
    fi

    log "reloading nginx with the restored configuration"
    if ! systemctl reload nginx; then
        log "ERROR: nginx reload failed during rollback"
        return 1
    fi

    return 0
}

rollback() {
    log "rolling back installed files and runtime state"

    local status=0 dst backup_path

    for dst in "${ROLLBACK_REMOVE[@]:-}"; do
        [[ -n "${dst}" ]] || continue
        rm -f "${dst}" || { log "ERROR: could not remove ${dst}"; status=1; }
    done

    for dst in "${ROLLBACK_RESTORE[@]:-}"; do
        [[ -n "${dst}" ]] || continue
        backup_path="${BACKUP_DIR}${dst}"
        if [[ -e "${backup_path}" || -L "${backup_path}" ]]; then
            rm -rf "${dst}"
            cp -a "${backup_path}" "${dst}" \
                || { log "ERROR: could not restore ${dst} from ${backup_path}"; status=1; }
        else
            log "ERROR: no backup found for ${dst}; it was left as installed"
            status=1
        fi
    done

    # Files on disk mean nothing until systemd re-reads them and the services
    # are put back the way they were.
    if [[ "${CHANGED_UNIT}" == true ]]; then
        log "reloading systemd after restoring units"
        systemctl daemon-reload \
            || { log "ERROR: systemctl daemon-reload failed during rollback"; status=1; }
    fi

    restore_runtime_state || status=1
    restore_nginx_runtime || status=1

    if (( status != 0 )); then
        log "ERROR: rollback INCOMPLETE — files were restored but the running state was not"
        local entry
        for entry in "${SERVICE_STATE_BEFORE[@]:-}"; do
            [[ -n "${entry}" ]] || continue
            dump_service_diagnostics "${entry%%|*}"
        done
        log "manual intervention required; backups remain in ${BACKUP_DIR}"
        return 1
    fi

    log "rollback complete: files and runtime state restored; backups remain in ${BACKUP_DIR}"
    return 0
}
# --- rollback (end) ---

# --- Modes ------------------------------------------------------------------

run_check() {
    local arch
    require_linux
    arch="$(detect_arch)"
    load_versions

    log "mode: check (read-only)"
    log "architecture: linux/${arch}"
    log "pinned versions: mailpit=${MAILPIT_VERSION}, mailtrap-local=${MAILTRAP_LOCAL_VERSION}"

    validate_config "${arch}"
    validate_checksums "${arch}"

    log "check passed: configuration, versions and checksums are valid"
}

run_apply() {
    local arch
    require_root
    require_linux
    arch="$(detect_arch)"
    load_versions

    log "mode: apply"
    log "architecture: linux/${arch}"
    log "pinned versions: mailpit=${MAILPIT_VERSION}, mailtrap-local=${MAILTRAP_LOCAL_VERSION}"

    validate_config "${arch}"
    validate_checksums "${arch}"

    # curl + ss are also required: apply verifies runtime health (listeners and
    # HTTP APIs) before it can report success.
    for tool in tar sha256sum install useradd systemctl nginx curl ss; do
        command -v "${tool}" >/dev/null 2>&1 || fail "required tool not found: ${tool}"
    done

    BACKUP_DIR="${BACKUP_ROOT}/$(date -u '+%Y%m%dT%H%M%SZ')"
    install -d -m 0700 "${BACKUP_ROOT}"
    install -d -m 0700 "${BACKUP_DIR}"
    log "backups for this run: ${BACKUP_DIR}"

    trap on_apply_error ERR EXIT

    # 0. Snapshot the runtime state before anything changes, so rollback can
    #    restore boot/running state and not just files.
    capture_service_states

    # 1. Users (idempotent).
    create_user "${USER_MAILPIT}" "${STATE_MAILPIT}"
    create_user "${USER_MAILTRAP}" "${STATE_MAILTRAP}"

    # 2. Directories (idempotent). Shared parent stays root-owned; each state
    #    dir is writable only by its own service user.
    install -d -o root -g root -m 0755 "${ETC_DIR}"
    install -d -o root -g root -m 0755 "${STATE_ROOT}"
    install -d -o "${USER_MAILPIT}" -g "${USER_MAILPIT}" -m 0750 "${STATE_MAILPIT}"
    install -d -o "${USER_MAILTRAP}" -g "${USER_MAILTRAP}" -m 0750 "${STATE_MAILTRAP}"

    # 3. Download + checksum-verify + stage binaries into a temp workspace.
    local stage_dir
    stage_dir="$(mktemp -d)"
    STAGING_DIRS+=("${stage_dir}")

    fetch_binary \
        "mailpit" \
        "https://github.com/axllent/mailpit/releases/download/v${MAILPIT_VERSION}/$(mailpit_archive "${arch}")" \
        "$(mailpit_archive "${arch}")" \
        "mailpit" \
        "${stage_dir}/mailpit"

    fetch_binary \
        "mailtrap-local" \
        "https://github.com/mailtrap/mailtrap-local/releases/download/v${MAILTRAP_LOCAL_VERSION}/$(mailtrap_archive "${arch}")" \
        "$(mailtrap_archive "${arch}")" \
        "mailtrap-local" \
        "${stage_dir}/mailtrap-local"

    # 4. Compute what changed (so we restart only changed services).
    files_differ "${stage_dir}/mailpit" "${BIN_MAILPIT}" && CHANGED_MAILPIT_BIN=true
    files_differ "${stage_dir}/mailtrap-local" "${BIN_MAILTRAP}" && CHANGED_MAILTRAP_BIN=true

    local mailpit_unit_changed=false mailtrap_unit_changed=false
    files_differ "${SYSTEMD_SRC}/staging-mailpit.service" "${UNIT_MAILPIT}" && mailpit_unit_changed=true
    files_differ "${SYSTEMD_SRC}/staging-mailtrap-local.service" "${UNIT_MAILTRAP}" && mailtrap_unit_changed=true

    local mailpit_env_changed=false mailpit_relay_changed=false mailtrap_yml_changed=false
    files_differ "${CONFIG_DIR}/mailpit.env" "${ENV_MAILPIT}" && mailpit_env_changed=true
    files_differ "${CONFIG_DIR}/mailpit-relay.yml" "${YML_MAILPIT_RELAY}" && mailpit_relay_changed=true
    files_differ "${CONFIG_DIR}/mailtrap-local.yml" "${YML_MAILTRAP}" && mailtrap_yml_changed=true

    files_differ "${NGINX_SRC}/${NGINX_MAILPIT_NAME}" "${NGINX_AVAILABLE}/${NGINX_MAILPIT_NAME}" && CHANGED_NGINX=true
    files_differ "${NGINX_SRC}/${NGINX_MAILTRAP_NAME}" "${NGINX_AVAILABLE}/${NGINX_MAILTRAP_NAME}" && CHANGED_NGINX=true

    # 5. Install binaries atomically.
    [[ "${CHANGED_MAILPIT_BIN}" == true ]] && install_binary_atomic "${stage_dir}/mailpit" "${BIN_MAILPIT}"
    [[ "${CHANGED_MAILTRAP_BIN}" == true ]] && install_binary_atomic "${stage_dir}/mailtrap-local" "${BIN_MAILTRAP}"

    # 6. Install environment/config files.
    [[ "${mailpit_env_changed}" == true ]] && install_file "${CONFIG_DIR}/mailpit.env" "${ENV_MAILPIT}" 0644
    [[ "${mailpit_relay_changed}" == true ]] && install_file "${CONFIG_DIR}/mailpit-relay.yml" "${YML_MAILPIT_RELAY}" 0644
    [[ "${mailtrap_yml_changed}" == true ]] && install_file "${CONFIG_DIR}/mailtrap-local.yml" "${YML_MAILTRAP}" 0644
    files_differ "${CONFIG_DIR}/versions.env" "${VERSIONS_DST}" \
        && install_file "${CONFIG_DIR}/versions.env" "${VERSIONS_DST}" 0644

    # 7. Install systemd units.
    if [[ "${mailpit_unit_changed}" == true ]]; then
        install_file "${SYSTEMD_SRC}/staging-mailpit.service" "${UNIT_MAILPIT}" 0644
        CHANGED_UNIT=true
    fi
    if [[ "${mailtrap_unit_changed}" == true ]]; then
        install_file "${SYSTEMD_SRC}/staging-mailtrap-local.service" "${UNIT_MAILTRAP}" 0644
        CHANGED_UNIT=true
    fi

    # 8. Install Nginx vhosts and enable them.
    install -d -o root -g root -m 0755 "${NGINX_AVAILABLE}" "${NGINX_ENABLED}"
    [[ "${CHANGED_NGINX}" == true ]] && install_file "${NGINX_SRC}/${NGINX_MAILPIT_NAME}" "${NGINX_AVAILABLE}/${NGINX_MAILPIT_NAME}" 0644
    [[ "${CHANGED_NGINX}" == true ]] && install_file "${NGINX_SRC}/${NGINX_MAILTRAP_NAME}" "${NGINX_AVAILABLE}/${NGINX_MAILTRAP_NAME}" 0644
    ensure_symlink "${NGINX_AVAILABLE}/${NGINX_MAILPIT_NAME}" "${NGINX_ENABLED}/${NGINX_MAILPIT_NAME}"
    ensure_symlink "${NGINX_AVAILABLE}/${NGINX_MAILTRAP_NAME}" "${NGINX_ENABLED}/${NGINX_MAILTRAP_NAME}"

    # 9. Reload systemd only if a unit changed, then verify unit syntax.
    if [[ "${CHANGED_UNIT}" == true ]]; then
        log "reloading systemd"
        systemctl daemon-reload
    fi
    log "verifying systemd units"
    systemd-analyze verify "${UNIT_MAILPIT}" "${UNIT_MAILTRAP}"

    # 10. Validate Nginx before touching the running server.
    log "validating nginx configuration"
    nginx -t

    # NOTE: the apply is NOT committed here. Activation and runtime health are
    # the most likely place to fail, which is exactly what the transaction
    # exists for, so APPLY_COMMITTED stays false until step 14.

    CHANGED_MAILPIT_SVC=false
    CHANGED_MAILTRAP_SVC=false
    { [[ "${CHANGED_MAILPIT_BIN}" == true ]] || [[ "${mailpit_env_changed}" == true ]] || [[ "${mailpit_relay_changed}" == true ]] || [[ "${mailpit_unit_changed}" == true ]]; } && CHANGED_MAILPIT_SVC=true
    { [[ "${CHANGED_MAILTRAP_BIN}" == true ]] || [[ "${mailtrap_yml_changed}" == true ]] || [[ "${mailtrap_unit_changed}" == true ]]; } && CHANGED_MAILTRAP_SVC=true

    # 11. Enable services for boot (idempotent) and restart only changed ones.
    #     Start the mirror first so Mailpit can relay to it immediately.
    #     Enabling is NOT best-effort: a service that cannot be enabled would
    #     survive this run but vanish on the next reboot, so failing here fails
    #     the apply and rolls back.
    log "enabling services for boot"
    systemctl enable staging-mailtrap-local.service \
        || fail "could not enable staging-mailtrap-local.service for boot"
    systemctl enable staging-mailpit.service \
        || fail "could not enable staging-mailpit.service for boot"

    if [[ "${CHANGED_MAILTRAP_SVC}" == true ]] || ! systemctl is-active --quiet staging-mailtrap-local.service; then
        log "restarting staging-mailtrap-local.service"
        systemctl restart staging-mailtrap-local.service
    fi
    if [[ "${CHANGED_MAILPIT_SVC}" == true ]] || ! systemctl is-active --quiet staging-mailpit.service; then
        log "restarting staging-mailpit.service"
        systemctl restart staging-mailpit.service
    fi

    # 12. Reload Nginx if its configuration changed.
    if [[ "${CHANGED_NGINX}" == true ]]; then
        log "reloading nginx"
        systemctl reload nginx
    fi

    # 13. Verify both services are actually healthy at runtime. This is what
    #     stops the installer from reporting success while a unit is disabled,
    #     stuck in "activating (auto-restart)" or silently restart-looping — it
    #     fails (non-zero) with diagnostics instead, and because the apply is
    #     still uncommitted the ERR trap restores the previous files and
    #     runtime state. Runs before the success banner is ever printed.
    verify_runtime_health

    # 14. Both services are enabled, stably active and serving: only now is the
    #     change committed and rollback disarmed.
    APPLY_COMMITTED=true

    trap - ERR EXIT
    cleanup_staging

    log "apply complete"
    log "  mailpit     : $(systemctl is-active staging-mailpit.service 2>/dev/null || echo unknown)"
    log "  mailtrap    : $(systemctl is-active staging-mailtrap-local.service 2>/dev/null || echo unknown)"
    log "  backups     : ${BACKUP_DIR}"
    log "Run 'verify-mail-capture' to confirm capture and mirroring."
}

case "${MODE}" in
    check)
        run_check
        ;;
    apply)
        run_apply
        ;;
esac
