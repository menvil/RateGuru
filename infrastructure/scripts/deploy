#!/usr/bin/env bash

set -Eeuo pipefail

# RATEGURU_COMMON_FILE is only honored alongside RATEGURU_ALLOW_TEST_OVERRIDES
# =true — a stray environment variable surviving in a real root shell (a
# leftover export, a shared profile) can never silently redirect this script
# at an attacker- or operator-controlled file to source. This is a plain
# inline condition, not a call to common's rateguru_test_overrides_allowed():
# common has not been sourced yet at this point, so no function it defines
# exists to call. Production never sets either variable, so this resolves to
# the exact same installed path as before.
COMMON_FILE=/home/www/rateguru/bin/common

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]] \
    && [[ -n "${RATEGURU_COMMON_FILE:-}" ]]
then
    COMMON_FILE="${RATEGURU_COMMON_FILE}"
fi

# shellcheck disable=SC1090
source "${COMMON_FILE}"

# Phase 4 slice 5: gated test overrides for the two external binaries deploy
# invokes by absolute path, mirroring status's own RATEGURU_HEALTH_CHECK_CLI/
# HEALTH_CHECK_BIN pattern exactly (unlike PHP_BIN/PHP_FPM_SERVICE, which
# already come from deployment.conf, these two were previously hardcoded
# literals with no test seam at all). Production values are unchanged; this
# exists purely so tests can run deploy's real pipeline end to end against
# self-contained stub health-check/verify-required-clis binaries instead of
# the real installed ones. Gated the same way every other RATEGURU_* override
# is: a stray environment variable in a real root shell can never silently
# redirect either binary without the explicit opt-in flag.
HEALTH_CHECK_BIN_DEFAULT="/home/www/rateguru/bin/health-check"
VERIFY_REQUIRED_CLIS_BIN_DEFAULT="/home/www/rateguru/bin/verify-required-clis"

HEALTH_CHECK_BIN="${HEALTH_CHECK_BIN_DEFAULT}"
VERIFY_REQUIRED_CLIS_BIN="${VERIFY_REQUIRED_CLIS_BIN_DEFAULT}"

# Phase 5 slice 5.5: how long the first-deploy Supervisor activation waits
# for the target queue program to reach RUNNING. supervisorctl itself is
# resolved through PATH — the same way this script already resolves
# systemctl and runuser, and the same way tests already PATH-shadow both —
# so only the wait tuning needs gated value overrides (shrunk by tests,
# never by production).
QUEUE_WAIT_ATTEMPTS=10
QUEUE_RETRY_DELAY_SECONDS=1

if rateguru_test_overrides_allowed; then
    if [[ -n "${RATEGURU_HEALTH_CHECK_BIN:-}" ]]; then
        HEALTH_CHECK_BIN="${RATEGURU_HEALTH_CHECK_BIN}"
    fi

    if [[ -n "${RATEGURU_VERIFY_REQUIRED_CLIS_BIN:-}" ]]; then
        VERIFY_REQUIRED_CLIS_BIN="${RATEGURU_VERIFY_REQUIRED_CLIS_BIN}"
    fi

    if [[ -n "${RATEGURU_DEPLOY_QUEUE_WAIT_ATTEMPTS:-}" ]]; then
        QUEUE_WAIT_ATTEMPTS="${RATEGURU_DEPLOY_QUEUE_WAIT_ATTEMPTS}"
    fi

    if [[ -n "${RATEGURU_DEPLOY_QUEUE_RETRY_DELAY:-}" ]]; then
        QUEUE_RETRY_DELAY_SECONDS="${RATEGURU_DEPLOY_QUEUE_RETRY_DELAY}"
    fi
fi

usage() {
    cat <<'USAGE'
Usage:

  deploy \
    --target TARGET_ID \
    --release v1.4.0-20260717-151500-a81d7f2 \
    --artifact /path/to/release.tar.gz \
    [--checksum /path/to/release.tar.gz.sha256] \
    [--migrate]
USAGE
}

# Everything below, down to (not including) the source guard at the bottom of
# this file, is constants and function definitions only — nothing runs until
# main is called. This is what lets tests source this whole section standalone
# (BASH_SOURCE[0] != $0 when sourced, so the guard never calls main on its
# own), call parse_deploy_args/resolve_target/perform_deploy directly for
# parsing- and resolution-only coverage, or call main explicitly for tests
# that legitimately need the full root-gated flow — the same technique
# already established for infrastructure/scripts/install-target-operations
# and infrastructure/scripts/cleanup, adapted here as a source guard instead
# of a thin run_*() wrapper specifically so require_root can stay the very
# first thing a real invocation does, unchanged from today.

# --- target and deployment-flag parsing --------------------------------------
#
# deploy cannot reuse common's parse_target_args directly — it has extra
# flags (--release, --artifact, --checksum, --migrate) that function doesn't
# know about — so it runs its own loop for --target plus those. Every
# value-taking flag below (--target, --release, --artifact, --checksum)
# validates its value through require_flag_value before assignment or
# shifting, so a missing, empty, or flag-shaped value (e.g.
# `--release --migrate`, which used to silently take the literal string
# "--migrate" as the release ID and leave --migrate itself unparsed) fails
# closed with a message naming the specific flag, rather than surfacing
# later as an unrelated error or, for --checksum, silently substituting a
# default the caller never asked for.

# require_flag_value <flag-name> <remaining-arg-count> <next-token>
#
# <remaining-arg-count> is "$#" from the caller's while loop, taken *before*
# any shift — i.e. it counts the flag itself plus everything after it, so
# "at least 2" means a following token genuinely exists. <next-token> is
# "${2-}" from the same call site (nounset-safe whether or not $2 exists).
require_flag_value() {
    local flag="$1" remaining="$2" value="${3-}"

    [[ "${remaining}" -ge 2 ]] || fail "${flag} requires a value"
    [[ -n "${value}" ]] || fail "${flag} requires a non-empty value"

    case "${value}" in
        -*) fail "${flag} requires a value, not another option: ${value}" ;;
    esac
}

parse_deploy_args() {
    TARGET_ID=""
    TARGET_SEEN=false
    RELEASE_ID=""
    ARTIFACT=""
    CHECKSUM_FILE=""
    RUN_MIGRATIONS=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                [[ "${TARGET_SEEN}" != true ]] || fail "--target given more than once"
                require_flag_value "--target" "$#" "${2-}"
                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --release)
                require_flag_value "--release" "$#" "${2-}"
                RELEASE_ID="$2"
                shift 2
                ;;
            --artifact)
                require_flag_value "--artifact" "$#" "${2-}"
                ARTIFACT="$2"
                shift 2
                ;;
            --checksum)
                require_flag_value "--checksum" "$#" "${2-}"
                CHECKSUM_FILE="$2"
                shift 2
                ;;
            --migrate)
                RUN_MIGRATIONS=true
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${TARGET_SEEN}" == true ]] || fail "--target is required"

    [[ -n "${RELEASE_ID}" ]] \
        || fail "--release is required"

    [[ -n "${ARTIFACT}" ]] \
        || fail "--artifact is required"
}

# --- target resolution (mirrors health-check/status/cleanup) -----------------

resolve_target() {
    # require_active_target validates the target ID, the whole registry, that
    # the target exists, and that it is lifecycle=active — all before
    # artifact/checksum canonicalization, the target filesystem root, the
    # deployment lock, or any mutation. main() already called require_root
    # before this function runs, so the full ordering is: root authorization
    # -> lifecycle=planned rejection -> (only if active) artifact/filesystem
    # validation.
    require_active_target "${TARGET_ID}"

    TARGET_ROOT="$(target_root "${TARGET_ID}")"
    RUNTIME_USER="$(target_runtime_user "${TARGET_ID}")"
    CODE_GROUP="$(target_code_group "${TARGET_ID}")"
    DEPLOY_ACCOUNT="$(target_deploy_user "${TARGET_ID}")"
    PUBLIC_HOSTNAME="$(target_primary_public_hostname "${TARGET_ID}")"
    INCOMING_ROOT="$(readlink -f "$(target_incoming_artifacts "${TARGET_ID}")")"
    SUPERVISOR_PROGRAM="$(target_supervisor_program "${TARGET_ID}")"
    LABEL="${TARGET_ID}"
    HEALTH_CHECK_ARGS=(--target "${TARGET_ID}")
}

# --- target Supervisor worker (Phase 5 slice 5.5) ----------------------------
#
# Closes the documented Phase 5.4 first-deploy gap: on a PRE_DEPLOY host the
# bootstrap installs the committed Supervisor program config but defers its
# activation (directory=current does not exist yet), so the first deployment
# must be the step that makes the target worker RUNNING. The program
# identity comes exclusively from the target registry
# (target_supervisor_program) — never hard-coded — and only the target's own
# program group is ever touched: no global reread-and-update-everything, no
# global restart of every program, no unrelated program.

# queue_program_running — every process of the target program group is
# RUNNING according to supervisorctl (the identical classification
# install-bootstrap-services uses). Deliberately strict: STARTING, BACKOFF,
# FATAL, EXITED and STOPPED are all "not running". The committed program sets
# startsecs=3, so Supervisor only promotes a process to RUNNING once it has
# survived that window — accepting STARTING as success would accept a worker
# that is about to crash-loop.
queue_program_running() {
    local output

    output="$(supervisorctl status "${SUPERVISOR_PROGRAM}:*" 2>/dev/null)" || return 1
    [[ -n "${output}" ]] || return 1

    ! grep -qv 'RUNNING' <<<"${output}"
}

# wait_for_queue_program_running — bounded observation of the target program
# reaching RUNNING, spending the existing production budget
# (QUEUE_WAIT_ATTEMPTS × QUEUE_RETRY_DELAY_SECONDS) rather than introducing a
# second timeout constant.
#
# This exists because a single immediate status check after Laravel's restart
# signal is racy. The committed program carries autorestart=true and
# startsecs=3: an idle worker may exit the moment it is signalled, and the
# replacement Supervisor spawns legitimately sits in STARTING until it has
# survived startsecs. Checking once can therefore observe STARTING and roll
# back a perfectly healthy deployment. A worker still finishing a job simply
# stays RUNNING and the wait returns on the first attempt.
#
# Strictly an observer: it never rereads, updates, starts, restarts or stops
# anything, and only ever looks at the registry-declared target program.
wait_for_queue_program_running() {
    local attempt

    for ((attempt = 1; attempt <= QUEUE_WAIT_ATTEMPTS; attempt++)); do
        if queue_program_running; then
            return 0
        fi

        sleep "${QUEUE_RETRY_DELAY_SECONDS}"
    done

    # One final observation, so the last sleep is not wasted.
    queue_program_running
}

# activate_supervisor_worker — the CASE A path: the target program is not
# active, so this deployment must make it RUNNING. reread parses the
# installed config, update registers/refreshes exactly the target program
# group, start covers a program registered but stopped, and the wait loop
# requires RUNNING. Activation failure is a deployment failure — a DEPLOYED
# target without its required queue worker is not a successful deployment.
activate_supervisor_worker() {
    log "activating supervisor worker ${SUPERVISOR_PROGRAM} (not active — first deployment after a PRE_DEPLOY bootstrap, or a stopped worker)"

    # reread only parses the installed configuration into supervisord's
    # memory — add/remove/start happens exclusively on update, which is why
    # slice 5.4 uses reread as its side-effect-free validation. So the
    # "this deploy may have started the worker" flag is armed after reread
    # and before update: a failed reread genuinely activated nothing, and
    # recovery must not then try to stop a program that was never added.
    if ! supervisorctl reread >/dev/null; then
        FAILURE_STATUS="failed-supervisor-activation"
        fail "supervisorctl reread failed"
    fi

    SUPERVISOR_ACTIVATED_NOW=true

    if ! supervisorctl update "${SUPERVISOR_PROGRAM}" >/dev/null; then
        FAILURE_STATUS="failed-supervisor-activation"
        fail "supervisorctl update ${SUPERVISOR_PROGRAM} failed"
    fi

    if ! queue_program_running; then
        # Registered but not started (e.g. the program group already existed
        # in a stopped state, where update alone changes nothing).
        supervisorctl start "${SUPERVISOR_PROGRAM}:*" >/dev/null 2>&1 || true
    fi

    # A freshly started process is STARTING until it survives startsecs, so
    # the same bounded wait applies here as after a restart signal.
    if ! wait_for_queue_program_running; then
        FAILURE_STATUS="failed-supervisor-activation"
        fail "supervisor worker ${SUPERVISOR_PROGRAM} did not reach RUNNING"
    fi

    log "supervisor worker ${SUPERVISOR_PROGRAM} RUNNING"
}

# issue_queue_restart RELEASE_DIR — writes Laravel's queue restart signal
# from RELEASE_DIR, as the runtime user. Returns the artisan exit status; the
# caller decides whether a failure is fatal (deploy) or a recovery warning.
issue_queue_restart() {
    local release_dir="$1"

    (
        cd "${release_dir}"

        runuser \
            -u "${RUNTIME_USER}" \
            -- "${PHP_BIN}" artisan queue:restart
    )
}

# perform_queue_transition — the single place the queue is handled, after the
# atomic current switch and the HTTP health check, and before the success
# record. Which action is correct depends entirely on the worker's state
# BEFORE this deployment, captured in ORIGINAL_QUEUE_RUNNING:
#
#   CASE A — the worker was not running (first deploy after a PRE_DEPLOY
#   bootstrap, or a worker an operator stopped). Activate the
#   registry-declared program and require RUNNING. Deliberately NO
#   queue:restart afterwards: the process was just started against the new
#   current, so it already booted the new release — signalling a restart
#   would only ask a fresh worker to exit for nothing.
#
#   CASE B — the worker was already running (every normal deployment on a
#   DEPLOYED target). No reread/update/start churn merely because a
#   deployment happened. Instead queue:restart is MANDATORY: Laravel workers
#   are long-lived and keep the application code they booted with, so a
#   worker that never receives the signal keeps serving the OLD release
#   indefinitely. A restart signal that cannot be written is therefore a
#   failed deployment, not a warning.
#
# PID turnover is deliberately not a deployment condition. Laravel's restart
# is graceful: the worker finishes its current job and exits afterwards, and
# Supervisor then replaces the process. Requiring immediate turnover would
# fail deployments for a worker that is simply mid-job. What is required is
# that the signal was written and the program remains operational.
perform_queue_transition() {
    if [[ "${ORIGINAL_QUEUE_RUNNING}" != true ]]; then
        activate_supervisor_worker

        log "worker ${SUPERVISOR_PROGRAM} was freshly started against the new release — no queue:restart signal needed"

        return 0
    fi

    log "supervisor worker ${SUPERVISOR_PROGRAM} already RUNNING — no supervisor registration/start churn"

    # A release with no artisan is not a Laravel application and has no queue
    # to signal; deploy already gates its whole Laravel preparation on the
    # same condition.
    if [[ ! -f "${RELEASE_ROOT}/artisan" ]]; then
        log "release contains no artisan — no queue restart signal applicable"
    else
        if ! issue_queue_restart "${RELEASE_ROOT}"; then
            FAILURE_STATUS="failed-queue-restart"
            fail "artisan queue:restart failed — the running worker would keep serving the previous release"
        fi

        QUEUE_RESTART_ISSUED=true

        log "queue restart signal issued; Supervisor performs the eventual worker process replacement"
    fi

    # The program must be operational after signalling — observed through the
    # bounded wait, never a single immediate check. Laravel's restart makes an
    # idle worker exit at once, and Supervisor's replacement is STARTING until
    # it survives startsecs; a worker still finishing a job just stays RUNNING
    # and this returns on the first attempt. Neither a PID change nor proof
    # that the old process already exited is required — only that the signal
    # was issued and the program becomes/continues operational in the window.
    if ! wait_for_queue_program_running; then
        FAILURE_STATUS="failed-queue-restart"
        fail "supervisor worker ${SUPERVISOR_PROGRAM} did not reach RUNNING within the wait budget after the queue restart signal"
    fi
}

# --- deployment recovery (unchanged internals; process-global trap, not
# function-scoped, so moving the call site that arms it into perform_deploy
# below changes nothing about when or how it fires) ---------------------------

restore_link_state() {
    local link_path="$1"
    local original_present="$2"
    local original_path="$3"
    local recovery_link="${link_path}.recovery"

    if [[ "${original_present}" == true ]]; then
        if [[ ! -d "${original_path}" ]]; then
            log "WARNING: original symlink target is unavailable: ${original_path}"
            return 1
        fi

        if ! ln -sfn "${original_path}" "${recovery_link}"; then
            return 1
        fi

        if ! mv -Tf "${recovery_link}" "${link_path}"; then
            rm -f "${recovery_link}" || true
            return 1
        fi
    elif ! rm -f "${link_path}"; then
        return 1
    fi

    return 0
}

restore_deployment_links() {
    local recovery_failed=false

    if ! restore_link_state \
        "${CURRENT_LINK}" \
        "${ORIGINAL_CURRENT_PRESENT}" \
        "${ORIGINAL_CURRENT_PATH}"
    then
        recovery_failed=true
    fi

    if ! restore_link_state \
        "${PREVIOUS_LINK}" \
        "${ORIGINAL_PREVIOUS_PRESENT}" \
        "${ORIGINAL_PREVIOUS_PATH}"
    then
        recovery_failed=true
    fi

    if ! systemctl reload "${PHP_FPM_SERVICE}"; then
        recovery_failed=true
    fi

    [[ "${recovery_failed}" == false ]]
}

handle_deployment_exit() {
    local exit_code=$?
    local recovery_succeeded=true

    trap - EXIT

    if (( exit_code != 0 )) \
        && [[ "${DEPLOYMENT_STARTED}" == true ]]
    then
        if [[ "${CURRENT_SWITCHED}" == true ]]; then
            log "deployment failed after switching current; restoring prior links"

            if ! restore_deployment_links; then
                recovery_succeeded=false
                log "WARNING: unable to fully restore deployment symlinks"
            fi
        fi

        # Supervisor state recovery (slice 5.5): only when THIS deploy
        # activated the target worker (which only happens when it was not
        # active before the deploy — an already-RUNNING worker is never
        # touched, so there is nothing to recover for it). Stopping the
        # newly-activated program guarantees no worker keeps executing
        # against a current that recovery just removed. A worker that cannot
        # be stopped blocks the failed release directory's cleanup below —
        # never delete a release a process may still be running in. Only the
        # target's own program group is touched.
        #
        # This stops the processes; it does not unregister the program. The
        # program group stays known to the running supervisord, so a failed
        # first deployment leaves the host in the same residual window the
        # PRE_DEPLOY bootstrap already documents: the committed config keeps
        # autostart=true, so a later supervisord restart would start it
        # against a current that does not exist and fail-loop until a
        # deployment succeeds. Deliberately not resolved by removing the
        # program here — recovery does not own the operator's supervisor
        # registration. See runbooks/bootstrap-services.md.
        if [[ "${SUPERVISOR_ACTIVATED_NOW}" == true ]]; then
            log "deployment failed after supervisor activation; stopping ${SUPERVISOR_PROGRAM} (it was not active before this deployment)"

            if ! supervisorctl stop "${SUPERVISOR_PROGRAM}:*" >/dev/null 2>&1; then
                recovery_succeeded=false
                log "WARNING: unable to stop supervisor worker ${SUPERVISOR_PROGRAM} during recovery"
            fi
        elif [[ "${ORIGINAL_QUEUE_RUNNING}" == true ]]; then
            # The worker ran before this deploy and was never registered or
            # started by it. If this deploy already signalled a restart, the
            # workers were told to exit and reboot against what `current`
            # points at — which recovery has just changed back to the old
            # release. Re-signal from the RESTORED release so the queue ends
            # up coherent with the release actually being served, rather than
            # leaving workers that booted (or are about to boot) the failed
            # one. Only the target's own program is involved.
            if [[ "${QUEUE_RESTART_ISSUED}" == true ]] \
                && [[ "${ORIGINAL_CURRENT_PRESENT}" == true ]] \
                && [[ -d "${ORIGINAL_CURRENT_PATH}" ]] \
                && [[ -f "${ORIGINAL_CURRENT_PATH}/artisan" ]]
            then
                log "re-issuing the queue restart signal from the restored release ${ORIGINAL_CURRENT_PATH}"

                if ! issue_queue_restart "${ORIGINAL_CURRENT_PATH}"; then
                    recovery_succeeded=false
                    log "WARNING: unable to re-issue the queue restart signal against the restored release"
                fi
            fi

            # Bounded wait, not a single check: a recovery restart signal
            # races Supervisor's replacement exactly like the deploy-time one,
            # so a transient STARTING must not be reported as degraded
            # recovery. The worker is never force-started here — this is a
            # normal deployed-target recovery, and only the target's own
            # program is ever observed.
            if ! wait_for_queue_program_running; then
                # Either something outside this pipeline stopped it, or the
                # program did not survive the transition — surfaced through
                # the existing recovery warning semantics, never silently
                # absorbed and never force-started by recovery.
                recovery_succeeded=false
                log "WARNING: supervisor worker ${SUPERVISOR_PROGRAM} was RUNNING before this deployment but is not RUNNING after recovery — investigate manually"
            fi
        fi

        if [[ "${TERMINAL_HISTORY_WRITTEN}" == false ]]; then
            if append_history \
                "${TARGET_ROOT}" \
                "deployment-finished" \
                "${RELEASE_ID}" \
                "${FAILURE_STATUS}"
            then
                TERMINAL_HISTORY_WRITTEN=true
            else
                log "WARNING: unable to record failed deployment"
            fi
        fi

        if [[ -d "${RELEASE_ROOT}" ]] \
            && { [[ "${CURRENT_SWITCHED}" == false ]] \
                || [[ "${recovery_succeeded}" == true ]]; }
        then
            rm -rf "${RELEASE_ROOT}" || true
        fi
    fi

    if [[ -d "${TEMP_RELEASE_ROOT}" ]]; then
        rm -rf "${TEMP_RELEASE_ROOT}" || true
    fi

    exit "${exit_code}"
}

# --- deployment pipeline -------------------------------------------------------

perform_deploy() {
    validate_release_id "${RELEASE_ID}"

    ARTIFACT="$(readlink -f "${ARTIFACT}")"

    [[ -f "${ARTIFACT}" ]] \
        || fail "artifact does not exist: ${ARTIFACT}"

    if [[ -z "${CHECKSUM_FILE}" ]]; then
        CHECKSUM_FILE="${ARTIFACT}.sha256"
    fi

    CHECKSUM_FILE="$(readlink -f "${CHECKSUM_FILE}")"

    [[ -f "${CHECKSUM_FILE}" ]] \
        || fail "checksum file does not exist: ${CHECKSUM_FILE}"

    case "${ARTIFACT}" in
        "${INCOMING_ROOT}"/*)
            ;;
        *)
            fail "artifact must be located inside ${INCOMING_ROOT}"
            ;;
    esac

    case "${CHECKSUM_FILE}" in
        "${INCOMING_ROOT}"/*)
            ;;
        *)
            fail "checksum must be located inside ${INCOMING_ROOT}"
            ;;
    esac

    RELEASES_ROOT="${TARGET_ROOT}/releases"
    RELEASE_ROOT="${RELEASES_ROOT}/${RELEASE_ID}"
    TEMP_RELEASE_ROOT="${RELEASES_ROOT}/.${RELEASE_ID}.tmp-$$"

    CURRENT_LINK="${TARGET_ROOT}/current"
    PREVIOUS_LINK="${TARGET_ROOT}/previous"

    acquire_deployment_lock "${TARGET_ROOT}"

    ORIGINAL_CURRENT_PRESENT=false
    ORIGINAL_CURRENT_PATH=""
    ORIGINAL_PREVIOUS_PRESENT=false
    ORIGINAL_PREVIOUS_PATH=""

    if [[ -L "${CURRENT_LINK}" ]]; then
        ORIGINAL_CURRENT_PRESENT=true
        ORIGINAL_CURRENT_PATH="$(readlink -f "${CURRENT_LINK}")"
    fi

    if [[ -L "${PREVIOUS_LINK}" ]]; then
        ORIGINAL_PREVIOUS_PRESENT=true
        ORIGINAL_PREVIOUS_PATH="$(readlink -f "${PREVIOUS_LINK}")"
    fi

    # Snapshot the target worker's state before any mutation (a read-only
    # supervisorctl status query — never reread/update/start): recovery must
    # distinguish "was RUNNING before this deploy" (left alone, stays
    # coherent against a restored old current) from "was not active before"
    # (a failed deploy that activated it must stop it again).
    ORIGINAL_QUEUE_RUNNING=false
    queue_program_running && ORIGINAL_QUEUE_RUNNING=true
    SUPERVISOR_ACTIVATED_NOW=false
    QUEUE_RESTART_ISSUED=false

    DEPLOYMENT_STARTED=false
    TERMINAL_HISTORY_WRITTEN=false
    CURRENT_SWITCHED=false
    FAILURE_STATUS="failed"

    trap handle_deployment_exit EXIT

    [[ ! -e "${RELEASE_ROOT}" ]] \
        || fail "release already exists: ${RELEASE_ROOT}"

    log "verifying artifact checksum"

    (
        cd "$(dirname "${ARTIFACT}")"

        sha256sum \
            --check \
            "$(basename "${CHECKSUM_FILE}")"
    )

    log "validating artifact paths"

    if tar -tzf "${ARTIFACT}" \
        | grep -Eq '(^/|(^|/)\.\.(/|$))'
    then
        fail "artifact contains an unsafe path"
    fi

    AVAILABLE_KB="$(
        df --output=avail "${RELEASES_ROOT}" \
            | tail -1 \
            | tr -d ' '
    )"

    ARTIFACT_KB="$(
        du -k "${ARTIFACT}" \
            | awk '{ print $1 }'
    )"

    REQUIRED_KB="$((ARTIFACT_KB * 5 + 102400))"

    if (( AVAILABLE_KB < REQUIRED_KB )); then
        fail "insufficient disk space for release extraction"
    fi

    append_history \
        "${TARGET_ROOT}" \
        "deployment-started" \
        "${RELEASE_ID}" \
        "running"

    DEPLOYMENT_STARTED=true

    log "extracting ${RELEASE_ID}"

    install \
        -d \
        -o "${DEPLOY_ACCOUNT}" \
        -g "${CODE_GROUP}" \
        -m 0750 \
        "${TEMP_RELEASE_ROOT}"

    tar \
        -xzf "${ARTIFACT}" \
        --no-same-owner \
        --no-same-permissions \
        -C "${TEMP_RELEASE_ROOT}"

    [[ -f "${TEMP_RELEASE_ROOT}/public/index.php" ]] \
        || fail "artifact does not contain public/index.php"

    if [[ -e "${TEMP_RELEASE_ROOT}/.env" ]] \
        || [[ -L "${TEMP_RELEASE_ROOT}/.env" ]]
    then
        rm -f "${TEMP_RELEASE_ROOT}/.env"
    fi

    if [[ -e "${TEMP_RELEASE_ROOT}/storage" ]] \
        || [[ -L "${TEMP_RELEASE_ROOT}/storage" ]]
    then
        rm -rf "${TEMP_RELEASE_ROOT}/storage"
    fi

    ln -s \
        "${TARGET_ROOT}/shared/.env" \
        "${TEMP_RELEASE_ROOT}/.env"

    ln -s \
        "${TARGET_ROOT}/shared/storage" \
        "${TEMP_RELEASE_ROOT}/storage"

    if [[ -e "${TEMP_RELEASE_ROOT}/public/storage" ]] \
        || [[ -L "${TEMP_RELEASE_ROOT}/public/storage" ]]
    then
        rm -rf "${TEMP_RELEASE_ROOT}/public/storage"
    fi

    ln -s \
        "${TARGET_ROOT}/shared/storage/app/public" \
        "${TEMP_RELEASE_ROOT}/public/storage"

    chown -R \
        "${DEPLOY_ACCOUNT}:${CODE_GROUP}" \
        "${TEMP_RELEASE_ROOT}"

    # Normalize modes without discarding the executable bit. Files Git tracked as
    # executable (installer/verify/status scripts, and any future ones) are extracted
    # with their exec bit intact and must stay runnable; every other regular file is
    # normalized to non-executable. Ownership was already normalized by chown -R
    # above; we never widen beyond group access (no world read/write/execute).
    # --- normalize release permissions (begin) ---
    find "${TEMP_RELEASE_ROOT}" \
        -type d \
        -exec chmod 0750 {} +

    find "${TEMP_RELEASE_ROOT}" \
        -type f \
        -perm /111 \
        -exec chmod 0750 {} +

    find "${TEMP_RELEASE_ROOT}" \
        -type f \
        ! -perm /111 \
        -exec chmod 0640 {} +
    # --- normalize release permissions (end) ---

    # Proves what this deploy script itself actually produces for the installed,
    # server-side copy of every infrastructure CLI, immediately after the
    # normalization above ran — not merely what the GitHub Actions artifact-build
    # workflows verified before upload. The two checks are independent: an
    # artifact CLI can arrive executable and still lose that bit here if this
    # normalization logic regresses on the server, or if the manifest itself goes
    # missing from a release. verify-required-clis fails closed and never
    # chmod's around a violation — a wrong mode here means the release is
    # genuinely broken, not something to paper over silently, so this fails
    # before current is ever switched. Shared with both artifact-build workflows
    # (deploy-staging.yml, release.yml) rather than reimplemented here, so the
    # one algorithm can't drift between the three call sites.
    # --- verify infrastructure CLI executable bits (begin) ---
    "${VERIFY_REQUIRED_CLIS_BIN}" --release-root "${TEMP_RELEASE_ROOT}"
    # --- verify infrastructure CLI executable bits (end) ---

    if [[ "${RUN_MIGRATIONS}" == true ]] \
        && [[ ! -f "${TEMP_RELEASE_ROOT}/artisan" ]]
    then
        fail "--migrate was requested, but artifact does not contain artisan"
    fi

    # Move to the final immutable path before generating Laravel caches.
    # Laravel configuration may contain absolute application/storage paths.
    mv \
        "${TEMP_RELEASE_ROOT}" \
        "${RELEASE_ROOT}"

    if [[ -f "${RELEASE_ROOT}/artisan" ]]; then
        log "preparing Laravel release"

        SHARED_STORAGE="${TARGET_ROOT}/shared/storage"

        install \
            -d \
            -o "${RUNTIME_USER}" \
            -g "${RUNTIME_USER}" \
            -m 2770 \
            "${SHARED_STORAGE}/framework/cache/data" \
            "${SHARED_STORAGE}/framework/sessions" \
            "${SHARED_STORAGE}/framework/views" \
            "${SHARED_STORAGE}/logs"

        chown -R \
            "${RUNTIME_USER}:${RUNTIME_USER}" \
            "${SHARED_STORAGE}/framework" \
            "${SHARED_STORAGE}/logs"

        find \
            "${SHARED_STORAGE}/framework" \
            "${SHARED_STORAGE}/logs" \
            -type d \
            -exec chmod 2770 {} +

        find \
            "${SHARED_STORAGE}/framework" \
            "${SHARED_STORAGE}/logs" \
            -type f \
            -exec chmod 0660 {} +

        install \
            -d \
            -o "${RUNTIME_USER}" \
            -g www-data \
            -m 2710 \
            "${SHARED_STORAGE}/app"

        install \
            -d \
            -o "${RUNTIME_USER}" \
            -g www-data \
            -m 2750 \
            "${SHARED_STORAGE}/app/public"

        install \
            -d \
            -o "${RUNTIME_USER}" \
            -g "${RUNTIME_USER}" \
            -m 0770 \
            "${RELEASE_ROOT}/bootstrap/cache"

        rm -f \
            "${RELEASE_ROOT}/bootstrap/cache/config.php" \
            "${RELEASE_ROOT}/bootstrap/cache/events.php" \
            "${RELEASE_ROOT}/bootstrap/cache/routes-"*.php

        if ! (
            cd "${RELEASE_ROOT}"

            runuser \
                -u "${RUNTIME_USER}" \
                -- "${PHP_BIN}" artisan config:cache

            runuser \
                -u "${RUNTIME_USER}" \
                -- "${PHP_BIN}" artisan rateguru:sharing:verify \
                    --expected-host="${PUBLIC_HOSTNAME}"

            runuser \
                -u "${RUNTIME_USER}" \
                -- "${PHP_BIN}" artisan view:cache

            if [[ "${RUN_MIGRATIONS}" == true ]]; then
                log "running database migrations"

                runuser \
                    -u "${RUNTIME_USER}" \
                    -- "${PHP_BIN}" artisan migrate --force
            fi
        ); then
            FAILURE_STATUS="failed-preparation"
            fail "Laravel release preparation failed"
        fi

        chown -R \
            "${DEPLOY_ACCOUNT}:${CODE_GROUP}" \
            "${RELEASE_ROOT}/bootstrap/cache"

        find "${RELEASE_ROOT}/bootstrap/cache" \
            -type d \
            -exec chmod 0750 {} +

        find "${RELEASE_ROOT}/bootstrap/cache" \
            -type f \
            -exec chmod 0640 {} +
    fi

    log "switching current symlink"

    ln -sfn \
        "${RELEASE_ROOT}" \
        "${CURRENT_LINK}.new"

    mv -Tf \
        "${CURRENT_LINK}.new" \
        "${CURRENT_LINK}"

    CURRENT_SWITCHED=true

    systemctl reload "${PHP_FPM_SERVICE}"

    if ! "${HEALTH_CHECK_BIN}" \
        "${HEALTH_CHECK_ARGS[@]}"
    then
        FAILURE_STATUS="failed-health-check"
        fail "deployment health check failed"
    fi

    # Slice 5.5: the queue transition — activation on a first deployment,
    # a mandatory restart signal on a normal one. Runs after the HTTP health
    # check and before the success record: both must hold before the
    # deployment may be called successful.
    perform_queue_transition

    if [[ "${ORIGINAL_CURRENT_PRESENT}" == true ]] \
        && [[ -d "${ORIGINAL_CURRENT_PATH}" ]]
    then
        ln -sfn \
            "${ORIGINAL_CURRENT_PATH}" \
            "${PREVIOUS_LINK}.new"

        mv -Tf \
            "${PREVIOUS_LINK}.new" \
            "${PREVIOUS_LINK}"
    fi

    # The queue transition already ran, immediately after the health check —
    # it is a deployment requirement, not a best-effort afterthought, so
    # there is deliberately no second, warning-only restart attempt here.

    log "${LABEL} deployed successfully: ${RELEASE_ID}"

    append_history \
        "${TARGET_ROOT}" \
        "deployment-finished" \
        "${RELEASE_ID}" \
        "success"

    TERMINAL_HISTORY_WRITTEN=true
}

# --- dispatch -----------------------------------------------------------

# require_root stays the first substantive action of a real invocation,
# unchanged from before this slice — this is the production root-only
# contract, and it is not weakened by anything above: parse_deploy_args,
# resolve_target and perform_deploy are all inert definitions until main
# calls them, in this exact order.
main() {
    require_root
    parse_deploy_args "$@"
    resolve_target
    perform_deploy
}

# A real invocation (`bash deploy ...` or `./deploy ...`) always has
# BASH_SOURCE[0] == $0, so main runs immediately here, exactly as today.
# Tests source this file instead — BASH_SOURCE[0] != $0 in that case, so main
# never auto-runs — then call parse_deploy_args/resolve_target/perform_deploy
# directly (bypassing require_root, for parsing/resolution-only coverage) or
# call main explicitly (for coverage that legitimately needs the real
# root-gated flow).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
