#!/usr/bin/env bash

set -Eeuo pipefail

URL="${RATEGURU_SOCIAL_SMOKE_URL:-}"
BASIC_AUTH="${RATEGURU_SOCIAL_SMOKE_BASIC_AUTH:-}"
USER_AGENT='facebookexternalhit/1.1 (+https://www.facebook.com/externalhit_uatext.php)'

fail() {
    printf '[ERR] %s\n' "$*" >&2
    exit 1
}

[[ -n "${URL}" ]] || fail "RATEGURU_SOCIAL_SMOKE_URL is required"

case "${URL}" in
    https://*)
        ;;
    *)
        fail "social preview URL must use HTTPS: ${URL}"
        ;;
esac

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "${TEMP_DIR}"' EXIT

HTML_FILE="${TEMP_DIR}/preview.html"
IMAGE_FILE="${TEMP_DIR}/preview-image"
CURL_OPTIONS=(
    --silent
    --show-error
    --location
    --max-time 20
    --user-agent "${USER_AGENT}"
)

if [[ -n "${BASIC_AUTH}" ]]; then
    CURL_OPTIONS+=(--user "${BASIC_AUTH}")
    printf '[WARN] Smoke test is authenticating through Basic Auth; real social crawlers remain blocked.\n'
fi

PAGE_RESULT="$(
    curl \
        "${CURL_OPTIONS[@]}" \
        --output "${HTML_FILE}" \
        --write-out $'%{http_code}\n%{content_type}' \
        "${URL}"
)"
PAGE_STATUS="$(printf '%s\n' "${PAGE_RESULT}" | sed -n '1p')"

[[ "${PAGE_STATUS}" == "200" ]] \
    || fail "social preview returned HTTP ${PAGE_STATUS:-000}: ${URL}"

CANONICAL_URL="$(
    sed -n 's/.*<link[^>]*rel="canonical"[^>]*href="\([^"]*\)".*/\1/p' "${HTML_FILE}" \
        | head -1
)"
OG_URL="$(
    sed -n 's/.*<meta[^>]*property="og:url"[^>]*content="\([^"]*\)".*/\1/p' "${HTML_FILE}" \
        | head -1
)"
OG_TITLE="$(
    sed -n 's/.*<meta[^>]*property="og:title"[^>]*content="\([^"]*\)".*/\1/p' "${HTML_FILE}" \
        | head -1
)"
OG_IMAGE="$(
    sed -n 's/.*<meta[^>]*property="og:image"[^>]*content="\([^"]*\)".*/\1/p' "${HTML_FILE}" \
        | head -1
)"

[[ -n "${CANONICAL_URL}" ]] || fail 'canonical URL is missing'
[[ -n "${OG_URL}" ]] || fail 'property="og:url" is missing'
[[ -n "${OG_TITLE}" ]] || fail 'property="og:title" is missing'
[[ -n "${OG_IMAGE}" ]] || fail 'property="og:image" is missing'
[[ "${CANONICAL_URL}" == "${OG_URL}" ]] \
    || fail "canonical URL and og:url differ: ${CANONICAL_URL} != ${OG_URL}"

for metadata_url in "${CANONICAL_URL}" "${OG_IMAGE}"; do
    case "${metadata_url}" in
        https://*)
            ;;
        *)
            fail "social metadata URL must use HTTPS: ${metadata_url}"
            ;;
    esac
done

EXPECTED_HOST="${URL#https://}"
EXPECTED_HOST="${EXPECTED_HOST%%/*}"
EXPECTED_HOST="${EXPECTED_HOST%%:*}"

for metadata_url in "${CANONICAL_URL}" "${OG_IMAGE}"; do
    metadata_host="${metadata_url#https://}"
    metadata_host="${metadata_host%%/*}"
    metadata_host="${metadata_host%%:*}"

    [[ "${metadata_host}" == "${EXPECTED_HOST}" ]] \
        || fail "social metadata host [${metadata_host}] does not match [${EXPECTED_HOST}]"
done

IMAGE_RESULT="$(
    curl \
        "${CURL_OPTIONS[@]}" \
        --output "${IMAGE_FILE}" \
        --write-out $'%{http_code}\n%{content_type}' \
        "${OG_IMAGE}"
)"
IMAGE_STATUS="$(printf '%s\n' "${IMAGE_RESULT}" | sed -n '1p')"
IMAGE_CONTENT_TYPE="$(printf '%s\n' "${IMAGE_RESULT}" | sed -n '2p' | tr '[:upper:]' '[:lower:]')"

[[ "${IMAGE_STATUS}" == "200" ]] \
    || fail "Open Graph image returned HTTP ${IMAGE_STATUS:-000}: ${OG_IMAGE}"

case "${IMAGE_CONTENT_TYPE}" in
    image/jpeg|image/png)
        ;;
    *)
        fail "Open Graph image has unsupported Content-Type [${IMAGE_CONTENT_TYPE:-missing}]"
        ;;
esac

[[ -s "${IMAGE_FILE}" ]] || fail 'Open Graph image response is empty'

printf 'Social preview smoke test passed: %s\n' "${URL}"
