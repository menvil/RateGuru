#!/usr/bin/env bash
#
# verify-required-clis — proves every infrastructure CLI named in
# infrastructure/config/required-clis.txt still has its executable bit
# inside a release tree, and that infrastructure/scripts/common remains a
# readable, non-executable sourced library.
#
# Shared by deploy itself (checking the just-normalized, not-yet-switched
# release on the server) and both artifact-build workflows (checking
# package_root before tar) — one algorithm, instead of three copies that
# could silently drift apart. Deliberately self-contained (no source of
# common): a generic filesystem check with no target-registry dependency,
# callable against any release tree by path alone.
#
# Fails closed: a missing/empty manifest, a missing or non-executable
# required CLI, or a wrongly-executable common all abort with a clear
# message and non-zero exit. Never chmod's, never modifies anything.

set -Eeuo pipefail

usage() {
    cat <<'USAGE'
Usage: verify-required-clis --release-root PATH

  --release-root PATH  Root of the release tree to verify (e.g. package_root
                        in the artifact-build workflows, or TEMP_RELEASE_ROOT
                        inside deploy). Must contain
                        infrastructure/config/required-clis.txt and
                        infrastructure/scripts/.
USAGE
}

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

log() {
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

RELEASE_ROOT=""
RELEASE_ROOT_SEEN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --release-root)
            if [[ "${RELEASE_ROOT_SEEN}" == true ]]; then
                usage >&2
                fail "--release-root given more than once"
            fi

            [[ $# -ge 2 ]] || { usage >&2; fail "--release-root requires a value"; }

            RELEASE_ROOT="$2"
            RELEASE_ROOT_SEEN=true
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            fail "unknown argument: $1"
            ;;
    esac
done

[[ "${RELEASE_ROOT_SEEN}" == true ]] || { usage >&2; fail "--release-root is required"; }
[[ -n "${RELEASE_ROOT}" ]] || { usage >&2; fail "--release-root requires a non-empty value"; }

REQUIRED_CLI_MANIFEST="${RELEASE_ROOT}/infrastructure/config/required-clis.txt"

[[ -f "${REQUIRED_CLI_MANIFEST}" ]] \
    || fail "release is missing required CLI manifest: infrastructure/config/required-clis.txt"

REQUIRED_CLI_COUNT=0

while IFS= read -r CLI_NAME; do
    [[ -n "${CLI_NAME}" ]] || continue

    REQUIRED_CLI_COUNT=$((REQUIRED_CLI_COUNT + 1))

    CLI_PATH="${RELEASE_ROOT}/infrastructure/scripts/${CLI_NAME}"

    [[ -f "${CLI_PATH}" ]] \
        || fail "release is missing required CLI: ${CLI_NAME}"

    [[ -x "${CLI_PATH}" ]] \
        || fail "required CLI lost executable mode after extraction: ${CLI_NAME}"
done < "${REQUIRED_CLI_MANIFEST}"

[[ "${REQUIRED_CLI_COUNT}" -gt 0 ]] \
    || fail "required CLI manifest is empty: infrastructure/config/required-clis.txt"

COMMON_RELEASE_PATH="${RELEASE_ROOT}/infrastructure/scripts/common"

[[ -f "${COMMON_RELEASE_PATH}" ]] \
    || fail "release is missing infrastructure/scripts/common"

[[ -r "${COMMON_RELEASE_PATH}" ]] \
    || fail "infrastructure/scripts/common is not readable"

[[ ! -x "${COMMON_RELEASE_PATH}" ]] \
    || fail "common must remain a non-executable sourced library"

log "verified: every required infrastructure CLI retains its executable mode after release normalization"
