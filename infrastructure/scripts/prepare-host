#!/usr/bin/env bash
#
# Prepare-host — Prepare Host: turn a clean supported VPS into infrastructure
# ready to host ONE RateGuru target, as a single resumable operation.
#
# Composes the already-authoritative primitives in their only valid dependency
# order:
#
#   5.2  install-bootstrap-runtime                  base packages
#   7.2  install-target-prerequisites --scope host  Nginx-referenced material
#   5.x  bootstrap-host                             the whole bootstrap pipeline
#   7.2  install-target-prerequisites --scope target  identity-scoped material
#   7.2  install-target-database                    PostgreSQL role/database
#   ->   final prepare-host verification
#
# WHY THAT ORDER, AND WHY IT IS NOT NEGOTIABLE. Each step exists at the only
# point in the sequence where it can succeed:
#
#   * The runtime slice runs first because everything after it needs tools a
#     clean Ubuntu image does not carry — `jq` above all, without which the
#     Target registry cannot be read at all. It is one of the clean-host bootstrap's own
#     authoritative installers, invoked here rather than reimplemented, and it
#     installs packages only: no RateGuru identity, no target directory, no
#     secret, nothing target-specific. bootstrap-host re-verifies this same
#     slice below and SKIPs it, which costs one verification and keeps
#     bootstrap-host the owner of the pipeline.
#
#   * Host-scope external material comes next because
#     install-bootstrap-services (5.4) FAILS CLOSED when an Nginx vhost names a
#     File that does not exist. This is the one manual step the clean-host bootstrap
#     clean-host runbook still asks an operator to perform between `--check`
#     and `--apply`; automating it is what makes preparation a single
#     operation. All of it lives under /etc and depends on no RateGuru
#     identity.
#
#   * bootstrap-host then runs its whole 5.2 -> 5.3 -> 5.4 -> preflight
#     pipeline, unchanged and undecomposed.
#
#   * Target-scope material follows, because shared/.env and the deploy user's
#     Authorized_keys live inside directories and accounts install-bootstrap-host-layout creates.
#     Installing them earlier would mean creating those directories with the
#     wrong owner and making 5.3 disagree with the host.
#
#   * The database is last: it needs PostgreSQL (5.2) AND the credentials
#     inside shared/.env, which only exist after the step before it.
#
# ORCHESTRATION ONLY. Every child stays authoritative for its own contract: no
# package list, user/group logic, filesystem ownership, service configuration,
# perimeter decision, secret-material rule or SQL statement is duplicated here,
# and bootstrap-host's own 5.2 -> 5.3 -> 5.4 -> preflight pipeline is invoked,
# never reimplemented. There is deliberately no --force, no --skip and no
# --continue-on-error: an unsafe host makes the owning child fail, and this
# orchestrator stops.
#
# WHAT PREPARE HOST IS NOT. Each of these is a different operation with a
# different blast radius, and collapsing them into one verb is how a
# "preparation" run ends up destroying a live system:
#
#   * it is not a deploy — no artifact, no release, no current symlink, no
#     migration. A prepared target legitimately has NO application release at
#     all, and that is the correct end state;
#   * it is not a restore — no database contents, no storage, no media, no
#     historical release;
#   * it is not a repair — drift in existing material or an existing database
#     Is reported and fails closed, never silently reconciled;
#   * it is not production activation — a lifecycle=planned target is rejected
#     before any target-specific mutation, and this script never edits the
#     registry;
#   * it is not configuration management for the machine — only resources this
#     repository's own contract declares are touched, and unrelated projects,
#     databases, vhosts, pools, users and directories on the same host are
#     never read, changed or removed.
#
# SAFE TO PRESS TWICE. On an already prepared — and possibly already deployed,
# already populated — host, a second run is verify/SKIP throughout: nothing is
# reinstalled blindly, no secret is rotated, no TLS key is replaced, no .env is
# overwritten, no user is recreated, no release is deleted, no migration runs
# and no backup is restored. An already deployed target stays deployed and
# healthy.
#
# Modes (all root-only — the children require root even for their read-only
# modes, and missing privileges are never silently downgraded into success):
#   --check   Strictly read-only, dependency-aware: how far is this host from
#             being prepared for this target? Runs each child's own read-only
#             mode in order; a slice whose prerequisite is unsatisfied is
#             reported BLOCKED rather than misjudged. Never invokes any child
#             --apply.
#   --apply   Convergent, not one giant transaction. Per slice: run the
#             authoritative child verification; if already satisfied, SKIP;
#             otherwise run the child's own --apply and require its
#             verification to pass before the next slice. Any child failure
#             stops the run immediately; earlier slices stay converged and
#             re-running resumes at the failing slice.
#   --verify  Read-only: every slice's own verification must pass, and the
#             target must be genuinely prepared.
#   --help    Usage.
#
# Clean-host rule: this command runs from a checked-out/extracted RateGuru
# repository (the trusted bootstrap bundle GitHub uploads), and its children are
# resolved as siblings of this script's own canonical location — never through
# /home/www/rateguru/current (a clean server has no deployment) and never
# through /home/www/rateguru/bin (which only exists after bootstrap installs
# the operational bundle).
#
# RECOVERY PREPARATION. `--apply --recovery-backup YYYYMMDD-HHMMSS` prepares
# a clean replacement host for a clean-host recovery, and the difference from
# an ordinary preparation is exactly one thing: where the external material
# comes from. Nothing is supplied by hand. The material directory the caller
# passes is a SEED holding only the recovery offsite credential
# (`rclone-config`) and the deploy public key (`deploy-authorized-keys`);
# everything else — the target's environment file and every host-scope
# prerequisite — is taken out of the named offsite backup itself, by the
# sibling fetch-recovery-material, after the runtime slice has put rclone and
# jq on the host and before the host-scope slice needs it:
#
#   runtime slice
#     -> lifecycle gate
#     -> fetch-recovery-material            the backup's bootstrap subset,
#                                           verified, laid out by logical name
#     -> host-scope prerequisites           from that material
#     -> bootstrap-host
#     -> offsite-write hold                 before the offsite credential lands
#     -> target-scope prerequisites         laravel-env from the backup, the
#                                           two seed files
#     -> target database
#     -> final verification
#
# The pipeline underneath is the ordinary one, slice for slice, with the same
# children, the same convergence rule and the same verifications. Recovery
# mode only decides what the material directory contains and where in the
# order it has to exist. The effective material lives in a root-only
# directory that is removed when this run ends, on success and on failure.
#
# THE OFFSITE-WRITE HOLD. A host prepared for a recovery ends up a complete
# RateGuru host with a backup cron, an offsite uploader and an offsite pruner,
# while DEPLOY_HOST and DNS still point at the machine that owns the real
# offsite namespace. So recovery preparation places the host-global
# offsite-write hold as soon as the run root exists and BEFORE the offsite
# credential is installed; backup-cycle, offsite-backup and offsite-retention
# refuse on this host while it exists, the recovery proves it at every hold
# check, and nothing here or in the recovery ever removes it. An ordinary
# preparation never places it.
#
# Signals: SIGINT is never trapped or reinterpreted — interrupting a long child
# verification terminates the orchestration without continuing downstream
# slices, and the child's signal-derived exit status is propagated.
#
# Test overrides: every RATEGURU_PREPAREHOST_* override below is honored only
# alongside RATEGURU_ALLOW_TEST_OVERRIDES=true — the identical gate every other
# bootstrap script uses — so a stray variable in a real root shell can never
# redirect this orchestrator at attacker- or operator-controlled children.

set -Eeuo pipefail

# --- Locations ----------------------------------------------------------------

# The script FILE is canonicalized before its directory, and that ordering is
# security-relevant — see the identical, fully-commented resolution in
# infrastructure/scripts/bootstrap-host. Canonicalizing the file first pins
# SCRIPT_DIR to the directory holding the REAL script, so sibling resolution
# can never be redirected by how the command was invoked.
if ! SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)" \
    || [[ -z "${SCRIPT_PATH}" ]]
then
    printf 'ERROR: cannot canonicalize the prepare-host script path: %s\n' "${BASH_SOURCE[0]}" >&2
    exit 1
fi

if ! SCRIPT_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" >/dev/null 2>&1 && pwd -P)" \
    || [[ -z "${SCRIPT_DIR}" ]]
then
    printf 'ERROR: cannot resolve the prepare-host script directory: %s\n' "${SCRIPT_PATH}" >&2
    exit 1
fi

if [[ "${SCRIPT_DIR}" != */infrastructure/scripts ]]; then
    printf 'ERROR: prepare-host must run from the repository checkout (…/infrastructure/scripts); resolved location: %s\n' "${SCRIPT_DIR}" >&2
    exit 1
fi

# --- Test override gate -------------------------------------------------------

rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

gated_default() {
    local var_name="$1" default_value="$2"

    if rateguru_test_overrides_allowed && [[ -n "${!var_name:-}" ]]; then
        printf '%s\n' "${!var_name}"
    else
        printf '%s\n' "${default_value}"
    fi
}

EFFECTIVE_UID="$(gated_default RATEGURU_PREPAREHOST_EUID "${EUID}")"

# The authoritative children, in the only valid dependency order.
RUNTIME_INSTALLER_BIN="$(gated_default RATEGURU_PREPAREHOST_RUNTIME_INSTALLER_BIN "${SCRIPT_DIR}/install-bootstrap-runtime")"
PREREQUISITES_INSTALLER_BIN="$(gated_default RATEGURU_PREPAREHOST_PREREQUISITES_INSTALLER_BIN "${SCRIPT_DIR}/install-target-prerequisites")"
BOOTSTRAP_HOST_BIN="$(gated_default RATEGURU_PREPAREHOST_BOOTSTRAP_HOST_BIN "${SCRIPT_DIR}/bootstrap-host")"
DATABASE_INSTALLER_BIN="$(gated_default RATEGURU_PREPAREHOST_DATABASE_INSTALLER_BIN "${SCRIPT_DIR}/install-target-database")"
TARGETS_CLI_BIN="$(gated_default RATEGURU_PREPAREHOST_TARGETS_CLI_BIN "${SCRIPT_DIR}/targets")"

# The recovery-material helper, used by --recovery-backup only: it turns the
# seed directory and one exact offsite backup into the effective material
# directory the prerequisite slices are then fed.
RECOVERY_MATERIAL_BIN="$(gated_default RATEGURU_PREPAREHOST_RECOVERY_MATERIAL_BIN "${SCRIPT_DIR}/fetch-recovery-material")"

# Where the effective recovery material is staged: root's own home, 0700,
# never /tmp — a directory the runtime user can never see into.
RECOVERY_MATERIAL_PARENT="$(gated_default RATEGURU_PREPAREHOST_RECOVERY_MATERIAL_PARENT /root)"

# The SOURCE registry in this checkout, never the installed runtime copy: on a
# clean host nothing is installed yet, and the trusted bootstrap bundle is the
# authority. Same source/runtime split bootstrap-host-preflight applies.
SOURCE_REGISTRY="$(gated_default RATEGURU_PREPAREHOST_SOURCE_REGISTRY "$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)/infrastructure/config/deployment-targets.json")"

# Where the data-operation guards live. Read only to REFUSE — see the interlock
# below. Deliberately the same root every operational script resolves, named
# here as a constant because this script cannot source `infrastructure/scripts/
# common`: it runs on hosts where nothing is installed yet, which is the whole
# point of it.
OPERATIONAL_RUN_ROOT="$(gated_default RATEGURU_PREPAREHOST_RUN_ROOT /home/www/rateguru/run)"

# --- Output -------------------------------------------------------------------

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

MODE=""
MODE_SEEN=false
TARGET_ID=""
TARGET_SEEN=false
MATERIAL_DIR=""
MATERIAL_DIR_SEEN=false
RECOVERY_BACKUP=""
RECOVERY_BACKUP_SEEN=false

usage() {
    cat <<'USAGE'
Usage:
  prepare-host --check  --target TARGET_ID [--material-dir DIR]
  prepare-host --apply  --target TARGET_ID [--material-dir DIR]
  prepare-host --apply  --target TARGET_ID --material-dir SEED_DIR --recovery-backup YYYYMMDD-HHMMSS
  prepare-host --verify --target TARGET_ID
  prepare-host --verify --target TARGET_ID --recovery-backup YYYYMMDD-HHMMSS
  prepare-host --help

All modes require root and a lifecycle=active target.

  --target           Deployment target ID from the RateGuru target registry.
  --material-dir     Root-owned 0700 directory of operator-supplied external
                     material, consumed by install-target-prerequisites. Only
                     ever used to fill in what is ABSENT; existing material is
                     never overwritten or rotated.
  --recovery-backup  Recovery preparation. With --apply: take the target's
                     environment file and every host-scope prerequisite out of
                     this exact offsite backup (schema 3 required), through
                     fetch-recovery-material, instead of from supplied
                     material. --material-dir then names the SEED directory,
                     holding exactly rclone-config and deploy-authorized-keys.
                     Places the host-global offsite-write hold before the
                     offsite credential is installed, and refuses to report the
                     host prepared unless that hold is still in place at the
                     end. With --verify: verify a recovery preparation AS one —
                     the read-only walk, plus the requirement that the
                     offsite-write hold exists and names this target and this
                     backup. Never with --check.

  --check   Read-only, dependency-aware preparation status per slice
            (prerequisites -> host bootstrap -> database -> final), reporting
            PASS / NEEDS_APPLY / BLOCKED. Exit 0 only when the target is
            already fully prepared.
  --apply   Convergent preparation: per slice, skip when its authoritative
            verification already passes, otherwise run the child's own --apply
            and require its verification. Fails fast and never rolls back
            safely converged earlier slices — re-run to resume.
  --verify  Read-only: every slice must verify, and the target must be
            prepared.

Orchestration only. Never deploys an application, never runs a migration,
never restores a backup, never creates or rotates a secret, never drops or
recreates a database, and never provisions a lifecycle=planned target.

--apply is also refused while a live restore or a host recovery owns the
target: this orchestrator's children reconverge the target's Supervisor program
and its scheduler cron entry, and both of those operations hold exactly those
two aside on purpose. --check and --verify report the hold and continue.
USAGE
}

# --- Slice table --------------------------------------------------------------

SLICE_IDS=(runtime host-prerequisites bootstrap target-prerequisites database)

# The runtime slice is the only host-global, target-agnostic one, and the only
# one allowed to run before the target lifecycle gate — see
# gate_lifecycle_before().
TARGET_AGNOSTIC_SLICE=runtime

slice_label() {
    case "$1" in
        runtime)              printf 'base runtime packages\n' ;;
        host-prerequisites)   printf 'Nginx-referenced external material (required before 5.4)\n' ;;
        bootstrap)            printf 'host bootstrap (5.2 runtime -> 5.3 identities -> 5.4 services -> preflight)\n' ;;
        target-prerequisites) printf 'identity-scoped external material (.env, deploy key, rclone)\n' ;;
        database)             printf 'target PostgreSQL role and database\n' ;;
        *)                    fail "internal: unknown slice: $1" ;;
    esac
}

slice_bin() {
    case "$1" in
        runtime)              printf '%s\n' "${RUNTIME_INSTALLER_BIN}" ;;
        host-prerequisites)   printf '%s\n' "${PREREQUISITES_INSTALLER_BIN}" ;;
        bootstrap)            printf '%s\n' "${BOOTSTRAP_HOST_BIN}" ;;
        target-prerequisites) printf '%s\n' "${PREREQUISITES_INSTALLER_BIN}" ;;
        database)             printf '%s\n' "${DATABASE_INSTALLER_BIN}" ;;
        *)                    fail "internal: unknown slice: $1" ;;
    esac
}

# slice_preapply_mode SLICE_ID — which read-only child mode decides whether a
# slice may be SKIPPED during --apply.
#
# For every slice but the two prerequisite ones this is `verify`: the question
# is simply "does the host already satisfy this contract?".
#
# The prerequisite slices are different, and getting this wrong would defeat one
# of the operation's load-bearing safety rules. Their `--verify` is deliberately
# material-blind — a prepared host is judged by what is installed on it, not by
# what was uploaded beside the run — so on a re-run where the operator supplied
# material that DIFFERS from what the host holds, `--verify` would pass, the
# slice would be skipped, and the conflict this whole design exists to surface
# would never be reported. `--check` is the material-aware read-only mode, and
# it is the correct gate whenever material was supplied: it returns 0 only when
# there is nothing to install AND nothing in conflict.
slice_preapply_mode() {
    local slice_id="$1"

    case "${slice_id}" in
        host-prerequisites|target-prerequisites)
            if [[ -n "${MATERIAL_DIR}" ]]; then
                printf 'check\n'

                return 0
            fi
            ;;
    esac

    printf 'verify\n'
}

# slice_args SLICE_ID MODE — the child's own argv for one mode.
#
# bootstrap-host is host-global and takes no --target: a host is bootstrapped
# once and can then carry several targets. Passing one would be a lie about
# what that pipeline does. The two target-aware children take --target, and
# only the prerequisite installer is ever handed the material directory.
slice_args() {
    local slice_id="$1" mode="$2" scope=""

    case "${slice_id}" in
        runtime|bootstrap)
            printf '%s\n' "--${mode}"
            ;;
        host-prerequisites|target-prerequisites)
            scope="${slice_id%-prerequisites}"

            printf '%s\n' "--${mode}" --target "${TARGET_ID}" --scope "${scope}"

            # --verify deliberately never sees the material directory: a
            # prepared host is judged by what is actually installed on it, not
            # by what happened to be uploaded alongside this run.
            if [[ -n "${MATERIAL_DIR}" ]] && [[ "${mode}" != verify ]]; then
                printf '%s\n' --material-dir "${MATERIAL_DIR}"
            fi
            ;;
        database)
            printf '%s\n' "--${mode}" --target "${TARGET_ID}"
            ;;
        *)
            fail "internal: unknown slice: ${slice_id}"
            ;;
    esac
}

# Long-child visibility (usability only — no invented progress): the host
# bootstrap slice runs three installers and a full preflight underneath.
slice_duration_note() {
    case "$1" in
        runtime)   printf ' (installs base packages on a clean host — this may take a while)' ;;
        bootstrap) printf ' (runs the whole 5.2/5.3/5.4 pipeline and its preflight — this takes a while)' ;;
        *)         printf '' ;;
    esac
}

declare -A SLICE_STATUS
FINAL_STATUS=""

require_root() {
    [[ "${EFFECTIVE_UID}" == "0" ]] || fail "--${MODE} must run as root"
}

require_children_executable() {
    local slice_id bin

    for slice_id in "${SLICE_IDS[@]}"; do
        bin="$(slice_bin "${slice_id}")"
        [[ -x "${bin}" ]] || fail "slice ${slice_id} child is not executable: ${bin} — run from a full repository checkout"
    done

    [[ -x "${RUNTIME_INSTALLER_BIN}" ]] || fail "runtime installer is not executable: ${RUNTIME_INSTALLER_BIN} — run from a full repository checkout"

    [[ -x "${TARGETS_CLI_BIN}" ]] || fail "targets CLI is not executable: ${TARGETS_CLI_BIN} — run from a full repository checkout"

    if recovery_mode && [[ "${MODE}" == apply ]]; then
        [[ -x "${RECOVERY_MATERIAL_BIN}" ]] || fail "recovery-material helper is not executable: ${RECOVERY_MATERIAL_BIN} — run from a full repository checkout"
    fi
}

# --- Target lifecycle gate ----------------------------------------------------
#
# The single most important gate in this script.
#
# `targets` is the standalone registry CLI: it validates the whole registry and
# reads a target without needing an installed deployment.conf, which is exactly
# right on a clean VPS where nothing is installed yet. It is pointed at the
# SOURCE registry in this checkout — the trusted bootstrap bundle — never at a
# runtime copy that may not exist. Every target-aware child re-enforces
# lifecycle independently; this gate exists so an unknown or planned target is
# refused BEFORE any target-specific mutation rather than after one.
#
# That ordering is what stops host-global bootstrap from becoming a loophole
# for silently provisioning a planned production target: `prepare-host --apply
# --target tits-guru` refuses while tits-guru remains lifecycle=planned, and
# refuses before a single RateGuru identity, directory, secret or database
# exists for it.
#
# One wrinkle, handled explicitly rather than papered over: reading a JSON
# registry needs `jq`, and a clean Ubuntu image has none — it arrives with the
# runtime slice, which is why that slice is the one and only step allowed to
# run before this gate. It installs packages from a committed list and nothing
# target-specific, so nothing is provisioned for a target that has not been
# gated. On every host that already has jq — which is every host that has ever
# been prepared — the gate runs first, before anything at all.

LIFECYCLE_VALIDATED=false

registry_readable() {
    command -v jq >/dev/null 2>&1 \
        && [[ -x "${TARGETS_CLI_BIN}" ]] \
        && [[ -f "${SOURCE_REGISTRY}" ]] \
        && "${TARGETS_CLI_BIN}" validate --file "${SOURCE_REGISTRY}" >/dev/null 2>&1
}

validate_target_id() {
    [[ "${TARGET_ID}" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]] \
        || fail "invalid target ID: ${TARGET_ID}"
}

validate_target_lifecycle() {
    validate_target_id

    local target_json lifecycle status=0

    target_json="$("${TARGETS_CLI_BIN}" show --target "${TARGET_ID}" --file "${SOURCE_REGISTRY}" 2>&1)" || status=$?

    if (( status != 0 )); then
        printf '%s\n' "${target_json}" >&2
        fail "unknown or unusable target: ${TARGET_ID}"
    fi

    lifecycle="$(printf '%s' "${target_json}" | jq -r '.lifecycle // empty')"

    if [[ "${lifecycle}" != "active" ]]; then
        fail "target ${TARGET_ID} has lifecycle=${lifecycle:-unknown}, not active — preparation is refused before any target-specific mutation. Activating a target is a deliberate registry change in its own phase, never a side effect of preparing a host."
    fi

    LIFECYCLE_VALIDATED=true
    printf 'Target %s: lifecycle=active — preparation may proceed\n' "${TARGET_ID}"
}

# gate_lifecycle_now_if_possible — run the gate up front on any host whose
# registry can already be read. On a genuinely bare host it silently defers to
# gate_lifecycle_before, which still runs it before the first target-specific
# slice; the read-only modes simply report the runtime slice as unsatisfied and
# everything downstream as BLOCKED, which is the truthful answer.
gate_lifecycle_now_if_possible() {
    if registry_readable; then
        validate_target_lifecycle
        return 0
    fi

    printf 'Target %s: lifecycle not yet readable (the registry needs jq, installed by the runtime slice); the gate runs before the first target-specific slice\n' "${TARGET_ID}"
}

# gate_lifecycle_before SLICE_ID — enforced immediately before every slice
# except the target-agnostic runtime one, and idempotent, so the gate is
# guaranteed to have run before anything target-specific no matter which path
# got us here.
gate_lifecycle_before() {
    local slice_id="$1"

    [[ "${LIFECYCLE_VALIDATED}" != true ]] || return 0
    [[ "${slice_id}" != "${TARGET_AGNOSTIC_SLICE}" ]] || return 0

    validate_target_lifecycle
}

# --- Data-operation interlock -------------------------------------------------
#
# A live restore or a host recovery owns a target's DATA while its guard
# exists, and preparation is not a data decision. The hazard is concrete rather
# than theoretical: this orchestrator's children reconverge the target's
# Supervisor program and its scheduler cron entry, and both operations hold
# exactly those two aside on purpose. A `--apply` in that window could put the
# scheduler back and start a worker against data whose code has not arrived,
# and install-target-operations could replace the operational scripts a running
# operation is executing.
#
# Read-only modes are allowed through and report it loudly: an operator looking
# at a held target needs the diagnosis, and reading a marker changes nothing.
# --apply refuses.
#
# The guard is only half of it. It is a long-lived interlock, not a mutual
# exclusion primitive: an operation writes it early and holds it until it is
# finished, but two processes can still both read "no guard" at the same
# instant. gate_data_operation_locks above is the other half — it takes the
# same per-namespace flock those operations hold for their whole run, so
# "started but not yet guarded" is a state this orchestrator cannot walk into.
#
# Deliberately existence-based rather than a second parser for the guard
# documents. `common` owns that parsing, this script cannot source it, and a
# copy of it here is exactly the duplication that drifts. Any guard at all
# means somebody else's operation owns this target, and that is the whole
# decision. The operation ID is reported when `jq` happens to be available —
# which it always is on a host that has ever been prepared, and never matters
# on one that has not, because a bare host carries no guards.

guard_marker_paths() {
    printf '%s\n' \
        "${OPERATIONAL_RUN_ROOT}/restores/${TARGET_ID}/restore-guard" \
        "${OPERATIONAL_RUN_ROOT}/recoveries/${TARGET_ID}/recovery-guard"
}

guard_operation_label() {
    local marker="$1"

    command -v jq >/dev/null 2>&1 || { printf 'unknown'; return 0; }

    jq -r '"operation " + (.operation // "unknown") + ", status " + (.status // "unknown")' \
        "${marker}" 2>/dev/null || printf 'unknown'
}

# gate_data_operation_locks — the SERIALISATION half, and the reason the marker
# check below is not enough on its own.
#
# A guard is a long-lived interlock: it says "this target is owned" for as long
# as an operation owns it. It is not a mutual exclusion primitive — two
# processes can both read "no guard" and both proceed. The operations
# themselves hold a per-namespace flock for their WHOLE run, from before the
# first byte they download, so locks are what make "started but not yet
# guarded" a state this orchestrator cannot walk into.
#
# ONE OWNER PER LOCK, and this is the part that is easy to get wrong. This
# orchestrator RUNS install-target-operations, which takes the two data-
# operation locks itself — so holding those here would deadlock a Prepare
# against its own grandchild the moment the operational bundle actually needs
# updating, which is exactly the repeatable case Prepare exists for. flock
# treats independently opened descriptors independently even inside one process
# tree, so an inherited lock does not satisfy a fresh acquisition.
#
# So preparation owns a lock of its own and only CHECKS theirs:
#
#   prepare-host-<namespace>.lock    HELD here for the whole run; nothing
#                                    beneath this orchestrator ever takes it
#   restore-target-<namespace>.lock  CHECKED and released — a running operation
#   recover-host-<namespace>.lock    holds one, so a busy lock refuses us
#
# The other side of the pair lives in restore-common's
# assert_no_host_preparation_running, which restore-target and recover-host
# call after taking their own lock. Whichever operation starts first holds its
# own lock before it checks the other's, so the second always sees a held lock
# and refuses.
#
# Only in --apply, and only when the run root already exists: a host with no run
# root has never run an operational script, so nothing can be in flight, and
# this orchestrator creates no directories to lock inside — that is the layout
# installer's job.
PREPARATION_LOCK_FD=""

gate_data_operation_locks() {
    [[ "${MODE}" == apply ]] || return 0
    [[ -d "${OPERATIONAL_RUN_ROOT}" ]] || return 0

    command -v jq >/dev/null 2>&1 || return 0

    local target_json namespace
    target_json="$("${TARGETS_CLI_BIN}" show --target "${TARGET_ID}" --file "${SOURCE_REGISTRY}" 2>/dev/null)" || return 0
    namespace="$(printf '%s' "${target_json}" | jq -r '.backup.namespace // empty')"

    [[ -n "${namespace}" ]] || return 0

    # Ours first, and held: from here on, a restore or a recovery that starts
    # will find it busy and refuse.
    local preparation_lock="${OPERATIONAL_RUN_ROOT}/prepare-host-${namespace}.lock"

    exec {PREPARATION_LOCK_FD}>>"${preparation_lock}" \
        || fail "could not open ${preparation_lock} to claim host preparation for backup namespace ${namespace}"

    flock -n "${PREPARATION_LOCK_FD}" \
        || fail "another host preparation is already running for backup namespace ${namespace} (${preparation_lock}); nothing was changed"

    # Theirs second, and released immediately: holding them would deadlock
    # install-target-operations, which takes the same two under this run.
    local prefix lock_file lock_fd label

    for prefix in restore-target recover-host; do
        lock_file="${OPERATIONAL_RUN_ROOT}/${prefix}-${namespace}.lock"

        # A lock file that does not exist means that operation has never run on
        # this host. Creating one would be this orchestrator writing into a
        # directory it does not own, so absence is read as "nothing to wait
        # for" rather than conjured into a lock.
        [[ -e "${lock_file}" ]] || continue

        exec {lock_fd}>>"${lock_file}" \
            || fail "could not open ${lock_file} to check whether an operation is running for backup namespace ${namespace}"

        if ! flock -n "${lock_fd}"; then
            case "${prefix}" in
                restore-target) label='A restore' ;;
                *)              label='A host recovery' ;;
            esac

            fail "${label} is running for backup namespace ${namespace} — preparation is refused while it holds ${lock_file}. This orchestrator'"'"'s children reconverge the target'"'"'s Supervisor program and its scheduler cron entry, and that operation is holding exactly those aside; nothing was changed."
        fi

        exec {lock_fd}>&-
    done
}

# gate_no_data_operation_hold — collects every guard present, then decides.
gate_no_data_operation_hold() {
    validate_target_id

    local marker
    local -a held=()

    while IFS= read -r marker; do
        [[ -e "${marker}" ]] || continue
        held+=("${marker}")
    done < <(guard_marker_paths)

    if (( ${#held[@]} == 0 )); then
        return 0
    fi

    printf '\n'

    if (( ${#held[@]} > 1 )); then
        printf 'DATA OPERATION HOLD: %s carries BOTH a restore guard and a recovery guard.\n' "${TARGET_ID}"
        printf 'A live restore requires a deployed target and a host recovery requires an empty\n'
        printf 'one, so the two can never legitimately hold the same target at once.\n'
    else
        printf 'DATA OPERATION HOLD: %s is owned by another operation right now.\n' "${TARGET_ID}"
    fi

    for marker in "${held[@]}"; do
        printf '  %s (%s)\n' "${marker}" "$(guard_operation_label "${marker}")"
    done

    printf '\n'

    if [[ "${MODE}" != apply ]]; then
        printf 'This is a read-only run, so it continues — but nothing may be APPLIED to this\n'
        printf 'target until that operation is finished or resolved.\n\n'

        return 0
    fi

    fail "preparation is refused while a data operation owns ${TARGET_ID}: this orchestrator's children reconverge the target's Supervisor program and its scheduler cron entry, and both are held aside on purpose. Finish or resolve the operation named above first — nothing was changed."
}

# --- Child invocation ---------------------------------------------------------

CHILD_OUTPUT=""
CHILD_STATUS=0

run_child_captured() {
    CHILD_OUTPUT=""
    CHILD_STATUS=0
    CHILD_OUTPUT="$("$@" 2>&1)" || CHILD_STATUS=$?
}

# print_child_excerpt — the child's own SUMMARY section when it has one,
# indented; a child that failed before printing any SUMMARY has its complete
# output shown instead, so the failing slice is never hidden.
print_child_excerpt() {
    if grep -q '^SUMMARY$' <<<"${CHILD_OUTPUT}"; then
        awk '/^SUMMARY$/ { buffer = ""; collecting = 1 }
             collecting { buffer = buffer "    " $0 "\n" }
             END { printf "%s", buffer }' <<<"${CHILD_OUTPUT}"
    else
        awk '{ print "    | " $0 }' <<<"${CHILD_OUTPUT}"
    fi
}

child_failed() {
    local description="$1"
    shift

    printf 'ERROR: %s failed: %s (exit status %d)\n' "${description}" "$*" "${CHILD_STATUS}" >&2
    exit "${CHILD_STATUS}"
}

# --- Summary ------------------------------------------------------------------

print_summary() {
    local ready_label="$1" slice_id
    local ready=true

    printf '\nSUMMARY\n'

    for slice_id in "${SLICE_IDS[@]}"; do
        printf '%s %s\n' "${slice_id}" "${SLICE_STATUS[${slice_id}]}"
        [[ "${SLICE_STATUS[${slice_id}]}" == PASS* ]] || ready=false
    done

    printf 'FINAL %s\n' "${FINAL_STATUS}"
    [[ "${FINAL_STATUS}" == PASS* ]] || ready=false

    printf '\n'

    if [[ "${ready}" == true ]]; then
        printf '%s: YES\n' "${ready_label}"
        printf 'APPLICATION DEPLOYED: NOT REQUIRED — a prepared target legitimately has no release yet\n'
        print_offsite_write_hold_status
        return 0
    fi

    printf '%s: NO\n' "${ready_label}"
    print_offsite_write_hold_status
    return 1
}

# print_offsite_write_hold_status — reported whenever the hold exists, in
# every mode, so a host prepared for a recovery says so in the same summary
# block the GitHub run shows. An ordinary host has no hold and prints nothing.
print_offsite_write_hold_status() {
    local marker
    marker="$(offsite_write_hold_path)"

    if [[ -e "${marker}" ]] || [[ -L "${marker}" ]]; then
        printf 'OFFSITE WRITES: HELD — %s (backup-cycle, offsite-backup and offsite-retention refuse on this host until it is deliberately adopted)\n' "${marker}"
    fi
}

# assert_recovery_preparation_held — the offsite-write hold exists and is a
# genuine hold document this script can read. Required at the end of a
# recovery --apply and by --verify --recovery-backup: a replacement machine
# whose offsite writers are not fenced could upload into, or prune, the
# namespace the target's live host owns, and no verification may call such a
# machine prepared. The hold is host-global: one placed by an earlier
# preparation or recovery of this machine fences it just the same and is kept,
# never rewritten, so its own identity is reported rather than enforced.
# Nothing re-holds it automatically — a missing hold means the preparation
# must be applied again.
assert_recovery_preparation_held() {
    local marker
    marker="$(offsite_write_hold_path)"

    [[ -e "${marker}" ]] || [[ -L "${marker}" ]] \
        || fail "recovery preparation of ${TARGET_ID} from backup ${RECOVERY_BACKUP} is NOT complete: the offsite-write hold ${marker} is missing — a replacement machine whose offsite writers are not held could upload into, or prune, the namespace the target's live host owns. Nothing re-holds it automatically; apply the recovery preparation again"

    [[ ! -L "${marker}" ]] && [[ -f "${marker}" ]] \
        || fail "recovery preparation of ${TARGET_ID} from backup ${RECOVERY_BACKUP} is NOT complete: the offsite-write hold ${marker} is not a regular file — refusing to reason about a hold this verification cannot read"

    local hold placed_by
    hold="$(jq -r '.hold // empty' "${marker}" 2>/dev/null || true)"
    placed_by="$(jq -r '"\(.created_by // "unknown") for \(.target // "unknown") from backup \(.backup // "unknown")"' "${marker}" 2>/dev/null || printf 'unknown')"

    [[ "${hold}" == "offsite-writes" ]] \
        || fail "recovery preparation of ${TARGET_ID} from backup ${RECOVERY_BACKUP} is NOT complete: ${marker} is not an offsite-write hold document — refusing to treat an unreadable marker as a fence"

    printf 'RECOVERY PREPARATION: HELD — offsite writes held on this host for %s from backup %s (%s; placed by %s)\n' "${TARGET_ID}" "${RECOVERY_BACKUP}" "${marker}" "${placed_by}"
}

# --- Read-only walkers (--check / --verify) -----------------------------------

# run_readonly_walk CHILD_MODE UNSATISFIED_STATUS — the shared dependency-aware,
# strictly read-only pipeline walk. The first unsatisfied slice gets
# UNSATISFIED_STATUS plus its concise child summary, and every downstream slice
# is BLOCKED rather than misjudged on a host its prerequisite has not prepared:
# a database installer cannot meaningfully judge a host with no PostgreSQL on
# it yet. No path in here executes any child --apply.
run_readonly_walk() {
    local child_mode="$1" unsatisfied_status="$2"
    local blocked=false previous_slice="" slice_id label bin
    local -a child_args

    for slice_id in "${SLICE_IDS[@]}"; do
        label="$(slice_label "${slice_id}")"
        bin="$(slice_bin "${slice_id}")"

        printf '\nSLICE %s — %s\n' "${slice_id}" "${label}"

        if [[ "${blocked}" == true ]]; then
            SLICE_STATUS[${slice_id}]=BLOCKED
            printf '  BLOCKED until slice %s is satisfied\n' "${previous_slice}"
            previous_slice="${slice_id}"
            continue
        fi

        previous_slice="${slice_id}"

        # Reached only when every prerequisite slice is satisfied, so on a host
        # whose registry was unreadable up front this is the first point at
        # which the gate both can and must run.
        gate_lifecycle_before "${slice_id}"

        printf '  %s %s%s...\n' "${child_mode^^}" "${label}" "$(slice_duration_note "${slice_id}")"

        mapfile -t child_args < <(slice_args "${slice_id}" "${child_mode}")
        run_child_captured "${bin}" "${child_args[@]}"

        if (( CHILD_STATUS == 0 )); then
            SLICE_STATUS[${slice_id}]=PASS
            printf '  PASS — slice contract satisfied (%s %s)\n' "${bin}" "${child_args[*]}"
            continue
        fi

        # Exit status 1 is the children's one and only "contract not satisfied"
        # verdict. Anything else (127, a signal-derived 130, ...) is abnormal
        # termination — surfaced and propagated verbatim, never reinterpreted.
        if (( CHILD_STATUS != 1 )); then
            print_child_excerpt
            child_failed "slice ${slice_id} ${child_mode}" "${bin}" "${child_args[@]}"
        fi

        SLICE_STATUS[${slice_id}]="${unsatisfied_status}"
        blocked=true
        printf '  %s — slice contract not satisfied (%s %s, exit status %d)\n' \
            "${unsatisfied_status}" "${bin}" "${child_args[*]}" "${CHILD_STATUS}"
        print_child_excerpt
        printf '  run for the full report: %s %s\n' "${bin}" "${child_args[*]}"
    done

    printf '\nFINAL PREPARATION STATE\n'

    if [[ "${blocked}" == true ]]; then
        FINAL_STATUS=BLOCKED
        printf '  BLOCKED until slice %s is satisfied\n' "${previous_slice}"
        return 0
    fi

    FINAL_STATUS='PASS — target prepared'
    printf '  PASS — %s is prepared: host bootstrap satisfied, external prerequisites present, database role/database ready and reachable with the target'"'"'s own credentials\n' "${TARGET_ID}"
}

run_check() {
    printf 'RateGuru prepare host (check mode, read-only)\n'
    printf 'Target: %s\n' "${TARGET_ID}"
    printf 'Pipeline: external prerequisites -> host bootstrap -> target database -> final\n'

    gate_lifecycle_now_if_possible
    gate_data_operation_locks
    gate_no_data_operation_hold
    run_readonly_walk check NEEDS_APPLY

    print_summary 'TARGET PREPARED' || exit 1
}

run_verify() {
    printf 'RateGuru prepare host (verify mode, read-only)\n'
    printf 'Target: %s\n' "${TARGET_ID}"

    if recovery_mode; then
        printf 'Recovery preparation from offsite backup %s: the offsite-write hold is required\n' "${RECOVERY_BACKUP}"
    fi

    gate_lifecycle_now_if_possible
    gate_data_operation_locks
    gate_no_data_operation_hold
    run_readonly_walk verify FAIL

    # A recovery preparation is verified AS one: every slice satisfied is not
    # enough on a replacement machine whose offsite writers are not fenced.
    if recovery_mode; then
        assert_recovery_preparation_held
    fi

    print_summary 'TARGET PREPARED' || exit 1
}

# --- Apply --------------------------------------------------------------------

run_apply() {
    printf 'RateGuru prepare host (apply)\n'
    printf 'Target: %s\n' "${TARGET_ID}"
    printf 'Convergent, fail-fast; safely converged earlier slices are never rolled back — re-run to resume\n'

    # Before ANY mutation whenever the registry can already be read, and in
    # every case before the first target-specific slice.
    gate_lifecycle_now_if_possible

    # And before any of it, the interlock, in both halves: the locks those
    # operations hold for their whole run, and the guards they leave behind.
    # The locks close the window before a guard exists; the guards close the
    # window after a process has exited.
    gate_data_operation_locks
    gate_no_data_operation_hold

    if recovery_mode; then
        printf 'Recovery preparation: the environment file and every host-scope prerequisite come from offsite backup %s, not from supplied material\n' "${RECOVERY_BACKUP}"
        run_recovery_slices

        # Placed between the host and target slices above; proven again here,
        # after every child has run, so this run can never report a
        # replacement machine prepared with its offsite writers unfenced.
        assert_recovery_preparation_held
    else
        local slice_id
        for slice_id in "${SLICE_IDS[@]}"; do
            converge_slice "${slice_id}"
        done
    fi

    printf '\nFINAL PREPARATION STATE\n'
    FINAL_STATUS='PASS — target prepared'
    printf '  PASS — %s is prepared\n' "${TARGET_ID}"

    print_summary 'TARGET PREPARED' || exit 1
}

# converge_slice SLICE_ID — one slice of the convergent pipeline: the child's
# own read-only verdict, SKIP when satisfied, otherwise the child's own --apply
# followed by its authoritative --verify. Identical in both preparation modes.
converge_slice() {
    local slice_id="$1"
    local label bin apply_status precheck_mode
    local -a precheck_args apply_args verify_args

    label="$(slice_label "${slice_id}")"
    bin="$(slice_bin "${slice_id}")"

    # Idempotent, and unconditional for every target-specific slice: no
    # RateGuru identity, directory, secret or database can come into
    # existence for a target that has not passed the lifecycle gate.
    gate_lifecycle_before "${slice_id}"

    precheck_mode="$(slice_preapply_mode "${slice_id}")"

    mapfile -t precheck_args < <(slice_args "${slice_id}" "${precheck_mode}")
    mapfile -t apply_args < <(slice_args "${slice_id}" apply)

    printf '\nSLICE %s — %s\n' "${slice_id}" "${label}"
    printf '  %s %s%s...\n' "${precheck_mode^^}" "${label}" "$(slice_duration_note "${slice_id}")"

    run_child_captured "${bin}" "${precheck_args[@]}"

    # The convergence rule, and the reason a second prepare run is cheap
    # and safe: an already-satisfied slice is SKIPPED outright. Nothing is
    # reinstalled to "make sure", because "making sure" is what overwrites
    # a live .env and rotates a working credential.
    if (( CHILD_STATUS == 0 )); then
        SLICE_STATUS[${slice_id}]='PASS (already satisfied — skipped)'
        printf '  SKIP — already satisfied (%s %s passed); no child apply\n' "${bin}" "${precheck_args[*]}"
        return 0
    fi

    # Only the children's explicit "contract not satisfied" verdict (exit 1)
    # triggers convergence. Abnormal termination — including a
    # signal-derived status like 130 from an interrupted verification — is
    # propagated verbatim and never escalated into a child apply.
    if (( CHILD_STATUS != 1 )); then
        print_child_excerpt
        child_failed "slice ${slice_id} pre-apply verification" "${bin}" "${precheck_args[@]}"
    fi

    printf '  APPLY required (%s %s exit status %d)\n' "${bin}" "${precheck_args[*]}" "${CHILD_STATUS}"
    printf '  APPLY %s %s (child output follows)\n' "${bin}" "${apply_args[*]}"

    # The child's own --apply streams directly: its transaction, its
    # rollback, its diagnostics — never captured, never swallowed.
    apply_status=0
    "${bin}" "${apply_args[@]}" || apply_status=$?

    if (( apply_status != 0 )); then
        printf 'ERROR: slice %s apply failed: %s %s (exit status %d)\n' \
            "${slice_id}" "${bin}" "${apply_args[*]}" "${apply_status}" >&2
        printf 'Earlier slices remain safely converged; fix the surfaced problem and re-run prepare-host --apply to resume at slice %s\n' \
            "${slice_id}" >&2
        exit "${apply_status}"
    fi

    printf '  VERIFY %s (post-apply)%s...\n' "${label}" "$(slice_duration_note "${slice_id}")"

    # Always the authoritative --verify here, never the material-aware
    # --check: afterwards the only question that matters is whether the
    # host itself satisfies the contract.
    mapfile -t verify_args < <(slice_args "${slice_id}" verify)
    run_child_captured "${bin}" "${verify_args[@]}"

    # The child's own apply reported success while its authoritative
    # contract still does not hold — the one case where a summary excerpt
    # is not enough, so the complete child report is printed.
    if (( CHILD_STATUS != 0 )); then
        printf '%s\n' "${CHILD_OUTPUT}"
        child_failed "slice ${slice_id} post-apply verification" "${bin}" "${verify_args[@]}"
    fi

    SLICE_STATUS[${slice_id}]='PASS (applied and verified)'
    printf '  PASS verified\n'
}

# --- Recovery preparation ------------------------------------------------------
#
# The ordinary slices, in the ordinary order, with two things placed between
# them: the recovery material, fetched after the runtime slice has installed
# rclone and jq and before the host-scope slice needs it; and the offsite-write
# hold, placed after host bootstrap has created the run root and before the
# target-scope slice installs the offsite credential.

EFFECTIVE_MATERIAL_DIR=""

run_recovery_slices() {
    converge_slice "${TARGET_AGNOSTIC_SLICE}"

    # The runtime slice is satisfied, so the registry is readable now and the
    # gate has to run here — the material fetch is target-specific.
    gate_lifecycle_before recovery-material

    stage_recovery_material

    converge_slice host-prerequisites
    converge_slice bootstrap

    hold_offsite_writes

    converge_slice target-prerequisites
    converge_slice database
}

# stage_recovery_material — the seed directory the caller supplied becomes the
# effective material directory the prerequisite slices are fed, through the
# recovery-material helper. The effective directory is root-only, lives under
# root's home, and is removed when this run ends however it ends.
stage_recovery_material() {
    local seed_dir="${MATERIAL_DIR}"

    printf '\nRECOVERY MATERIAL — offsite backup %s\n' "${RECOVERY_BACKUP}"

    [[ -x "${RECOVERY_MATERIAL_BIN}" ]] \
        || fail "recovery-material helper is not executable: ${RECOVERY_MATERIAL_BIN} — run from a full repository checkout"

    [[ -d "${RECOVERY_MATERIAL_PARENT}" ]] \
        || fail "the recovery material parent directory does not exist: ${RECOVERY_MATERIAL_PARENT}"

    EFFECTIVE_MATERIAL_DIR="$(mktemp -d "${RECOVERY_MATERIAL_PARENT%/}/rateguru-recovery-material.XXXXXX")" \
        || fail "could not create a root-only directory for the recovery material under ${RECOVERY_MATERIAL_PARENT}"

    chmod 0700 "${EFFECTIVE_MATERIAL_DIR}"
    trap discard_recovery_material EXIT

    printf '  FETCH %s --target %s --backup %s (child output follows)\n' \
        "${RECOVERY_MATERIAL_BIN}" "${TARGET_ID}" "${RECOVERY_BACKUP}"

    local fetch_status=0
    "${RECOVERY_MATERIAL_BIN}" \
        --target "${TARGET_ID}" \
        --backup "${RECOVERY_BACKUP}" \
        --seed-dir "${seed_dir}" \
        --output-dir "${EFFECTIVE_MATERIAL_DIR}" \
        || fetch_status=$?

    if (( fetch_status != 0 )); then
        printf 'ERROR: recovery material could not be staged from offsite backup %s (exit status %d)\n' \
            "${RECOVERY_BACKUP}" "${fetch_status}" >&2
        printf 'Nothing target-specific was prepared; the helper'"'"'s own diagnosis above says why. The runtime slice stays converged.\n' >&2
        exit "${fetch_status}"
    fi

    MATERIAL_DIR="${EFFECTIVE_MATERIAL_DIR}"

    printf '  PASS — effective material staged root-only in %s (removed when this run ends)\n' "${EFFECTIVE_MATERIAL_DIR}"
}

# discard_recovery_material — on every exit path. Guarded by construction:
# only a directory this run created under the recovery material parent, by the
# name mktemp gave it, is ever removed.
discard_recovery_material() {
    if [[ -n "${EFFECTIVE_MATERIAL_DIR}" ]] \
        && [[ "${EFFECTIVE_MATERIAL_DIR}" == "${RECOVERY_MATERIAL_PARENT%/}/rateguru-recovery-material."* ]]
    then
        rm -rf -- "${EFFECTIVE_MATERIAL_DIR}"
    fi
}

# offsite_write_hold_path — the same path common's offsite_write_hold_file
# composes; stated here because this script cannot source common, and pinned
# to it by a test.
offsite_write_hold_path() {
    printf '%s/offsite-write-hold\n' "${OPERATIONAL_RUN_ROOT%/}"
}

# hold_offsite_writes — after host bootstrap created the run root, before the
# offsite credential exists on this host. Idempotent: a hold that is already
# there is reported and kept, never rewritten. The document carries identity
# only — which target, which backup, which operation placed it and when.
hold_offsite_writes() {
    local marker
    marker="$(offsite_write_hold_path)"

    printf '\nOFFSITE-WRITE HOLD\n'

    [[ -d "${OPERATIONAL_RUN_ROOT}" ]] \
        || fail "the operational run root ${OPERATIONAL_RUN_ROOT} does not exist after host bootstrap — the offsite-write hold cannot be recorded, so preparation stops before the offsite credential is installed"

    if [[ -e "${marker}" ]] || [[ -L "${marker}" ]]; then
        printf '  OFFSITE WRITES: HELD (already) — %s\n' "${marker}"
        return 0
    fi

    # Created 0600 before any content reaches it: the document is not secret,
    # but a marker other operations read must never be writable by anyone else
    # for even a moment.
    install -m 0600 /dev/null "${marker}.tmp" \
        || fail "could not create the offsite-write hold ${marker}"

    jq -n \
        --arg hold offsite-writes \
        --arg reason host-recovery \
        --arg target "${TARGET_ID}" \
        --arg backup "${RECOVERY_BACKUP}" \
        --arg created_by "prepare-host --recovery-backup" \
        --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{
            hold: $hold,
            reason: $reason,
            target: $target,
            backup: $backup,
            created_by: $created_by,
            created_at: $created_at
        }' > "${marker}.tmp" \
        || { rm -f "${marker}.tmp"; fail "could not write the offsite-write hold ${marker}"; }

    chmod 0600 "${marker}.tmp"
    mv -f "${marker}.tmp" "${marker}" \
        || { rm -f "${marker}.tmp"; fail "could not install the offsite-write hold ${marker}"; }

    printf '  OFFSITE WRITES: HELD — %s\n' "${marker}"
    printf '  backup-cycle, offsite-backup and offsite-retention refuse on this host until it is\n'
    printf '  deliberately adopted; the target scheduler and queue are not affected.\n'
}

# --- Entry point --------------------------------------------------------------

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify)
                if [[ "${MODE_SEEN}" == true ]]; then
                    usage >&2
                    fail "mode given more than once"
                fi

                MODE="${1#--}"
                MODE_SEEN=true
                shift
                ;;
            --target)
                if [[ "${TARGET_SEEN}" == true ]]; then
                    fail "--target given more than once"
                fi

                if [[ $# -lt 2 ]] || [[ -z "${2-}" ]]; then
                    fail "--target requires a non-empty value"
                fi

                case "$2" in
                    -*) fail "--target requires a value, not another option: $2" ;;
                esac

                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --material-dir)
                if [[ "${MATERIAL_DIR_SEEN}" == true ]]; then
                    fail "--material-dir given more than once"
                fi

                if [[ $# -lt 2 ]] || [[ -z "${2-}" ]]; then
                    fail "--material-dir requires a non-empty value"
                fi

                case "$2" in
                    -*) fail "--material-dir requires a value, not another option: $2" ;;
                esac

                MATERIAL_DIR="$2"
                MATERIAL_DIR_SEEN=true
                shift 2
                ;;
            --recovery-backup)
                if [[ "${RECOVERY_BACKUP_SEEN}" == true ]]; then
                    fail "--recovery-backup given more than once"
                fi

                if [[ $# -lt 2 ]] || [[ -z "${2-}" ]]; then
                    fail "--recovery-backup requires a non-empty value"
                fi

                case "$2" in
                    -*) fail "--recovery-backup requires a value, not another option: $2" ;;
                esac

                RECOVERY_BACKUP="$2"
                RECOVERY_BACKUP_SEEN=true
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done

    if [[ "${MODE_SEEN}" != true ]]; then
        usage >&2
        fail "one of --check, --apply or --verify is required"
    fi

    if [[ "${TARGET_SEEN}" != true ]]; then
        usage >&2
        fail "--target is required"
    fi

    if [[ "${MODE}" == verify ]] && [[ "${MATERIAL_DIR_SEEN}" == true ]]; then
        fail "--verify never consults supplied material; it inspects the prepared host only"
    fi

    if [[ "${RECOVERY_BACKUP_SEEN}" == true ]]; then
        # An exact backup ID by shape; whether it is a real timestamp, and
        # whether it exists, is the recovery-material helper's decision.
        [[ "${RECOVERY_BACKUP}" =~ ^[0-9]{8}-[0-9]{6}$ ]] \
            || fail "--recovery-backup requires an exact offsite backup timestamp YYYYMMDD-HHMMSS (got: ${RECOVERY_BACKUP}); there is no 'latest'"

        [[ "${MODE}" == apply ]] || [[ "${MODE}" == verify ]] \
            || fail "--recovery-backup is valid with --apply (a recovery preparation) or --verify (its verification, which requires the offsite-write hold), never with --check"

        if [[ "${MODE}" == apply ]]; then
            [[ "${MATERIAL_DIR_SEEN}" == true ]] \
                || fail "--recovery-backup requires --material-dir naming the seed directory (rclone-config and deploy-authorized-keys)"
        fi
    fi
}

recovery_mode() {
    [[ -n "${RECOVERY_BACKUP}" ]]
}

main() {
    parse_args "$@"

    require_root
    require_children_executable

    case "${MODE}" in
        check)  run_check ;;
        verify) run_verify ;;
        apply)  run_apply ;;
    esac

    exit 0
}

# Source-guard: allows tests to source this file and call functions directly
# without main() auto-running — the same pattern every other orchestrator uses.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
