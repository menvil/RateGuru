#!/usr/bin/env bash
#
# render-environment-templates — generate each deployment target's environment
# template from the one canonical contract.
#
#   render-environment-templates --check
#   render-environment-templates --write
#
# WHAT PROBLEM THIS SOLVES. Every target's template declares the same keys, and
# for as long as they were hand-maintained that was a rule somebody had to
# remember: add a key to staging, remember production, remember the next brand.
# A rule enforced by memory is a rule that fails the week it matters. So the key
# list, the section order, the descriptions, the values and the classification of
# every key live in ONE reviewed file —
#
#   infrastructure/config/environment-contract.json
#
# — and the templates are generated from it. A developer changes the contract
# once; every target's template follows.
#
# WHAT IT MUST NEVER BE. This renders COMMITTED REPOSITORY FILES and nothing
# else. It does not know the path of any host's runtime environment file, cannot
# be pointed at one, and is deliberately absent from the operational bundle
# install-target-operations puts on a host: a target's shared/.env is canonical
# there, operator-owned, and a generator that could write it would be a way for
# a deploy to invent a credential nobody chose. The destinations below are the
# only paths this script will write, and they are derived from the registry
# rather than accepted as input.
#
#   --check  Read-only. Renders into a private temporary directory and compares
#            byte for byte against what is committed. Exit 0 when every target's
#            template is current; non-zero, naming the stale ones, otherwise.
#            Writes nothing, anywhere, on any path.
#   --write  Regenerates the committed templates in place. Nothing else.
#
# VALUES. Four forms, deliberately — this is a contract, not a templating
# language:
#
#   "VALUE"                                 the same for every target
#   {"from": "target_id"}                   the target's own id
#   {"from": "environment_class"}           its environment class
#   {"by_environment_class": {...}}         one value per class, for the few
#                                           settings that genuinely differ
#                                           (staging's mail capture against
#                                           production's placeholders)
#
# A target-specific value is never written twice: APP_DEPLOYMENT_TARGET comes
# from the registry's own target id, and APP_ENV and SENTRY_ENVIRONMENT from its
# environment class, so the registry stays the single place a target is defined.

set -Eeuo pipefail
umask 022

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

CONTRACT_FILE="${REPO_ROOT}/infrastructure/config/environment-contract.json"
REGISTRY_FILE="${REPO_ROOT}/infrastructure/config/deployment-targets.json"
TEMPLATE_ROOT="${REPO_ROOT}/infrastructure/templates/environment"
TARGETS_CLI="${SCRIPT_DIR}/targets"
TEMPLATE_ROOT_CANONICAL=""

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage:
  render-environment-templates --check
  render-environment-templates --write

  --check  Read-only. Renders each target's template into a private temporary
           directory and compares it byte for byte against the committed file.
           Exit 0 only when every one is current. Writes nothing, anywhere.
  --write  Regenerate the committed repository templates from
           infrastructure/config/environment-contract.json.

Generates only committed repository files under
infrastructure/templates/environment/, named by the deployment target registry.

It has no knowledge of any host's runtime environment file and cannot be used to
create, repair or modify one: a target's shared/.env is canonical on its host and
is the operator's to own.
USAGE
}

MODE=""

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--write)
                [[ -z "${MODE}" ]] || fail "give exactly one of --check or --write"
                MODE="${1#--}"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ -n "${MODE}" ]] || { usage >&2; fail "one of --check or --write is required"; }
}

require_inputs() {
    [[ -f "${CONTRACT_FILE}" ]] || fail "canonical contract is missing: ${CONTRACT_FILE}"
    [[ -f "${REGISTRY_FILE}" ]] || fail "target registry is missing: ${REGISTRY_FILE}"
    [[ -d "${TEMPLATE_ROOT}" ]] || fail "template directory is missing: ${TEMPLATE_ROOT}"

    TEMPLATE_ROOT_CANONICAL="$(cd -- "${TEMPLATE_ROOT}" >/dev/null 2>&1 && pwd -P)" \
        || fail "cannot resolve the template directory: ${TEMPLATE_ROOT}"

    command -v jq >/dev/null 2>&1 || fail "jq is required"

    jq -e . "${CONTRACT_FILE}" >/dev/null 2>&1 || fail "canonical contract is not valid JSON: ${CONTRACT_FILE}"
    jq -e . "${REGISTRY_FILE}" >/dev/null 2>&1 || fail "target registry is not valid JSON: ${REGISTRY_FILE}"

    local version
    version="$(jq -r '.schema_version' "${CONTRACT_FILE}")"

    [[ "${version}" == "1" ]] \
        || fail "canonical contract declares schema_version ${version}; this renderer understands 1"

    # The registry is where every destination comes from, so it is validated by
    # its own authority before a single path is believed — in BOTH modes, and
    # before --write touches anything. Syntactically-valid JSON is not the same
    # as a valid registry, and this script must not be the place that discovers
    # the difference after writing a file.
    [[ -x "${TARGETS_CLI}" ]] \
        || fail "the target registry validator is not executable: ${TARGETS_CLI} — run from a full repository checkout"

    "${TARGETS_CLI}" validate --file "${REGISTRY_FILE}" >/dev/null \
        || fail "the target registry does not validate, so no destination it declares may be trusted; nothing was rendered"
}

# assert_destination_within_templates DECLARED TARGET_ID — prove, rather than
# pattern-match, that this declaration names a file directly inside the
# repository's environment template directory.
#
# A glob is not a boundary. `infrastructure/templates/environment/*.env.example`
# is matched by
#
#   infrastructure/templates/environment/../../escaped.env.example
#
# because `*` happily spans `/../`. For a tool whose whole claim is "I can only
# write here", a pattern that can be walked out of is not good enough — so the
# path is RECONSTRUCTED from its own basename and required to equal what was
# declared. A declaration with anything between the directory and the file name
# cannot survive that, whatever it is.
assert_destination_within_templates() {
    local declared="$1" target_id="$2" base parent

    case "${declared}" in
        /*) fail "target ${target_id} declares an absolute environment_template (${declared}); only a repository-relative path may be rendered" ;;
    esac

    base="${declared##*/}"

    [[ "${declared}" == "infrastructure/templates/environment/${base}" ]] \
        || fail "target ${target_id} declares environment_template ${declared}, which is not a file directly inside infrastructure/templates/environment/ — refusing to render outside the template directory"

    [[ "${base}" == *.env.example ]] \
        || fail "target ${target_id} declares environment_template ${declared}, which is not an .env.example file"

    [[ "${base}" != "." ]] && [[ "${base}" != ".." ]] && [[ "${base}" != ".env.example" ]] \
        || fail "target ${target_id} declares an unusable environment_template file name: ${base}"

    # Belt and braces: the directory the file would land in, canonicalized, must
    # be the template directory itself — so a symlinked path cannot escape even
    # though the textual check above already passed.
    parent="$(cd -- "$(dirname -- "${REPO_ROOT}/${declared}")" >/dev/null 2>&1 && pwd -P)" \
        || fail "target ${target_id} declares environment_template ${declared}, whose directory cannot be resolved"

    [[ "${parent}" == "${TEMPLATE_ROOT_CANONICAL}" ]] \
        || fail "target ${target_id} declares environment_template ${declared}, which resolves into ${parent} rather than ${TEMPLATE_ROOT_CANONICAL} — refusing to render outside the template directory"

    # A generated file is a regular file. Rendering through a symlink would write
    # wherever it points.
    [[ ! -L "${REPO_ROOT}/${declared}" ]] \
        || fail "target ${target_id} declares environment_template ${declared}, which is a symlink — refusing to render through one"
}

# render_template TARGET_ID ENVIRONMENT_CLASS — the whole file, on stdout.
#
# One jq program rather than a shell loop over keys: the ordering of sections and
# of the keys inside them is the contract's, and a shell loop would be a second
# place that order is decided.
render_template() {
    local target_id="$1" environment_class="$2"

    jq -r \
        --arg target "${target_id}" \
        --arg class "${environment_class}" \
        --arg contract 'infrastructure/config/environment-contract.json' \
        '
        def rule($name): "# --- " + $name + " " + ("-" * (74 - ($name | length)));

        def value($entry):
            $entry.value as $v
            | if ($v | type) == "string" then $v
              elif ($v | has("from")) then
                  (if $v.from == "target_id" then $target
                   elif $v.from == "environment_class" then $class
                   else error("unsupported value source: " + $v.from) end)
              elif ($v | has("by_environment_class")) then
                  ($v.by_environment_class[$class]
                   // error("no value for environment class " + $class + " on key " + $entry.key))
              else error("unsupported value shape on key " + $entry.key)
              end;

        def commented($text):
            $text | split("\n") | map(if . == "" then "#" else "# " + . end) | join("\n");

        [
          "# RateGuru environment template — " + $target,
          "#",
          "# GENERATED FROM " + $contract,
          "# DO NOT EDIT THIS FILE DIRECTLY — run",
          "#   infrastructure/scripts/render-environment-templates --write",
          "# and commit the result. CI compares this file against that output.",
          "#",
          "# The canonical runtime file lives on the host at",
          "# <application_root>/shared/.env, is created once by an operator and is never",
          "# written by any deploy, configure, recovery or rendering operation. This",
          "# template is the reviewed declaration of WHICH KEYS that file must carry.",
          "#",
          "# Every target is rendered from the one contract, so the key list and its order",
          "# are identical across targets by construction rather than by anybody",
          "# remembering. This file also travels INSIDE every release artifact built from",
          "# it, and that copy is what an ordinary deploy judges a host'"'"'s .env against —",
          "# because the tooling installed on a host may be older than the application",
          "# being deployed onto it. Configure Target uses the repository copy;",
          "# verify-environment-contract uses the host'"'"'s installed copy for standalone",
          "# inspection. Controlled restore and recovery alignment are exempt: they",
          "# install an exact historical release beside historical state.",
          "#",
          "# Key names only, never values, and nothing ever writes the host'"'"'s file.",
          "#",
          "# Values here are defaults and placeholders. An empty value means \"the operator",
          "# supplies it\"; it does not mean the key is optional.",
          ""
        ]
        + (
            [ .sections[]
              | .name as $name
              | [ rule($name), commented(.description), "" ]
                + [ ($keys[] | select(.classification == "target" and .section == $name)
                     | .key + "=" + value(.)) ]
                + [ "" ]
            ] | add
          )
        | .[]
        ' --argjson keys "$(jq -c '.keys' "${CONTRACT_FILE}")" "${CONTRACT_FILE}" \
        | sed -e '$ { /^$/d; }'
}

# The targets to render, and the file each one owns — both from the registry, so
# a target cannot be rendered to a path somebody typed.
target_rows() {
    jq -r '.targets | to_entries[] | [.key, .value.environment_class, .value.environment_template] | @tsv' "${REGISTRY_FILE}"
}

main() {
    parse_args "$@"
    require_inputs

    # BOTH modes render into a private directory first, and that is the point of
    # it in --write as much as in --check.
    #
    # Redirecting straight at a committed file truncates it before the renderer has
    # produced a byte: a render that then fails — a contract a jq program cannot
    # evaluate, a value shape nobody has taught it — leaves the repository holding
    # an empty or half-written template, and the operator who runs --write to fix
    # something has broken the thing they were fixing. So every target is rendered
    # first, and the committed files are replaced only once ALL of them succeeded.
    local stage=""

    stage="$(mktemp -d "${TMPDIR:-/tmp}/rateguru-environment-render.XXXXXX")" \
        || fail "could not create a temporary directory to render into"

    chmod 0700 "${stage}"

    # Removed however this ends, including a fail() inside the loop below.
    # shellcheck disable=SC2064  # the path is fixed now, which is what is wanted
    trap "rm -rf -- '${stage}'" EXIT

    local target_id environment_class declared destination rendered
    local -a stale=() claimed=() pending=()
    local written=0

    while IFS=$'\t' read -r target_id environment_class declared; do
        [[ -n "${target_id}" ]] || continue

        assert_destination_within_templates "${declared}" "${target_id}"

        # The registry forbids two targets sharing a template, and this is the
        # same rule where the writing happens: without it the second render would
        # overwrite the first, and the target that lost would be deployed against
        # a contract describing somebody else.
        case " ${claimed[*]-} " in
            *" ${declared} "*) fail "two targets declare environment_template ${declared}; the second render would overwrite the first" ;;
        esac

        claimed+=("${declared}")

        destination="${REPO_ROOT}/${declared}"
        rendered="${stage}/$(basename "${declared}")"

        # A render that fails must not have touched anything. fail() here exits
        # with the staging directory removed by the trap and every committed file
        # exactly as it was.
        render_template "${target_id}" "${environment_class}" > "${rendered}" \
            || fail "could not render ${declared} for target ${target_id}; no committed template was changed"

        [[ -s "${rendered}" ]] \
            || fail "rendering ${declared} for target ${target_id} produced nothing; no committed template was changed"

        if [[ "${MODE}" == write ]]; then
            pending+=("${rendered}|${destination}|${declared}")

            continue
        fi

        if [[ ! -f "${destination}" ]]; then
            stale+=("${declared} (missing)")

            continue
        fi

        if ! cmp -s "${rendered}" "${destination}"; then
            stale+=("${declared}")
            printf 'STALE %s\n' "${declared}" >&2
            diff -u "${destination}" "${rendered}" | sed 's/^/  /' >&2 || true
        else
            printf 'CURRENT %s\n' "${declared}"
        fi
    done < <(target_rows)

    if [[ "${MODE}" == write ]]; then
        # Every target rendered. Only now is anything committed replaced, and each
        # replacement is a single install(1) — the mode is set as the file lands
        # rather than afterwards, so there is no window where a generated template
        # exists with the wrong one.
        local entry source target label
        for entry in ${pending[@]+"${pending[@]}"}; do
            source="${entry%%|*}"
            label="${entry##*|}"
            target="${entry#*|}"
            target="${target%|*}"

            install -m 0644 "${source}" "${target}" \
                || fail "could not install the rendered ${label}"

            printf 'WROTE %s\n' "${label}"
            written=$((written + 1))
        done

        printf 'rendered %d target template(s) from %s\n' "${written}" "infrastructure/config/environment-contract.json"

        return 0
    fi

    if (( ${#stale[@]} > 0 )); then
        printf '\n%d committed target template(s) do not match the canonical contract:\n' "${#stale[@]}" >&2

        local entry
        for entry in "${stale[@]}"; do
            printf '  %s\n' "${entry}" >&2
        done

        fail "run infrastructure/scripts/render-environment-templates --write and commit the result"
    fi

    printf 'every committed target template matches infrastructure/config/environment-contract.json\n'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
