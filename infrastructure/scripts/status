#!/usr/bin/env bash

set -Eeuo pipefail

# RATEGURU_COMMON_FILE is for tests and controlled tooling only. Production
# never sets it, so this resolves to the exact same installed path as before.
# shellcheck disable=SC1090
source "${RATEGURU_COMMON_FILE:-/home/www/rateguru/bin/common}"

# RATEGURU_HEALTH_CHECK_CLI is for tests only, mirroring the RATEGURU_*_CLI
# convention already used in common for the targets validator.
HEALTH_CHECK_BIN="${RATEGURU_HEALTH_CHECK_CLI:-/home/www/rateguru/bin/health-check}"

usage() {
    cat <<'USAGE'
Usage:
  status --target TARGET
  status --environment staging|production
USAGE
}

TARGET_ID=""
ENVIRONMENT=""
TARGET_SEEN=false
ENVIRONMENT_SEEN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)
            if [[ "${TARGET_SEEN}" == true ]]; then
                fail "--target given more than once"
            fi

            [[ $# -ge 2 ]] || fail "--target requires a value"

            TARGET_ID="$2"
            TARGET_SEEN=true
            shift 2
            ;;
        --environment)
            if [[ "${ENVIRONMENT_SEEN}" == true ]]; then
                fail "--environment given more than once"
            fi

            [[ $# -ge 2 ]] || fail "--environment requires a value"

            ENVIRONMENT="$2"
            ENVIRONMENT_SEEN=true
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            fail "unknown argument: $1"
            ;;
    esac
done

if [[ "${TARGET_SEEN}" == true ]] && [[ "${ENVIRONMENT_SEEN}" == true ]]; then
    fail "--target and --environment cannot be combined"
fi

if [[ "${TARGET_SEEN}" != true ]] && [[ "${ENVIRONMENT_SEEN}" != true ]]; then
    fail "exactly one of --target or --environment is required"
fi

# require_active_target validates the target ID, the whole registry, that the
# target exists, and that it is lifecycle=active — all before ROOT is computed
# below and any application path is inspected. A planned target (e.g.
# tits-guru today), a disabled one, or an unknown ID is rejected here, before
# any symlink is resolved or history file is read.
if [[ "${TARGET_SEEN}" == true ]]; then
    [[ -n "${TARGET_ID}" ]] || fail "--target requires a non-empty value"

    require_active_target "${TARGET_ID}"

    ROOT="$(target_root "${TARGET_ID}")"
    LIFECYCLE="$(target_lifecycle "${TARGET_ID}")"
    ENVIRONMENT_CLASS="$(target_environment_class "${TARGET_ID}")"
    HEALTH_CHECK_ARGS=(--target "${TARGET_ID}")
else
    [[ -n "${ENVIRONMENT}" ]] || fail "--environment requires a non-empty value"

    validate_environment "${ENVIRONMENT}"

    ROOT="$(environment_root "${ENVIRONMENT}")"
    HEALTH_CHECK_ARGS=(--environment "${ENVIRONMENT}")
fi

CURRENT_LINK="${ROOT}/current"
PREVIOUS_LINK="${ROOT}/previous"
HISTORY_FILE="${ROOT}/deployments/history.jsonl"

print_link() {
    local label="$1"
    local link="$2"

    if [[ -L "${link}" ]]; then
        local path
        local release

        path="$(readlink -f "${link}")"
        release="$(basename "${path}")"

        printf '%-12s %s\n' "${label}:" "${release}"
        printf '%-12s %s\n' "${label} path:" "${path}"
    else
        printf '%-12s %s\n' "${label}:" "not configured"
    fi
}

echo "========================================"
echo "RateGuru deployment status"
echo "========================================"

if [[ "${TARGET_SEEN}" == true ]]; then
    printf '%-12s %s\n' "Target:" "${TARGET_ID}"
    printf '%-12s %s\n' "Lifecycle:" "${LIFECYCLE}"
    printf '%-12s %s\n' "Environment class:" "${ENVIRONMENT_CLASS}"
else
    printf '%-12s %s\n' "Environment:" "${ENVIRONMENT}"
fi

printf '%-12s %s\n' "Checked at:" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

echo
echo "Releases"
echo "----------------------------------------"

print_link "Current" "${CURRENT_LINK}"
print_link "Previous" "${PREVIOUS_LINK}"

echo
echo "Current release metadata"
echo "----------------------------------------"

if [[ -L "${CURRENT_LINK}" ]] \
    && [[ -r "${CURRENT_LINK}/release.json" ]]
then
    if RELEASE_METADATA="$(jq . "${CURRENT_LINK}/release.json" 2>/dev/null)"
    then
        printf '%s\n' "${RELEASE_METADATA}"
    else
        echo "release.json is malformed"
    fi
else
    echo "release.json is unavailable"
fi

echo
echo "Health"
echo "----------------------------------------"

if "${HEALTH_CHECK_BIN}" "${HEALTH_CHECK_ARGS[@]}"; then
    echo "Status: healthy"
else
    echo "Status: unhealthy"
fi

echo
echo "Recent deployment history"
echo "----------------------------------------"

if [[ -r "${HISTORY_FILE}" ]]; then
    while IFS= read -r history_entry; do
        if ! jq . <<<"${history_entry}"; then
            printf 'Malformed history entry: %s\n' "${history_entry}"
        fi
    done < <(tail -6 "${HISTORY_FILE}")
else
    echo "No deployment history"
fi
