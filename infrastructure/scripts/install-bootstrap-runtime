#!/usr/bin/env bash
#
# Install-bootstrap-runtime — : reproducible base/runtime
# package installation for a clean Ubuntu 22.04 RateGuru host.
#
# Modes:
#   --check   Strictly read-only. Validates the OS/architecture/package-
#             manager prerequisites and reports repository, package and
#             runtime state, plus the intended --apply action for every
#             unsatisfied item. Never runs apt-get update, never installs
#             anything, never adds repositories or keys. Exits 0 only when
#             The install-bootstrap-runtime contract is already satisfied.
#   --apply   Root only. Idempotently configures the two RateGuru-owned
#             package repositories (PHP PPA, PGDG), installs missing
#             required packages, upgrades an nginx below its security floor
#             (its packages only, then restarts nginx onto the new binary),
#             and ends with the full --verify report. Never removes
#             packages, never runs apt upgrade/dist-upgrade/full-upgrade,
#             never touches application users, directories, any other
#             service or RateGuru configuration.
#   --verify  Read-only. The authoritative install-bootstrap-runtime contract gate: exits 0
#             only when every repository, package, binary, PHP module and
#             client version requirement holds. --check is exactly this
#             report with intended actions added.
#   --help    Usage.
#
# Supported host contract: the RateGuru staging VPS baseline only — Ubuntu
# 22.04 (apt/dpkg), exactly, on x86_64/amd64 only. SUPPORTED_OS_ID and
# SUPPORTED_OS_VERSION_ID mirror bootstrap-host-preflight and architecture
# tests enforce that the two scripts never drift apart. Any other OS family,
# release or architecture fails closed before any repository or package
# mutation — this mutating installer does not silently claim support for
# hosts the staging baseline has not proven.
#
# Repository ownership: this installer manages exactly two apt sources, both
# required specifically by the RateGuru runtime and both proven on the real
# staging host:
#   - Ondřej Surý PHP PPA (ppa.launchpadcontent.net/ondrej/php/ubuntu jammy)
#     — PHP 8.5 is not supplied by the Ubuntu 22.04 base repository.
#   - PGDG (apt.postgresql.org jammy-pgdg) — the staging host runs
#     PostgreSQL 18 packages (18.x-1.pgdg22.04+1).
# Each is written as a deb822 .sources file referencing a dedicated keyring
# under /etc/apt/keyrings; key material is fetched over HTTPS only, and is
# installed only after its primary-key fingerprint matches the pin embedded
# below (a single key per keyring — a bundle with extra keys is rejected).
# apt-key is never used. For installer-owned repository files, --check and
# --verify validate authoritatively and read-only: the .sources file must be
# byte-exact against the composed expectation, and the installed keyring
# must be a valid OpenPGP keyring holding exactly one primary key whose
# fingerprint equals the pin (the same local gpg validation --apply uses on
# freshly fetched material — never a network call). Any drift, garbage or
# wrong-fingerprint keyring is CONFLICT and fails --verify. A pre-existing
# apt source that already provides the same repository (however the
# operator configured it — e.g. the classic add-apt-repository .list the
# current staging host carries) is recognized and left untouched. Unrelated
# host repositories (NodeSource, ClickHouse, Datadog/Vector, anything else)
# are never inspected, managed or removed — they are outside this
# installer's ownership.
#
# Version policy: the contract is major/runtime compatibility, never an
# incidental security-patch pin. PHP must be series 8.5 (8.5.x floats with
# security updates) and at least PHP_MIN_VERSION — a security floor, below
# which a release is known to be exploitable, not a pin: every later 8.5.x
# passes. --apply meets it by upgrading the installed php8.5 packages and
# moving PHP-FPM and the long-running PHP workers onto the new binary
# (reconcile_php_security_floor). PostgreSQL must be major
# 18. Nginx, Redis, Supervisor and every base utility come from the Ubuntu
# 22.04 (jammy) distribution repository — no external repository is
# introduced to chase the exact staging patch versions (nginx 1.18.0, redis
# 6.0.16, supervisor 4.2.1). Nginx alone has a security floor of its own,
# NGINX_MIN_PACKAGE_VERSION, an Ubuntu package revision; unlike PHP's, --apply
# meets it by upgrading the nginx packages (reconcile_nginx_security_floor).
#
# Managed external runtime — rclone: the real staging host runs a standalone
# /usr/bin/rclone that no dpkg package owns, and the Ubuntu 22.04 rclone
# package (1.53.x) is far older than the runtime the committed offsite-backup
# scripts were proven against. rclone is therefore a RateGuru-managed
# external runtime binary, never an Ubuntu package dependency: the rclone apt
# package is neither required nor ever installed, no third-party apt
# repository is added for it, and dpkg ownership of the binary is deliberately
# not part of the contract. The exact pinned release lives in the committed
# external-runtimes contract (infrastructure/config/external-runtimes/
# versions.env) — never "latest", never a dynamic lookup; moving the pin is a
# deliberate repository change. --check/--verify report rclone in their own
# EXTERNAL RUNTIME section (separate from PACKAGES), and --apply reconciles
# drift by downloading the exact pinned release archive plus its SHA256SUMS
# from the official rclone download origin over HTTPS, verifying the
# clearsigned SHA256SUMS against the committed release-signing public key
# (trusted only through the pinned fingerprint the contract carries — never
# because of where any file was downloaded from), verifying the artifact
# checksum, extracting, confirming the extracted binary reports exactly the
# pinned version, and only then staging the candidate with final ownership
# and mode and renaming it over the installed binary atomically. Any failure
# before that rename leaves the currently working rclone untouched. The
# operator's rclone configuration (/root/.config/rclone/rclone.conf) is never
# read, written or touched, `rclone selfupdate` and the upstream install.sh
# pipeline are never used, and a compliant host performs no network activity
# at all for rclone.
#
# Managed external runtime — yt-dlp: the media import downloads videos from
# the pages users link through yt-dlp, whose site support changes every few
# weeks; the Ubuntu 22.04 package is years behind and would break on the
# first changed site. It is therefore a second RateGuru-managed external
# runtime under the same contract file and the same rules as rclone: the
# exact pinned release (YTDLP_* in versions.env), never "latest" and never
# `yt-dlp -U`. --apply downloads the standalone yt-dlp_linux executable (it
# carries its own Python, so the host's Python never matters) and the
# release's SHA2-256SUMS with its detached signature from the official GitHub
# release, verifies the signature against the committed release-signing key
# (trusted only through the pinned fingerprint), verifies the executable's
# checksum, confirms it reports exactly the pinned version, and renames it
# over the installed binary atomically. Moving the pin is the upgrade path,
# and on a compliant host there is no network activity for yt-dlp either.
#
# Managed external runtime — ffmpeg: the media pipeline probes and transcodes
# video, and turns animated GIFs into video, with ffmpeg and ffprobe — on
# files users upload, so the tools parse untrusted input. Jammy's package is
# the 4.4 series, frozen in 2022, in universe (best-effort security fixes),
# and a different version from the one CI and developers test with. A
# third managed runtime therefore replaces it: the exact pinned static build
# (FFMPEG_* in versions.env) from BtbN/FFmpeg-Builds — the Linux builds the
# FFmpeg project itself links to — taken from a month-end autobuild, which
# that project keeps for two years. It publishes checksums but no
# signature, so the trust anchor is the SHA-256 committed in the contract:
# --apply downloads the archive over HTTPS, refuses it unless its digest is
# exactly the pinned one, extracts only bin/ffmpeg and bin/ffprobe, confirms
# both report exactly the pinned version, and renames each into
# FFMPEG_BIN_DIR atomically. CI installs the same build from the same pin.
# Jammy's ffmpeg package is not required any more and, like every package,
# is never removed: a host prepared with it keeps /usr/bin/ffmpeg, unused —
# /usr/local/bin precedes /usr/bin on PATH, and the application looks there
# first even where PATH is cleared (PHP-FPM).
#
# Deliberate package decisions:
#   - Node.js, npm and Composer are intentionally absent: GitHub Actions
#     builds the immutable application artifact (composer install --no-dev,
#     npm ci, npm run build; vendor/ and public/build ship inside the
#     artifact), so the application host never builds anything.
#   - php8.5-igbinary is not listed: it arrives automatically as a
#     dependency of php8.5-redis (the redis extension is built against the
#     igbinary serializer) and is not an independent runtime requirement.
#   - php8.5-readline is not listed: an interactive-CLI convenience, not
#     part of the runtime contract; it may appear as a dependency but is
#     never required or verified.
#   - exif and pcntl ship inside php8.5-common/php8.5-cli — no extra
#     package, but both are verified as loaded modules (composer.json
#     requires ext-exif; queue workers rely on pcntl signal handling).
#   - SQLite is not installed: repository tests support SQLite, but the
#     staging/production runtime contract is PostgreSQL only.
#   - openssh-server is required: the committed deploy pipeline delivers
#     release artifacts over SSH (deploy-staging.yml), so sshd is a genuine
#     Runtime prerequisite even though install-bootstrap-runtime never touches its
#     configuration.
#   - shellcheck/actionlint/wget/journalctl are not requirements: the first
#     two are development-only validators, wget is unused by the committed
#     scripts (curl is the contract), and journalctl ships with systemd
#     anyway. Their absence never fails --check/--verify.
#   - Jammy's ffmpeg package is not required: ffmpeg is the managed runtime
#     above. xz-utils is required instead, to unpack its .tar.xz archive — a
#     minimal Ubuntu 22.04 image does not carry xz.
#
# Package post-install side effects (documented, distro-standard, never
# RateGuru-specific): installing these packages lets their maintainer
# scripts do what they always do on Ubuntu — postgresql-18 creates the
# default "main" cluster (via postgresql-common) and starts
# postgresql.service; nginx starts with the distribution default site;
# redis-server starts bound to localhost; php8.5-fpm starts with the
# distribution "www" pool; supervisor starts with an empty conf.d. None of
# that is RateGuru configuration: vhosts, pools, workers, databases, roles,
# users, directories and TLS all belong to the later installers and are never
# created here. This slice also never enables/disables/starts/stops any
# service itself — the one exception is restarting nginx after the security
# upgrade above — and never edits pg_hba.conf or any service configuration.
#
# Bootstrap ordering: a genuinely minimal Ubuntu 22.04 host has neither
# curl nor gnupg, yet both are needed to fetch and validate external
# repository keys. --apply therefore first ensures the bootstrap repository
# tooling (ca-certificates, curl, gnupg) is installed from the host's
# existing Ubuntu sources — before any external repository work — and only
# then fetches/validates/installs the PHP and PGDG sources.
#
# apt policy: --check/--verify never run apt-get at all (package state is
# read through dpkg-query). --apply runs apt-get update only when needed:
# once before installing missing bootstrap repository tooling, and once
# after repository configuration changed (or when runtime packages must be
# installed and the indexes were not just refreshed) — so a first clean-host
# apply performs at most two updates and an already-satisfied host performs
# none. A second --apply on a satisfied host runs no apt command, fetches
# no key material and rewrites no repository or keyring file (the local
# read-only keyring validation is the only gpg activity). apt-get upgrade/
# dist-upgrade/full-upgrade are never run. Installation is deterministic
# and noninteractive: DEBIAN_FRONTEND=noninteractive, -y,
# --no-install-recommends.
#
# Failure safety: repository configuration fails closed. Key material is
# fetched and validated in a private work directory; the real keyring and
# .sources files are only ever replaced by staging a complete candidate in
# the destination directory and renaming it into place. A repository that
# cannot be fetched/validated aborts the run before any package
# installation, and a previously working repository file is never deleted —
# the old file stays in place until its complete replacement is renamed
# over it.
#
# Test overrides: every RATEGURU_BOOTSTRAP_* override below is honored only
# alongside RATEGURU_ALLOW_TEST_OVERRIDES=true — the identical gate common,
# backup, bootstrap-host-preflight and every installer use — so a stray
# variable in a real shell can never redirect probes or mutation at
# attacker- or operator-controlled paths. Production execution ignores all
# of them.

set -Eeuo pipefail

# --- Locations ----------------------------------------------------------------

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

# --- Supported host contract ------------------------------------------------

# Kept in exact-token parity with bootstrap-host-preflight (architecture
# tests compare the two scripts); moving the baseline is a deliberate edit
# to both pins.
SUPPORTED_OS_ID="ubuntu"
SUPPORTED_OS_VERSION_ID="22.04"
SUPPORTED_OS_CODENAME="jammy"

# The only architecture proven by the staging baseline. This mutating
# installer fails closed on anything else (the read-only preflight merely
# warns — it never mutates, so it can afford to).
SUPPORTED_ARCHITECTURES="x86_64 amd64"

PHP_SERIES="8.5"
# The lowest PHP release the hosts may run. 8.5.13 (php.net, 2026-11-19)
# fixes the security flaws found after 8.5.12, among them CVE-2026-129289,
# request smuggling through PHP-FPM, and remote code execution in session
# handling; 8.5.12 (2026-10-22) had fixed two critical unauthenticated remote
# code execution flaws in the core, CVE-2026-109618 (GHSA-w8hw-w9fx-j79w,
# out-of-memory handling that leaves request data half-initialized while a
# multipart body is parsed) and CVE-2026-109619 (GHSA-6wmf-4rv5-p3rp,
# request-owned state used by the next request the same worker handles).
# Every earlier 8.5 release is exposed through PHP-FPM, which serves the
# public site. --apply meets it (reconcile_php_security_floor). Raise it with
# the next PHP security release, together with composer.json's php
# requirement; never lower it.
PHP_MIN_VERSION="8.5.13"
POSTGRES_MAJOR="18"

# The lowest nginx the hosts may run. nginx comes from the Ubuntu 22.04
# archive, which fixes a flaw without changing the upstream number — a
# patched build and an exploitable one both report nginx/1.18.0 — so the
# floor is the Ubuntu package revision, read from dpkg, never from
# `nginx -v`. It is read from the nginx package REQUIRED_PACKAGES already
# installs: on jammy that package requires its server (nginx-core, or another
# flavour) at exactly its own version, so its version is the binary's — and
# an nginx from nginx.org is itself a package named nginx, of the foreign
# numbering below, so it is caught here rather than replaced by an install. 1.18.0-6ubuntu14.24 (USN-9182-1,
# 2026-11-20) carries the fixes nginx 1.30.7 released on 2026-11-18 for the
# flaws these hosts are exposed to: CVE-2026-123007, HTTP/2 flow-control
# memory corruption that can run code (critical; needs nothing but HTTP/2,
# which the sites serve), CVE-2026-123633, an HTTP/2 use-after-free, and
# CVE-2026-118899, an endless loop reading a request body over TLS 1.3, which
# the listeners enable. Only the jammy series is proven: nginx from another
# source (nginx.org, a PPA) numbers its releases differently — 1.30.6 sorts
# above every 1.18.0 build and is still exposed — so it is a CONFLICT, never
# a pass. Raise it with the next Ubuntu nginx security update; never lower it.
NGINX_PACKAGE="nginx"
NGINX_PACKAGE_SERIES="1.18.0-6ubuntu"
NGINX_MIN_PACKAGE_VERSION="1.18.0-6ubuntu14.24"
# What one nginx release is on jammy, upgraded together when below the floor:
# the package the floor is read from, the server and the files they share
# (--only-upgrade skips any of them not installed). apt brings the module
# packages along, since the server requires them at exactly its own version.
NGINX_UPGRADE_PACKAGES=(nginx nginx-core nginx-common)

# --- RateGuru-owned repositories ----------------------------------------------

PHP_REPO_URI="https://ppa.launchpadcontent.net/ondrej/php/ubuntu"
PHP_REPO_SUITE="${SUPPORTED_OS_CODENAME}"
PHP_REPO_COMPONENT="main"
# Launchpad PPA signing key for ppa:ondrej/php.
PHP_REPO_KEY_FINGERPRINT="14AA40EC0831756756D7F66C4F4EA0AAE5267A6C"
PHP_REPO_KEY_URL="https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${PHP_REPO_KEY_FINGERPRINT}"

PGDG_REPO_URI="https://apt.postgresql.org/pub/repos/apt"
PGDG_REPO_SUITE="${SUPPORTED_OS_CODENAME}-pgdg"
PGDG_REPO_COMPONENT="main"
# PostgreSQL Global Development Group apt signing key (ACCC4CF8).
PGDG_REPO_KEY_FINGERPRINT="B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8"
PGDG_REPO_KEY_URL="https://www.postgresql.org/media/keys/ACCC4CF8.asc"

# --- Managed external runtime: rclone -----------------------------------------

# The official rclone release download origin. Deliberately a constant: the
# bootstrap controls exactly which release is installed, and neither the
# origin nor the version is ever discovered dynamically.
RCLONE_DOWNLOAD_BASE_URL="https://downloads.rclone.org"

# The pinned release, install contract and release-signing fingerprint live
# in the committed external-runtimes contract; the release-signing public
# key is committed next to it and is trusted only after it matches the
# pinned fingerprint.
RCLONE_CONTRACT_FILE_DEFAULT="${REPO_ROOT}/infrastructure/config/external-runtimes/versions.env"
RCLONE_SIGNING_KEY_FILE_DEFAULT="${REPO_ROOT}/infrastructure/config/external-runtimes/rclone-release-signing-key.asc"

# --- Managed external runtime: yt-dlp -----------------------------------------

# The official yt-dlp release origin. A constant, like rclone's: the release
# is the pinned one, never discovered.
YTDLP_DOWNLOAD_BASE_URL="https://github.com/yt-dlp/yt-dlp/releases/download"

# The pinned release and its install contract live in the same committed
# external-runtimes contract as rclone's; the release-signing public key is
# committed next to it and trusted only after it matches the pinned
# fingerprint.
YTDLP_SIGNING_KEY_FILE_DEFAULT="${REPO_ROOT}/infrastructure/config/external-runtimes/yt-dlp-release-signing-key.asc"

# --- Managed external runtime: ffmpeg -----------------------------------------

# BtbN/FFmpeg-Builds' release origin. A constant: the build is the pinned
# month-end autobuild, never "latest", never discovered.
FFMPEG_DOWNLOAD_BASE_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download"

# --- Required package contract ----------------------------------------------

# The smallest Ubuntu 22.04 package set supplying the clean-host bootstrap's canonical
# tool inventory (REQUIRED_BASE_TOOLS + RUNTIME_SERVICE_TOOLS in
# bootstrap-host-preflight) plus the runtime services and certbot tooling.
# rclone is deliberately NOT here: it is a managed external runtime binary
# (see the header and reconcile_rclone), never an apt package requirement.
# unzip is required because the pinned rclone release ships as a .zip.
# bind9-dnsutils supplies dig and openssl the openssl CLI: verifying the
# production mail identity reads public DNS and judges DKIM keys with them, on
# every run of infrastructure verification, so they are host runtime rather
# than something a read-only verification may install. xz-utils unpacks the
# pinned ffmpeg build (see the header).
BASE_PACKAGES=(
    acl
    bash
    bind9-dnsutils
    ca-certificates
    certbot
    coreutils
    cron
    curl
    diffutils
    findutils
    gnupg
    grep
    gzip
    hostname
    iproute2
    jq
    libc-bin
    mawk
    nftables
    nginx
    openssh-server
    openssl
    passwd
    procps
    redis-server
    rsync
    sed
    sudo
    supervisor
    tar
    unzip
    util-linux
    xz-utils
)

PHP_PACKAGES=()
for _php_component in cli common fpm bcmath curl gd intl mbstring pgsql redis xml zip; do
    PHP_PACKAGES+=("php${PHP_SERIES}-${_php_component}")
done
unset _php_component

POSTGRES_PACKAGES=(
    "postgresql-${POSTGRES_MAJOR}"
    "postgresql-client-${POSTGRES_MAJOR}"
    # Roaring bitmaps (pg_roaringbitmap, from PGDG): Analytics keeps the people
    # of each day as one, so a period's unique people are a union rather than
    # a sort of every visit. A plain extension — no preload, no restart;
    # install-target-database creates it in each target's database.
    "postgresql-${POSTGRES_MAJOR}-roaringbitmap"
)

# The tooling required to fetch and validate external repository keys — a
# subset of BASE_PACKAGES, installed first from the host's existing Ubuntu
# sources because a genuinely minimal host has none of it yet.
BOOTSTRAP_TOOLING_PACKAGES=(ca-certificates curl gnupg)

REQUIRED_PACKAGES=("${BASE_PACKAGES[@]}" "${PHP_PACKAGES[@]}" "${POSTGRES_PACKAGES[@]}")

# Modules verified through `php8.5 -m` — package presence alone proves
# nothing about what the CLI/FPM runtime actually loads.
REQUIRED_PHP_MODULES=(bcmath curl exif gd intl mbstring pcntl pdo_pgsql pgsql redis xml zip)

# Binaries the installed packages must supply, verified by lookup
# ("tool:package" — the package named is where the tool comes from).
REQUIRED_RUNTIME_TOOLS=(
    setfacl:acl
    getfacl:acl
    certbot:certbot
    cron:cron
    curl:curl
    cmp:diffutils
    diff:diffutils
    find:findutils
    gpg:gnupg
    grep:grep
    gzip:gzip
    hostname:hostname
    ss:iproute2
    ip:iproute2
    jq:jq
    dig:bind9-dnsutils
    openssl:openssl
    getent:libc-bin
    awk:mawk
    nft:nftables
    nginx:nginx
    sshd:openssh-server
    useradd:passwd
    redis-server:redis-server
    rsync:rsync
    sed:sed
    sudo:sudo
    visudo:sudo
    supervisord:supervisor
    tar:tar
    unzip:unzip
    flock:util-linux
    namei:util-linux
    runuser:util-linux
    xz:xz-utils
)

# --- Test override gate -----------------------------------------------------

rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

# gated_default VAR_NAME DEFAULT — echoes the gated override when allowed and
# set, the default otherwise.
gated_default() {
    local var_name="$1" default_value="$2"

    if rateguru_test_overrides_allowed && [[ -n "${!var_name:-}" ]]; then
        printf '%s\n' "${!var_name}"
    else
        printf '%s\n' "${default_value}"
    fi
}

OS_RELEASE_FILE="$(gated_default RATEGURU_BOOTSTRAP_OS_RELEASE_FILE /etc/os-release)"
ARCH_VALUE="$(gated_default RATEGURU_BOOTSTRAP_ARCH "$(uname -m 2>/dev/null || printf 'unknown')")"
EFFECTIVE_UID="$(gated_default RATEGURU_BOOTSTRAP_EUID "${EUID}")"

APT_SOURCES_MAIN="$(gated_default RATEGURU_BOOTSTRAP_APT_SOURCES_MAIN /etc/apt/sources.list)"
APT_SOURCES_DIR="$(gated_default RATEGURU_BOOTSTRAP_APT_SOURCES_DIR /etc/apt/sources.list.d)"
APT_KEYRINGS_DIR="$(gated_default RATEGURU_BOOTSTRAP_APT_KEYRINGS_DIR /etc/apt/keyrings)"

# Empty means "resolve through the real PATH" / "use the real command".
TOOL_PATH="$(gated_default RATEGURU_BOOTSTRAP_TOOL_PATH '')"
APT_GET_BIN="$(gated_default RATEGURU_BOOTSTRAP_APT_GET_BIN apt-get)"
DPKG_QUERY_BIN="$(gated_default RATEGURU_BOOTSTRAP_DPKG_QUERY_BIN dpkg-query)"

# Deliberately NOT override-gated: curl and gpg must resolve through the
# same PATH discipline as every tool probe, so a simulated host without
# them genuinely has no way to fetch or validate keys — the bootstrap
# tooling ordering below is what makes them exist, and tests must prove
# that, not bypass it.
GPG_BIN="gpg"
CURL_BIN="curl"

PHP_CLI_BIN="$(gated_default RATEGURU_BOOTSTRAP_PHP_CLI_BIN "php${PHP_SERIES}")"
PHP_FPM_BIN="$(gated_default RATEGURU_BOOTSTRAP_PHP_FPM_BIN "php-fpm${PHP_SERIES}")"
PSQL_BIN="$(gated_default RATEGURU_BOOTSTRAP_PSQL_BIN psql)"
PG_DUMP_BIN="$(gated_default RATEGURU_BOOTSTRAP_PG_DUMP_BIN pg_dump)"
PG_RESTORE_BIN="$(gated_default RATEGURU_BOOTSTRAP_PG_RESTORE_BIN pg_restore)"
# Used only to finish an nginx upgrade this run made (see
# reconcile_nginx_security_floor).
NGINX_BIN="$(gated_default RATEGURU_BOOTSTRAP_NGINX_BIN nginx)"
SYSTEMCTL_BIN="$(gated_default RATEGURU_BOOTSTRAP_SYSTEMCTL_BIN systemctl)"
# Where the running nginx master's PID and executable are read
# (nginx_runs_replaced_binary).
NGINX_PID_FILE="$(gated_default RATEGURU_BOOTSTRAP_NGINX_PID_FILE /run/nginx.pid)"
# PHP-FPM's master and the supervised PHP workers (reconcile_php_security_floor).
PHP_FPM_PID_FILE="$(gated_default RATEGURU_BOOTSTRAP_PHP_FPM_PID_FILE "/run/php/php${PHP_SERIES}-fpm.pid")"
SUPERVISORCTL_BIN="$(gated_default RATEGURU_BOOTSTRAP_SUPERVISORCTL_BIN supervisorctl)"
PROC_ROOT="$(gated_default RATEGURU_BOOTSTRAP_PROC_ROOT /proc)"

STAT_BIN="$(gated_default RATEGURU_BOOTSTRAP_STAT_BIN stat)"
RCLONE_CONTRACT_FILE="$(gated_default RATEGURU_BOOTSTRAP_RCLONE_CONTRACT_FILE "${RCLONE_CONTRACT_FILE_DEFAULT}")"
RCLONE_SIGNING_KEY_FILE="$(gated_default RATEGURU_BOOTSTRAP_RCLONE_KEY_FILE "${RCLONE_SIGNING_KEY_FILE_DEFAULT}")"
YTDLP_SIGNING_KEY_FILE="$(gated_default RATEGURU_BOOTSTRAP_YTDLP_KEY_FILE "${YTDLP_SIGNING_KEY_FILE_DEFAULT}")"

# rclone_contract_value KEY — the value of the first KEY=VALUE line in the
# committed external-runtimes contract, which every managed external runtime
# (rclone, yt-dlp) shares. Plain text extraction in one awk pass — the
# contract is never sourced, never eval'd.
rclone_contract_value() {
    local key="$1"

    [[ -r "${RCLONE_CONTRACT_FILE}" ]] || return 1

    awk -v prefix="${key}=" \
        'index($0, prefix) == 1 { print substr($0, length(prefix) + 1); exit }' \
        "${RCLONE_CONTRACT_FILE}"
}

RCLONE_VERSION="$(rclone_contract_value RCLONE_VERSION || true)"
RCLONE_PLATFORM="$(rclone_contract_value RCLONE_PLATFORM || true)"
RCLONE_BINARY_PATH="$(rclone_contract_value RCLONE_BINARY || true)"
RCLONE_OWNER="$(rclone_contract_value RCLONE_OWNER || true)"
RCLONE_GROUP="$(rclone_contract_value RCLONE_GROUP || true)"
RCLONE_MODE="$(rclone_contract_value RCLONE_MODE || true)"
RCLONE_KEY_FINGERPRINT="$(rclone_contract_value RCLONE_RELEASE_SIGNING_FINGERPRINT || true)"

# The contract is only usable when every field is present and well-formed —
# a truncated or hand-mangled contract must fail closed, never install
# "whatever was parseable".
rclone_contract_valid() {
    [[ "${RCLONE_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
        && [[ "${RCLONE_PLATFORM}" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        && [[ "${RCLONE_BINARY_PATH}" == /* ]] \
        && [[ -n "${RCLONE_OWNER}" ]] \
        && [[ -n "${RCLONE_GROUP}" ]] \
        && [[ "${RCLONE_MODE}" =~ ^0[0-7]{3}$ ]] \
        && [[ "${RCLONE_KEY_FINGERPRINT}" =~ ^[0-9A-F]{40}$ ]]
}

YTDLP_VERSION="$(rclone_contract_value YTDLP_VERSION || true)"
YTDLP_ARTIFACT="$(rclone_contract_value YTDLP_ARTIFACT || true)"
YTDLP_BINARY_PATH="$(rclone_contract_value YTDLP_BINARY || true)"
YTDLP_OWNER="$(rclone_contract_value YTDLP_OWNER || true)"
YTDLP_GROUP="$(rclone_contract_value YTDLP_GROUP || true)"
YTDLP_MODE="$(rclone_contract_value YTDLP_MODE || true)"
YTDLP_KEY_FINGERPRINT="$(rclone_contract_value YTDLP_RELEASE_SIGNING_FINGERPRINT || true)"

# yt-dlp releases are dated (2026.11.23), with a fourth number for a second
# release on the same day. Like rclone's, a contract missing or mangling any
# field fails closed.
ytdlp_contract_valid() {
    [[ "${YTDLP_VERSION}" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}(\.[0-9]+)?$ ]] \
        && [[ "${YTDLP_ARTIFACT}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
        && [[ "${YTDLP_BINARY_PATH}" == /* ]] \
        && [[ -n "${YTDLP_OWNER}" ]] \
        && [[ -n "${YTDLP_GROUP}" ]] \
        && [[ "${YTDLP_MODE}" =~ ^0[0-7]{3}$ ]] \
        && [[ "${YTDLP_KEY_FINGERPRINT}" =~ ^[0-9A-F]{40}$ ]]
}

FFMPEG_VERSION="$(rclone_contract_value FFMPEG_VERSION || true)"
FFMPEG_RELEASE="$(rclone_contract_value FFMPEG_RELEASE || true)"
FFMPEG_ARTIFACT="$(rclone_contract_value FFMPEG_ARTIFACT || true)"
FFMPEG_SHA256="$(rclone_contract_value FFMPEG_SHA256 || true)"
FFMPEG_BIN_DIR="$(rclone_contract_value FFMPEG_BIN_DIR || true)"
FFMPEG_OWNER="$(rclone_contract_value FFMPEG_OWNER || true)"
FFMPEG_GROUP="$(rclone_contract_value FFMPEG_GROUP || true)"
FFMPEG_MODE="$(rclone_contract_value FFMPEG_MODE || true)"

# The version is what the build itself prints after "ffmpeg version"; the
# digest is the trust anchor, so it must be a whole SHA-256.
ffmpeg_contract_valid() {
    [[ "${FFMPEG_VERSION}" =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]] \
        && [[ "${FFMPEG_RELEASE}" =~ ^autobuild-[0-9]{4}(-[0-9]{2}){4}$ ]] \
        && [[ "${FFMPEG_ARTIFACT}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.tar\.xz$ ]] \
        && [[ "${FFMPEG_SHA256}" =~ ^[0-9a-f]{64}$ ]] \
        && [[ "${FFMPEG_BIN_DIR}" == /* ]] \
        && [[ -n "${FFMPEG_OWNER}" ]] \
        && [[ -n "${FFMPEG_GROUP}" ]] \
        && [[ "${FFMPEG_MODE}" =~ ^0[0-7]{3}$ ]]
}

PHP_REPO_SOURCES_FILE="${APT_SOURCES_DIR}/rateguru-php.sources"
PHP_REPO_KEYRING_FILE="${APT_KEYRINGS_DIR}/rateguru-php.gpg"
PGDG_REPO_SOURCES_FILE="${APT_SOURCES_DIR}/rateguru-pgdg.sources"
PGDG_REPO_KEYRING_FILE="${APT_KEYRINGS_DIR}/rateguru-pgdg.gpg"

# --- Output -----------------------------------------------------------------

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

MODE=""
MODE_SEEN=false

COUNT_PASS=0
COUNT_MISSING=0
COUNT_WARN=0
COUNT_CONFLICT=0

section() {
    printf '\n%s\n' "$1"
}

# item STATUS NAME DETAIL [ACTION]
#
# One report line, identical in shape to bootstrap-host-preflight. ACTION is
# the intended --apply action, printed only by --check and only for non-PASS
# items. Output is deterministic: no timestamps, no ordering surprises.
item() {
    local status="$1" name="$2" detail="$3" action="${4:-}"

    case "${status}" in
        PASS)     COUNT_PASS=$((COUNT_PASS + 1)) ;;
        MISSING)  COUNT_MISSING=$((COUNT_MISSING + 1)) ;;
        WARN)     COUNT_WARN=$((COUNT_WARN + 1)) ;;
        CONFLICT) COUNT_CONFLICT=$((COUNT_CONFLICT + 1)) ;;
        *)        fail "internal: unknown item status: ${status}" ;;
    esac

    printf '  %-8s %s — %s\n' "${status}" "${name}" "${detail}"

    if [[ "${MODE}" == check ]] && [[ "${status}" != PASS ]] && [[ -n "${action}" ]]; then
        printf '           -> apply: %s\n' "${action}"
    fi
}

# action MESSAGE — one --apply progress line. Deterministic, no timestamps.
action() {
    printf 'APPLY    %s\n' "$*"
}

usage() {
    cat <<'USAGE'
Usage:
  install-bootstrap-runtime --check
  install-bootstrap-runtime --apply
  install-bootstrap-runtime --verify
  install-bootstrap-runtime --help

  --check   Read-only install-bootstrap-runtime contract validation plus the intended
            --apply action for every unsatisfied item. Never runs apt-get,
            never installs anything. Exits 0 only when the contract is
            already satisfied.
  --apply   Root only. Idempotently configures the RateGuru-owned PHP PPA
            and PGDG repositories, installs missing required packages,
            upgrades an nginx below its security floor (its packages only,
            then restarts nginx), and ends with the full --verify report.
            Never upgrades anything else, never removes, never touches
            users/directories/other services/RateGuru configuration.
  --verify  Read-only install-bootstrap-runtime contract gate: exit 0 only when every
            repository, package, binary, PHP module and client-version
            requirement holds.

Repository/package scope only: users, groups, filesystem, databases,
service configuration and TLS belong to later bootstrap installers.
USAGE
}

# --- Probes -----------------------------------------------------------------

# tool_available NAME — command lookup, constrained to the fixture PATH when
# the gated override is active. The real lookup appends /usr/sbin:/sbin so
# non-root --check/--verify still see daemon binaries (sshd, nginx, ...).
tool_available() {
    local tool="$1"

    if [[ -n "${TOOL_PATH}" ]]; then
        PATH="${TOOL_PATH}" command -v -- "${tool}" >/dev/null 2>&1
    else
        PATH="${PATH}:/usr/sbin:/sbin" command -v -- "${tool}" >/dev/null 2>&1
    fi
}

# probe_exec BIN [ARGS...] — executes a probe binary under the same PATH
# discipline tool_available uses, so bare tool names resolve identically.
probe_exec() {
    if [[ -n "${TOOL_PATH}" ]]; then
        PATH="${TOOL_PATH}" "$@"
    else
        PATH="${PATH}:/usr/sbin:/sbin" "$@"
    fi
}

# tool_path NAME — the resolved path of a tool under the same PATH
# discipline as tool_available; empty output and non-zero when absent.
tool_path() {
    local tool="$1"

    if [[ -n "${TOOL_PATH}" ]]; then
        PATH="${TOOL_PATH}" command -v -- "${tool}" 2>/dev/null
    else
        PATH="${PATH}:/usr/sbin:/sbin" command -v -- "${tool}" 2>/dev/null
    fi
}

# os_release_field KEY — value of KEY from the os-release file, unquoted.
os_release_field() {
    local key="$1"

    [[ -r "${OS_RELEASE_FILE}" ]] || return 1

    sed -n "s/^${key}=//p" "${OS_RELEASE_FILE}" | head -n 1 | tr -d '"'
}

architecture_supported() {
    local arch
    for arch in ${SUPPORTED_ARCHITECTURES}; do
        [[ "${ARCH_VALUE}" == "${arch}" ]] && return 0
    done

    return 1
}

# package_installed NAME — dpkg database state, read-only. Anything but
# "installed" (including an unknown package) counts as not installed.
package_installed() {
    local package="$1" state

    state="$(probe_exec "${DPKG_QUERY_BIN}" -W -f "\${db:Status-Status}" -- "${package}" 2>/dev/null)" || return 1

    [[ "${state}" == installed ]]
}

# apt_source_configured URI SUITE — true when any existing apt source
# already provides the repository, in either the classic one-line format or
# deb822. Matching is scheme-agnostic on the URI body so however the
# operator originally added the repository (http/https, .list or .sources,
# any file name) it is recognized and left alone.
apt_source_configured() {
    local uri="$1" suite="$2"
    local uri_body="${uri#*://}"
    local file

    for file in "${APT_SOURCES_MAIN}" "${APT_SOURCES_DIR}"/*.list; do
        [[ -r "${file}" ]] || continue

        if awk -v uri="${uri_body}" -v suite="${suite}" '
            /^[[:space:]]*#/ { next }
            /^[[:space:]]*deb(-src)?[[:space:]]/ && index($0, uri) > 0 {
                for (i = 3; i <= NF; i++) if ($i == suite) { found = 1; exit }
            }
            END { exit !found }
        ' "${file}"; then
            return 0
        fi
    done

    for file in "${APT_SOURCES_DIR}"/*.sources; do
        [[ -r "${file}" ]] || continue

        if awk -v uri="${uri_body}" -v suite="${suite}" '
            /^[[:space:]]*#/ { next }
            /^URIs:/ && index($0, uri) > 0 { have_uri = 1 }
            /^Suites:/ { for (i = 2; i <= NF; i++) if ($i == suite) have_suite = 1 }
            END { exit !(have_uri && have_suite) }
        ' "${file}"; then
            return 0
        fi
    done

    return 1
}

# keyring_matches_pin KEYRING_FILE FINGERPRINT — read-only, local-only
# OpenPGP validation: true only when the file is a valid keyring containing
# exactly one primary key whose fingerprint equals the pin. The single
# validation used both on freshly fetched material during --apply and on
# the installed keyring during --check/--verify — never a network call.
keyring_matches_pin() {
    local keyring_file="$1" key_fingerprint="$2"

    [[ -s "${keyring_file}" ]] || return 1
    tool_available "${GPG_BIN}" || return 1

    probe_exec "${GPG_BIN}" --batch --show-keys --with-colons "${keyring_file}" 2>/dev/null \
        | awk -F: -v pin="${key_fingerprint}" '
            $1 == "pub" { pubs++; expect_fpr = 1; next }
            $1 == "fpr" && expect_fpr { primary = $10; expect_fpr = 0 }
            END { exit !(pubs == 1 && primary == pin) }
        '
}

# sources_file_content LABEL URI SUITE COMPONENT KEYRING — the exact deb822
# content this installer owns for one repository.
sources_file_content() {
    local label="$1" uri="$2" suite="$3" component="$4" keyring="$5"

    cat <<CONTENT
# RateGuru ${label} repository — managed by install-bootstrap-runtime
#. Do not edit: re-run --apply to reconcile.
Types: deb
URIs: ${uri}
Suites: ${suite}
Components: ${component}
Architectures: amd64
Signed-By: ${keyring}
CONTENT
}

# --- Managed rclone runtime probes -------------------------------------------

# rclone_stat_probe PATH — "OWNER|GROUP|MODE" for an existing path, fails
# when absent or unreadable. Never dereferenced further, never recursive.
rclone_stat_probe() {
    probe_exec "${STAT_BIN}" -c '%U|%G|%a' -- "$1" 2>/dev/null
}

# rclone_reported_version BIN — "v1.75.0" from the first line of
# `BIN --version` ("rclone v1.75.0 ..."); empty when the binary cannot
# report a version at all.
rclone_reported_version() {
    probe_exec "$1" --version 2>/dev/null | head -n 1 | awk '$1 == "rclone" { print $2 }'
}

# rclone_state — classifies the installed binary against the pinned
# contract. Prints exactly one of:
#   compliant | absent | foreign:<path> | not-file | no-stat |
#   owner:<o>:<g> | mode:<m> | no-version | version:<v>
# Checked in contract order: path, owner/group, mode, version. dpkg
# ownership is deliberately never consulted — an operator-installed
# standalone binary that matches the contract is fully compliant.
rclone_state() {
    if [[ ! -e "${RCLONE_BINARY_PATH}" ]]; then
        local found
        found="$(tool_path rclone || true)"

        if [[ -n "${found}" ]]; then
            printf 'foreign:%s\n' "${found}"
        else
            printf 'absent\n'
        fi

        return 0
    fi

    # A directory (or a link to one) where the binary belongs is never
    # replaced: mv would drop the new binary inside it.
    if [[ -d "${RCLONE_BINARY_PATH}" ]]; then
        printf 'not-file\n'

        return 0
    fi

    local probe owner group mode
    if ! probe="$(rclone_stat_probe "${RCLONE_BINARY_PATH}")"; then
        printf 'no-stat\n'

        return 0
    fi
    IFS='|' read -r owner group mode <<<"${probe}"

    if [[ "${owner}" != "${RCLONE_OWNER}" ]] || [[ "${group}" != "${RCLONE_GROUP}" ]]; then
        printf 'owner:%s:%s\n' "${owner}" "${group}"

        return 0
    fi

    # stat %a prints modes without a leading zero; compare numerically so
    # 755 and 0755 never masquerade as drift.
    if (( 8#${mode} != 8#${RCLONE_MODE} )); then
        printf 'mode:%s\n' "${mode}"

        return 0
    fi

    local version
    version="$(rclone_reported_version "${RCLONE_BINARY_PATH}" || true)"

    if [[ ! "${version}" =~ ^v[0-9]+(\.[0-9]+){2}$ ]]; then
        printf 'no-version\n'

        return 0
    fi

    if [[ "${version}" != "v${RCLONE_VERSION}" ]]; then
        printf 'version:%s\n' "${version}"

        return 0
    fi

    printf 'compliant\n'
}

# ytdlp_reported_version BIN — "2026.11.23", the whole first line of
# `BIN --version`; empty when the binary cannot report a version at all.
# The standalone executable unpacks its bundled Python into a temporary
# directory of its own for the run and removes it afterwards — the only
# effect asking it for a version has.
ytdlp_reported_version() {
    probe_exec "$1" --version 2>/dev/null | head -n 1 | tr -d '[:space:]'
}

# ytdlp_state — classifies the installed yt-dlp against the pinned contract,
# in the same terms and the same order as rclone_state: path, owner/group,
# mode, version. Prints exactly one of:
#   compliant | absent | foreign:<path> | not-file | no-stat |
#   owner:<o>:<g> | mode:<m> | no-version | version:<v>
ytdlp_state() {
    if [[ ! -e "${YTDLP_BINARY_PATH}" ]]; then
        local found
        found="$(tool_path yt-dlp || true)"

        if [[ -n "${found}" ]]; then
            printf 'foreign:%s\n' "${found}"
        else
            printf 'absent\n'
        fi

        return 0
    fi

    # A directory (or a link to one) where the binary belongs is never
    # replaced: mv would drop the new binary inside it.
    if [[ -d "${YTDLP_BINARY_PATH}" ]]; then
        printf 'not-file\n'

        return 0
    fi

    local probe owner group mode
    if ! probe="$(rclone_stat_probe "${YTDLP_BINARY_PATH}")"; then
        printf 'no-stat\n'

        return 0
    fi
    IFS='|' read -r owner group mode <<<"${probe}"

    if [[ "${owner}" != "${YTDLP_OWNER}" ]] || [[ "${group}" != "${YTDLP_GROUP}" ]]; then
        printf 'owner:%s:%s\n' "${owner}" "${group}"

        return 0
    fi

    if (( 8#${mode} != 8#${YTDLP_MODE} )); then
        printf 'mode:%s\n' "${mode}"

        return 0
    fi

    local version
    version="$(ytdlp_reported_version "${YTDLP_BINARY_PATH}" || true)"

    if [[ ! "${version}" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}(\.[0-9]+)?$ ]]; then
        printf 'no-version\n'

        return 0
    fi

    if [[ "${version}" != "${YTDLP_VERSION}" ]]; then
        printf 'version:%s\n' "${version}"

        return 0
    fi

    printf 'compliant\n'
}

# ffmpeg_reported_version BIN TOOL — the version token of `BIN -version`'s
# first line ("ffmpeg version n8.1.3-27-g8dca1586f4-20261031 Copyright ...");
# empty when the binary cannot report one.
ffmpeg_reported_version() {
    probe_exec "$1" -hide_banner -version 2>/dev/null | head -n 1 \
        | awk -v tool="$2" '$1 == tool && $2 == "version" { print $3 }'
}

# ffmpeg_tool_state TOOL — one of the two managed binaries against the
# contract, in rclone_state's order. Prints exactly one of:
#   compliant | absent | not-file | no-stat | owner:<o>:<g> | mode:<m> |
#   no-version | version:<v>
ffmpeg_tool_state() {
    local tool="$1"
    local path="${FFMPEG_BIN_DIR}/${tool}"

    if [[ ! -e "${path}" ]]; then
        printf 'absent\n'

        return 0
    fi

    if [[ -d "${path}" ]]; then
        printf 'not-file\n'

        return 0
    fi

    local probe owner group mode
    if ! probe="$(rclone_stat_probe "${path}")"; then
        printf 'no-stat\n'

        return 0
    fi
    IFS='|' read -r owner group mode <<<"${probe}"

    if [[ "${owner}" != "${FFMPEG_OWNER}" ]] || [[ "${group}" != "${FFMPEG_GROUP}" ]]; then
        printf 'owner:%s:%s\n' "${owner}" "${group}"

        return 0
    fi

    if (( 8#${mode} != 8#${FFMPEG_MODE} )); then
        printf 'mode:%s\n' "${mode}"

        return 0
    fi

    local version
    version="$(ffmpeg_reported_version "${path}" "${tool}" || true)"

    if [[ -z "${version}" ]]; then
        printf 'no-version\n'

        return 0
    fi

    if [[ "${version}" != "${FFMPEG_VERSION}" ]]; then
        printf 'version:%s\n' "${version}"

        return 0
    fi

    printf 'compliant\n'
}

# ffmpeg_state — the pair against the contract. Prints compliant, absent
# (neither binary at FFMPEG_BIN_DIR), foreign:<path> (neither, but an ffmpeg
# elsewhere on PATH — Jammy's package, on a host prepared before the
# managed build), or the first unsatisfied binary as <state>@<tool>[:<detail>],
# e.g. version@ffprobe:4.4.2-0ubuntu0.22.04.1 or absent@ffprobe.
ffmpeg_state() {
    local ffmpeg_tool ffprobe_tool
    ffmpeg_tool="$(ffmpeg_tool_state ffmpeg)"
    ffprobe_tool="$(ffmpeg_tool_state ffprobe)"

    # A directory where either binary belongs comes first, whatever the other
    # one's state: reported as anything else, --apply would download and its
    # rename would drop the new binary inside that directory.
    if [[ "${ffmpeg_tool}" == not-file ]]; then
        printf 'not-file@ffmpeg\n'

        return 0
    fi

    if [[ "${ffprobe_tool}" == not-file ]]; then
        printf 'not-file@ffprobe\n'

        return 0
    fi

    if [[ "${ffmpeg_tool}" == absent ]] && [[ "${ffprobe_tool}" == absent ]]; then
        local found
        found="$(tool_path ffmpeg || true)"

        if [[ -n "${found}" ]]; then
            printf 'foreign:%s\n' "${found}"
        else
            printf 'absent\n'
        fi

        return 0
    fi

    local tool state
    for tool in ffmpeg ffprobe; do
        if [[ "${tool}" == ffmpeg ]]; then state="${ffmpeg_tool}"; else state="${ffprobe_tool}"; fi
        [[ "${state}" == compliant ]] && continue

        if [[ "${state}" == *:* ]]; then
            printf '%s@%s:%s\n' "${state%%:*}" "${tool}" "${state#*:}"
        else
            printf '%s@%s\n' "${state}" "${tool}"
        fi

        return 0
    done

    printf 'compliant\n'
}

# --- Report sections (shared by --check and --verify) -----------------------

report_host() {
    section "HOST"

    local os_id os_version
    os_id="$(os_release_field ID || true)"
    os_version="$(os_release_field VERSION_ID || true)"

    if [[ ! -r "${OS_RELEASE_FILE}" ]]; then
        item MISSING "os-release" "cannot read ${OS_RELEASE_FILE}; supported baseline is ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID}" \
            "provision a ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID} host — never installable by this script"
    elif [[ "${os_id}" != "${SUPPORTED_OS_ID}" ]]; then
        item CONFLICT "os-release" "unsupported OS family ID=${os_id:-unknown} (supported: ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID} only)" \
            "unsupported host — reprovision on ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID}"
    elif [[ "${os_version}" != "${SUPPORTED_OS_VERSION_ID}" ]]; then
        item CONFLICT "os-release" "ID=${os_id} VERSION_ID=${os_version:-unknown} is not the supported baseline ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID}" \
            "unsupported release — the baseline moves only by deliberately editing both version pins"
    else
        item PASS "os-release" "ID=${os_id} VERSION_ID=${os_version} (supported baseline)"
    fi

    if architecture_supported; then
        item PASS "architecture" "${ARCH_VALUE} (supported: ${SUPPORTED_ARCHITECTURES})"
    else
        item CONFLICT "architecture" "${ARCH_VALUE} is not a supported architecture (supported: ${SUPPORTED_ARCHITECTURES})" \
            "unsupported architecture — this installer never mutates unproven platforms"
    fi

    if tool_available apt-get && tool_available dpkg; then
        item PASS "apt-dpkg" "apt-get and dpkg available"
    else
        item MISSING "apt-dpkg" "apt-get/dpkg not available — package bootstrap impossible" \
            "unsupported without apt — reprovision on the ${SUPPORTED_OS_ID} baseline"
    fi

    if [[ "${EFFECTIVE_UID}" == "0" ]]; then
        item PASS "effective-uid" "0 (root — --apply available)"
    else
        item WARN "effective-uid" "${EFFECTIVE_UID} (not root — ${MODE} is read-only; --apply requires root)" \
            "run --apply as root"
    fi
}

# report_repository LABEL URI SUITE COMPONENT KEY_FPR SOURCES_FILE KEYRING_FILE
#
# Installer-owned files are validated authoritatively and read-only: the
# .sources file must be byte-exact against the composed expectation, and
# the keyring must hold exactly the pinned key (keyring_matches_pin — a
# local gpg inspection, never a fetch). Anything less is CONFLICT.
report_repository() {
    local label="$1" uri="$2" suite="$3" component="$4"
    local key_fingerprint="$5" sources_file="$6" keyring_file="$7"

    if [[ -f "${sources_file}" ]]; then
        local expected_content
        expected_content="$(sources_file_content "${label}" "${uri}" "${suite}" "${component}" "${keyring_file}")"

        if ! printf '%s\n' "${expected_content}" | cmp -s - "${sources_file}"; then
            item CONFLICT "repo:${label}" "installer-owned ${sources_file} drifted from the expected deb822 content" \
                "re-run --apply to reconcile the ${label} repository transactionally"
        elif ! keyring_matches_pin "${keyring_file}" "${key_fingerprint}"; then
            item CONFLICT "repo:${label}" "keyring ${keyring_file} is absent, invalid, or does not hold exactly the pinned key ${key_fingerprint}" \
                "re-run --apply to reinstall the ${label} repository transactionally"
        else
            item PASS "repo:${label}" "configured by this installer (exact sources, keyring matches pinned ${key_fingerprint})"
        fi
    elif apt_source_configured "${uri}" "${suite}"; then
        item PASS "repo:${label}" "provided by a pre-existing apt source (${uri#*://} ${suite}) — left untouched"
    else
        item MISSING "repo:${label}" "no apt source provides ${uri#*://} ${suite}" \
            "install ${sources_file} and its pinned keyring"
    fi
}

report_repositories() {
    section "REPOSITORIES"

    report_repository php "${PHP_REPO_URI}" "${PHP_REPO_SUITE}" "${PHP_REPO_COMPONENT}" \
        "${PHP_REPO_KEY_FINGERPRINT}" "${PHP_REPO_SOURCES_FILE}" "${PHP_REPO_KEYRING_FILE}"
    report_repository pgdg "${PGDG_REPO_URI}" "${PGDG_REPO_SUITE}" "${PGDG_REPO_COMPONENT}" \
        "${PGDG_REPO_KEY_FINGERPRINT}" "${PGDG_REPO_SOURCES_FILE}" "${PGDG_REPO_KEYRING_FILE}"
}

report_packages() {
    section "PACKAGES"

    local package
    for package in "${REQUIRED_PACKAGES[@]}"; do
        if package_installed "${package}"; then
            item PASS "package:${package}" "installed"
        else
            item MISSING "package:${package}" "not installed" \
                "apt-get install ${package}"
        fi
    done
}

# The managed external runtime section — deliberately separate from
# PACKAGES: rclone is never an apt requirement, so its absence must never
# surface as "MISSING package:rclone" or propose any apt action.
report_external_runtime() {
    section "EXTERNAL RUNTIME"

    report_rclone_runtime
    report_ytdlp_runtime
    report_ffmpeg_runtime
}

report_rclone_runtime() {
    if ! rclone_contract_valid; then
        item CONFLICT "rclone" "external-runtimes contract unreadable or incomplete: ${RCLONE_CONTRACT_FILE}" \
            "restore the committed contract from the repository — never editable on the host"

        return 0
    fi

    local state
    state="$(rclone_state)"

    case "${state}" in
        compliant)
            item PASS "rclone" "v${RCLONE_VERSION}, ${RCLONE_BINARY_PATH}, ${RCLONE_OWNER}:${RCLONE_GROUP} ${RCLONE_MODE} (managed external runtime)"
            ;;
        absent)
            item MISSING "rclone" "${RCLONE_BINARY_PATH} absent" \
                "install verified rclone v${RCLONE_VERSION}"
            ;;
        foreign:*)
            item CONFLICT "rclone" "found at ${state#foreign:}, but the managed binary path is ${RCLONE_BINARY_PATH}" \
                "install verified rclone v${RCLONE_VERSION} at ${RCLONE_BINARY_PATH} (the unexpected copy is never touched)"
            ;;
        not-file)
            item CONFLICT "rclone" "${RCLONE_BINARY_PATH} is a directory, not the binary" \
                "move it aside by hand, then re-run --apply"
            ;;
        no-stat)
            item CONFLICT "rclone" "cannot stat ${RCLONE_BINARY_PATH}" \
                "investigate the binary manually, then re-run --apply"
            ;;
        owner:*)
            item CONFLICT "rclone" "owned by ${state#owner:}, required ${RCLONE_OWNER}:${RCLONE_GROUP}" \
                "replace with verified rclone v${RCLONE_VERSION}"
            ;;
        mode:*)
            item CONFLICT "rclone" "mode ${state#mode:}, required ${RCLONE_MODE}" \
                "replace with verified rclone v${RCLONE_VERSION}"
            ;;
        no-version)
            item CONFLICT "rclone" "${RCLONE_BINARY_PATH} cannot report a version" \
                "replace with verified rclone v${RCLONE_VERSION}"
            ;;
        version:*)
            item CONFLICT "rclone" "${state#version:} installed, required v${RCLONE_VERSION}" \
                "replace with verified rclone v${RCLONE_VERSION}"
            ;;
        *)
            fail "internal: unknown rclone state: ${state}"
            ;;
    esac
}

report_ytdlp_runtime() {
    if ! ytdlp_contract_valid; then
        item CONFLICT "yt-dlp" "external-runtimes contract unreadable or incomplete: ${RCLONE_CONTRACT_FILE}" \
            "restore the committed contract from the repository — never editable on the host"

        return 0
    fi

    local state
    state="$(ytdlp_state)"

    case "${state}" in
        compliant)
            item PASS "yt-dlp" "${YTDLP_VERSION}, ${YTDLP_BINARY_PATH}, ${YTDLP_OWNER}:${YTDLP_GROUP} ${YTDLP_MODE} (managed external runtime)"
            ;;
        absent)
            item MISSING "yt-dlp" "${YTDLP_BINARY_PATH} absent" \
                "install verified yt-dlp ${YTDLP_VERSION}"
            ;;
        foreign:*)
            item CONFLICT "yt-dlp" "found at ${state#foreign:}, but the managed binary path is ${YTDLP_BINARY_PATH}" \
                "install verified yt-dlp ${YTDLP_VERSION} at ${YTDLP_BINARY_PATH} (the unexpected copy is never touched)"
            ;;
        not-file)
            item CONFLICT "yt-dlp" "${YTDLP_BINARY_PATH} is a directory, not the binary" \
                "move it aside by hand, then re-run --apply"
            ;;
        no-stat)
            item CONFLICT "yt-dlp" "cannot stat ${YTDLP_BINARY_PATH}" \
                "investigate the binary manually, then re-run --apply"
            ;;
        owner:*)
            item CONFLICT "yt-dlp" "owned by ${state#owner:}, required ${YTDLP_OWNER}:${YTDLP_GROUP}" \
                "replace with verified yt-dlp ${YTDLP_VERSION}"
            ;;
        mode:*)
            item CONFLICT "yt-dlp" "mode ${state#mode:}, required ${YTDLP_MODE}" \
                "replace with verified yt-dlp ${YTDLP_VERSION}"
            ;;
        no-version)
            item CONFLICT "yt-dlp" "${YTDLP_BINARY_PATH} cannot report a version" \
                "replace with verified yt-dlp ${YTDLP_VERSION}"
            ;;
        version:*)
            item CONFLICT "yt-dlp" "${state#version:} installed, required ${YTDLP_VERSION}" \
                "replace with verified yt-dlp ${YTDLP_VERSION}"
            ;;
        *)
            fail "internal: unknown yt-dlp state: ${state}"
            ;;
    esac
}

report_ffmpeg_runtime() {
    if ! ffmpeg_contract_valid; then
        item CONFLICT "ffmpeg" "external-runtimes contract unreadable or incomplete: ${RCLONE_CONTRACT_FILE}" \
            "restore the committed contract from the repository — never editable on the host"

        return 0
    fi

    local state
    state="$(ffmpeg_state)"

    local install="install verified ffmpeg ${FFMPEG_VERSION}"
    local replace="replace with verified ffmpeg ${FFMPEG_VERSION}"
    local kind="${state%%@*}" rest="${state#*@}"
    local tool="${rest%%:*}" detail=""
    [[ "${rest}" == *:* ]] && detail="${rest#*:}"
    local path="${FFMPEG_BIN_DIR}/${tool}"

    case "${state}" in
        compliant)
            item PASS "ffmpeg" "${FFMPEG_VERSION}, ffmpeg and ffprobe in ${FFMPEG_BIN_DIR}, ${FFMPEG_OWNER}:${FFMPEG_GROUP} ${FFMPEG_MODE} (managed external runtime)"
            ;;
        absent)
            item MISSING "ffmpeg" "${FFMPEG_BIN_DIR}/ffmpeg and ffprobe absent" "${install}"
            ;;
        foreign:*)
            item CONFLICT "ffmpeg" "found at ${state#foreign:}, but the managed binaries belong in ${FFMPEG_BIN_DIR}" \
                "${install} in ${FFMPEG_BIN_DIR} (the unexpected copy is never touched)"
            ;;
        absent@*)
            item MISSING "ffmpeg" "${path} absent" "${install}"
            ;;
        not-file@*)
            item CONFLICT "ffmpeg" "${path} is a directory, not the binary" \
                "move it aside by hand, then re-run --apply"
            ;;
        no-stat@*)
            item CONFLICT "ffmpeg" "cannot stat ${path}" \
                "investigate the binary manually, then re-run --apply"
            ;;
        owner@*)
            item CONFLICT "ffmpeg" "${path} owned by ${detail}, required ${FFMPEG_OWNER}:${FFMPEG_GROUP}" "${replace}"
            ;;
        mode@*)
            item CONFLICT "ffmpeg" "${path} mode ${detail}, required ${FFMPEG_MODE}" "${replace}"
            ;;
        no-version@*)
            item CONFLICT "ffmpeg" "${path} cannot report a version" "${replace}"
            ;;
        version@*)
            item CONFLICT "ffmpeg" "${path} reports ${detail}, required ${FFMPEG_VERSION}" "${replace}"
            ;;
        *)
            fail "internal: unknown ffmpeg state: ${state} (${kind})"
            ;;
    esac
}

# php_reported_version BIN — second word of `BIN -v` line 1 ("PHP 8.5.12 ...").
php_reported_version() {
    probe_exec "$1" -v 2>/dev/null | head -n 1 | awk '{ print $2 }'
}

# postgres_reported_version BIN — third word of `BIN --version`
# ("psql (PostgreSQL) 18.4 ...").
postgres_reported_version() {
    probe_exec "$1" --version 2>/dev/null | head -n 1 | awk '{ print $3 }'
}

# php_version_meets_floor VERSION — true when VERSION ("8.5.12", with or
# without a build suffix) is PHP_MIN_VERSION or later. Compared numerically,
# part by part, in bash alone: as text, 8.5.9 would sort after 8.5.12. A
# version that does not start with three numeric parts never meets it.
php_version_meets_floor() {
    local have=() floor=() i

    [[ "$1" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]] || return 1
    have=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")

    [[ "${PHP_MIN_VERSION}" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
    floor=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")

    for i in 0 1 2; do
        if (( 10#${have[i]} > 10#${floor[i]} )); then
            return 0
        fi

        if (( 10#${have[i]} < 10#${floor[i]} )); then
            return 1
        fi
    done

    return 0
}

# report_php_binary NAME BIN LABEL — version-series and security-floor check
# for one PHP SAPI.
report_php_binary() {
    local name="$1" bin="$2" label="$3" version

    if ! tool_available "${bin}" && [[ ! -x "${bin}" ]]; then
        item MISSING "${name}" "${bin} not found (${label})" \
            "apt-get install the php${PHP_SERIES} packages"

        return 0
    fi

    version="$(php_reported_version "${bin}")"

    if [[ "${version}" != "${PHP_SERIES}".* ]]; then
        item CONFLICT "${name}" "reports PHP ${version:-unknown}, required series is ${PHP_SERIES}" \
            "install the php${PHP_SERIES} packages from the PHP PPA (never removes the conflicting PHP)"
    elif ! php_version_meets_floor "${version}"; then
        item CONFLICT "${name}" "reports PHP ${version}, below the security floor ${PHP_MIN_VERSION}" \
            "upgrade the php${PHP_SERIES} packages (apt-get install --only-upgrade), then restart php${PHP_SERIES}-fpm and the supervised PHP workers onto the new binary"
    else
        item PASS "${name}" "PHP ${version} (required series ${PHP_SERIES}, security floor ${PHP_MIN_VERSION})"
    fi
}

# runs_replaced_binary PID — the process executes a binary an upgrade has
# since replaced: the kernel shows its executable as deleted. False when the
# process or its executable cannot be read (as a non-root --check cannot read
# root's), so it only ever adds a restart that is certainly due.
runs_replaced_binary() {
    local exe

    [[ "$1" =~ ^[0-9]+$ ]] || return 1

    exe="$(readlink -- "${PROC_ROOT}/$1/exe" 2>/dev/null)" || return 1

    [[ "${exe}" == *" (deleted)" ]]
}

# php_fpm_runs_replaced_binary — PHP-FPM's master still executes the binary
# an upgrade replaced.
php_fpm_runs_replaced_binary() {
    local pid

    [[ -r "${PHP_FPM_PID_FILE}" ]] || return 1
    read -r pid < "${PHP_FPM_PID_FILE}" || return 1

    runs_replaced_binary "${pid}"
}

# stale_php_workers — the supervisor programs whose process still executes a
# PHP binary an upgrade replaced (the queue workers, the Nightwatch agent),
# space-separated, into STALE_PHP_WORKERS. None when supervisor is not
# running or not installed. Not a $(...) capture, so a caller reads the
# result in its own shell.
STALE_PHP_WORKERS=""

resolve_stale_php_workers() {
    local name state pid rest exe

    STALE_PHP_WORKERS=""

    while read -r name state pid rest; do
        [[ "${state}" == RUNNING && "${pid}" == pid ]] || continue

        pid="${rest%%,*}"

        runs_replaced_binary "${pid}" || continue

        exe="$(readlink -- "${PROC_ROOT}/${pid}/exe" 2>/dev/null)" || continue

        [[ "${exe}" == *php* ]] || continue

        STALE_PHP_WORKERS="${STALE_PHP_WORKERS:+${STALE_PHP_WORKERS} }${name}"
    done < <(probe_exec "${SUPERVISORCTL_BIN}" status 2>/dev/null || true)
}

# report_php_processes — no PHP process the hosts serve or work with still
# runs a binary an upgrade replaced: an upgrade is only done once they run
# the new code.
report_php_processes() {
    local stale=()

    php_fpm_runs_replaced_binary && stale+=("php${PHP_SERIES}-fpm")

    resolve_stale_php_workers
    [[ -n "${STALE_PHP_WORKERS}" ]] && stale+=(${STALE_PHP_WORKERS})

    if (( ${#stale[@]} == 0 )); then
        item PASS "php-processes" "no PHP process runs a replaced binary"
    else
        item CONFLICT "php-processes" "still running the PHP binary an upgrade replaced: ${stale[*]}" \
            "restart them onto the installed binary (php-fpm${PHP_SERIES} -t first)"
    fi
}

report_php_runtime() {
    report_php_binary "php-cli" "${PHP_CLI_BIN}" "CLI SAPI"
    report_php_binary "php-fpm" "${PHP_FPM_BIN}" "FPM SAPI"
    report_php_processes

    if ! tool_available "${PHP_CLI_BIN}" && [[ ! -x "${PHP_CLI_BIN}" ]]; then
        item MISSING "php-modules" "cannot enumerate modules without ${PHP_CLI_BIN}" \
            "install the php${PHP_SERIES} packages, then re-verify"

        return 0
    fi

    local loaded_modules module missing_modules=()
    loaded_modules="$(probe_exec "${PHP_CLI_BIN}" -m 2>/dev/null || true)"

    for module in "${REQUIRED_PHP_MODULES[@]}"; do
        if ! grep -ixq -- "${module}" <<<"${loaded_modules}"; then
            missing_modules+=("${module}")
        fi
    done

    if (( ${#missing_modules[@]} == 0 )); then
        item PASS "php-modules" "all required modules loaded (${REQUIRED_PHP_MODULES[*]})"
    else
        item MISSING "php-modules" "not loaded: ${missing_modules[*]}" \
            "apt-get install the matching php${PHP_SERIES}-* packages"
    fi
}

# nginx_package_version — the installed version of NGINX_PACKAGE as dpkg
# records it ("1.18.0-6ubuntu14.24"); empty when it is not installed.
nginx_package_version() {
    package_installed "${NGINX_PACKAGE}" || return 0

    probe_exec "${DPKG_QUERY_BIN}" -W -f "\${Version}" -- "${NGINX_PACKAGE}" 2>/dev/null || true
}

# nginx_version_meets_floor VERSION — true when VERSION is a package of the
# NGINX_PACKAGE_SERIES at NGINX_MIN_PACKAGE_VERSION or later. Within the
# series only the Ubuntu revision differs ("14.24"); it is compared as dpkg
# does, numerically part by part (as text, 14.3 would sort after 14.24), and
# anything after it ("14.24.1", "14.24build1") is later — except a "~"
# suffix, which dpkg sorts before the revision itself. A version outside the
# series never meets it.
nginx_version_meets_floor() {
    local series="${NGINX_PACKAGE_SERIES//./\\.}"
    local have_major have_minor have_rest floor_major floor_minor

    [[ "$1" =~ ^${series}([0-9]+)(\.([0-9]+))?(.*)$ ]] || return 1
    have_major="${BASH_REMATCH[1]}"
    have_minor="${BASH_REMATCH[3]:-0}"
    have_rest="${BASH_REMATCH[4]}"

    [[ "${NGINX_MIN_PACKAGE_VERSION}" =~ ^${series}([0-9]+)\.([0-9]+)$ ]] || return 1
    floor_major="${BASH_REMATCH[1]}"
    floor_minor="${BASH_REMATCH[2]}"

    if (( 10#${have_major} != 10#${floor_major} )); then
        (( 10#${have_major} > 10#${floor_major} ))
        return
    fi

    if (( 10#${have_minor} != 10#${floor_minor} )); then
        (( 10#${have_minor} > 10#${floor_minor} ))
        return
    fi

    [[ "${have_rest}" != "~"* ]]
}

# nginx_runs_replaced_binary — the running nginx master still executes a binary
# an upgrade has since replaced: the kernel shows its executable as deleted.
# False when nginx is not running, or its PID or executable cannot be read (as
# a non-root --check cannot read root's), so it only ever adds a restart that
# is certainly due.
nginx_runs_replaced_binary() {
    local pid exe

    [[ -r "${NGINX_PID_FILE}" ]] || return 1
    read -r pid < "${NGINX_PID_FILE}" || return 1
    [[ "${pid}" =~ ^[0-9]+$ ]] || return 1

    exe="$(readlink -- "${PROC_ROOT}/${pid}/exe" 2>/dev/null)" || return 1

    [[ "${exe}" == *" (deleted)" ]]
}

# report_nginx_package — the nginx security floor, by package revision.
report_nginx_package() {
    local version

    if ! package_installed "${NGINX_PACKAGE}"; then
        item MISSING "nginx-version" "${NGINX_PACKAGE} not installed" \
            "apt-get install ${NGINX_PACKAGE}"

        return 0
    fi

    version="$(nginx_package_version)"

    if [[ "${version}" != "${NGINX_PACKAGE_SERIES}"* ]]; then
        item CONFLICT "nginx-version" "${NGINX_PACKAGE} ${version:-unknown} is not the Ubuntu ${SUPPORTED_OS_CODENAME} series ${NGINX_PACKAGE_SERIES}*" \
            "install nginx from the Ubuntu ${SUPPORTED_OS_CODENAME} archive — another source numbers its releases differently, so no floor is known for it (never replaced by --apply)"
    elif ! nginx_version_meets_floor "${version}"; then
        item CONFLICT "nginx-version" "${NGINX_PACKAGE} ${version}, below the security floor ${NGINX_MIN_PACKAGE_VERSION}" \
            "upgrade ${NGINX_UPGRADE_PACKAGES[*]} (apt-get install --only-upgrade) and restart nginx"
    elif nginx_runs_replaced_binary; then
        item CONFLICT "nginx-version" "${NGINX_PACKAGE} ${version} is installed, but the running nginx still executes the binary it replaced" \
            "restart nginx once nginx -t passes"
    else
        item PASS "nginx-version" "${NGINX_PACKAGE} ${version} (security floor ${NGINX_MIN_PACKAGE_VERSION})"
    fi
}

# report_postgres_client NAME BIN — major-version check for one client tool.
report_postgres_client() {
    local name="$1" bin="$2" version major

    if ! tool_available "${bin}" && [[ ! -x "${bin}" ]]; then
        item MISSING "${name}" "${bin} not found" \
            "apt-get install postgresql-client-${POSTGRES_MAJOR}"

        return 0
    fi

    version="$(postgres_reported_version "${bin}")"
    major="${version%%.*}"

    if [[ "${major}" == "${POSTGRES_MAJOR}" ]]; then
        item PASS "${name}" "PostgreSQL ${version} (required major ${POSTGRES_MAJOR})"
    else
        item CONFLICT "${name}" "reports PostgreSQL ${version:-unknown}, required major is ${POSTGRES_MAJOR}" \
            "install postgresql-client-${POSTGRES_MAJOR} from PGDG (never removes the conflicting version)"
    fi
}

report_runtime() {
    section "RUNTIME"

    report_php_runtime

    report_nginx_package

    report_postgres_client "psql" "${PSQL_BIN}"
    report_postgres_client "pg_dump" "${PG_DUMP_BIN}"
    report_postgres_client "pg_restore" "${PG_RESTORE_BIN}"

    local tool
    for tool in createdb dropdb; do
        if tool_available "${tool}"; then
            item PASS "tool:${tool}" "present (package: postgresql-client-${POSTGRES_MAJOR})"
        else
            item MISSING "tool:${tool}" "not found (package: postgresql-client-${POSTGRES_MAJOR})" \
                "apt-get install postgresql-client-${POSTGRES_MAJOR}"
        fi
    done

    local entry package
    for entry in "${REQUIRED_RUNTIME_TOOLS[@]}"; do
        tool="${entry%%:*}"
        package="${entry#*:}"

        if tool_available "${tool}"; then
            item PASS "tool:${tool}" "present (package: ${package})"
        else
            item MISSING "tool:${tool}" "not found (package: ${package})" \
                "apt-get install ${package}"
        fi
    done
}

report_summary() {
    section "SUMMARY"

    printf 'Bootstrap runtime installer (%s):\n' "${MODE}"
    printf 'PASS: %d\n' "${COUNT_PASS}"
    printf 'MISSING: %d\n' "${COUNT_MISSING}"
    printf 'WARN: %d\n' "${COUNT_WARN}"
    printf 'CONFLICT: %d\n' "${COUNT_CONFLICT}"
    printf '\n'

    if contract_satisfied; then
        printf 'HOST RUNTIME CONTRACT: SATISFIED\n'
    else
        printf 'HOST RUNTIME CONTRACT: NOT SATISFIED\n'
    fi
}

contract_satisfied() {
    (( COUNT_MISSING == 0 )) && (( COUNT_CONFLICT == 0 ))
}

# run_contract_report — the full read-only report used by --check and
# --verify (and by --apply as its closing gate). Exits 0 only when the
# runtime contract is satisfied.
run_contract_report() {
    printf 'RateGuru bootstrap runtime installer (%s mode)\n' "${MODE}"
    printf 'Supported baseline: %s %s (%s), architectures: %s\n' \
        "${SUPPORTED_OS_ID}" "${SUPPORTED_OS_VERSION_ID}" "${SUPPORTED_OS_CODENAME}" "${SUPPORTED_ARCHITECTURES}"
    printf 'Required runtime: PHP %s, PostgreSQL %s\n' "${PHP_SERIES}" "${POSTGRES_MAJOR}"

    report_host
    report_repositories
    report_packages
    report_external_runtime
    report_runtime
    report_summary

    contract_satisfied
}

# --- Apply ------------------------------------------------------------------

require_root() {
    [[ "${EFFECTIVE_UID}" == "0" ]] || fail "--apply must run as root"
}

# The hard gates every mutation hides behind: exact OS baseline, proven
# architecture, and a working package manager. Fail closed before any
# repository or package mutation.
apply_gate_host() {
    local os_id os_version
    os_id="$(os_release_field ID || true)"
    os_version="$(os_release_field VERSION_ID || true)"

    [[ -r "${OS_RELEASE_FILE}" ]] \
        || fail "cannot read ${OS_RELEASE_FILE}; supported baseline is ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID}"

    [[ "${os_id}" == "${SUPPORTED_OS_ID}" ]] && [[ "${os_version}" == "${SUPPORTED_OS_VERSION_ID}" ]] \
        || fail "unsupported host ID=${os_id:-unknown} VERSION_ID=${os_version:-unknown}; supported baseline is ${SUPPORTED_OS_ID} ${SUPPORTED_OS_VERSION_ID} exactly"

    architecture_supported \
        || fail "unsupported architecture ${ARCH_VALUE}; supported: ${SUPPORTED_ARCHITECTURES}"

    if ! tool_available apt-get || ! tool_available dpkg; then
        fail "apt-get/dpkg not available — package bootstrap impossible"
    fi
}

# stage_install SRC DST MODE — replaces DST with SRC atomically: a complete
# candidate is staged in DST's own directory and renamed into place, so a
# previously working file is never deleted and no partial file is ever
# observable at DST.
stage_install() {
    local src="$1" dst="$2" mode="$3" staged

    staged="$(mktemp "${dst}.XXXXXX")" || fail "cannot stage candidate for ${dst}"

    if ! install -m "${mode}" -- "${src}" "${staged}"; then
        rm -f -- "${staged}"
        fail "cannot stage candidate for ${dst}"
    fi

    if ! mv -f -- "${staged}" "${dst}"; then
        rm -f -- "${staged}"
        fail "cannot install ${dst}"
    fi
}

# fetch_and_validate_key WORKDIR LABEL KEY_URL KEY_FINGERPRINT
#
# Downloads the repository signing key over HTTPS only, dearmors it, and
# accepts it only when the material contains exactly one primary key whose
# fingerprint matches the pin (keyring_matches_pin — the same validation
# --check/--verify apply to the installed keyring). The validated binary
# keyring is left at WORKDIR/key.gpg; any failure aborts before anything
# reaches the real keyring directory. Fails closed when the bootstrap
# repository tooling itself is absent — external repository work must never
# be attempted without it.
fetch_and_validate_key() {
    local workdir="$1" label="$2" key_url="$3" key_fingerprint="$4"

    tool_available "${CURL_BIN}" \
        || fail "repo:${label}: curl unavailable — bootstrap repository tooling must be installed before any external repository work"
    tool_available "${GPG_BIN}" \
        || fail "repo:${label}: gpg unavailable — bootstrap repository tooling must be installed before any external repository work"

    probe_exec "${CURL_BIN}" --fail --silent --show-error --location \
        --proto '=https' --tlsv1.2 --max-time 60 \
        --output "${workdir}/key.asc" -- "${key_url}" \
        || fail "repo:${label}: cannot download signing key from ${key_url}"

    probe_exec "${GPG_BIN}" --batch --yes --dearmor \
        --output "${workdir}/key.gpg" "${workdir}/key.asc" 2>/dev/null \
        || fail "repo:${label}: downloaded key material is not a valid OpenPGP key"

    keyring_matches_pin "${workdir}/key.gpg" "${key_fingerprint}" \
        || fail "repo:${label}: signing key fingerprint does not match the pinned ${key_fingerprint} (or the material bundles extra keys) — refusing to install it"
}

APT_UPDATE_NEEDED=false
APT_INDEXES_FRESH=false

# reconcile_repository LABEL URI SUITE COMPONENT KEY_URL KEY_FPR SOURCES_FILE KEYRING_FILE
#
# Idempotent, fail-closed convergence of one installer-owned repository:
#   - already provided by a pre-existing apt source -> left untouched;
#   - installer-owned files present and exact -> no rewrite, no key fetch;
#   - absent or drifted -> fetch + pin-validate the key, then stage and
#     rename keyring and .sources into place.
reconcile_repository() {
    local label="$1" uri="$2" suite="$3" component="$4"
    local key_url="$5" key_fingerprint="$6" sources_file="$7" keyring_file="$8"

    local expected_content
    expected_content="$(sources_file_content "${label}" "${uri}" "${suite}" "${component}" "${keyring_file}")"

    if [[ -f "${sources_file}" ]]; then
        if printf '%s\n' "${expected_content}" | cmp -s - "${sources_file}" \
            && keyring_matches_pin "${keyring_file}" "${key_fingerprint}"
        then
            action "repo:${label} already configured by this installer — nothing to do"

            return 0
        fi

        action "repo:${label} installer-owned configuration drifted — reinstalling transactionally"
    elif apt_source_configured "${uri}" "${suite}"; then
        action "repo:${label} provided by a pre-existing apt source — left untouched"

        return 0
    else
        action "repo:${label} not configured — installing ${sources_file}"
    fi

    local workdir
    workdir="$(mktemp -d)" || fail "repo:${label}: cannot create work directory"

    fetch_and_validate_key "${workdir}" "${label}" "${key_url}" "${key_fingerprint}"

    printf '%s\n' "${expected_content}" >"${workdir}/repo.sources" \
        || fail "repo:${label}: cannot compose sources candidate"

    install -d -m 0755 -- "${APT_KEYRINGS_DIR}" \
        || fail "repo:${label}: cannot create ${APT_KEYRINGS_DIR}"

    stage_install "${workdir}/key.gpg" "${keyring_file}" 0644
    stage_install "${workdir}/repo.sources" "${sources_file}" 0644

    rm -rf -- "${workdir}"

    action "repo:${label} installed (${sources_file}, keyring ${keyring_file})"

    APT_UPDATE_NEEDED=true
}

apt_update() {
    action "apt-get update ($1)"

    # --allow-releaseinfo-change-label: a repository renaming itself is no
    # reason to stop. apt refuses any change of a Release file's fields until
    # someone accepts it, and a non-interactive update just fails — as every
    # host did on 2026-11-21, when the PHP PPA's Label became "PPA for PHP
    # (deprecated)". The Label is a description; every signature is still
    # verified, and a changed Origin, Suite, Codename or Version still stops
    # the run.
    DEBIAN_FRONTEND=noninteractive probe_exec "${APT_GET_BIN}" update --allow-releaseinfo-change-label \
        || fail "apt-get update failed"

    APT_INDEXES_FRESH=true
}

# ensure_bootstrap_repository_tooling — installs ca-certificates/curl/gnupg
# from the host's existing Ubuntu sources when missing, so external
# repository keys can be fetched and validated at all. Runs strictly before
# any external repository work; a satisfied host performs no apt call here.
ensure_bootstrap_repository_tooling() {
    local package missing_tooling=()
    for package in "${BOOTSTRAP_TOOLING_PACKAGES[@]}"; do
        package_installed "${package}" || missing_tooling+=("${package}")
    done

    if (( ${#missing_tooling[@]} == 0 )); then
        return 0
    fi

    action "bootstrap repository tooling missing: ${missing_tooling[*]} — installing from the existing Ubuntu sources"

    apt_update "refreshing the host's existing Ubuntu sources for the bootstrap tooling"
    APT_INDEXES_FRESH=true

    DEBIAN_FRONTEND=noninteractive probe_exec "${APT_GET_BIN}" install -y --no-install-recommends -- \
        "${missing_tooling[@]}" \
        || fail "apt-get install failed for the bootstrap repository tooling (${missing_tooling[*]})"
}

# --- Apply: managed rclone runtime -------------------------------------------

RCLONE_WORKDIR=""

# Temporary download/verify material is cleaned via trap, so every failure
# path (fail() exits, apt errors, signal) leaves nothing behind. ERR/EXIT
# traps can fire inside $(...) subshells, so only the process that owns the
# trap may ever remove the directory.
cleanup_rclone_workdir() {
    [[ "${BASHPID:-$$}" == "$$" ]] || return 0
    [[ -n "${RCLONE_WORKDIR}" ]] || return 0

    rm -rf -- "${RCLONE_WORKDIR}"
    RCLONE_WORKDIR=""
}

# fetch_rclone_file URL DST — HTTPS-only download from the official rclone
# release origin.
fetch_rclone_file() {
    local url="$1" dst="$2"

    probe_exec "${CURL_BIN}" --fail --silent --show-error --location \
        --proto '=https' --tlsv1.2 --max-time 300 \
        --output "${dst}" -- "${url}" \
        || fail "rclone: cannot download ${url}"
}

# reconcile_rclone — idempotent, fail-closed convergence of the managed
# rclone binary onto the pinned contract:
#   - compliant -> no network request, no download, no file replacement;
#   - anything else -> download the exact pinned release archive and its
#     SHA256SUMS, verify the clearsigned SHA256SUMS against the committed
#     release-signing key (accepted only after the key matches the pinned
#     fingerprint), verify the artifact checksum, extract, confirm the
#     extracted binary reports exactly the pinned version, then stage the
#     candidate with final ownership/mode in the destination directory and
#     rename it into place atomically. The currently installed binary is
#     untouched until that rename; any earlier failure aborts the run.
# The operator's rclone configuration is never read or written, and
# `rclone selfupdate` is never invoked.
reconcile_rclone() {
    rclone_contract_valid \
        || fail "rclone: external-runtimes contract unreadable or incomplete: ${RCLONE_CONTRACT_FILE}"

    local state
    state="$(rclone_state)"

    if [[ "${state}" == compliant ]]; then
        action "rclone v${RCLONE_VERSION} already installed at ${RCLONE_BINARY_PATH} — nothing to do"

        return 0
    fi

    [[ "${state}" != not-file ]] \
        || fail "rclone: ${RCLONE_BINARY_PATH} is a directory — refusing to install over it; move it aside by hand"

    action "rclone requires reconciliation (state: ${state}) — installing verified v${RCLONE_VERSION}"

    tool_available "${CURL_BIN}" \
        || fail "rclone: curl unavailable — the bootstrap tooling must be installed first"
    tool_available "${GPG_BIN}" \
        || fail "rclone: gpg unavailable — the bootstrap tooling must be installed first"
    tool_available unzip \
        || fail "rclone: unzip unavailable — the base package contract installs it"

    [[ -r "${RCLONE_SIGNING_KEY_FILE}" ]] \
        || fail "rclone: committed release-signing key not readable: ${RCLONE_SIGNING_KEY_FILE}"

    RCLONE_WORKDIR="$(mktemp -d)" || fail "rclone: cannot create work directory"
    trap cleanup_rclone_workdir EXIT

    local workdir="${RCLONE_WORKDIR}"
    local artifact="rclone-v${RCLONE_VERSION}-${RCLONE_PLATFORM}.zip"
    local release_url="${RCLONE_DOWNLOAD_BASE_URL}/v${RCLONE_VERSION}"

    action "rclone: downloading ${artifact} and SHA256SUMS from ${release_url}"

    fetch_rclone_file "${release_url}/${artifact}" "${workdir}/${artifact}"
    fetch_rclone_file "${release_url}/SHA256SUMS" "${workdir}/SHA256SUMS"

    # The committed key is trusted only through the pinned fingerprint: it
    # must dearmor to a keyring holding exactly that key (keyring_matches_pin
    # — the same validation the repository keyrings get) before it may
    # verify anything. A private GNUPGHOME keeps the operator's keyrings
    # completely out of the trust decision.
    install -d -m 0700 -- "${workdir}/gnupg" || fail "rclone: cannot create gpg work home"

    GNUPGHOME="${workdir}/gnupg" probe_exec "${GPG_BIN}" --batch --yes --dearmor \
        --output "${workdir}/signing-key.gpg" "${RCLONE_SIGNING_KEY_FILE}" 2>/dev/null \
        || fail "rclone: committed release-signing key is not a valid OpenPGP key"

    keyring_matches_pin "${workdir}/signing-key.gpg" "${RCLONE_KEY_FINGERPRINT}" \
        || fail "rclone: committed release-signing key does not match the pinned fingerprint ${RCLONE_KEY_FINGERPRINT} — refusing to trust it"

    # SHA256SUMS is clearsigned; --decrypt verifies the signature against
    # the pin-validated keyring (and only that keyring) and emits the signed
    # payload. A signature by any other key fails closed.
    GNUPGHOME="${workdir}/gnupg" probe_exec "${GPG_BIN}" --batch \
        --no-default-keyring --keyring "${workdir}/signing-key.gpg" \
        --output "${workdir}/SHA256SUMS.verified" --decrypt "${workdir}/SHA256SUMS" 2>/dev/null \
        || fail "rclone: SHA256SUMS signature verification failed against the pinned release-signing key"

    local expected_sha actual_sha
    expected_sha="$(awk -v name="${artifact}" '$2 == name { print $1; exit }' "${workdir}/SHA256SUMS.verified")"

    [[ "${expected_sha}" =~ ^[0-9a-f]{64}$ ]] \
        || fail "rclone: verified SHA256SUMS carries no usable digest for ${artifact}"

    actual_sha="$(sha256sum "${workdir}/${artifact}" | awk '{ print $1 }')"

    [[ "${actual_sha}" == "${expected_sha}" ]] \
        || fail "rclone: checksum mismatch for ${artifact}: expected ${expected_sha}, got ${actual_sha}"

    action "rclone: signature and checksum verified — extracting"

    probe_exec unzip -q "${workdir}/${artifact}" -d "${workdir}/extract" \
        || fail "rclone: cannot extract ${artifact}"

    local candidate="${workdir}/extract/rclone-v${RCLONE_VERSION}-${RCLONE_PLATFORM}/rclone"

    [[ -f "${candidate}" ]] || fail "rclone: ${artifact} does not contain the rclone binary"

    # No `--` separator: BSD chmod (local test hosts) rejects it, and the
    # candidate path is always inside this run's own work directory.
    chmod 0755 "${candidate}" || fail "rclone: cannot mark the extracted binary executable"

    local candidate_version
    candidate_version="$(rclone_reported_version "${candidate}" || true)"

    [[ "${candidate_version}" == "v${RCLONE_VERSION}" ]] \
        || fail "rclone: extracted binary reports ${candidate_version:-no version}, expected v${RCLONE_VERSION}"

    # Atomic replacement: a complete candidate with final ownership and mode
    # is staged in the destination directory and renamed into place.
    local staged
    staged="$(mktemp "${RCLONE_BINARY_PATH}.XXXXXX")" || fail "rclone: cannot stage the candidate"

    if ! install -m "${RCLONE_MODE}" -o "${RCLONE_OWNER}" -g "${RCLONE_GROUP}" -- "${candidate}" "${staged}"; then
        rm -f -- "${staged}"
        fail "rclone: cannot stage the verified binary with final ownership"
    fi

    if ! mv -f -- "${staged}" "${RCLONE_BINARY_PATH}"; then
        rm -f -- "${staged}"
        fail "rclone: cannot install ${RCLONE_BINARY_PATH}"
    fi

    cleanup_rclone_workdir

    state="$(rclone_state)"
    [[ "${state}" == compliant ]] \
        || fail "rclone: post-install verification failed (state: ${state})"

    action "rclone v${RCLONE_VERSION} installed at ${RCLONE_BINARY_PATH} (${RCLONE_OWNER}:${RCLONE_GROUP} ${RCLONE_MODE})"
}

YTDLP_WORKDIR=""

# The same trap discipline as rclone's work directory: only the process that
# owns the trap removes it.
cleanup_ytdlp_workdir() {
    [[ "${BASHPID:-$$}" == "$$" ]] || return 0
    [[ -n "${YTDLP_WORKDIR}" ]] || return 0

    rm -rf -- "${YTDLP_WORKDIR}"
    YTDLP_WORKDIR=""
}

# fetch_ytdlp_file URL DST — HTTPS-only download from the official yt-dlp
# release origin; GitHub answers a release asset with a redirect to its own
# object storage, which --proto keeps on HTTPS.
fetch_ytdlp_file() {
    local url="$1" dst="$2"

    probe_exec "${CURL_BIN}" --fail --silent --show-error --location \
        --proto '=https' --tlsv1.2 --max-time 300 \
        --output "${dst}" -- "${url}" \
        || fail "yt-dlp: cannot download ${url}"
}

# reconcile_ytdlp — idempotent, fail-closed convergence of the managed yt-dlp
# onto the pinned contract, the way reconcile_rclone converges rclone:
#   - compliant -> no network request, no download, no file replacement;
#   - anything else -> download the pinned standalone executable, the
#     release's SHA2-256SUMS and its detached signature; verify the signature
#     against the committed release-signing key (accepted only after the key
#     matches the pinned fingerprint), verify the executable's checksum,
#     confirm it reports exactly the pinned version, then stage it with final
#     ownership/mode beside the destination and rename it into place. The
#     installed binary is untouched until that rename.
# `yt-dlp -U` is never invoked: the pin is the only way a version changes.
reconcile_ytdlp() {
    ytdlp_contract_valid \
        || fail "yt-dlp: external-runtimes contract unreadable or incomplete: ${RCLONE_CONTRACT_FILE}"

    local state
    state="$(ytdlp_state)"

    if [[ "${state}" == compliant ]]; then
        action "yt-dlp ${YTDLP_VERSION} already installed at ${YTDLP_BINARY_PATH} — nothing to do"

        return 0
    fi

    [[ "${state}" != not-file ]] \
        || fail "yt-dlp: ${YTDLP_BINARY_PATH} is a directory — refusing to install over it; move it aside by hand"

    action "yt-dlp requires reconciliation (state: ${state}) — installing verified ${YTDLP_VERSION}"

    tool_available "${CURL_BIN}" \
        || fail "yt-dlp: curl unavailable — the bootstrap tooling must be installed first"
    tool_available "${GPG_BIN}" \
        || fail "yt-dlp: gpg unavailable — the bootstrap tooling must be installed first"

    [[ -r "${YTDLP_SIGNING_KEY_FILE}" ]] \
        || fail "yt-dlp: committed release-signing key not readable: ${YTDLP_SIGNING_KEY_FILE}"

    YTDLP_WORKDIR="$(mktemp -d)" || fail "yt-dlp: cannot create work directory"
    trap cleanup_ytdlp_workdir EXIT

    local workdir="${YTDLP_WORKDIR}"
    local release_url="${YTDLP_DOWNLOAD_BASE_URL}/${YTDLP_VERSION}"

    action "yt-dlp: downloading ${YTDLP_ARTIFACT}, SHA2-256SUMS and its signature from ${release_url}"

    fetch_ytdlp_file "${release_url}/${YTDLP_ARTIFACT}" "${workdir}/${YTDLP_ARTIFACT}"
    fetch_ytdlp_file "${release_url}/SHA2-256SUMS" "${workdir}/SHA2-256SUMS"
    fetch_ytdlp_file "${release_url}/SHA2-256SUMS.sig" "${workdir}/SHA2-256SUMS.sig"

    # Trusted only through the pinned fingerprint, in a private GNUPGHOME —
    # exactly as rclone's key is.
    install -d -m 0700 -- "${workdir}/gnupg" || fail "yt-dlp: cannot create gpg work home"

    GNUPGHOME="${workdir}/gnupg" probe_exec "${GPG_BIN}" --batch --yes --dearmor \
        --output "${workdir}/signing-key.gpg" "${YTDLP_SIGNING_KEY_FILE}" 2>/dev/null \
        || fail "yt-dlp: committed release-signing key is not a valid OpenPGP key"

    keyring_matches_pin "${workdir}/signing-key.gpg" "${YTDLP_KEY_FINGERPRINT}" \
        || fail "yt-dlp: committed release-signing key does not match the pinned fingerprint ${YTDLP_KEY_FINGERPRINT} — refusing to trust it"

    # The signature is detached: --verify checks it over the SHA2-256SUMS
    # bytes against the pin-validated keyring alone. A signature by any other
    # key, or over any other content, fails closed.
    GNUPGHOME="${workdir}/gnupg" probe_exec "${GPG_BIN}" --batch \
        --no-default-keyring --keyring "${workdir}/signing-key.gpg" \
        --verify "${workdir}/SHA2-256SUMS.sig" "${workdir}/SHA2-256SUMS" 2>/dev/null \
        || fail "yt-dlp: SHA2-256SUMS signature verification failed against the pinned release-signing key"

    local expected_sha actual_sha
    expected_sha="$(awk -v name="${YTDLP_ARTIFACT}" '$2 == name { print $1; exit }' "${workdir}/SHA2-256SUMS")"

    [[ "${expected_sha}" =~ ^[0-9a-f]{64}$ ]] \
        || fail "yt-dlp: verified SHA2-256SUMS carries no usable digest for ${YTDLP_ARTIFACT}"

    actual_sha="$(sha256sum "${workdir}/${YTDLP_ARTIFACT}" | awk '{ print $1 }')"

    [[ "${actual_sha}" == "${expected_sha}" ]] \
        || fail "yt-dlp: checksum mismatch for ${YTDLP_ARTIFACT}: expected ${expected_sha}, got ${actual_sha}"

    action "yt-dlp: signature and checksum verified"

    local candidate="${workdir}/${YTDLP_ARTIFACT}"

    # No `--` separator: BSD chmod (local test hosts) rejects it, and the
    # candidate path is always inside this run's own work directory.
    chmod 0755 "${candidate}" || fail "yt-dlp: cannot mark the downloaded executable executable"

    local candidate_version
    candidate_version="$(ytdlp_reported_version "${candidate}" || true)"

    [[ "${candidate_version}" == "${YTDLP_VERSION}" ]] \
        || fail "yt-dlp: downloaded executable reports ${candidate_version:-no version}, expected ${YTDLP_VERSION}"

    local staged
    staged="$(mktemp "${YTDLP_BINARY_PATH}.XXXXXX")" || fail "yt-dlp: cannot stage the candidate"

    if ! install -m "${YTDLP_MODE}" -o "${YTDLP_OWNER}" -g "${YTDLP_GROUP}" -- "${candidate}" "${staged}"; then
        rm -f -- "${staged}"
        fail "yt-dlp: cannot stage the verified binary with final ownership"
    fi

    if ! mv -f -- "${staged}" "${YTDLP_BINARY_PATH}"; then
        rm -f -- "${staged}"
        fail "yt-dlp: cannot install ${YTDLP_BINARY_PATH}"
    fi

    cleanup_ytdlp_workdir

    state="$(ytdlp_state)"
    [[ "${state}" == compliant ]] \
        || fail "yt-dlp: post-install verification failed (state: ${state})"

    action "yt-dlp ${YTDLP_VERSION} installed at ${YTDLP_BINARY_PATH} (${YTDLP_OWNER}:${YTDLP_GROUP} ${YTDLP_MODE})"
}

FFMPEG_WORKDIR=""

cleanup_ffmpeg_workdir() {
    [[ "${BASHPID:-$$}" == "$$" ]] || return 0
    [[ -n "${FFMPEG_WORKDIR}" ]] || return 0

    rm -rf -- "${FFMPEG_WORKDIR}"
    FFMPEG_WORKDIR=""
}

# fetch_ffmpeg_file URL DST — HTTPS-only download of the pinned build;
# GitHub redirects a release asset to its object storage, which --proto keeps
# on HTTPS. The archive is about 150 MB, hence the longer ceiling.
fetch_ffmpeg_file() {
    local url="$1" dst="$2"

    probe_exec "${CURL_BIN}" --fail --silent --show-error --location \
        --proto '=https' --tlsv1.2 --max-time 900 \
        --output "${dst}" -- "${url}" \
        || fail "ffmpeg: cannot download ${url}"
}

# reconcile_ffmpeg — idempotent, fail-closed convergence of the managed
# ffmpeg and ffprobe onto the pinned build:
#   - compliant -> no network request, no download, no file replacement;
#   - a directory where a binary belongs -> refused before any download;
#   - anything else -> download the pinned archive, refuse it unless its
#     SHA-256 is exactly the committed one, extract only bin/ffmpeg and
#     bin/ffprobe, confirm both report exactly the pinned version, stage both
#     with final ownership and mode beside their destinations, and only then
#     rename each into place. A failure before the renames leaves both
#     installed binaries untouched.
reconcile_ffmpeg() {
    ffmpeg_contract_valid \
        || fail "ffmpeg: external-runtimes contract unreadable or incomplete: ${RCLONE_CONTRACT_FILE}"

    local state
    state="$(ffmpeg_state)"

    if [[ "${state}" == compliant ]]; then
        action "ffmpeg ${FFMPEG_VERSION} already installed in ${FFMPEG_BIN_DIR} — nothing to do"

        return 0
    fi

    if [[ "${state}" == not-file@* ]]; then
        local blocked="${state#not-file@}"
        fail "ffmpeg: ${FFMPEG_BIN_DIR}/${blocked} is a directory — refusing to install over it; move it aside by hand"
    fi

    action "ffmpeg requires reconciliation (state: ${state}) — installing verified ${FFMPEG_VERSION}"

    tool_available "${CURL_BIN}" \
        || fail "ffmpeg: curl unavailable — the bootstrap tooling must be installed first"
    tool_available tar \
        || fail "ffmpeg: tar unavailable — the base package contract installs it"
    tool_available xz \
        || fail "ffmpeg: xz unavailable — the base package contract installs xz-utils"

    FFMPEG_WORKDIR="$(mktemp -d)" || fail "ffmpeg: cannot create work directory"
    trap cleanup_ffmpeg_workdir EXIT

    local workdir="${FFMPEG_WORKDIR}"
    local url="${FFMPEG_DOWNLOAD_BASE_URL}/${FFMPEG_RELEASE}/${FFMPEG_ARTIFACT}"

    action "ffmpeg: downloading ${FFMPEG_ARTIFACT} from ${FFMPEG_DOWNLOAD_BASE_URL}/${FFMPEG_RELEASE}"

    fetch_ffmpeg_file "${url}" "${workdir}/${FFMPEG_ARTIFACT}"

    local actual_sha
    actual_sha="$(sha256sum "${workdir}/${FFMPEG_ARTIFACT}" | awk '{ print $1 }')"

    [[ "${actual_sha}" == "${FFMPEG_SHA256}" ]] \
        || fail "ffmpeg: checksum mismatch for ${FFMPEG_ARTIFACT}: expected ${FFMPEG_SHA256}, got ${actual_sha}"

    action "ffmpeg: checksum matches the pinned digest — extracting ffmpeg and ffprobe"

    local base="${FFMPEG_ARTIFACT%.tar.xz}"

    probe_exec tar -xJf "${workdir}/${FFMPEG_ARTIFACT}" -C "${workdir}" "${base}/bin/ffmpeg" "${base}/bin/ffprobe" 2>/dev/null \
        || fail "ffmpeg: ${FFMPEG_ARTIFACT} does not contain ${base}/bin/ffmpeg and ${base}/bin/ffprobe"

    local tool candidate candidate_version
    for tool in ffmpeg ffprobe; do
        candidate="${workdir}/${base}/bin/${tool}"

        [[ -f "${candidate}" ]] || fail "ffmpeg: ${FFMPEG_ARTIFACT} does not contain ${base}/bin/${tool}"

        # No `--` separator: BSD chmod (local test hosts) rejects it.
        chmod 0755 "${candidate}" || fail "ffmpeg: cannot mark the extracted ${tool} executable"

        candidate_version="$(ffmpeg_reported_version "${candidate}" "${tool}" || true)"

        [[ "${candidate_version}" == "${FFMPEG_VERSION}" ]] \
            || fail "ffmpeg: extracted ${tool} reports ${candidate_version:-no version}, expected ${FFMPEG_VERSION}"
    done

    # Both staged first, so a failure staging the second leaves the installed
    # pair as it was rather than half replaced.
    local staged_ffmpeg staged_ffprobe
    staged_ffmpeg="$(mktemp "${FFMPEG_BIN_DIR}/ffmpeg.XXXXXX")" || fail "ffmpeg: cannot stage ffmpeg"
    staged_ffprobe="$(mktemp "${FFMPEG_BIN_DIR}/ffprobe.XXXXXX")" || { rm -f -- "${staged_ffmpeg}"; fail "ffmpeg: cannot stage ffprobe"; }

    if ! install -m "${FFMPEG_MODE}" -o "${FFMPEG_OWNER}" -g "${FFMPEG_GROUP}" -- "${workdir}/${base}/bin/ffmpeg" "${staged_ffmpeg}" \
        || ! install -m "${FFMPEG_MODE}" -o "${FFMPEG_OWNER}" -g "${FFMPEG_GROUP}" -- "${workdir}/${base}/bin/ffprobe" "${staged_ffprobe}"; then
        rm -f -- "${staged_ffmpeg}" "${staged_ffprobe}"
        fail "ffmpeg: cannot stage the verified binaries with final ownership"
    fi

    if ! mv -f -- "${staged_ffprobe}" "${FFMPEG_BIN_DIR}/ffprobe"; then
        rm -f -- "${staged_ffmpeg}" "${staged_ffprobe}"
        fail "ffmpeg: cannot install ${FFMPEG_BIN_DIR}/ffprobe"
    fi

    if ! mv -f -- "${staged_ffmpeg}" "${FFMPEG_BIN_DIR}/ffmpeg"; then
        rm -f -- "${staged_ffmpeg}"
        fail "ffmpeg: cannot install ${FFMPEG_BIN_DIR}/ffmpeg"
    fi

    cleanup_ffmpeg_workdir

    state="$(ffmpeg_state)"
    [[ "${state}" == compliant ]] \
        || fail "ffmpeg: post-install verification failed (state: ${state})"

    action "ffmpeg ${FFMPEG_VERSION} installed in ${FFMPEG_BIN_DIR} (ffmpeg, ffprobe; ${FFMPEG_OWNER}:${FFMPEG_GROUP} ${FFMPEG_MODE})"
}

# reconcile_php_security_floor — PHP below PHP_MIN_VERSION is upgraded to what
# its repository offers: the installed packages of PHP_PACKAGES and nothing
# else (--only-upgrade installs nothing new; apt brings along what they
# require at exactly their own version, such as php8.5-opcache; the host's
# php.ini files are kept). There is no option to run below the floor: its
# releases are known to be exploitable, and the hosts change only through
# these installers. The upgrade is finished here too (finish_php_upgrade),
# and so is one an earlier run left unfinished, found by a process still
# running the replaced binary. A PHP of another series is never replaced
# (its CONFLICT stands).
reconcile_php_security_floor() {
    local cli fpm

    package_installed "php${PHP_SERIES}-cli" || return 0

    cli="$(php_reported_version "${PHP_CLI_BIN}")"
    fpm="$(php_reported_version "${PHP_FPM_BIN}")"

    [[ "${cli}" == "${PHP_SERIES}".* ]] || return 0

    if php_version_meets_floor "${cli}" && { [[ -z "${fpm}" ]] || php_version_meets_floor "${fpm}"; }; then
        resolve_stale_php_workers

        if php_fpm_runs_replaced_binary || [[ -n "${STALE_PHP_WORKERS}" ]]; then
            action "php: PHP ${cli} is installed, but processes still run the binary it replaced"
            finish_php_upgrade "${cli}"
        else
            action "php: PHP ${cli} meets the security floor ${PHP_MIN_VERSION}"
        fi

        return 0
    fi

    [[ "${APT_INDEXES_FRESH}" == true ]] \
        || apt_update "PHP is below its security floor"

    action "php: upgrading PHP ${cli} to the security floor ${PHP_MIN_VERSION} or later (${PHP_PACKAGES[*]})"

    # NEEDRESTART_MODE=l, as for nginx: needrestart only lists; this run
    # restarts what runs PHP itself, after php-fpm -t.
    NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive probe_exec "${APT_GET_BIN}" install -y --only-upgrade --no-install-recommends \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -- \
        "${PHP_PACKAGES[@]}" \
        || fail "apt-get could not upgrade PHP"

    cli="$(php_reported_version "${PHP_CLI_BIN}")"
    fpm="$(php_reported_version "${PHP_FPM_BIN}")"

    php_version_meets_floor "${cli}" && php_version_meets_floor "${fpm}" \
        || fail "PHP is still ${cli:-unknown} (FPM ${fpm:-unknown}) after the upgrade — its repository does not offer ${PHP_MIN_VERSION} yet"

    resolve_stale_php_workers
    finish_php_upgrade "${cli}"
}

# finish_php_upgrade VERSION — PHP-FPM restarts onto the installed binary once
# its configuration passes php-fpm -t (one that fails leaves it as it is and
# fails the run; the next run tries again), then each supervisor program still
# running the replaced binary restarts: supervisor stops it the way it always
# does, so a queue worker gets its stopwaitsecs to finish its job — the media
# worker a minute, after which its job runs again. PHP-FPM not running is not
# started here; install-bootstrap-services starts it as a base service.
finish_php_upgrade() {
    local version="$1" program

    if probe_exec "${SYSTEMCTL_BIN}" is-active --quiet "php${PHP_SERIES}-fpm"; then
        probe_exec "${PHP_FPM_BIN}" -t >/dev/null 2>&1 \
            || fail "PHP ${version} is installed, but php-fpm${PHP_SERIES} -t fails, so PHP-FPM was not restarted — fix the configuration, then re-run --apply"

        probe_exec "${SYSTEMCTL_BIN}" restart "php${PHP_SERIES}-fpm" \
            || fail "PHP ${version} is installed, but php${PHP_SERIES}-fpm did not restart — re-run --apply once it can"

        action "php: php${PHP_SERIES}-fpm restarted onto the installed binary (PHP ${version})"
    fi

    for program in ${STALE_PHP_WORKERS}; do
        probe_exec "${SUPERVISORCTL_BIN}" restart "${program}" >/dev/null \
            || fail "PHP ${version} is installed, but the supervisor program ${program} did not restart — re-run --apply once it can"

        action "php: supervisor program ${program} restarted onto the installed binary"
    done
}

# reconcile_nginx_security_floor — the one upgrade --apply makes: an nginx of
# the proven series below NGINX_MIN_PACKAGE_VERSION is upgraded to what the
# Ubuntu archive offers, its packages and nothing else (--only-upgrade
# installs nothing new; the configuration files on the host are kept). An
# exploitable web server is not left for an operator to notice, since the
# hosts change only through these installers. The upgrade is finished here
# too, the only service this slice ever touches: nginx moves onto the
# installed binary (finish_nginx_upgrade) — after this run's upgrade, and
# also whenever the running nginx still executes a binary an earlier upgrade
# replaced, which is how a run whose nginx -t or restart failed is finished
# by the next one without any state kept between them. An nginx of another
# series is never replaced (its CONFLICT stands), and one at the floor and
# running its installed binary costs no apt call and no restart.
reconcile_nginx_security_floor() {
    local version

    package_installed "${NGINX_PACKAGE}" || return 0

    version="$(nginx_package_version)"

    [[ "${version}" == "${NGINX_PACKAGE_SERIES}"* ]] || return 0

    if nginx_version_meets_floor "${version}"; then
        if nginx_runs_replaced_binary; then
            action "nginx: ${NGINX_PACKAGE} ${version} is installed, but the running nginx still executes the binary it replaced"
            finish_nginx_upgrade "${version}"
        else
            action "nginx: ${NGINX_PACKAGE} ${version} meets the security floor ${NGINX_MIN_PACKAGE_VERSION}"
        fi

        return 0
    fi

    [[ "${APT_INDEXES_FRESH}" == true ]] \
        || apt_update "nginx is below its security floor"

    action "nginx: upgrading ${NGINX_PACKAGE} ${version} to the security floor ${NGINX_MIN_PACKAGE_VERSION} or later (${NGINX_UPGRADE_PACKAGES[*]})"

    # NEEDRESTART_MODE=l: Ubuntu's needrestart only lists what else uses an
    # upgraded library, rather than restarting PHP-FPM or PostgreSQL behind
    # this run's back.
    NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive probe_exec "${APT_GET_BIN}" install -y --only-upgrade --no-install-recommends \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -- \
        "${NGINX_UPGRADE_PACKAGES[@]}" \
        || fail "apt-get could not upgrade nginx"

    version="$(nginx_package_version)"

    nginx_version_meets_floor "${version}" \
        || fail "nginx is still ${NGINX_PACKAGE} ${version:-unknown} after the upgrade — the Ubuntu archive does not offer ${NGINX_MIN_PACKAGE_VERSION} yet"

    finish_nginx_upgrade "${version}"
}

# finish_nginx_upgrade VERSION — a running nginx restarts onto the installed
# binary once its configuration passes nginx -t; a configuration that fails
# leaves the running nginx as it is and fails the run, and the next run, which
# finds the replaced binary still running, tries again. An nginx that is not
# running is not started here: install-bootstrap-services starts it as a base
# service, on whatever binary is installed.
finish_nginx_upgrade() {
    local version="$1"

    if ! probe_exec "${SYSTEMCTL_BIN}" is-active --quiet nginx; then
        action "nginx: ${NGINX_PACKAGE} ${version} installed; nginx is not running, so this run does not restart it"

        return 0
    fi

    probe_exec "${NGINX_BIN}" -t >/dev/null 2>&1 \
        || fail "nginx ${version} is installed, but its configuration does not pass nginx -t, so nginx was not restarted — fix the configuration, then re-run --apply"

    probe_exec "${SYSTEMCTL_BIN}" restart nginx \
        || fail "nginx ${version} is installed, but nginx did not restart — re-run --apply once it can"

    action "nginx: restarted onto the installed binary (${NGINX_PACKAGE} ${version})"
}

# perform_apply — root is enforced by run_apply; tests exercising failure
# paths call this directly with the gated EUID override in place.
perform_apply() {
    apply_gate_host

    ensure_bootstrap_repository_tooling

    reconcile_repository php \
        "${PHP_REPO_URI}" "${PHP_REPO_SUITE}" "${PHP_REPO_COMPONENT}" \
        "${PHP_REPO_KEY_URL}" "${PHP_REPO_KEY_FINGERPRINT}" \
        "${PHP_REPO_SOURCES_FILE}" "${PHP_REPO_KEYRING_FILE}"

    reconcile_repository pgdg \
        "${PGDG_REPO_URI}" "${PGDG_REPO_SUITE}" "${PGDG_REPO_COMPONENT}" \
        "${PGDG_REPO_KEY_URL}" "${PGDG_REPO_KEY_FINGERPRINT}" \
        "${PGDG_REPO_SOURCES_FILE}" "${PGDG_REPO_KEYRING_FILE}"

    local package missing_packages=()
    for package in "${REQUIRED_PACKAGES[@]}"; do
        package_installed "${package}" || missing_packages+=("${package}")
    done

    # Repository changes always force a re-read of the indexes (they must
    # include the new sources); a plain package install reuses indexes that
    # the bootstrap-tooling phase just refreshed.
    if [[ "${APT_UPDATE_NEEDED}" == true ]]; then
        apt_update "repository configuration changed"
    elif (( ${#missing_packages[@]} > 0 )) && [[ "${APT_INDEXES_FRESH}" != true ]]; then
        apt_update "packages must be installed"
    fi

    if (( ${#missing_packages[@]} > 0 )); then
        action "installing ${#missing_packages[@]} missing package(s): ${missing_packages[*]}"

        DEBIAN_FRONTEND=noninteractive probe_exec "${APT_GET_BIN}" install -y --no-install-recommends -- \
            "${missing_packages[@]}" \
            || fail "apt-get install failed"
    else
        action "packages: all ${#REQUIRED_PACKAGES[@]} required packages already installed"
    fi

    reconcile_php_security_floor
    reconcile_nginx_security_floor

    # After the package phase, so unzip exists on a clean host. Never an apt
    # action: rclone converges through the verified-download path only.
    reconcile_rclone

    # The same verified-download path, for the media import's downloader.
    reconcile_ytdlp

    # And for the media pipeline's ffmpeg/ffprobe, after the package phase
    # put xz-utils in place to unpack it.
    reconcile_ffmpeg

    action "apply finished — running the full contract verification"

    MODE=verify
    run_contract_report
}

run_apply() {
    require_root
    perform_apply
}

# --- Entry point ------------------------------------------------------------

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify)
                if [[ "${MODE_SEEN}" == true ]]; then
                    usage >&2
                    fail "mode given more than once"
                fi

                MODE="${1#--}"
                MODE_SEEN=true
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done

    if [[ "${MODE_SEEN}" != true ]]; then
        usage >&2
        fail "one of --check, --apply or --verify is required"
    fi
}

main() {
    parse_args "$@"

    case "${MODE}" in
        check|verify)
            run_contract_report || exit 1
            ;;
        apply)
            printf 'RateGuru bootstrap runtime installer (apply mode)\n'
            run_apply || exit 1
            ;;
    esac

    exit 0
}

# Source-guard: allows tests to source this file and call functions directly
# without main() auto-running — the same pattern the other installers use.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
