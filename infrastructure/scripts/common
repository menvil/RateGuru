#!/usr/bin/env bash

set -Eeuo pipefail

# RATEGURU_DEPLOYMENT_CONF_FILE is only honored alongside
# RATEGURU_ALLOW_TEST_OVERRIDES=true — a stray environment variable surviving
# in a real root shell (a leftover export, a shared profile) can never
# silently redirect this privileged `source` at an attacker- or
# operator-controlled file. This is a plain inline condition rather than a
# call to a shared function: no function this file defines exists yet at this
# point in its own execution (function definitions run in order, same as
# anything else in a sourced file), so there is nothing to call. The identical
# check is reused, as an actual function, further down for
# RATEGURU_TARGET_REGISTRY_FILE and RATEGURU_TARGETS_CLI, where that ordering
# problem does not apply.
CONFIG_FILE_DEFAULT="/home/www/rateguru/config/deployment.conf"

if [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]] \
    && [[ -n "${RATEGURU_DEPLOYMENT_CONF_FILE:-}" ]]
then
    CONFIG_FILE="${RATEGURU_DEPLOYMENT_CONF_FILE}"
else
    CONFIG_FILE="${CONFIG_FILE_DEFAULT}"
fi

if [[ ! -r "${CONFIG_FILE}" ]]; then
    echo "ERROR: deployment configuration is unavailable: ${CONFIG_FILE}" >&2
    exit 1
fi

if [[ ! -f "${CONFIG_FILE}" ]] || [[ -L "${CONFIG_FILE}" ]]; then
    echo "ERROR: deployment configuration must be a regular file: ${CONFIG_FILE}" >&2
    exit 1
fi

# Ownership and mode are only demanded of the installed default, exactly like
# the target registry's own usability check — an explicit test fixture works
# without root.
if [[ "${CONFIG_FILE}" == "${CONFIG_FILE_DEFAULT}" ]]; then
    if [[ "$(stat -c '%u:%g' "${CONFIG_FILE}")" != "0:0" ]]; then
        echo "ERROR: deployment configuration must be owned by root:root: ${CONFIG_FILE}" >&2
        exit 1
    fi

    CONFIG_MODE="$(stat -c '%a' "${CONFIG_FILE}")"

    if (( (8#${CONFIG_MODE} & 8#022) != 0 )); then
        echo "ERROR: deployment configuration must not be group- or other-writable: ${CONFIG_FILE}" >&2
        exit 1
    fi
fi

# shellcheck disable=SC1090
source "${CONFIG_FILE}"

log() {
    printf '[%s] %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        "$*"
}

fail() {
    log "ERROR: $*" >&2
    exit 1
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        fail "this command must be executed as root"
    fi
}

validate_environment() {
    local environment="$1"

    case "${environment}" in
        staging|production)
            ;;
        *)
            fail "invalid environment: ${environment}"
            ;;
    esac
}

validate_release_id() {
    local release_id="$1"

    if [[ ! "${release_id}" =~ ${RELEASE_ID_REGEX} ]]; then
        fail "invalid release ID: ${release_id}"
    fi
}

environment_root() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "${STAGING_ROOT}"
            ;;
        production)
            printf '%s\n' "${PRODUCTION_ROOT}"
            ;;
    esac
}

environment_runtime_user() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "${STAGING_RUNTIME_USER}"
            ;;
        production)
            printf '%s\n' "${PRODUCTION_RUNTIME_USER}"
            ;;
    esac
}

environment_code_group() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "${STAGING_CODE_GROUP}"
            ;;
        production)
            printf '%s\n' "${PRODUCTION_CODE_GROUP}"
            ;;
    esac
}

environment_url() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "http://127.0.0.1/"
            ;;
        production)
            printf '%s\n' "http://127.0.0.1/"
            ;;
    esac
}

environment_host_header() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "rateguru-staging.internal"
            ;;
        production)
            printf '%s\n' "rateguru-production.internal"
            ;;
    esac
}

environment_public_hostname() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "rateguru.staging.myprojects.pp.ua"
            ;;
        production)
            printf '%s\n' "tits.guru"
            ;;
    esac
}

acquire_deployment_lock() {
    local environment_root="$1"

    exec 200>"${environment_root}/locks/deployment.lock"

    if ! flock -n 200; then
        fail "another deployment operation is already running"
    fi
}

append_history() {
    local environment_root="$1"
    local event="$2"
    local release_id="${3:-null}"
    local status="${4:-unknown}"

    printf \
        '{"timestamp":"%s","event":"%s","release":"%s","status":"%s","user":"%s"}\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        "${event}" \
        "${release_id}" \
        "${status}" \
        "${SUDO_USER:-$(id -un)}" \
        >> "${environment_root}/deployments/history.jsonl"
}

environment_deploy_user() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "${STAGING_DEPLOY_USER}"
            ;;
        production)
            printf '%s\n' "${PRODUCTION_DEPLOY_USER}"
            ;;
    esac
}

environment_incoming_artifacts() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "${STAGING_INCOMING_ARTIFACTS}"
            ;;
        production)
            printf '%s\n' "${PRODUCTION_INCOMING_ARTIFACTS}"
            ;;
    esac
}

# Phase 4 slice 4: cleanup's legacy (--environment) default retention only.
# Kept for --environment compatibility — deployment.conf's
# STAGING_RELEASE_RETENTION/PRODUCTION_RELEASE_RETENTION are host-level
# settings, not the registry's per-target release_retention field. Target
# mode does NOT call this: it reads target_release_retention(TARGET_ID)
# instead, because release_retention is a required per-target registry
# field precisely so two targets sharing an environment_class (e.g. two
# production targets) can retain a different number of releases. Legacy and
# target mode currently resolve the same number for staging/staging-main
# only because the registry and deployment.conf happen to agree today — see
# target_release_retention below and cleanup's own resolve_target().
#
# No default/error case for an unrecognized environment, matching every
# other environment_* helper in this block (environment_root,
# environment_runtime_user, environment_code_group, ...): none of them have
# one. Every real call site runs validate_environment first, so this is
# never reached with anything but "staging"/"production" — adding a check
# here alone would be inconsistent with its siblings for no safety gain. If
# this contract is ever revisited, do it for every environment_* helper
# together, not one at a time.
environment_release_retention() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "${STAGING_RELEASE_RETENTION}"
            ;;
        production)
            printf '%s\n' "${PRODUCTION_RELEASE_RETENTION}"
            ;;
    esac
}

# Phase 4 slice 7.1: legacy (--environment) backup helpers, mirroring
# environment_public_hostname/environment_host_header — literal per-class
# values, not sourced from deployment.conf, because these three are
# deliberately declared here rather than added as new deployment.conf
# settings. Same contract as every other environment_* helper in this block:
# no default/error case, because every real call site runs
# validate_environment first. Target mode never calls these — it reads
# target_database_name/target_backup_namespace/target_local_backup_retention
# (already defined below) from the registry instead.
environment_database_name() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "rateguru_staging"
            ;;
        production)
            printf '%s\n' "rateguru_production"
            ;;
    esac
}

environment_backup_namespace() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "staging"
            ;;
        production)
            printf '%s\n' "production"
            ;;
    esac
}

environment_local_backup_retention() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "14"
            ;;
        production)
            printf '%s\n' "30"
            ;;
    esac
}

# Phase 4 slice 7.2: legacy (--environment) offsite retention, same contract
# as environment_local_backup_retention above (no default/error case; every
# real call site runs validate_environment first). Target mode never calls
# this — it reads target_offsite_backup_retention (already defined below)
# from the registry instead.
environment_offsite_backup_retention() {
    local environment="$1"

    case "${environment}" in
        staging)
            printf '%s\n' "30"
            ;;
        production)
            printf '%s\n' "90"
            ;;
    esac
}

# Phase 4 slice 7.2: shared, strict backup-manifest schema classifier for
# offsite-backup and offsite-restore-test. infrastructure/scripts/restore-test
# (local restore-test) already established this exact contract inline and is
# out of scope for this slice — it is not touched, and does not call this
# function — but the contract must stay identical, so it is extracted here
# rather than re-derived with different semantics per caller.
#
# Never classify by `jq -r '.manifest_schema_version // empty'` alone: raw
# output loses JSON type, so a schema_version of 3, 0, the JSON *string* "2"
# (not a number), "garbage", an array, an object or a boolean would all
# compare unequal to the literal string "2" and silently pass as legacy
# schema 1 (fail-open). `type` disambiguates first.
#
# Prints exactly one of:
#   schema1        - the field is absent or JSON null
#   schema2        - the field is a JSON number equal to 2
#   invalid:<value> - anything else, with the offending value's own JSON
#                     representation appended (quoted for a string, compact
#                     for an array/object) — callers turn this into their own
#                     `fail "unsupported backup manifest schema_version: ..."`
#
# Never calls fail itself, and has no dependency on any selector-resolved
# variable (ENVIRONMENT_CLASS, BACKUP_NAMESPACE, TARGET_ID, ...) — safe to
# call before those exist.
manifest_schema_classify() {
    local manifest_path="$1"
    local manifest_schema_type
    manifest_schema_type="$(jq -r '.manifest_schema_version | type' "${manifest_path}")"

    case "${manifest_schema_type}" in
        null)
            printf 'schema1\n'
            ;;
        number)
            local manifest_schema_version
            manifest_schema_version="$(jq -r '.manifest_schema_version' "${manifest_path}")"

            if [[ "${manifest_schema_version}" == "2" ]]; then
                printf 'schema2\n'
            else
                printf 'invalid:%s\n' "${manifest_schema_version}"
            fi
            ;;
        *)
            local manifest_schema_value
            manifest_schema_value="$(jq -c '.manifest_schema_version' "${manifest_path}")"
            printf 'invalid:%s\n' "${manifest_schema_value}"
            ;;
    esac
}

# Phase 4 slice 7.2 (review follow-up): shared manifest validator for
# offsite-backup and offsite-restore-test — both scripts had this exact,
# byte-identical implementation; extracted here to remove the duplication.
# infrastructure/scripts/restore-test (local restore-test) has a materially
# different contract (it also checks `database` against its own
# independently resolved database name) and stays untouched, exactly as
# before — this function is never called by it.
#
# Runs before any rclone command — checksum validation only proves the
# selected backup's own files are internally consistent; this proves the
# backup actually belongs to the resolved selector. Operates on
# ENVIRONMENT_CLASS, BACKUP_NAMESPACE, SELECTOR_TYPE and TARGET_ID, set by
# the caller's own resolve_* step before this runs — same convention as
# require_active_target and parse_selector_args below.
validate_backup_manifest() {
    local manifest_path="$1"

    [[ -f "${manifest_path}" ]] || fail "backup manifest is missing: ${manifest_path}"

    local manifest_project manifest_environment manifest_database

    manifest_project="$(jq -r '.project // empty' "${manifest_path}")"
    manifest_environment="$(jq -r '.environment // empty' "${manifest_path}")"
    manifest_database="$(jq -r '.database // empty' "${manifest_path}")"

    [[ "${manifest_project}" == "rateguru" ]] \
        || fail "backup manifest project mismatch: expected rateguru, got '${manifest_project}'"

    [[ "${manifest_environment}" == "${ENVIRONMENT_CLASS}" ]] \
        || fail "backup manifest environment mismatch: expected ${ENVIRONMENT_CLASS}, got '${manifest_environment}'"

    [[ -n "${manifest_database}" ]] \
        || fail "backup manifest database is missing or empty"

    local manifest_schema_status
    manifest_schema_status="$(manifest_schema_classify "${manifest_path}")"

    case "${manifest_schema_status}" in
        schema1)
            ;;
        schema2)
            local manifest_backup_namespace
            manifest_backup_namespace="$(jq -r '.backup_namespace // empty' "${manifest_path}")"

            [[ "${manifest_backup_namespace}" == "${BACKUP_NAMESPACE}" ]] \
                || fail "backup manifest backup_namespace mismatch: expected ${BACKUP_NAMESPACE}, got '${manifest_backup_namespace}'"

            if [[ "${SELECTOR_TYPE}" == "target" ]]; then
                local manifest_target
                manifest_target="$(jq -r '.target // empty' "${manifest_path}")"

                if [[ -n "${manifest_target}" ]] && [[ "${manifest_target}" != "${TARGET_ID}" ]]; then
                    fail "backup manifest target mismatch: expected ${TARGET_ID}, got '${manifest_target}'"
                fi
            fi
            ;;
        invalid:*)
            fail "unsupported backup manifest schema_version: ${manifest_schema_status#invalid:}"
            ;;
    esac
}

# --- deployment target registry (begin) ---
#
# Phase 4 slice 1: read-only accessors over the non-secret target registry.
#
# Nothing below runs at source time. The registry is read only when a target_*
# helper is actually called, so scripts installed before the registry exists —
# every operational script today — keep working untouched. Sourcing common must
# never fail merely because the registry is absent.
#
# The registry is data, never code: it is parsed with jq and never sourced,
# eval'd or substituted into a shell command. Target IDs reach jq through --arg
# only, never by string concatenation into a jq program.

TARGET_REGISTRY_DEFAULT_FILE="/home/www/rateguru/config/deployment-targets.json"
TARGET_REGISTRY_SCHEMA_VERSION=1

# Gates every RATEGURU_*_FILE / RATEGURU_*_CLI override below that could
# redirect a privileged script at an attacker- or operator-controlled file —
# the identical plain condition guards RATEGURU_DEPLOYMENT_CONF_FILE near the
# top of this file, before this block starts. Defined as a real function here
# (rather than inlined, as that one is) because it is called from multiple
# places below, and — unlike the top-of-file check — it has somewhere earlier
# in this same execution to have already been defined.
#
# This function lives inside the extractable block (between the begin/end
# markers) rather than at the top of the file, because tests exercise this
# block in isolation by extracting exactly the text between those markers —
# see tests/Feature/Architecture/DeploymentTargetRegistryTest.php's
# targetHelperHarness(). A definition outside the markers would not be part of
# what gets extracted, and target_registry_file()/target_registry_validator()
# below would fail to find it when tested that way.
rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

# One resolution contract, identical to scripts/targets (which layers --file on
# top as the most specific source):
#   1. RATEGURU_TARGET_REGISTRY_FILE — tests and controlled tooling, and only
#      when RATEGURU_ALLOW_TEST_OVERRIDES=true
#   2. TARGET_REGISTRY_FILE — set by the deployment.conf sourced above; no test
#      flag required, since honoring it requires deployment.conf to already
#      have loaded (from its own root-owned installed path, or from a fixture
#      that already required the same flag to be read at all)
#   3. TARGET_REGISTRY_DEFAULT_FILE
#
# `common` already sourced deployment.conf, so step 2 is a plain variable here.
# The CLI reaches the same value by parsing that file, because deployment.conf
# assigns without `export` and the value would not survive into a child process.
target_registry_file() {
    if rateguru_test_overrides_allowed && [[ -n "${RATEGURU_TARGET_REGISTRY_FILE:-}" ]]; then
        printf '%s\n' "${RATEGURU_TARGET_REGISTRY_FILE}"

        return 0
    fi

    if [[ -n "${TARGET_REGISTRY_FILE:-}" ]]; then
        printf '%s\n' "${TARGET_REGISTRY_FILE}"

        return 0
    fi

    printf '%s\n' "${TARGET_REGISTRY_DEFAULT_FILE}"
}

validate_target_id() {
    local target_id="${1-}"

    if [[ ! "${target_id}" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]]; then
        fail "invalid target ID: ${target_id}"
    fi
}

# Readable regular file, real JSON, schema we understand. When the registry is
# the installed runtime default we additionally demand root ownership and no
# group/other write, matching how deployment.conf is already protected. An
# explicitly pointed-at file (tests, repository checks) skips the ownership
# demand but is still never allowed to be a symlink.
target_registry_assert_usable() {
    local registry_file
    registry_file="$(target_registry_file)"

    if [[ -L "${registry_file}" ]]; then
        fail "target registry must not be a symlink: ${registry_file}"
    fi

    if [[ ! -e "${registry_file}" ]]; then
        fail "target registry is unavailable: ${registry_file}"
    fi

    if [[ ! -f "${registry_file}" ]]; then
        fail "target registry must be a regular file: ${registry_file}"
    fi

    if [[ ! -r "${registry_file}" ]]; then
        fail "target registry is not readable: ${registry_file}"
    fi

    if [[ "${registry_file}" == "${TARGET_REGISTRY_DEFAULT_FILE}" ]]; then
        if [[ "$(stat -c '%u:%g' "${registry_file}")" != "0:0" ]]; then
            fail "target registry must be owned by root:root: ${registry_file}"
        fi

        local registry_mode
        registry_mode="$(stat -c '%a' "${registry_file}")"

        if (( (8#${registry_mode} & 8#022) != 0 )); then
            fail "target registry must not be group- or other-writable: ${registry_file}"
        fi
    fi

    if ! jq -e 'type == "object"' "${registry_file}" >/dev/null 2>&1; then
        fail "target registry is not valid JSON: ${registry_file}"
    fi

    if ! jq -e --argjson expected "${TARGET_REGISTRY_SCHEMA_VERSION}" \
        '.schema_version == $expected' "${registry_file}" >/dev/null 2>&1
    then
        local found
        found="$(jq -r '.schema_version // "missing"' "${registry_file}" 2>/dev/null || printf 'unreadable')"

        fail "unsupported target registry schema_version: ${found} (expected ${TARGET_REGISTRY_SCHEMA_VERSION})"
    fi
}

# Locate the registry validator. It ships beside this file, so an installed
# common at /home/www/rateguru/bin/common finds /home/www/rateguru/bin/targets.
target_registry_validator() {
    if rateguru_test_overrides_allowed && [[ -n "${RATEGURU_TARGETS_CLI:-}" ]]; then
        printf '%s\n' "${RATEGURU_TARGETS_CLI}"

        return 0
    fi

    # BASH_SOURCE is unset when this block is evaluated outside a sourced file
    # (bash -c, tests), and `set -u` would abort on a bare reference.
    local own_source="${BASH_SOURCE[0]:-}"

    if [[ -n "${own_source}" ]]; then
        local own_dir
        own_dir="$(cd -- "$(dirname -- "${own_source}")" 2>/dev/null && pwd)" || own_dir=""

        if [[ -n "${own_dir}" ]] && [[ -x "${own_dir}/targets" ]]; then
            printf '%s\n' "${own_dir}/targets"

            return 0
        fi
    fi

    printf '%s\n' "/home/www/rateguru/bin/targets"
}

# Full registry validation — schema, required properties, semantics and
# cross-target collisions — run at most once per shell process.
#
# Without this, a helper would happily return one property while the rest of the
# same target was missing or malformed. Reading application_root must not
# succeed on a target whose database name or socket is invalid, because the
# caller will use both.
#
# The result is cached against the resolved path, so a script reading a dozen
# properties pays for validation once rather than a dozen times.
_TARGET_REGISTRY_VALIDATED_FILE=""

target_registry_assert_valid() {
    local registry_file
    registry_file="$(target_registry_file)"

    if [[ "${_TARGET_REGISTRY_VALIDATED_FILE}" == "${registry_file}" ]]; then
        return 0
    fi

    local validator
    validator="$(target_registry_validator)"

    if [[ ! -x "${validator}" ]]; then
        fail "target registry validator is unavailable: ${validator}"
    fi

    local output
    if ! output="$("${validator}" validate --file "${registry_file}" 2>&1)"; then
        fail "target registry failed validation: ${registry_file}"$'\n'"${output}"
    fi

    _TARGET_REGISTRY_VALIDATED_FILE="${registry_file}"
}

# Internal: presence lookup that assumes validate_target_id and
# target_registry_assert_usable have already run. Callers that have done both
# use this instead of target_exists, so the registry is not re-stat'ed and its
# schema not re-checked once per property access.
_target_present() {
    local target_id="$1"
    local registry_file="$2"

    jq -e --arg id "${target_id}" \
        '(.targets | type == "object") and (.targets | has($id))' \
        "${registry_file}" >/dev/null 2>&1
}

target_exists() {
    local target_id="${1-}"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    _target_present "${target_id}" "$(target_registry_file)"
}

# Whole normalized target object, key-sorted so output is deterministic.
target_get() {
    local target_id="${1-}"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    local registry_file
    registry_file="$(target_registry_file)"

    if ! _target_present "${target_id}" "${registry_file}"; then
        fail "unknown target: ${target_id}"
    fi

    jq -S -e --arg id "${target_id}" '.targets[$id]' "${registry_file}" \
        || fail "unable to read target: ${target_id}"
}

# Internal: fetch one property by jq path, refusing null/empty results so a
# missing or mistyped field is an error rather than a silent empty string.
_target_property() {
    local target_id="$1"
    local jq_path="$2"
    local expected_type="$3"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    local registry_file
    registry_file="$(target_registry_file)"

    if ! _target_present "${target_id}" "${registry_file}"; then
        fail "unknown target: ${target_id}"
    fi

    local value
    if ! value="$(jq -e -r --arg id "${target_id}" \
        "(.targets[\$id] | ${jq_path}) as \$v
         | if (\$v | type) != \"${expected_type}\" then error(\"type\") else \$v end" \
        "${registry_file}" 2>/dev/null)"
    then
        fail "target ${target_id} is missing a valid ${jq_path} (expected ${expected_type})"
    fi

    if [[ "${expected_type}" == "string" ]] && [[ -z "${value}" ]]; then
        fail "target ${target_id} has an empty ${jq_path}"
    fi

    printf '%s\n' "${value}"
}

target_lifecycle()                { _target_property "${1-}" '.lifecycle' string; }
target_environment_class()        { _target_property "${1-}" '.environment_class' string; }
target_root()                     { _target_property "${1-}" '.application_root' string; }
target_runtime_user()             { _target_property "${1-}" '.runtime_user' string; }
target_runtime_group()            { _target_property "${1-}" '.runtime_group' string; }
target_deploy_user()              { _target_property "${1-}" '.deploy_user' string; }
target_code_group()               { _target_property "${1-}" '.code_group' string; }
target_incoming_artifacts()       { _target_property "${1-}" '.incoming_artifacts' string; }
target_release_retention()        { _target_property "${1-}" '.release_retention' number; }
target_database_name()            { _target_property "${1-}" '.database.name' string; }
target_database_role()            { _target_property "${1-}" '.database.application_role' string; }
target_health_url()               { _target_property "${1-}" '.health.url' string; }
target_health_host_header()       { _target_property "${1-}" '.health.host_header' string; }
target_backup_namespace()         { _target_property "${1-}" '.backup.namespace' string; }
target_local_backup_retention()   { _target_property "${1-}" '.backup.local_retention_days' number; }
target_offsite_backup_retention() { _target_property "${1-}" '.backup.offsite_retention_days' number; }
target_php_fpm_pool()             { _target_property "${1-}" '.php_fpm.pool' string; }
target_php_fpm_socket()           { _target_property "${1-}" '.php_fpm.socket' string; }
target_supervisor_program()       { _target_property "${1-}" '.supervisor.program' string; }
target_queue_name()               { _target_property "${1-}" '.supervisor.queue' string; }
target_scheduler_name()           { _target_property "${1-}" '.scheduler.name' string; }
target_nginx_site_name()          { _target_property "${1-}" '.nginx.site_name' string; }
# Phase 4 slice 5: the first public_hostnames entry is the target's canonical
# public hostname, used by deploy for `artisan rateguru:sharing:verify
# --expected-host`. No new registry field: _target_property's existing
# generic contract already fails closed here for free — `.public_hostnames[0]`
# on an empty array, or on a first element that isn't a string, both yield a
# value whose jq type isn't "string", which _target_property already turns
# into "target X is missing a valid .public_hostnames[0] (expected string)".
target_primary_public_hostname()  { _target_property "${1-}" '.public_hostnames[0]' string; }

# Phase 4 slice 2: the single gate operational commands use before acting on a
# target. target_lifecycle already validates the target ID, validates the
# whole registry, and confirms the target exists (failing "unknown target: …"
# otherwise) — so this only adds the final check: the target must be
# lifecycle=active. A planned or disabled target must never be read further,
# so this must run before any URL is built, curl is called, or an application
# path is touched.
#
# validate_target_id / target_registry_assert_usable / target_registry_assert_valid
# are called directly here — not through target_lifecycle's own $(...) command
# substitution below — because a command substitution forks a subshell, and
# target_registry_assert_valid's cache (_TARGET_REGISTRY_VALIDATED_FILE) is a
# plain shell variable: setting it inside a subshell has no effect once that
# subshell exits. Running the three checks directly, in this function's own
# (the caller's) shell, means the cache is actually set here — in the process
# health-check or status is running as — so target_lifecycle two lines down,
# and every target_* call the caller makes afterward, inherit an
# already-matching cache and skip re-running the external validator. Without
# this, every target_* accessor call would re-invoke the validator from
# scratch, once each, silently defeating the "once per process" design.
require_active_target() {
    local target_id="${1-}"

    validate_target_id "${target_id}"
    target_registry_assert_usable
    target_registry_assert_valid

    local lifecycle
    lifecycle="$(target_lifecycle "${target_id}")"

    if [[ "${lifecycle}" != "active" ]]; then
        fail "target ${target_id} has lifecycle=${lifecycle}, not active"
    fi
}

# Shared --target/--environment selector parsing for target-aware operational
# commands (health-check, status). Runs in the caller's own shell — never a
# subshell — so it sets TARGET_ID, ENVIRONMENT, TARGET_SEEN and
# ENVIRONMENT_SEEN directly in the caller's scope rather than returning them.
#
# Call as: parse_selector_args "$0" "$@"  (or an explicit program name in
# place of "$0", since callers invoke this via `bash script`, not `./script`).
#
# Enforces: exactly one of --target/--environment; the two together fail;
# duplicate --target or duplicate --environment fails; a selector given with no
# value, or an explicitly empty value, fails; an unrecognized argument fails;
# --help prints both forms and exits 0. It does not perform target/environment
# *semantic* validation (require_active_target, validate_environment) — that
# stays with the caller, since what happens with a validated selector differs
# per command.
parse_selector_args() {
    local program_name="$1"
    shift

    TARGET_ID=""
    ENVIRONMENT=""
    TARGET_SEEN=false
    ENVIRONMENT_SEEN=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                if [[ "${TARGET_SEEN}" == true ]]; then
                    fail "--target given more than once"
                fi

                [[ $# -ge 2 ]] || fail "--target requires a value"

                TARGET_ID="$2"
                TARGET_SEEN=true
                shift 2
                ;;
            --environment)
                if [[ "${ENVIRONMENT_SEEN}" == true ]]; then
                    fail "--environment given more than once"
                fi

                [[ $# -ge 2 ]] || fail "--environment requires a value"

                ENVIRONMENT="$2"
                ENVIRONMENT_SEEN=true
                shift 2
                ;;
            --help|-h)
                cat <<USAGE
Usage:
  ${program_name} --target TARGET
  ${program_name} --environment staging|production
USAGE
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    assert_selector_state
}

# Phase 4 slice 4: extracted from parse_selector_args's own tail so cleanup
# can reuse it too. cleanup cannot use parse_selector_args directly — it has
# extra flags (--keep, --dry-run, --apply) that function doesn't know about —
# so it runs its own argument loop for --target/--environment/--keep/
# --dry-run/--apply, then calls this function for the exact same
# mutual-exclusion / exactly-one-required / non-empty validation
# health-check and status already get from parse_selector_args. Operates on
# the same TARGET_ID/ENVIRONMENT/TARGET_SEEN/ENVIRONMENT_SEEN globals, set
# directly in the caller's own shell — never a subshell — same convention as
# every other function in this block.
assert_selector_state() {
    if [[ "${TARGET_SEEN}" == true ]] && [[ "${ENVIRONMENT_SEEN}" == true ]]; then
        fail "--target and --environment cannot be combined"
    fi

    if [[ "${TARGET_SEEN}" != true ]] && [[ "${ENVIRONMENT_SEEN}" != true ]]; then
        fail "exactly one of --target or --environment is required"
    fi

    if [[ "${TARGET_SEEN}" == true ]]; then
        [[ -n "${TARGET_ID}" ]] || fail "--target requires a non-empty value"
    else
        [[ -n "${ENVIRONMENT}" ]] || fail "--environment requires a non-empty value"
    fi
}

# Phase 4 slice 7.2 (review follow-up): shared flag-value validator for the
# offsite-* scripts' own hand-rolled --target/--environment (and
# offsite-retention's --apply) argument loops — offsite-backup,
# offsite-retention and offsite-restore-test had this exact, byte-identical
# implementation; extracted here to remove the duplication. backup/deploy/
# rollback keep their own separate copies untouched (out of scope for this
# slice) — bash's normal function-shadowing means a script defining its own
# require_flag_value after sourcing this file is unaffected either way.
#
# require_flag_value <flag-name> <remaining-arg-count> <next-token>
require_flag_value() {
    local flag="$1" remaining="$2" value="${3-}"

    [[ "${remaining}" -ge 2 ]] || fail "${flag} requires a value"
    [[ -n "${value}" ]] || fail "${flag} requires a non-empty value"

    case "${value}" in
        -*) fail "${flag} requires a value, not another option: ${value}" ;;
    esac
}
# --- deployment target registry (end) ---
