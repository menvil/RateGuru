#!/usr/bin/env bash
#
# install-media-fetch-isolation — the account each target's yt-dlp runs as,
# kept off the host's own network.
#
#   install-media-fetch-isolation --check    read-only: what --apply would change, and whether it may
#   install-media-fetch-isolation --apply    install it, or bring it back to what this bundle renders (root)
#   install-media-fetch-isolation --verify   read-only: installed, live, and current
#
# yt-dlp opens the addresses a site's pages hand it, outside the application's
# pinned import client. The application runs it, for each target, as an
# account of that target's own — the runtime user's name and "-fetch"
# (config import.ytdlp.isolation_suffix, App\Support\Import\YtDlpIsolation) —
# wherever that account exists and the table below is loaded. One account per
# target: one target's yt-dlp never reaches another's downloads. This installs
# the accounts and what holds them:
#
#   <runtime user>-fetch                 for each active target: a system
#                                        account, no password, no home, no shell
#   /etc/sudoers.d/rateguru-media-fetch  root:root 0440: each active target's
#                                        runtime user may run yt-dlp as its own
#                                        account — that one program, nothing
#                                        else; checked by visudo first
#   /etc/rateguru/media-fetch.nft        root:root 0644: one nftables table of
#                                        RateGuru's own, inet rateguru_media_fetch,
#                                        that rejects those accounts' traffic to
#                                        this host's own addresses and every
#                                        loopback, private, link-local and
#                                        reserved one — their resolver on
#                                        127.0.0.53 aside; checked by nft -c first
#   /etc/systemd/system/rateguru-media-fetch-firewall.service
#                                        root:root 0644: loads that table at boot,
#                                        before the network, and keeps the marker
#                                        /run/rateguru-media-fetch.armed while it
#                                        is loaded — without it the application
#                                        never runs yt-dlp as the accounts
#   /var/lib/rateguru-media-fetch/table.listed
#                                        root:root 0644: the table as nft listed
#                                        it once --apply had loaded and checked
#                                        it, with the ruleset it came from —
#                                        --verify compares the live table with
#                                        it whole, every rule and address range
#
# A target retired since keeps its account, and the table keeps holding it: a
# yt-dlp it started may still be running. Only the sudo rule drops it.
#
# The table replaces only itself: it never flushes the ruleset, so ufw's own
# tables, and anything else, stay as they are. The distribution's
# nftables.service is never enabled — its /etc/nftables.conf flushes the whole
# ruleset.
#
# NEVER: ufw, another table, another account's groups, a target's files, or an
# account of those names RateGuru did not create — that is never taken over.
#
# Host-wide, one table for every target: run by install-bootstrap-services in
# the host run; a target-scoped repair never touches it. Every mode needs root:
# what is read — the accounts' lock state, the sudoers directory, the live
# table — is root's to read.
#
# Test overrides: the RATEGURU_MEDIAFETCH_* variables below are honoured only
# alongside RATEGURU_ALLOW_TEST_OVERRIDES=true.

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

# --- Test override gate -------------------------------------------------------

rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

gated_default() {
    local var_name="$1" default_value="$2"

    if rateguru_test_overrides_allowed && [[ -n "${!var_name:-}" ]]; then
        printf '%s\n' "${!var_name}"
    else
        printf '%s\n' "${default_value}"
    fi
}

EFFECTIVE_UID="$(gated_default RATEGURU_MEDIAFETCH_EUID "${EUID}")"
FS_ROOT="$(gated_default RATEGURU_MEDIAFETCH_FS_ROOT '')"
SRC_REGISTRY="$(gated_default RATEGURU_MEDIAFETCH_SOURCE_REGISTRY "${REPO_ROOT}/infrastructure/config/deployment-targets.json")"
SRC_VERSIONS="$(gated_default RATEGURU_MEDIAFETCH_SOURCE_VERSIONS "${REPO_ROOT}/infrastructure/config/external-runtimes/versions.env")"

GETENT_BIN="$(gated_default RATEGURU_MEDIAFETCH_GETENT_BIN getent)"
USERADD_BIN="$(gated_default RATEGURU_MEDIAFETCH_USERADD_BIN useradd)"
VISUDO_BIN="$(gated_default RATEGURU_MEDIAFETCH_VISUDO_BIN visudo)"
NFT_BIN="$(gated_default RATEGURU_MEDIAFETCH_NFT_BIN nft)"
SYSTEMCTL_BIN="$(gated_default RATEGURU_MEDIAFETCH_SYSTEMCTL_BIN systemctl)"

FILE_OWNER="$(gated_default RATEGURU_MEDIAFETCH_FILE_OWNER root)"
FILE_GROUP="$(gated_default RATEGURU_MEDIAFETCH_FILE_GROUP root)"

FETCH_SUFFIX="-fetch"
FETCH_HOME="/nonexistent"
FETCH_SHELL="/usr/sbin/nologin"
FETCH_SUDOERS="/etc/sudoers.d/rateguru-media-fetch"
FETCH_RULESET="/etc/rateguru/media-fetch.nft"
FETCH_UNIT_NAME="rateguru-media-fetch-firewall.service"
FETCH_UNIT="/etc/systemd/system/${FETCH_UNIT_NAME}"
FETCH_TABLE="rateguru_media_fetch"
FETCH_MARKER="/run/rateguru-media-fetch.armed"
FETCH_RECORD="/var/lib/rateguru-media-fetch/table.listed"
# The one resolver the account may reach: systemd-resolved's stub, which
# itself asks upstream as its own user, outside this table.
FETCH_RESOLVER="127.0.0.53"
RESOLV_CONF="/etc/resolv.conf"

# Every address that is not the public internet: loopback, RFC 1918, carrier
# NAT, link-local (cloud metadata among it), documentation and benchmark
# ranges, multicast and reserved — and their IPv6 counterparts, IPv4-mapped
# addresses included, so none is reached through the other family.
FETCH_DENIED_V4="0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4"
FETCH_DENIED_V6="::/96, ::1/128, ::ffff:0:0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001::/32, 2001:db8::/32, 2002::/16, fc00::/7, fe80::/10, fec0::/10, ff00::/8"

# --- Output ---------------------------------------------------------------------

MODE=""
COUNT_PASS=0
COUNT_FAIL=0
COUNT_DRIFT=0

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

action() {
    printf '[apply] %s\n' "$*"
}

item() {
    local status="$1" name="$2" detail="$3"
    printf '  %-8s %-46s %s\n' "${status}" "${name}" "${detail}"
    case "${status}" in
        PASS) COUNT_PASS=$((COUNT_PASS + 1)) ;;
        FAIL) COUNT_FAIL=$((COUNT_FAIL + 1)) ;;
        DRIFT|MISSING) COUNT_DRIFT=$((COUNT_DRIFT + 1)) ;;
    esac
}

usage() {
    cat <<'USAGE'
Usage:
  install-media-fetch-isolation --check
  install-media-fetch-isolation --apply
  install-media-fetch-isolation --verify

The account each target's yt-dlp runs as (<runtime user>-fetch), the sudo
rule that lets each active target's runtime user run yt-dlp as its own, and
the nftables table that keeps them off this host's network.
USAGE
}

physical() {
    printf '%s%s\n' "${FS_ROOT}" "$1"
}

require_root() {
    [[ "${EFFECTIVE_UID}" == 0 ]] || fail "--${MODE} must run as root"
}

require_tools() {
    local tool
    for tool in "$@"; do
        command -v "${tool}" >/dev/null 2>&1 || fail "required tool not found: ${tool}"
    done
}

require_host_tools() {
    require_tools jq cmp stat awk install sha256sum "${GETENT_BIN}" "${USERADD_BIN}" "${VISUDO_BIN}" "${NFT_BIN}" "${SYSTEMCTL_BIN}"
}

# --- What the bundle says -----------------------------------------------------------

YTDLP_BINARY=""
RUNTIME_USERS=()
FETCH_USERS=()
# Every account the table holds: the active targets', and any RateGuru made
# for a target retired since.
FILTERED_USERS=()

load_sources() {
    [[ -f "${SRC_REGISTRY}" ]] || fail "the target registry is missing: ${SRC_REGISTRY}"
    [[ -f "${SRC_VERSIONS}" ]] || fail "the pinned runtime versions are missing: ${SRC_VERSIONS}"

    YTDLP_BINARY="$(sed -n 's/^YTDLP_BINARY=//p' "${SRC_VERSIONS}" | head -n 1)"
    [[ "${YTDLP_BINARY}" =~ ^/[A-Za-z0-9/._-]+$ ]] \
        || fail "YTDLP_BINARY in ${SRC_VERSIONS} is not an absolute path — refusing to render a sudo rule around it"

    local target_id runtime_user
    RUNTIME_USERS=()
    while IFS= read -r target_id; do
        [[ -n "${target_id}" ]] || continue
        runtime_user="$(jq -r --arg id "${target_id}" '.targets[$id].runtime_user // empty' "${SRC_REGISTRY}")"
        [[ "${runtime_user}" =~ ^[a-z_][a-z0-9_-]{0,25}$ ]] \
            || fail "target ${target_id}: runtime_user '${runtime_user}' is not a renderable account name with room for '${FETCH_SUFFIX}' — refusing to render a sudo rule around it"
        RUNTIME_USERS+=("${runtime_user}")
        FETCH_USERS+=("${runtime_user}${FETCH_SUFFIX}")
    done < <(jq -r '.targets | to_entries[] | select(.value.lifecycle == "active") | .key' "${SRC_REGISTRY}" | sort)

    (( ${#RUNTIME_USERS[@]} > 0 )) \
        || fail "the registry declares no active target, so no runtime user may run yt-dlp — refusing to install an empty rule"

    load_filtered_users
}

# load_filtered_users — the active targets' accounts and every media fetch
# account RateGuru made that is still on the host, by name, once each. A
# retired target's stays in the table: a yt-dlp it started may still run, and
# without the table it would reach this host's network.
load_filtered_users() {
    local name accounts
    # Listed first, its failure stopping everything: a list cut short would
    # render a table without a retired account whose yt-dlp may still run.
    accounts="$("${GETENT_BIN}" passwd)" \
        || fail "the host's accounts could not be listed (getent passwd) — refusing to render a table that might leave a media fetch account out. Nothing was changed"
    [[ -n "${accounts}" ]] \
        || fail "getent passwd listed no account at all — refusing to render a table that might leave a media fetch account out. Nothing was changed"

    FILTERED_USERS=()
    while IFS= read -r name; do
        [[ -n "${name}" ]] && FILTERED_USERS+=("${name}")
    done < <(
        {
            printf '%s\n' "${FETCH_USERS[@]}"
            awk -F: -v suffix="${FETCH_SUFFIX}" -v home="${FETCH_HOME}" -v shell="${FETCH_SHELL}" '
                length($1) > length(suffix) && substr($1, length($1) - length(suffix) + 1) == suffix \
                    && $5 == "RateGuru media fetch for " substr($1, 1, length($1) - length(suffix)) " (yt-dlp)" \
                    && $6 == home && $7 == shell { print $1 }' <<<"${accounts}"
        } | sort -u
    )
}

# retired USER — a media fetch account RateGuru made for a target no longer active.
retired() {
    local user="$1" active
    for active in "${FETCH_USERS[@]}"; do
        [[ "${active}" == "${user}" ]] && return 1
    done
    return 0
}

# --- What is rendered ------------------------------------------------------------------

render_sudoers() {
    local runtime_user
    printf '# RateGuru media fetch — rendered by install-media-fetch-isolation. Do not edit.\n'
    printf '#\n'
    printf "# Each active target's runtime user may run yt-dlp as its own account,\n"
    printf '# <runtime user>%s — that one program, nothing else. Those accounts are kept\n' "${FETCH_SUFFIX}"
    printf '# off the host network by the nftables table inet %s.\n' "${FETCH_TABLE}"
    for runtime_user in "${RUNTIME_USERS[@]}"; do
        printf 'Defaults:%s !requiretty\n' "${runtime_user}"
        printf '%s ALL=(%s%s) NOPASSWD: %s\n' "${runtime_user}" "${runtime_user}" "${FETCH_SUFFIX}" "${YTDLP_BINARY}"
    done
}

render_ruleset() {
    local accounts user
    accounts=""
    for user in "${FILTERED_USERS[@]}"; do
        accounts+="${accounts:+, }\"${user}\""
    done

    cat <<EOF
#!/usr/sbin/nft -f
# RateGuru media fetch — rendered by install-media-fetch-isolation. Do not edit.
#
# The accounts each target's yt-dlp runs as reach the public internet and
# their resolver, and nothing of this host's network: its own addresses and
# every loopback, private, link-local and reserved address are refused. This
# table replaces only itself; ufw's tables, and anything else, are untouched.
table inet ${FETCH_TABLE}
delete table inet ${FETCH_TABLE}
table inet ${FETCH_TABLE} {
    chain output {
        type filter hook output priority filter; policy accept;
        meta skuid { ${accounts} } ip daddr ${FETCH_RESOLVER} udp dport 53 accept
        meta skuid { ${accounts} } ip daddr ${FETCH_RESOLVER} tcp dport 53 accept
        meta skuid { ${accounts} } fib daddr type local reject
        meta skuid { ${accounts} } ip daddr { ${FETCH_DENIED_V4} } reject
        meta skuid { ${accounts} } ip6 daddr { ${FETCH_DENIED_V6} } reject
    }
}
EOF
}

render_unit() {
    cat <<EOF
# RateGuru media fetch — rendered by install-media-fetch-isolation. Do not edit.
#
# Early, as ufw's and nftables' own units are: without the default
# dependencies, so it never closes an ordering cycle with units that run
# before sysinit.target and after the network (cloud-init). The marker it
# keeps in /run is what the application asks before it runs yt-dlp as the
# accounts this table holds.
[Unit]
Description=RateGuru media fetch firewall (keeps yt-dlp's accounts off this host's network)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f ${FETCH_RULESET}
ExecStartPost=/usr/bin/touch ${FETCH_MARKER}
ExecReload=/usr/sbin/nft -f ${FETCH_RULESET}
ExecStopPost=/usr/bin/rm -f ${FETCH_MARKER}

[Install]
WantedBy=multi-user.target
EOF
}

# --- State ------------------------------------------------------------------------------

fetch_gecos() {
    printf 'RateGuru media fetch for %s (yt-dlp)\n' "${1%"${FETCH_SUFFIX}"}"
}

# fetch_account USER — absent | ours | foreign | unlocked: an account of that
# name RateGuru did not create is never taken over, and one with a password is
# not a media fetch account.
fetch_account() {
    local user="$1" entry shadow
    entry="$("${GETENT_BIN}" passwd "${user}" 2>/dev/null || true)"
    if [[ -z "${entry}" ]]; then
        printf 'absent\n'
        return 0
    fi

    if [[ "$(cut -d: -f5 <<<"${entry}")" != "$(fetch_gecos "${user}")" || "$(cut -d: -f6 <<<"${entry}")" != "${FETCH_HOME}" \
        || "$(cut -d: -f7 <<<"${entry}")" != "${FETCH_SHELL}" ]]; then
        printf 'foreign\n'
        return 0
    fi

    shadow="$("${GETENT_BIN}" shadow "${user}" 2>/dev/null | cut -d: -f2 || true)"
    if [[ "${shadow}" == '!'* || "${shadow}" == '*'* ]]; then
        printf 'ours\n'
    else
        printf 'unlocked\n'
    fi
}

fetch_uid() {
    "${GETENT_BIN}" passwd "$1" 2>/dev/null | cut -d: -f3
}

file_state() {
    local logical="$1" expected="$2" mode="$3" path
    path="$(physical "${logical}")"
    if [[ ! -e "${path}" && ! -L "${path}" ]]; then
        printf 'MISSING\n'
    elif [[ -L "${path}" || ! -f "${path}" ]] || ! cmp -s "${expected}" "${path}" \
        || [[ "$(stat -c '%U:%G %a' "${path}" 2>/dev/null)" != "${FILE_OWNER}:${FILE_GROUP} ${mode}" ]]
    then
        printf 'DRIFT\n'
    else
        printf 'PASS\n'
    fi
}

# resolver_is_stub — the host resolves through systemd-resolved's stub, the one
# resolver the table lets the account reach.
resolver_is_stub() {
    local conf nameservers
    conf="$(physical "${RESOLV_CONF}")"
    [[ -r "${conf}" ]] || return 1
    nameservers="$(awk '$1 == "nameserver" { print $2 }' "${conf}" | sort -u)"
    [[ "${nameservers}" == "${FETCH_RESOLVER}" ]]
}

# table_live — the table is loaded, holds every account it filters — by name
# or by the uid nft lists — and refuses this host's own addresses and the
# private ranges of both families. What --apply asks before it records the
# table; --verify compares the whole of it with that record as well.
table_live() {
    local listed user uid
    listed="$("${NFT_BIN}" list table inet "${FETCH_TABLE}" 2>/dev/null)" || return 1
    for user in "${FILTERED_USERS[@]}"; do
        uid="$(fetch_uid "${user}")"
        grep -qE "\"${user}\"|[ {,]${uid:-x}([ },]|\$)" <<<"${listed}" || return 1
    done
    grep -q 'fib daddr type local reject' <<<"${listed}" \
        && grep -q '10.0.0.0/8' <<<"${listed}" \
        && grep -q 'fc00::/7' <<<"${listed}"
}

# render_record FILE — the live table as nft lists it, under the hash of the
# ruleset rendered now.
render_record() {
    printf '# ruleset sha256 %s\n' "$(sha256sum "${WORK}/ruleset" | cut -d' ' -f1)" > "$1"
    "${NFT_BIN}" list table inet "${FETCH_TABLE}" >> "$1"
}

# live_as_recorded — the live table is, rule for rule and range for range,
# what --apply loaded and checked from the ruleset rendered now. A range
# dropped by hand, a rule added, the chain's policy changed: all differ.
live_as_recorded() {
    local record
    record="$(physical "${FETCH_RECORD}")"
    [[ -f "${record}" && ! -L "${record}" ]] || return 1
    render_record "${WORK}/live"
    cmp -s "${record}" "${WORK}/live"
}

marker_present() {
    [[ -f "$(physical "${FETCH_MARKER}")" ]]
}

# distribution_nftables — the distribution's nftables.service is enabled or
# running: it loads /etc/nftables.conf, which flushes the whole ruleset — this
# table with it — whenever it starts, at boot or by hand, while the marker
# stays.
distribution_nftables() {
    "${SYSTEMCTL_BIN}" is-enabled --quiet nftables.service 2>/dev/null \
        || "${SYSTEMCTL_BIN}" is-active --quiet nftables.service 2>/dev/null
}

# --- Modes -------------------------------------------------------------------------------

WORK=""

render_all() {
    WORK="$(mktemp -d)"
    trap 'rm -rf "${WORK}"' EXIT
    render_sudoers > "${WORK}/sudoers"
    render_ruleset > "${WORK}/ruleset"
    render_unit > "${WORK}/unit"
}

report() {
    local user
    for user in "${FETCH_USERS[@]}"; do
        case "$(fetch_account "${user}")" in
            ours)     item PASS "account:${user}" "a system account with no password, home or shell" ;;
            absent)   item MISSING "account:${user}" "does not exist — --apply creates it" ;;
            unlocked) item FAIL "account:${user}" "has a password — a media fetch account never logs in" ;;
            foreign)  item FAIL "account:${user}" "exists but was not created by RateGuru — it is never taken over" ;;
        esac
    done

    for user in "${FILTERED_USERS[@]}"; do
        retired "${user}" || continue
        item PASS "account:${user}" "its target is retired: kept in the table, and given no sudo rule"
    done

    if resolver_is_stub; then
        item PASS resolver "${RESOLV_CONF} names only ${FETCH_RESOLVER}, the one resolver the table lets the account reach"
    else
        item FAIL resolver "${RESOLV_CONF} does not name ${FETCH_RESOLVER} alone — the table would leave yt-dlp unable to resolve, or reaching a private resolver"
    fi

    case "$(file_state "${FETCH_SUDOERS}" "${WORK}/sudoers" 440)" in
        PASS)    item PASS "file:${FETCH_SUDOERS}" "each active target's runtime user: yt-dlp as its own account — nothing else" ;;
        MISSING) item MISSING "file:${FETCH_SUDOERS}" "absent" ;;
        *)       item DRIFT "file:${FETCH_SUDOERS}" "differs from what this bundle renders — --apply replaces it" ;;
    esac

    case "$(file_state "${FETCH_RULESET}" "${WORK}/ruleset" 644)" in
        PASS)    item PASS "file:${FETCH_RULESET}" "exactly what this bundle renders" ;;
        MISSING) item MISSING "file:${FETCH_RULESET}" "absent" ;;
        *)       item DRIFT "file:${FETCH_RULESET}" "differs from what this bundle renders — --apply replaces it" ;;
    esac

    case "$(file_state "${FETCH_UNIT}" "${WORK}/unit" 644)" in
        PASS)    item PASS "file:${FETCH_UNIT}" "exactly what this bundle renders" ;;
        MISSING) item MISSING "file:${FETCH_UNIT}" "absent" ;;
        *)       item DRIFT "file:${FETCH_UNIT}" "differs from what this bundle renders — --apply replaces it" ;;
    esac

    if "${SYSTEMCTL_BIN}" is-enabled --quiet "${FETCH_UNIT_NAME}" 2>/dev/null; then
        item PASS "unit:${FETCH_UNIT_NAME}" "enabled: the table is loaded at every boot"
    else
        item DRIFT "unit:${FETCH_UNIT_NAME}" "not enabled — the table would be gone after a reboot"
    fi

    if ! table_live; then
        item DRIFT "table:inet ${FETCH_TABLE}" "not loaded as rendered — the application runs no yt-dlp as the accounts until it is"
    elif ! live_as_recorded; then
        item DRIFT "table:inet ${FETCH_TABLE}" "loaded, but not exactly as --apply loaded and checked it from this ruleset (${FETCH_RECORD}) — a rule, a range or the policy changed; --apply loads it again"
    else
        item PASS "table:inet ${FETCH_TABLE}" "loaded exactly as --apply checked it: every fetch account is refused this host's network now"
    fi

    if marker_present; then
        item PASS "marker:${FETCH_MARKER}" "kept by the unit: the application may run yt-dlp as the accounts"
    else
        item DRIFT "marker:${FETCH_MARKER}" "missing — the application runs no yt-dlp as the accounts until the unit has loaded the table"
    fi

    if distribution_nftables; then
        item FAIL "unit:nftables.service" "enabled or running — its flush ruleset removes this table. Disable it as infrastructure/runbooks/bootstrap-host.md says (saving ufw's rules first), then --apply"
    else
        item PASS "unit:nftables.service" "neither enabled nor running: nothing flushes this table"
    fi
}

summary() {
    printf 'SUMMARY  pass=%d fail=%d drift=%d\n' "${COUNT_PASS}" "${COUNT_FAIL}" "${COUNT_DRIFT}"
}

run_check() {
    require_root
    require_host_tools
    load_sources
    render_all
    printf 'install-media-fetch-isolation --check (read-only)\n'
    report
    summary
    (( COUNT_FAIL == 0 ))
}

run_verify() {
    require_root
    require_host_tools
    load_sources
    render_all
    printf 'install-media-fetch-isolation --verify (read-only)\n'
    report
    summary
    (( COUNT_FAIL + COUNT_DRIFT == 0 ))
}

# --- Apply, with its rollback ------------------------------------------------------

BACKUP=""
INSTALLED=()
UNIT_WAS_ENABLED=false

# install_file CANDIDATE LOGICAL MODE — atomically, owner and mode first; the
# file it replaces is kept for the rollback.
install_file() {
    local candidate="$1" logical="$2" mode="$3" path tmp
    path="$(physical "${logical}")"
    # Made when missing, never re-permissioned: /etc/sudoers.d is 0750 and
    # stays so.
    [[ -d "$(dirname "${path}")" ]] || install -d -m 0755 "$(dirname "${path}")"

    if [[ -e "${path}" ]]; then
        mkdir -p "${BACKUP}$(dirname "${logical}")"
        cp -p "${path}" "${BACKUP}${logical}"
    fi
    INSTALLED+=("${logical}")

    tmp="${path}.rateguru-tmp.$$"
    cp "${candidate}" "${tmp}"
    chown "${FILE_OWNER}:${FILE_GROUP}" "${tmp}"
    chmod "0${mode}" "${tmp}"
    mv -f "${tmp}" "${path}"
}

# rollback — every file this run replaced goes back to what it was, one it
# added goes; the table is loaded again from what is left, or removed with it.
rollback() {
    local logical path incomplete=false
    trap - ERR
    set +e
    printf '[rollback] restoring what this run replaced\n' >&2
    for logical in "${INSTALLED[@]}"; do
        path="$(physical "${logical}")"
        rm -f "${path}.rateguru-tmp.$$"
        if [[ -e "${BACKUP}${logical}" ]]; then
            cp -p "${BACKUP}${logical}" "${path}" || incomplete=true
        else
            rm -f "${path}" || incomplete=true
        fi
    done
    [[ "${UNIT_WAS_ENABLED}" == true ]] || "${SYSTEMCTL_BIN}" disable "${FETCH_UNIT_NAME}" >/dev/null 2>&1
    "${SYSTEMCTL_BIN}" daemon-reload >/dev/null 2>&1
    if [[ -f "$(physical "${FETCH_RULESET}")" ]]; then
        "${SYSTEMCTL_BIN}" restart "${FETCH_UNIT_NAME}" >/dev/null 2>&1 \
            || "${NFT_BIN}" -f "$(physical "${FETCH_RULESET}")" >/dev/null 2>&1 || incomplete=true
    else
        "${NFT_BIN}" delete table inet "${FETCH_TABLE}" >/dev/null 2>&1
        rm -f "$(physical "${FETCH_MARKER}")"
    fi
    if [[ "${incomplete}" == true ]]; then
        printf 'ROLLBACK INCOMPLETE: a replaced file could not be restored — check %s, %s, %s and %s by hand\n' \
            "${FETCH_SUDOERS}" "${FETCH_RULESET}" "${FETCH_UNIT}" "${FETCH_RECORD}" >&2
        return 1
    fi
}

# restored — what the failure message says of the rollback that just ran.
restored() {
    if rollback; then
        printf 'what it replaced was restored'
    else
        printf 'the rollback was INCOMPLETE (above)'
    fi
}

on_apply_error() {
    fail "--apply failed; $(restored)"
}

run_apply() {
    local user
    require_root
    require_host_tools
    load_sources
    render_all

    resolver_is_stub \
        || fail "${RESOLV_CONF} does not name ${FETCH_RESOLVER} alone — the table lets the accounts reach that resolver only, so yt-dlp could not resolve. Nothing was changed"

    # Before anything is made: with it, the table could be flushed at any
    # start of that unit while the marker and the sudo rule stay.
    ! distribution_nftables \
        || fail "the distribution's nftables.service is enabled or running — its flush ruleset would remove this table. Disable it as infrastructure/runbooks/bootstrap-host.md says (saving ufw's rules first). Nothing was changed"

    for user in "${FETCH_USERS[@]}"; do
        case "$(fetch_account "${user}")" in
            foreign)  fail "${user} exists but was not created by RateGuru — it is never taken over. Nothing was changed" ;;
            unlocked) fail "${user} has a password — it is never given yt-dlp while it does. Nothing was changed" ;;
        esac
    done

    # The sudo rule needs no account to be checked; it is, before any is made.
    "${VISUDO_BIN}" -cqf "${WORK}/sudoers" >/dev/null \
        || fail "visudo refuses the rendered sudoers rule — nothing was changed"

    for user in "${FETCH_USERS[@]}"; do
        [[ "$(fetch_account "${user}")" == absent ]] || continue
        action "creating the media fetch account ${user} (system, no password, home or shell)"
        "${USERADD_BIN}" --system --user-group --no-create-home --home-dir "${FETCH_HOME}" \
            --shell "${FETCH_SHELL}" --comment "$(fetch_gecos "${user}")" "${user}"
        [[ "$(fetch_account "${user}")" == ours ]] || fail "the media fetch account ${user} could not be created as reviewed"
    done

    # Checked once the accounts exist: the ruleset's skuid names real ones.
    "${NFT_BIN}" -c -f "${WORK}/ruleset" >/dev/null \
        || fail "nft refuses the rendered ruleset — nothing was installed. The accounts made stay; without the marker the application runs no yt-dlp until --apply succeeds"

    BACKUP="${WORK}/backup"
    mkdir -p "${BACKUP}"
    if "${SYSTEMCTL_BIN}" is-enabled --quiet "${FETCH_UNIT_NAME}" 2>/dev/null; then
        UNIT_WAS_ENABLED=true
    fi
    trap on_apply_error ERR

    # The table first, live before anything can run yt-dlp as the account;
    # the rule that lets the targets do so last.
    action "installing the ruleset ${FETCH_RULESET} and its unit ${FETCH_UNIT_NAME}"
    install_file "${WORK}/ruleset" "${FETCH_RULESET}" 644
    install_file "${WORK}/unit" "${FETCH_UNIT}" 644
    "${SYSTEMCTL_BIN}" daemon-reload
    "${SYSTEMCTL_BIN}" enable "${FETCH_UNIT_NAME}" >/dev/null
    action "loading the table inet ${FETCH_TABLE}"
    "${SYSTEMCTL_BIN}" restart "${FETCH_UNIT_NAME}"
    table_live || fail "the table inet ${FETCH_TABLE} is not loaded after --apply — $(restored)"
    # What --verify holds the live table to from now on, whole.
    render_record "${WORK}/record"
    install_file "${WORK}/record" "${FETCH_RECORD}" 644

    action "installing the sudoers rule ${FETCH_SUDOERS}: yt-dlp as each one's own account, for ${RUNTIME_USERS[*]}"
    install_file "${WORK}/sudoers" "${FETCH_SUDOERS}" 440
    "${VISUDO_BIN}" -cqf "$(physical "${FETCH_SUDOERS}")" >/dev/null \
        || fail "visudo refuses the installed sudoers rule — $(restored)"

    trap - ERR
    COUNT_PASS=0 COUNT_FAIL=0 COUNT_DRIFT=0
    report
    summary
    (( COUNT_FAIL + COUNT_DRIFT == 0 )) || fail "the media fetch isolation is not as rendered after --apply (above)"
    action "apply complete — each target's yt-dlp runs as its own account, kept off this host's network"
}

# --- Entry point --------------------------------------------------------------------------

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify)
                [[ -z "${MODE}" ]] || { usage >&2; fail "mode given more than once"; }
                MODE="${1#--}"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done

    [[ -n "${MODE}" ]] || { usage >&2; fail "one of --check, --apply or --verify is required"; }

    case "${MODE}" in
        check)  run_check ;;
        apply)  run_apply ;;
        verify) run_verify ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
