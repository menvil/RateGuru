#!/usr/bin/env bash
#
# Deployment target registry: validation and read-only inspection.
#
# The registry (infrastructure/config/deployment-targets.json, installed at
# /home/www/rateguru/config/deployment-targets.json) is committed, non-secret
# data describing every independently deployable application instance.
#
# This script is deliberately standalone: it does NOT source `common`, because
# `common` requires an installed /home/www/rateguru/config/deployment.conf and
# this script must run in the repository during CI where no such file exists.
#
# The registry is data, never code. It is read with jq only — never sourced,
# never eval'd, never substituted into a shell command. Target IDs never reach
# a jq program by concatenation: the snapshot program below iterates the keys
# itself, and `show` passes its target through --arg.
#
# Usage:
#   targets validate [--file PATH]
#   targets list     [--file PATH]
#   targets show --target TARGET [--file PATH]

set -Eeuo pipefail

REGISTRY_DEFAULT_FILE="/home/www/rateguru/config/deployment-targets.json"
DEPLOYMENT_CONF_FILE="${RATEGURU_DEPLOYMENT_CONF_FILE:-/home/www/rateguru/config/deployment.conf}"
SCHEMA_VERSION=1

# Only this target may currently be active. Every other target must stay
# planned or disabled until the host that serves it has been provisioned.
ACTIVE_ALLOWLIST="staging-main"

# Property names anywhere in the registry that would indicate a secret leaked
# into committed, world-readable data.
SECRET_NAME_PATTERN='password|passwd|secret|token|private_key|privatekey|credential|credentials|dsn|api_key|apikey|access_key|accesskey'

# Values that must be unique across targets: a collision would make two targets
# silently share state, a socket, a backup path, an account or a service unit.
#
# Each entry is "<jq path>|<label>". The jq path must not itself contain '|',
# so array fields use the `[]?` form rather than a pipe.
COLLISION_FIELDS=(
    '.application_root|application_root'
    '.incoming_artifacts|incoming artifacts directory'
    '.runtime_user|runtime user'
    '.runtime_group|runtime group'
    '.deploy_user|deploy user'
    '.code_group|code group'
    '.database.name|database name'
    '.database.application_role|database application role'
    '.health.host_header|health host header'
    '.backup.namespace|backup namespace'
    '.php_fpm.pool|PHP-FPM pool'
    '.php_fpm.socket|PHP-FPM socket'
    '.supervisor.program|Supervisor program'
    '.supervisor.queue|queue name'
    '.scheduler.name|scheduler name'
    '.nginx.site_name|Nginx site name'
    '.nginx.internal_hostname|Nginx internal hostname'
    # Flattened across targets: two targets claiming the same public hostname
    # would collide in Nginx and in certificate issuance.
    '.public_hostnames[]?|public hostname'
    # Two targets declaring the same generated environment template would have
    # the renderer write one target's identity and environment class, then
    # overwrite it with the other's — last one wins, silently, and the target
    # that lost is deployed against a contract describing somebody else.
    '.environment_template|environment template'
)

REQUIRED_STRINGS=(
    .id
    .lifecycle
    .environment_class
    .application_root
    .runtime_user
    .runtime_group
    .deploy_user
    .code_group
    .incoming_artifacts
    .database.name
    .database.application_role
    .health.url
    .health.host_header
    .backup.namespace
    .php_fpm.pool
    .php_fpm.socket
    .supervisor.program
    .supervisor.queue
    .scheduler.name
    .nginx.site_name
    .nginx.internal_hostname
    .environment_template
)

REQUIRED_POSITIVE_INTEGERS=(
    .release_retention
    .backup.local_retention_days
    .backup.offsite_retention_days
)

# Fields that must be strict JSON integers with a hard floor of 2: age-based
# retention must never be able to reduce the backup count below this minimum,
# so a registry that even permits fewer than two retained backups is invalid.
REQUIRED_MINIMUM_COUNTS=(
    .backup.minimum_retained_backups
)

ERROR_COUNT=0

log() {
    printf '%s\n' "$*"
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

# Record a validation problem without aborting, so one run reports every
# problem rather than only the first.
problem() {
    printf 'INVALID: %s\n' "$*" >&2
    ERROR_COUNT=$((ERROR_COUNT + 1))
}

usage() {
    cat >&2 <<'USAGE'
Usage:
  targets validate [--file PATH]
  targets list     [--file PATH]
  targets show --target TARGET [--file PATH]
USAGE
    exit 1
}

# --- argument parsing -------------------------------------------------------

COMMAND=""
REGISTRY_FILE=""
TARGET_ID=""
FILE_SEEN=false
TARGET_SEEN=false

if [[ $# -eq 0 ]]; then
    usage
fi

case "${1}" in
    validate|list|show)
        COMMAND="${1}"
        shift
        ;;
    -h|--help)
        usage
        ;;
    *)
        printf 'ERROR: unknown command: %s\n' "${1}" >&2
        usage
        ;;
esac

while [[ $# -gt 0 ]]; do
    case "${1}" in
        --file)
            if [[ "${FILE_SEEN}" == true ]]; then
                fail "--file given more than once"
            fi

            [[ $# -ge 2 ]] || fail "--file requires a value"

            REGISTRY_FILE="${2}"
            FILE_SEEN=true
            shift 2
            ;;
        --target)
            if [[ "${TARGET_SEEN}" == true ]]; then
                fail "--target given more than once"
            fi

            [[ $# -ge 2 ]] || fail "--target requires a value"

            TARGET_ID="${2}"
            TARGET_SEEN=true
            shift 2
            ;;
        *)
            fail "unknown argument: ${1}"
            ;;
    esac
done

if [[ "${COMMAND}" == "show" ]] && [[ "${TARGET_SEEN}" != true ]]; then
    fail "show requires --target"
fi

if [[ "${COMMAND}" != "show" ]] && [[ "${TARGET_SEEN}" == true ]]; then
    fail "--target is only valid for show"
fi

# TARGET_REGISTRY_FILE normally lives in the installed deployment.conf. `common`
# sees it because it sources that file; this CLI deliberately does not, so it
# reads the value out of the file instead. Relying on the variable being
# exported by the parent shell would not work: deployment.conf assigns without
# `export`, so the value never reaches a child process.
#
# The file is parsed, never sourced or eval'd, and only when it passes the same
# ownership checks `common` already applies to it. Anything unsafe is ignored
# rather than trusted, which degrades to the default path.
deployment_conf_registry_file() {
    local conf="${DEPLOYMENT_CONF_FILE}"

    [[ -e "${conf}" ]] || return 1
    [[ ! -L "${conf}" ]] || return 1
    [[ -f "${conf}" ]] || return 1
    [[ -r "${conf}" ]] || return 1

    # Ownership is only demanded of the installed path, so a test fixture
    # pointed at by RATEGURU_DEPLOYMENT_CONF_FILE works without root.
    if [[ "${conf}" == "/home/www/rateguru/config/deployment.conf" ]]; then
        [[ "$(stat -c '%u:%g' "${conf}")" == "0:0" ]] || return 1

        local mode
        mode="$(stat -c '%a' "${conf}")"

        (( (8#${mode} & 8#022) == 0 )) || return 1
    fi

    local value
    value="$(
        sed -n 's/^[[:space:]]*TARGET_REGISTRY_FILE[[:space:]]*=[[:space:]]*//p' "${conf}" \
            | tail -n 1
    )"

    # Strip one layer of surrounding quotes; reject anything still containing
    # shell metacharacters rather than trying to interpret it.
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"

    [[ -n "${value}" ]] || return 1
    [[ "${value}" != *['$`;&|<>()']* ]] || return 1

    printf '%s\n' "${value}"
}

# One resolution contract, identical to `common`, with --file layered on top as
# the most specific source:
#   1. --file            (CLI only; an explicitly empty value is rejected)
#   2. RATEGURU_TARGET_REGISTRY_FILE
#   3. TARGET_REGISTRY_FILE  (environment, else parsed from deployment.conf)
#   4. REGISTRY_DEFAULT_FILE
if [[ "${FILE_SEEN}" == true ]]; then
    [[ -n "${REGISTRY_FILE}" ]] || fail "--file requires a non-empty value"
elif [[ -n "${RATEGURU_TARGET_REGISTRY_FILE:-}" ]]; then
    REGISTRY_FILE="${RATEGURU_TARGET_REGISTRY_FILE}"
elif [[ -n "${TARGET_REGISTRY_FILE:-}" ]]; then
    REGISTRY_FILE="${TARGET_REGISTRY_FILE}"
elif REGISTRY_FILE="$(deployment_conf_registry_file)"; then
    :
else
    REGISTRY_FILE="${REGISTRY_DEFAULT_FILE}"
fi

# --- registry snapshot ------------------------------------------------------
#
# Every rule below used to run its own jq process against the registry — 136 of
# them for a two-target registry — once in every shell that validates it, which
# is every operational script and every child it starts. Now ONE jq process
# reads the file and emits every value the rules need as NUL-delimited
# "key, value" pairs, and the rules read them from an associative array.
#
# Each value is written exactly as the per-value `jq -r` call used to print it:
# raw text for strings, jq's own rendering for numbers and booleans, pretty
# JSON for anything else. The reader then strips trailing newlines, which is
# what `$(...)` did to each of the old captures, and the rules that split a
# value into lines keep doing so. Every verdict therefore stays the same, with
# two deliberate exceptions. A file holding anything other than exactly one JSON
# document (an empty file, two documents, a stray value before the object) is
# rejected as not valid JSON instead of being read document by document. And a
# NUL character anywhere in the document — a key or a string value, however
# deeply nested — is rejected outright: NUL is the record delimiter, so one
# inside a key or value would shift every pair that follows it, and bash used to
# drop such bytes from a capture with a warning and validate what was left.
# Nothing in a registry legitimately contains one.
#
# Target IDs are never interpolated into the program. It iterates keys_unsorted
# itself and labels each record with the key it came from; the only text spliced
# into it is the constant property lists declared at the top of this file.
#
# Record keys, with SEP = 0x1f:
#   D                 number of JSON documents in the file
#   Y                 type of the (single) document
#   Z                 "1" when a NUL character occurs anywhere in the document;
#                     no further records are written then
#   V / F             schema_version verdict ("ok"/"bad") / its rendered value
#   S                 secret-like property names, one per line
#   O / N             type of .targets / number of targets
#   K                 target IDs, one per line
#   P SEP id SEP path class of one property: "s" string, "i" integer, "f"
#                     non-integer number, "A" absent, null or false, "o" other
#   W SEP id SEP path the property's rendered value
#   H SEP id SEP name public_hostnames facts: type, count, all, offending,
#                     unique, entries
#   C SEP jq-path     values shared by more than one target, one per line
#   END               written last, so a jq failure leaves it absent

declare -A SNAPSHOT=()
SNAPSHOT_SEP=$'\x1f'
SNAPSHOT_PROGRAM=""

# Assembles the jq program into SNAPSHOT_PROGRAM by concatenation. Not through
# `${program/PLACEHOLDER/...}`: since bash 5.2 an `&` in the replacement stands
# for the matched text, and the hosts run 5.1.
build_snapshot_program() {
    local path entry jq_path

    SNAPSHOT_PROGRAM='
def rec(k; v): k, "\u0000", v, "\u0000";
# split, not contains: jq 1.6 reads a NUL needle as an empty string in
# contains, which then matches every string.
def has_nul: ([.. | strings] + [paths | .[] | strings]) | any((split("\u0000") | length) > 1);
def class:
    if . == null then "A"
    else .[0] as $v
        | if $v == null or $v == false then "A"
          elif ($v | type) == "string" then "s"
          elif ($v | type) == "number" then (if $v == ($v | floor) then "i" else "f" end)
          else "o"
          end
    end;
def value: if . == null then "" else .[0] end;
[inputs] as $docs
| rec("D"; ($docs | length | tostring)),
  if ($docs | length) == 1 then
    $docs[0] as $r
    | ($r | has_nul) as $nul
    | rec("Y"; ($r | type)),
      rec("Z"; (if $nul then "1" else "0" end)),
      if ($r | type) == "object" and ($nul | not) then
        rec("V"; if (($r.schema_version | type) == "number"
                     and ($r.schema_version == ($expected | floor))
                     and ($r.schema_version == $expected)) then "ok" else "bad" end),
        rec("F"; ($r.schema_version // "missing")),
        rec("S"; ([ $r | paths as $p
                    | $p[-1]
                    | select(type == "string")
                    | select(test($pattern; "i"))
                  ] | unique | join("\n"))),
        rec("O"; ($r.targets | type)),
        if ($r.targets | type) == "object" then
          rec("N"; ($r.targets | length | tostring)),
          rec("K"; ($r.targets | keys_unsorted | join("\n"))),
          ( $r.targets | keys_unsorted[] as $id
            | $r.targets[$id] as $t
            | ("P" + $sep + $id + $sep) as $pk
            | ("W" + $sep + $id + $sep) as $wk
            | ("H" + $sep + $id + $sep) as $hk
            | ( '

    # One try per property: a target that is not an object, or a nested object
    # that is a scalar, must fail that property alone — exactly what a failing
    # per-property jq process did — and never abort the whole snapshot.
    for path in "${REQUIRED_STRINGS[@]}" "${REQUIRED_POSITIVE_INTEGERS[@]}" "${REQUIRED_MINIMUM_COUNTS[@]}"; do
        SNAPSHOT_PROGRAM+="(try [ (\$t | ${path}) ] catch null) as \$w | rec(\$pk + \"${path}\"; (\$w | class)), rec(\$wk + \"${path}\"; (\$w | value)), "
    done

    SNAPSHOT_PROGRAM+='empty ),
              ( try ($t.public_hostnames | type) catch "error" ) as $ht
            | rec($hk + "type"; $ht),
              if $ht == "array" then
                $t.public_hostnames as $ph
                | all($ph[]; type == "string" and length > 0) as $all
                | rec($hk + "count"; ($ph | length | tostring)),
                  rec($hk + "all"; (if $all then "true" else "false" end)),
                  rec($hk + "offending"; ([ $ph[]
                      | select((type != "string") or (length == 0))
                      | "\(type):\(tojson)"
                    ] | join(", "))),
                  rec($hk + "unique"; ($ph | unique | length | tostring)),
                  rec($hk + "entries"; (if $all then ($ph | join("\n")) else "" end))
              else empty end
          ),
          ( '

    for entry in "${COLLISION_FIELDS[@]}"; do
        jq_path="${entry%%|*}"
        SNAPSHOT_PROGRAM+="rec(\"C\" + \$sep + \"${jq_path}\"; (try ([ \$r.targets[] | ${jq_path} | select(type == \"string\") ] | group_by(.) | map(select(length > 1) | .[0]) | join(\"\\n\")) catch \"\")), "
    done

    SNAPSHOT_PROGRAM+='empty )
        else empty end
      else empty end
  else empty end,
  rec("END"; "")
'
}

# Fills SNAPSHOT from the registry in one jq process. Returns non-zero when jq
# could not parse the file or died before writing the END record.
load_snapshot() {
    build_snapshot_program

    local -a fields=()
    mapfile -d '' -t fields < <(
        jq -n -j \
            --arg pattern "${SECRET_NAME_PATTERN}" \
            --arg sep "${SNAPSHOT_SEP}" \
            --argjson expected "${SCHEMA_VERSION}" \
            "${SNAPSHOT_PROGRAM}" \
            "${REGISTRY_FILE}" 2>/dev/null
    )

    local i=0 key value
    while (( i + 1 < ${#fields[@]} )); do
        key="${fields[i]}"
        value="${fields[i + 1]}"

        while [[ "${value}" == *$'\n' ]]; do
            value="${value%$'\n'}"
        done

        SNAPSHOT["${key}"]="${value}"
        i=$((i + 2))
    done

    [[ -n "${SNAPSHOT[END]+set}" ]]
}

# snapshot_get VAR KEY: stores the record's value in VAR, empty when absent.
snapshot_get() {
    printf -v "$1" '%s' "${SNAPSHOT["$2"]-}"
}

# --- file-level checks ------------------------------------------------------

# A symlink is rejected everywhere: it lets the validated path and the read path
# diverge. Ownership/mode are only demanded for the installed runtime default,
# so repository validation works without root.
assert_registry_file() {
    if [[ -L "${REGISTRY_FILE}" ]]; then
        fail "target registry must not be a symlink: ${REGISTRY_FILE}"
    fi

    if [[ ! -e "${REGISTRY_FILE}" ]]; then
        fail "target registry is unavailable: ${REGISTRY_FILE}"
    fi

    if [[ ! -f "${REGISTRY_FILE}" ]]; then
        fail "target registry must be a regular file: ${REGISTRY_FILE}"
    fi

    if [[ ! -r "${REGISTRY_FILE}" ]]; then
        fail "target registry is not readable: ${REGISTRY_FILE}"
    fi

    if [[ "${REGISTRY_FILE}" == "${REGISTRY_DEFAULT_FILE}" ]]; then
        if [[ "$(stat -c '%u:%g' "${REGISTRY_FILE}")" != "0:0" ]]; then
            fail "target registry must be owned by root:root: ${REGISTRY_FILE}"
        fi

        local mode
        mode="$(stat -c '%a' "${REGISTRY_FILE}")"

        if (( (8#${mode} & 8#020) != 0 )); then
            fail "target registry must not be group-writable: ${REGISTRY_FILE}"
        fi

        if (( (8#${mode} & 8#002) != 0 )); then
            fail "target registry must not be world-writable: ${REGISTRY_FILE}"
        fi
    fi

    # Exactly one JSON document, and that document an object.
    if ! load_snapshot || [[ "${SNAPSHOT[D]-}" != "1" ]] || [[ "${SNAPSHOT[Y]-}" != "object" ]]; then
        fail "target registry is not valid JSON: ${REGISTRY_FILE}"
    fi

    if [[ "${SNAPSHOT[Z]-}" == "1" ]]; then
        fail "target registry must not contain NUL characters: ${REGISTRY_FILE}"
    fi
}

assert_schema_version() {
    if [[ "${SNAPSHOT[V]-}" != "ok" ]]; then
        local found
        snapshot_get found "F"

        fail "unsupported target registry schema_version: ${found} (expected ${SCHEMA_VERSION})"
    fi
}

# target_property VAR TARGET_ID JQ_PATH: stores one property of one target in
# VAR. Leaves it empty and returns non-zero when the property is absent, null or
# false, so callers can distinguish "missing" from "empty".
target_property() {
    local target_id="$2"
    local jq_path="$3"

    local class
    snapshot_get class "P${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${jq_path}"

    if [[ -z "${class}" ]] || [[ "${class}" == "A" ]]; then
        printf -v "$1" ''

        return 1
    fi

    snapshot_get "$1" "W${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${jq_path}"
}

# --- value validators -------------------------------------------------------

is_absolute_normalized_path() {
    local path="$1"

    [[ "${path}" == /* ]] || return 1
    [[ "${path}" != *//* ]] || return 1
    [[ "${path}" != */ ]] || return 1
    [[ "${path}" != *"/./"* ]] && [[ "${path}" != */. ]] || return 1
    [[ "${path}" != *"/../"* ]] && [[ "${path}" != */.. ]] || return 1
    [[ "${path}" != *".."* ]] || return 1

    return 0
}

is_safe_postgres_identifier() {
    [[ "$1" =~ ^[a-z_][a-z0-9_]{0,62}$ ]]
}

# Linux account names: portable charset, must not start with a digit or dash,
# and must fit the 32-byte utmp limit.
is_safe_account_name() {
    local name="$1"

    [[ "${#name}" -le 32 ]] || return 1
    [[ "${name}" =~ ^[a-z_][a-z0-9_-]*$ ]]
}

# Values that are rendered verbatim into Nginx, PHP-FPM, Supervisor and cron
# configuration for a generic production target. The renderer treats every
# registry value as DATA — never as shell, never through eval or envsubst — and
# this closed format is what makes that safe: a name matching it cannot carry a
# newline, a quote, a comment character, a directive separator or a path.
#
# Deliberately excludes '.': a cron.d entry whose filename contains a dot is
# silently ignored by cron, so a scheduler name with one would install a file
# that never runs. One class for all five keeps the rendered families
# consistent, and nothing in the registry has ever needed a dot.
is_safe_service_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]]
}

is_plain_hostname() {
    local hostname="$1"

    [[ -n "${hostname}" ]] || return 1
    [[ "${hostname}" != *[[:space:]]* ]] || return 1
    [[ "${hostname}" != *"://"* ]] || return 1
    [[ "${hostname}" != */* ]] || return 1
    [[ "${hostname}" != *:* ]] || return 1
    [[ "${hostname}" != *"*"* ]] || return 1
    [[ "${hostname}" != .* ]] && [[ "${hostname}" != *. ]] || return 1
    [[ "${hostname}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || return 1
    [[ "${hostname}" != *..* ]] || return 1

    return 0
}

is_positive_integer() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

# --- schema validation ------------------------------------------------------

validate_secret_free() {
    local offenders
    snapshot_get offenders "S"

    if [[ -n "${offenders}" ]]; then
        local name
        while IFS= read -r name; do
            [[ -n "${name}" ]] || continue
            problem "registry contains a secret-like property name: ${name}"
        done <<< "${offenders}"
    fi
}

validate_structure() {
    if [[ "${SNAPSHOT[O]-}" != "object" ]]; then
        problem "targets must be an object"

        return
    fi

    local count
    snapshot_get count "N"

    if ! (( count > 0 )); then
        problem "targets must not be empty"
    fi
}

validate_target() {
    local target_id="$1"

    if [[ ! "${target_id}" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]]; then
        problem "invalid target ID: ${target_id}"

        return
    fi

    local declared_id
    if ! target_property declared_id "${target_id}" '.id'; then
        problem "${target_id}: missing id"
    elif [[ "${declared_id}" != "${target_id}" ]]; then
        problem "${target_id}: id property is ${declared_id}, must match its object key"
    fi

    local path class
    for path in "${REQUIRED_STRINGS[@]}"; do
        local value
        snapshot_get class "P${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${path}"

        if [[ "${class}" != "s" ]]; then
            problem "${target_id}: ${path} is missing, null or not a string"

            continue
        fi

        snapshot_get value "W${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${path}"

        if [[ -z "${value}" ]]; then
            problem "${target_id}: ${path} must not be empty"
        fi
    done

    for path in "${REQUIRED_POSITIVE_INTEGERS[@]}"; do
        local value
        snapshot_get class "P${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${path}"

        if [[ "${class}" != "i" ]]; then
            problem "${target_id}: ${path} is missing, null or not an integer"

            continue
        fi

        snapshot_get value "W${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${path}"

        if ! is_positive_integer "${value}"; then
            problem "${target_id}: ${path} must be a positive integer, got ${value}"
        fi
    done

    for path in "${REQUIRED_MINIMUM_COUNTS[@]}"; do
        local value
        snapshot_get class "P${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${path}"

        if [[ "${class}" != "i" ]]; then
            problem "${target_id}: ${path} is missing, null or not an integer"

            continue
        fi

        snapshot_get value "W${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}${path}"

        if ! is_positive_integer "${value}" || (( value < 2 )); then
            problem "${target_id}: ${path} must be an integer >= 2, got ${value}"
        fi
    done

    validate_target_enums "${target_id}"
    validate_target_paths "${target_id}"
    validate_target_accounts "${target_id}"
    validate_target_service_names "${target_id}"
    validate_target_network "${target_id}"
}

# The five names a production target's service configuration is rendered
# around. They are validated here, once, rather than in each renderer: the
# registry is the only place a value can enter the system, so a closed format
# proved at the boundary is the one that every consumer inherits.
validate_target_service_names() {
    local target_id="$1"

    local entry field label value
    for entry in \
        '.php_fpm.pool|php_fpm.pool' \
        '.supervisor.program|supervisor.program' \
        '.supervisor.queue|supervisor.queue' \
        '.scheduler.name|scheduler.name' \
        '.nginx.site_name|nginx.site_name'
    do
        field="${entry%%|*}"
        label="${entry#*|}"

        target_property value "${target_id}" "${field}" || true

        if [[ -n "${value}" ]] && ! is_safe_service_name "${value}"; then
            problem "${target_id}: ${label} must be a lowercase service name matching [a-z0-9][a-z0-9_-]{0,63} (it is rendered verbatim into service configuration): ${value}"
        fi
    done

    # The pool socket's basename is the one path component derived from a
    # service name rather than declared as one. A socket whose file name does
    # not follow the same closed format would let a path be smuggled in
    # through php_fpm.socket while php_fpm.pool stayed innocent.
    local socket basename
    target_property socket "${target_id}" '.php_fpm.socket' || true

    if [[ -n "${socket}" ]] && [[ "${socket}" == *.sock ]]; then
        basename="${socket##*/}"
        basename="${basename%.sock}"

        # No -n check: "/run/php/.sock" strips to an empty basename, which is
        # exactly the value a closed format has to reject rather than skip.
        if ! is_safe_service_name "${basename}"; then
            problem "${target_id}: php_fpm.socket file name must be a lowercase service name matching [a-z0-9][a-z0-9_-]{0,63}.sock: ${socket}"
        fi
    fi
}

validate_target_enums() {
    local target_id="$1"

    local lifecycle
    target_property lifecycle "${target_id}" '.lifecycle' || true

    case "${lifecycle}" in
        active|planned|disabled)
            ;;
        *)
            problem "${target_id}: lifecycle must be active, planned or disabled, got '${lifecycle}'"
            ;;
    esac

    # Only the proven staging target may be active in this slice. A planned or
    # disabled target must never be mistaken for something deployable.
    if [[ "${lifecycle}" == "active" ]] && [[ "${target_id}" != "${ACTIVE_ALLOWLIST}" ]]; then
        problem "${target_id}: lifecycle=active is currently allowed only for ${ACTIVE_ALLOWLIST}"
    fi

    local environment_class
    target_property environment_class "${target_id}" '.environment_class' || true

    case "${environment_class}" in
        staging|production)
            ;;
        *)
            problem "${target_id}: environment_class must be staging or production, got '${environment_class}'"
            ;;
    esac
}

validate_target_paths() {
    local target_id="$1"

    local application_root incoming socket
    target_property application_root "${target_id}" '.application_root' || true
    target_property incoming "${target_id}" '.incoming_artifacts' || true
    target_property socket "${target_id}" '.php_fpm.socket' || true

    if [[ -n "${application_root}" ]]; then
        if ! is_absolute_normalized_path "${application_root}"; then
            problem "${target_id}: application_root must be an absolute normalized path without '..': ${application_root}"
        elif [[ "${application_root}" != /home/www/rateguru/* ]]; then
            problem "${target_id}: application_root must live below /home/www/rateguru: ${application_root}"
        fi
    fi

    if [[ -n "${incoming}" ]]; then
        if ! is_absolute_normalized_path "${incoming}"; then
            problem "${target_id}: incoming_artifacts must be an absolute normalized path without '..': ${incoming}"
        elif [[ "${incoming}" != /home/* ]]; then
            problem "${target_id}: incoming_artifacts must live below /home: ${incoming}"
        fi
    fi

    if [[ -n "${socket}" ]]; then
        if ! is_absolute_normalized_path "${socket}"; then
            problem "${target_id}: php_fpm.socket must be an absolute normalized path without '..': ${socket}"
        else
            if [[ "${socket}" != /run/php/* ]]; then
                problem "${target_id}: php_fpm.socket must live below /run/php: ${socket}"
            fi

            if [[ "${socket}" != *.sock ]]; then
                problem "${target_id}: php_fpm.socket must end with .sock: ${socket}"
            fi
        fi
    fi

    local template
    target_property template "${target_id}" '.environment_template' || true

    if [[ -n "${template}" ]]; then
        if [[ "${template}" == /* ]]; then
            problem "${target_id}: environment_template must be repository-relative: ${template}"
        elif [[ "${template}" == *".."* ]]; then
            problem "${target_id}: environment_template must not contain '..': ${template}"
        elif [[ "${template}" != infrastructure/templates/environment/* ]]; then
            problem "${target_id}: environment_template must live under infrastructure/templates/environment/: ${template}"
        fi
    fi
}

validate_target_accounts() {
    local target_id="$1"

    local field
    for field in runtime_user runtime_group deploy_user code_group; do
        local value
        target_property value "${target_id}" ".${field}" || true

        if [[ -n "${value}" ]] && ! is_safe_account_name "${value}"; then
            problem "${target_id}: ${field} is not a safe Linux account name (<=32 chars): ${value}"
        fi
    done

    # The code group owns release files and is shared with the deploy user and
    # www-data. Collapsing it into the runtime user's own group would hand the
    # runtime user ownership of the code it executes, which is precisely the
    # separation the staging model exists to maintain.
    local runtime_user runtime_group code_group
    target_property runtime_user "${target_id}" '.runtime_user' || true
    target_property runtime_group "${target_id}" '.runtime_group' || true
    target_property code_group "${target_id}" '.code_group' || true

    if [[ -n "${code_group}" ]]; then
        if [[ "${code_group}" == "${runtime_group}" ]]; then
            problem "${target_id}: code_group must differ from runtime_group (both '${code_group}')"
        fi

        if [[ "${code_group}" == "${runtime_user}" ]]; then
            problem "${target_id}: code_group must not be the runtime user's own group ('${code_group}')"
        fi
    fi

    local database_name database_role
    target_property database_name "${target_id}" '.database.name' || true
    target_property database_role "${target_id}" '.database.application_role' || true

    if [[ -n "${database_name}" ]] && ! is_safe_postgres_identifier "${database_name}"; then
        problem "${target_id}: database.name is not a safe PostgreSQL identifier: ${database_name}"
    fi

    if [[ -n "${database_role}" ]] && ! is_safe_postgres_identifier "${database_role}"; then
        problem "${target_id}: database.application_role is not a safe PostgreSQL identifier: ${database_role}"
    fi
}

validate_target_network() {
    local target_id="$1"

    local health_url
    target_property health_url "${target_id}" '.health.url' || true

    if [[ "${health_url}" != "http://127.0.0.1/" ]]; then
        problem "${target_id}: health.url must be http://127.0.0.1/ (health checks go through the loopback vhost), got '${health_url}'"
    fi

    local hostname host_header internal_hostname
    target_property host_header "${target_id}" '.health.host_header' || true
    target_property internal_hostname "${target_id}" '.nginx.internal_hostname' || true

    for hostname in "${host_header}" "${internal_hostname}"; do
        if [[ -n "${hostname}" ]] && ! is_plain_hostname "${hostname}"; then
            problem "${target_id}: '${hostname}' is not a bare hostname (no scheme, path, port, wildcard or whitespace)"
        fi
    done

    local hostnames_key="H${SNAPSHOT_SEP}${target_id}${SNAPSHOT_SEP}"
    local hostnames_type
    snapshot_get hostnames_type "${hostnames_key}type"

    if [[ "${hostnames_type}" != "array" ]]; then
        problem "${target_id}: public_hostnames must be an array"

        return
    fi

    local count
    snapshot_get count "${hostnames_key}count"

    if (( count < 1 )); then
        problem "${target_id}: public_hostnames must contain at least one hostname"

        return
    fi

    # Every element must be a non-empty string *before* any hostname check.
    # Without this, `tostring` would turn 123/true/null into "123"/"true"/"null",
    # each of which satisfies the bare-hostname pattern.
    local all_strings
    snapshot_get all_strings "${hostnames_key}all"

    if [[ "${all_strings}" != "true" ]]; then
        local offending
        snapshot_get offending "${hostnames_key}offending"

        problem "${target_id}: every public hostname must be a non-empty string (offending: ${offending})"

        return
    fi

    local unique_count
    snapshot_get unique_count "${hostnames_key}unique"

    if [[ "${unique_count}" != "${count}" ]]; then
        problem "${target_id}: public_hostnames contains duplicates"
    fi

    # Safe to read as raw strings now that every element is known to be one.
    local entries
    snapshot_get entries "${hostnames_key}entries"

    while IFS= read -r hostname; do
        [[ -n "${hostname}" ]] || continue

        if ! is_plain_hostname "${hostname}"; then
            problem "${target_id}: public hostname '${hostname}' is not a bare hostname"
        fi
    done <<< "${entries}"
}

validate_collisions() {
    local entry
    for entry in "${COLLISION_FIELDS[@]}"; do
        local jq_path="${entry%%|*}"
        local label="${entry#*|}"

        local duplicates
        snapshot_get duplicates "C${SNAPSHOT_SEP}${jq_path}"

        local value
        while IFS= read -r value; do
            [[ -n "${value}" ]] || continue
            problem "duplicate ${label} across targets: ${value}"
        done <<< "${duplicates}"
    done
}

# --- commands ---------------------------------------------------------------

# The single validation path. Every command runs this before producing output,
# so `list` and `show` can never present a registry that `validate` rejects —
# reading a target whose socket, retention or database name is invalid is just
# as wrong as validating it.
#
# All diagnostics go to stderr, so a command's normal output stays clean and a
# failing run emits none of it.
assert_registry_valid() {
    assert_registry_file
    assert_schema_version
    validate_secret_free
    validate_structure

    if (( ERROR_COUNT == 0 )); then
        local target_id target_ids
        snapshot_get target_ids "K"

        while IFS= read -r target_id; do
            [[ -n "${target_id}" ]] || continue
            validate_target "${target_id}"
        done <<< "${target_ids}"

        validate_collisions
    fi

    if (( ERROR_COUNT > 0 )); then
        printf 'ERROR: target registry is invalid (%d problem(s)): %s\n' \
            "${ERROR_COUNT}" "${REGISTRY_FILE}" >&2

        exit 1
    fi
}

command_validate() {
    assert_registry_valid

    log "target registry is valid: ${REGISTRY_FILE}"
}

command_list() {
    assert_registry_valid

    # Sorted by target ID so output is stable regardless of file key order.
    jq -r '
        .targets
        | to_entries
        | sort_by(.key)[]
        | [.key, (.value.lifecycle // "?"), (.value.environment_class // "?")]
        | @tsv
    ' "${REGISTRY_FILE}"
}

command_show() {
    assert_registry_valid

    if [[ ! "${TARGET_ID}" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]]; then
        fail "invalid target ID: ${TARGET_ID}"
    fi

    if ! jq -e --arg id "${TARGET_ID}" '.targets | has($id)' \
        "${REGISTRY_FILE}" >/dev/null 2>&1
    then
        fail "unknown target: ${TARGET_ID}"
    fi

    jq -S --arg id "${TARGET_ID}" '.targets[$id]' "${REGISTRY_FILE}"
}

case "${COMMAND}" in
    validate)
        command_validate
        ;;
    list)
        command_list
        ;;
    show)
        command_show
        ;;
esac
