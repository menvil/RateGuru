#!/usr/bin/env bash
#
# activate-mail-inbound — the guarded switch of the host's inbound mail
# receiver to PUBLIC SMTP on TCP 25, its verification, and its rollback.
#
#   activate-mail-inbound --check    --target TARGET   read-only: may --apply proceed
#   activate-mail-inbound --apply    --target TARGET   install if needed, prove, open TCP 25 (root)
#   activate-mail-inbound --verify   --target TARGET   read-only: what the host is, and whether it is right
#   activate-mail-inbound --rollback --target TARGET   close TCP 25, receiver disabled (root)
#
# WHAT ASKS FOR IT. Not the caller: the trusted bundle this script runs from.
# Its mail-inbound.json must request public SMTP (`receiver.public_smtp:
# enabled`) and TARGET must be a production target its inbound plan receives
# for. Otherwise every mode that would change something refuses — "activation
# is not requested by this trusted bundle" — before it changes anything. The
# receiver serves every target of the plan; TARGET is the one whose operator
# runs this, and its GitHub Environment the one that authorizes it.
#
# --apply, under the host's infrastructure lock:
#
#   1. The request, as above.
#   2. Already done? A host whose receiver is enabled and verifies — the
#      receiver, its listener's owner, the firewall rule, the gateway — is a
#      no-op that succeeds.
#   3. The proof, before anything public changes, all of it required:
#        - the host's public IPv4 address, from its route to the Internet,
#          judged globally reachable by `mail-inbound render-dns`;
#        - a valid TLS certificate for every MX host name
#          (install-mail-inbound --tls-check);
#        - the outbound mail gateway verifies (install-mail-gateway --verify),
#          and its configuration files are recorded, to be proved unchanged;
#        - nothing listens on 25, 465 or 587 that may not (public-smtp-port);
#        - the host's firewall is one this script can manage — ufw, active —
#          or there provably is none; anything else refuses;
#        - the receiver installs or converges, still disabled
#          (install-mail-inbound --apply, then --verify);
#        - the live receiver, on its loopback listener: no SMTP AUTH, the
#          reviewed message size, every address of a corpus answered exactly
#          as `mail-inbound route` judges it, the recipient limit enforced, the
#          null sender accepted, and one probe message stored in the host
#          postmaster's mailbox, then removed.
#   4. The rollback capsule, written before anything public changes.
#   5. TCP 25 opened for exactly that address (ufw), a one-use ENABLE
#      authorization for the receiver, install-mail-inbound --apply — which
#      consumes it and adds the public listener — and the proof again: the
#      receiver verifies, port 25 is owned by its unit alone on that address,
#      465 and 587 are closed, the firewall rule is there, the gateway still
#      verifies and its files are byte for byte what they were.
#   6. Any failure from step 5 on returns the host to disabled through the
#      same code — a one-use DISABLE authorization, the receiver's apply, the
#      firewall rule removed — and proves it. When even that cannot be proved
#      the result is CRITICAL and nothing broader is attempted: the gateway,
#      OpenDKIM and every queue are never touched by this script.
#
# --rollback closes public SMTP whatever the bundle requests: the DISABLE
# authorization, the receiver's apply, RateGuru's firewall rule removed — and
# only it — and the proof that nothing listens on 25 any more. The receiver
# stays installed and keeps every message it stored. Published MX records are
# not touched: the operator removes them, or they point at a closed port.
#
# --verify is read-only, and says which state the host is in:
#   not-installed       no receiver on this host
#   installed-disabled  the receiver verifies, nothing listens on 25, no rule
#   enabled-verified    the receiver verifies, it alone listens on the
#                       recorded address, the firewall rule is there
#   drift               anything else — reported as a failure
# and in every state, that the outbound gateway still verifies.
#
# NEVER. No DNS record is published, no message is read or printed — the probe
# is found by its own random token and removed — no rule of the firewall but
# RateGuru's own TCP 25 rule is added or removed, and no SSH, HTTP or HTTPS
# rule is touched. The provider's own firewall, outside the host, is the
# operator's: this script says what it needs and never claims it.
#
# Every run whose mode and target were understood ends with exactly one line
# RATEGURU_MAIL_INBOUND_ACTIVATION_RESULT={target, mode, status, requested,
# changed, rolled_back, state, public_smtp, address, firewall}; status is pass,
# fail or critical.
#
# Repository tooling: run as root from a trusted bundle by its workflows, never
# installed on a host.
#
# Test overrides: the RATEGURU_MAILINBOUNDACTIVATE_* variables below are
# honoured only alongside RATEGURU_ALLOW_TEST_OVERRIDES=true.

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

gated_default() {
    local var_name="$1" default_value="$2"

    if rateguru_test_overrides_allowed && [[ -n "${!var_name:-}" ]]; then
        printf '%s\n' "${!var_name}"
    else
        printf '%s\n' "${default_value}"
    fi
}

EFFECTIVE_UID="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_EUID "${EUID}")"
FS_ROOT="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_FS_ROOT '')"

# The host's one infrastructure lock: the same file prepare-host and every
# other host-level operation hold.
RUN_ROOT="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_RUN_ROOT /home/www/rateguru/run)"
HOST_LOCK_NAME="host-infrastructure.lock"

# shellcheck disable=SC2034 # read by public-smtp-port
SS_BIN="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_SS_BIN ss)"
IP_BIN="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_IP_BIN ip)"
UFW_BIN="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_UFW_BIN ufw)"
NFT_BIN="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_NFT_BIN nft)"
IPTABLES_SAVE_BIN="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_IPTABLES_SAVE_BIN iptables-save)"
IPTABLES_LEGACY_SAVE_BIN="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_IPTABLES_LEGACY_SAVE_BIN iptables-legacy-save)"

# The receiver's loopback port comes from the plan; the test seam alone points
# the probes elsewhere.
PROBE_PORT_OVERRIDE="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_PROBE_PORT '')"
PROBE_WAIT="$(gated_default RATEGURU_MAILINBOUNDACTIVATE_PROBE_WAIT 60)"
[[ "${PROBE_WAIT}" =~ ^[1-9][0-9]*$ ]] || PROBE_WAIT=60

# The SMTP conversations, and the one judge of who may listen on a public SMTP
# port.
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/smtp-submission"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/public-smtp-port"

INBOUND_CONTRACT="${REPO_ROOT}/infrastructure/config/mail-inbound.json"

STATE_DIR="${PUBLIC_SMTP_INBOUND_STATE_DIR}"
TRANSITION_AUTHORIZATION="${STATE_DIR}/transition-authorization.json"
AUTHORIZATION_KIND="rateguru-mail-inbound-transition-authorization"
AUTHORIZATION_LIFETIME=900

CAPSULE_ROOT="/var/lib/rateguru-mail-inbound-activation"
CAPSULE_KIND="rateguru-mail-inbound-activation"

STORE_DIR="/var/spool/rateguru-mail-inbound/store"
HOST_POSTMASTER_MAILBOX="host/postmaster/"

# The gateway's own configuration and record: proved byte for byte unchanged.
GATEWAY_FILES=(
    /etc/postfix/main.cf
    /etc/postfix/master.cf
    /var/lib/rateguru-mail-gateway/applied-plan.json
    /var/lib/rateguru-mail-gateway/applied-outbound.json
)

FIREWALL_COMMENT="rateguru-mail-inbound"

MODE=""
TARGET_ID=""

RESULT_READY=false
RESULT_PRINTED=false
REQUESTED=false
CHANGED=false
ROLLED_BACK=false
HOST_STATE="unknown"
PUBLIC_STATE="unknown"
ADDRESS=""
FIREWALL_MODE="unknown"

TRANSACTION_OPEN=false
GATEWAY_DIGESTS=""
PLAN=""
COUNT_FAIL=0

log() { printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"; }
ok() { printf '  PASS %s\n' "$*"; }
bad() { printf '  FAIL %s\n' "$*"; COUNT_FAIL=$((COUNT_FAIL + 1)); }

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage:
  activate-mail-inbound --check    --target TARGET
  activate-mail-inbound --apply    --target TARGET
  activate-mail-inbound --verify   --target TARGET
  activate-mail-inbound --rollback --target TARGET
  activate-mail-inbound --help

  --check     Read-only (root): whether --apply would activate, would be a
              no-op, or must refuse, with every precondition it can judge
              without changing the host.
  --apply     Root. Install the receiver if needed, prove it, open public TCP
              25 for exactly the host's address, and prove it again; any
              failure returns the receiver to disabled. A no-op when the
              receiver is already enabled and verifies.
  --verify    Read-only (root): which state the host is in —
              not-installed, installed-disabled, enabled-verified or drift —
              and that the outbound gateway still verifies.
  --rollback  Root. Close public SMTP: the receiver disabled, RateGuru's TCP
              25 rule removed, proved closed. Stored mail is kept.

The trusted bundle decides everything else; there is nothing to override.
USAGE
}

physical() {
    printf '%s%s\n' "${FS_ROOT}" "$1"
}

bundle_script() {
    printf '%s/infrastructure/scripts/%s\n' "${REPO_ROOT}" "$1"
}

# --- Result -------------------------------------------------------------------------

result_line() {
    local status="$1"

    [[ "${RESULT_PRINTED}" == false ]] || return 0
    RESULT_PRINTED=true

    jq -c -n \
        --arg target "${TARGET_ID}" --arg mode "${MODE}" --arg status "${status}" \
        --argjson requested "${REQUESTED}" --argjson changed "${CHANGED}" \
        --argjson rolled_back "${ROLLED_BACK}" --arg state "${HOST_STATE}" \
        --arg public_smtp "${PUBLIC_STATE}" --arg address "${ADDRESS}" --arg firewall "${FIREWALL_MODE}" '
        {target: $target, mode: $mode, status: $status, requested: $requested,
         changed: $changed, rolled_back: $rolled_back, state: $state,
         public_smtp: $public_smtp, address: (if $address == "" then null else $address end),
         firewall: $firewall}' \
        | sed 's/^/RATEGURU_MAIL_INBOUND_ACTIVATION_RESULT=/'
}

# --- Exit: the open transaction, the result ------------------------------------------

on_exit() {
    local status=$?
    trap - EXIT
    # Nothing interrupts the return to disabled: a lost connection or a second
    # signal must not leave public SMTP half-way.
    trap '' HUP INT PIPE TERM
    set +e

    if [[ "${TRANSACTION_OPEN}" == true ]]; then
        TRANSACTION_OPEN=false
        log "the activation did not complete (exit ${status}) — returning the receiver to disabled"

        if return_to_disabled; then
            ROLLED_BACK=true
            set_capsule_state rolled-back || true
            log "ROLLED BACK: public SMTP is closed, nothing listens on 25, the receiver is disabled; the activation failed"
            result_line fail
            status=1
        else
            printf 'CRITICAL: the activation of public SMTP failed AND its return to disabled could not be proved. Nothing broader was attempted. Inspect now: install-mail-inbound --verify, ss -ltnp sport = :25, and the firewall rule commented %s.\n' "${FIREWALL_COMMENT}" >&2
            log "ACTIVATION: CRITICAL — rollback not verified"
            result_line critical
            status=2
        fi
    fi

    withdraw_authorization

    if [[ "${RESULT_READY}" == true && "${RESULT_PRINTED}" == false ]] && command -v jq >/dev/null 2>&1; then
        result_line "$( (( status == 0 )) && echo pass || echo fail)"
    fi

    exit "${status}"
}

# --- Preconditions ------------------------------------------------------------------

require_root() {
    [[ "${EFFECTIVE_UID}" == 0 ]] \
        || die "activate-mail-inbound --${MODE} must run as root (the receiver, its firewall rule and the gateway it proves are root's)"
}

require_tools() {
    local tool
    for tool in "$@"; do
        command -v "${tool}" >/dev/null 2>&1 || die "required tool not found: ${tool}"
    done
}

HOST_LOCK_FD=""

acquire_host_lock() {
    local path="${RUN_ROOT}/${HOST_LOCK_NAME}"

    [[ -d "${RUN_ROOT}" ]] \
        || die "the operational lock directory does not exist: ${RUN_ROOT} — this host has not been bootstrapped; nothing was changed"

    exec {HOST_LOCK_FD}>>"${path}" \
        || die "could not open ${path} to claim this host's shared infrastructure; nothing was changed"

    flock -n "${HOST_LOCK_FD}" \
        || die "another operation is already mutating this host's shared infrastructure (${path}); nothing was changed"
}

# --- Children: the authoritative owners --------------------------------------------------

CHILD_OUTPUT=""

# run_child LABEL COMMAND... — one owner's verdict, its report shown beneath it.
run_child() {
    local label="$1" status=0 line
    shift

    if [[ ! -x "$1" ]]; then
        CHILD_OUTPUT=""
        printf '  ---- %s: not executable: %s — run from a full trusted bundle\n' "${label}" "$1"
        return 127
    fi

    CHILD_OUTPUT="$("$@" 2>&1 </dev/null)" || status=$?

    printf '  ---- %s (exit %s)\n' "${label}" "${status}"
    while IFS= read -r line; do
        [[ -n "${line}" ]] && printf '       | %s\n' "${line}"
    done <<<"${CHILD_OUTPUT}"

    return "${status}"
}

# --- The request ------------------------------------------------------------------------

load_request() {
    PLAN="$("$(bundle_script mail-inbound)" render-plan 2>/dev/null)" \
        || die "mail-inbound render-plan refused the trusted bundle's inbound contract — nothing was changed"

    jq -e --arg t "${TARGET_ID}" 'any(.targets[]; .target == $t and .environment_class == "production")' <<<"${PLAN}" >/dev/null \
        || die "${TARGET_ID} is not a production target the trusted bundle's inbound plan receives mail for — nothing was changed"

    if [[ "$(jq -r '.receiver.public_smtp' <<<"${PLAN}")" == enabled ]]; then REQUESTED=true; else REQUESTED=false; fi
}

require_requested() {
    [[ "${REQUESTED}" == true ]] \
        || die "activation is not requested by this trusted bundle: its mail-inbound.json says receiver.public_smtp is $(jq -r '.receiver.public_smtp' <<<"${PLAN}"). Nothing was changed"
}

# --- The host --------------------------------------------------------------------------

# read_host_state — PUBLIC_STATE and ADDRESS from the receiver's own record.
read_host_state() {
    local applied
    applied="$(public_smtp_inbound_applied "${FS_ROOT}")"

    case "${applied}" in
        absent)  PUBLIC_STATE=disabled; ADDRESS="" ;;
        corrupt) PUBLIC_STATE=unknown; ADDRESS="" ;;
        *)
            PUBLIC_STATE="${applied%%$'\t'*}"
            ADDRESS="${applied#*$'\t'}"
            [[ "${ADDRESS}" != "-" ]] || ADDRESS=""
            ;;
    esac
}

receiver_installed() {
    local marker
    marker="$(physical "${PUBLIC_SMTP_INBOUND_MARKER}")"
    [[ -f "${marker}" ]] && [[ "$(sed -n 's/^state=//p' "${marker}" 2>/dev/null | tail -n 1)" == installed ]]
}

# detect_address — the source address of this host's route to the Internet,
# accepted only when mail-inbound judges it a globally reachable IPv4 address.
detect_address() {
    local route address
    route="$("${IP_BIN}" -4 route get 1.1.1.1 2>/dev/null)" || return 1
    address="$(sed -n 's/.* src \([0-9.]*\).*/\1/p' <<<"${route}" | head -n 1)"
    [[ -n "${address}" ]] || return 1

    "$(bundle_script mail-inbound)" render-dns --target "${TARGET_ID}" --ipv4 "${address}" >/dev/null 2>&1 \
        || return 1
    printf '%s\n' "${address}"
}

gateway_digests() {
    local path
    for path in "${GATEWAY_FILES[@]}"; do
        if [[ -f "$(physical "${path}")" ]]; then
            printf '%s %s\n' "$(sha256sum -- "$(physical "${path}")" | cut -d ' ' -f 1)" "${path}"
        else
            printf 'absent %s\n' "${path}"
        fi
    done
}

gateway_verify() {
    if run_child "install-mail-gateway --verify" "$(bundle_script install-mail-gateway)" --verify; then
        ok "the outbound mail gateway verifies: loopback listeners, routes, signing and its recorded policy as reviewed"
        return 0
    fi
    bad "the outbound mail gateway does not verify — nothing about inbound mail may change on a host whose outbound path is not proved"
    return 1
}

gateway_unchanged() {
    if [[ "$(gateway_digests)" == "${GATEWAY_DIGESTS}" ]]; then
        ok "the gateway's main.cf, master.cf and recorded policy are byte for byte what they were"
        return 0
    fi
    bad "the gateway's configuration or recorded policy changed during the activation"
    return 1
}

check_public_ports() {
    local problems problem
    problems="$(public_smtp_problems "${FS_ROOT}" "${INBOUND_CONTRACT}")"

    if [[ -z "${problems}" ]]; then
        ok "$1"
        return 0
    fi
    while IFS= read -r problem; do
        bad "${problem}"
    done <<<"${problems}"
    return 1
}

# port25_listeners — every local address that listens on TCP 25.
port25_listeners() {
    public_smtp_listening_sockets | awk -F'\t' '$1 ~ /:25$/ { print $1 }'
}

receiver_verify() {
    if run_child "install-mail-inbound --verify" "$(bundle_script install-mail-inbound)" --verify; then
        ok "the receiver verifies: files, volume, store, service, listeners and every requirement"
        return 0
    fi
    bad "the receiver does not verify"
    return 1
}

# --- Firewall ----------------------------------------------------------------------
#
# Two hosts are manageable: one whose firewall is ufw, active — RateGuru adds
# and removes one rule of its own, commented FIREWALL_COMMENT, allowing TCP 25
# to exactly the receiver's address — and one with no host firewall at all,
# proved by asking the packet filter itself that nothing drops or rejects
# inbound traffic. Anything else is a firewall this script cannot prove it
# manages, and it refuses.

FIREWALL_DETAIL=""

detect_firewall() {
    local rules="" seen=false

    if command -v "${UFW_BIN}" >/dev/null 2>&1 \
        && [[ "$("${UFW_BIN}" status 2>/dev/null | head -n 1)" == "Status: active" ]]
    then
        FIREWALL_MODE=ufw
        FIREWALL_DETAIL="ufw is active: RateGuru adds and removes one rule of its own (${FIREWALL_COMMENT}) for TCP 25 to the receiver's address"
        return 0
    fi

    if command -v "${NFT_BIN}" >/dev/null 2>&1; then
        rules+="$("${NFT_BIN}" list ruleset 2>/dev/null)"$'\n' && seen=true
    fi
    if command -v "${IPTABLES_SAVE_BIN}" >/dev/null 2>&1; then
        rules+="$("${IPTABLES_SAVE_BIN}" 2>/dev/null)"$'\n' && seen=true
    fi
    if command -v "${IPTABLES_LEGACY_SAVE_BIN}" >/dev/null 2>&1; then
        rules+="$("${IPTABLES_LEGACY_SAVE_BIN}" 2>/dev/null)"$'\n'
    fi

    if [[ "${seen}" != true ]]; then
        FIREWALL_MODE=unmanaged
        FIREWALL_DETAIL="neither nft nor iptables-save can show this host's packet filter, so whether TCP 25 is open cannot be proved"
        return 0
    fi

    if grep -qiE '(^|[[:space:]])(drop|reject)([[:space:];]|$)|-j (DROP|REJECT)|^:INPUT (DROP|REJECT)|policy (drop|reject)' <<<"${rules}"; then
        FIREWALL_MODE=unmanaged
        FIREWALL_DETAIL="the host filters inbound traffic with rules that are not ufw's — RateGuru never edits a firewall it does not manage. Manage it with ufw, or remove those rules"
        return 0
    fi

    FIREWALL_MODE=none
    FIREWALL_DETAIL="no host firewall filters inbound traffic (ufw is not active, and nothing in the packet filter drops or rejects): TCP 25 is reachable once the receiver listens, and closed when it stops"
}

ufw_rule_present() {
    "${UFW_BIN}" status 2>/dev/null \
        | grep -E "^${1//./\\.} 25/tcp +ALLOW( IN)? +Anywhere +# ${FIREWALL_COMMENT}\$" >/dev/null
}

# ufw_foreign_port25 ADDRESS — a ufw rule RateGuru did not write already
# allows TCP 25; its own rule could then never be the only way in.
ufw_foreign_port25() {
    "${UFW_BIN}" status 2>/dev/null \
        | grep -E '(^| )25(/tcp)?( |$)' \
        | grep -vE "# ${FIREWALL_COMMENT}\$" >/dev/null
}

open_firewall() {
    [[ "${FIREWALL_MODE}" == ufw ]] || return 0
    if ufw_rule_present "${ADDRESS}"; then
        ok "the firewall rule ${FIREWALL_COMMENT} for TCP 25 to ${ADDRESS} is already there"
        return 0
    fi
    log "opening TCP 25 to ${ADDRESS} in ufw (rule ${FIREWALL_COMMENT})"
    "${UFW_BIN}" allow in proto tcp to "${ADDRESS}" port 25 comment "${FIREWALL_COMMENT}" >/dev/null
    ufw_rule_present "${ADDRESS}" || die "ufw did not record the rule for TCP 25 to ${ADDRESS}"
    ok "TCP 25 to ${ADDRESS} is allowed by ufw, and nothing else was changed"
}

# close_firewall ADDRESS — RateGuru's own rule, and only it, removed.
close_firewall() {
    local address="$1"
    [[ "${FIREWALL_MODE}" == ufw && -n "${address}" ]] || return 0
    ufw_rule_present "${address}" || return 0
    log "removing RateGuru's ufw rule for TCP 25 to ${address}"
    "${UFW_BIN}" delete allow in proto tcp to "${address}" port 25 comment "${FIREWALL_COMMENT}" >/dev/null || return 1
    ! ufw_rule_present "${address}"
}

# --- The live receiver: its loopback listener ---------------------------------------------

probe_port() {
    if [[ -n "${PROBE_PORT_OVERRIDE}" ]]; then
        printf '%s\n' "${PROBE_PORT_OVERRIDE}"
    else
        jq -r '.receiver.loopback_port' <<<"${PLAN}"
    fi
}

# probe_corpus — "ADDRESS<TAB>EXPECTED" for every address the proof asks the
# live receiver about: the plan's own exact addresses, a well-formed and a
# malformed identifier of every address space, another destination's form, an
# unknown mailbox, the no-reply sender, a foreign domain and the bare
# Postmaster. EXPECTED is accept or reject, as `mail-inbound route` judges it —
# the one decision the receiver must agree with.
probe_corpus() {
    local address verdict sample='01234567890abcdefghjkmnpqr'

    {
        jq -r --arg sample "${sample}" '
            .targets[] as $t
            | ($t.destinations[] | select(.accepts == "exact-addresses") | .addresses[]),
              ($t.destinations[] | "unknown-mailbox@\(.domain)"),
              ($t.destinations[] | select(.accepts == "identifier-addresses")
                | "\(.address_space.local_part_prefix)\($sample)@\(.domain)",
                  "\(.address_space.local_part_prefix)\($sample | sub("^0"; "i"))@\(.domain)"),
              ([$t.destinations[] | select(.accepts == "identifier-addresses")]
                | select(length >= 2)
                | "\(.[0].address_space.local_part_prefix)\($sample)@\(.[1].domain)")' <<<"${PLAN}"
        printf 'probe@relay-probe.invalid\n'
        printf 'Postmaster\n'
    } | while IFS= read -r address; do
        [[ -n "${address}" ]] || continue
        if "$(bundle_script mail-inbound)" route --recipient "${address}" >/dev/null 2>&1; then
            verdict=accept
        else
            verdict=reject
        fi
        printf '%s\t%s\n' "${address}" "${verdict}"
    done
}

# live_proof — the receiver answers exactly as the plan says. Never sends a
# message but its own probe, which goes to the host postmaster's mailbox and
# is removed once it is found there.
live_proof() {
    local port corpus addresses=() expected=() reply i size limit failures=0
    port="$(probe_port)"
    size="$(jq -r '.receiver.limits.message_size_bytes' <<<"${PLAN}")"
    limit="$(jq -r '.receiver.limits.recipients_per_message' <<<"${PLAN}")"

    corpus="$(probe_corpus)"
    while IFS=$'\t' read -r address verdict; do
        [[ -n "${address}" ]] || continue
        addresses+=("${address}")
        expected+=("${verdict}")
    done <<<"${corpus}"

    if ! smtp_probe_recipients 127.0.0.1 "${port}" inbound-proof.invalid "" "${addresses[@]}"; then
        bad "the receiver's loopback listener 127.0.0.1:${port} did not complete the probe (${SMTP_STAGE}: ${SMTP_REPLY})"
        return 1
    fi

    if grep -qE '^AUTH( |$)' <<<"${SMTP_EHLO}"; then
        bad "the receiver offers SMTP AUTH"; failures=$((failures + 1))
    else
        ok "no SMTP AUTH is offered"
    fi
    if grep -qxF "SIZE ${size}" <<<"${SMTP_EHLO}"; then
        ok "the receiver announces the reviewed maximum message size (SIZE ${size})"
    else
        bad "the receiver does not announce SIZE ${size}"; failures=$((failures + 1))
    fi

    for i in "${!addresses[@]}"; do
        reply="${SMTP_RCPT_REPLIES[${i}]:-}"
        case "${expected[${i}]}:${reply:0:1}" in
            accept:2|reject:5)
                ok "RCPT TO:<${addresses[${i}]}> ${expected[${i}]}ed, as mail-inbound route judges it"
                ;;
            *)
                bad "RCPT TO:<${addresses[${i}]}> answered \"${reply}\", but mail-inbound route says ${expected[${i}]}"
                failures=$((failures + 1))
                ;;
        esac
    done

    # One more recipient than the limit allows, in one transaction: accepted
    # addresses of the plan, each of which alone would be taken.
    local many=() accepted
    mapfile -t accepted < <(jq -r '.targets[].destinations[] | select(.accepts == "exact-addresses") | .addresses[]' <<<"${PLAN}")
    for (( i = 0; i <= limit; i++ )); do
        many+=("${accepted[$(( i % ${#accepted[@]} ))]}")
    done
    if smtp_probe_transaction 127.0.0.1 "${port}" inbound-proof.invalid probe@relay-probe.invalid "${many[@]}" \
        && [[ "${SMTP_RCPT_REPLIES[${limit}]:0:1}" == 4 ]]
    then
        ok "a message to more than ${limit} recipient(s) is answered with a temporary refusal for the rest"
    else
        bad "the recipient limit (${limit}) is not enforced: ${SMTP_RCPT_REPLIES[*]:-no reply}"
        failures=$((failures + 1))
    fi

    store_probe || failures=$((failures + 1))

    (( failures == 0 ))
}

# store_probe — one message to the host postmaster, found in its mailbox by its
# own random token within PROBE_WAIT seconds, then removed. Nothing else in the
# store is read but to match that token.
store_probe() {
    local token mailbox waited=0 file port
    port="$(probe_port)"
    token="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    mailbox="$(physical "${STORE_DIR}")/${HOST_POSTMASTER_MAILBOX}"

    if ! smtp_submit_message 127.0.0.1 "${port}" inbound-proof.invalid probe@relay-probe.invalid Postmaster \
        "$(printf 'From: RateGuru inbound proof <probe@relay-probe.invalid>\nTo: postmaster\nSubject: RateGuru inbound store proof\nX-RateGuru-Inbound-Proof: %s\n\nA probe of the inbound store. It is removed by the proof that sent it.' "${token}")"
    then
        bad "the probe message was not accepted (${SMTP_STAGE}: ${SMTP_REPLY})"
        return 1
    fi

    while (( waited < PROBE_WAIT )); do
        file="$(grep -rlF -- "X-RateGuru-Inbound-Proof: ${token}" "${mailbox}new" "${mailbox}cur" 2>/dev/null | head -n 1 || true)"
        if [[ -n "${file}" ]]; then
            rm -f -- "${file}"
            ok "the probe was accepted after it was queued (${SMTP_QUEUE_ID:-queued}), stored in ${HOST_POSTMASTER_MAILBOX} and removed"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    bad "the probe was accepted (${SMTP_QUEUE_ID:-queued}) but did not reach ${HOST_POSTMASTER_MAILBOX} within ${PROBE_WAIT}s — accepted mail is not being stored"
    return 1
}

# --- Transition authorization ------------------------------------------------------

AUTHORIZATION_NONCE=""

# authorize DIRECTION — the one-use authorization for install-mail-inbound to
# move the receiver from its recorded state, root-only and short-lived.
authorize() {
    local direction="$1" path from tmp now
    path="$(physical "${TRANSITION_AUTHORIZATION}")"
    now="$(date -u '+%s')"
    AUTHORIZATION_NONCE="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"

    if [[ "${direction}" == enable ]]; then from=disabled; else from=enabled; fi

    tmp="${path}.new.$$"
    (
        umask 077
        jq -n --arg kind "${AUTHORIZATION_KIND}" --arg target "${TARGET_ID}" --arg direction "${direction}" \
            --arg from "${from}" --arg address "${ADDRESS}" --arg nonce "${AUTHORIZATION_NONCE}" \
            --argjson now "${now}" --argjson lifetime "${AUTHORIZATION_LIFETIME}" '
            {kind: $kind, schema_version: 1, target: $target, direction: $direction, from: $from,
             address: (if $direction == "enable" then $address else null end),
             nonce: $nonce, created_at: $now, expires_at: ($now + $lifetime)}' > "${tmp}" \
            && chmod 0600 "${tmp}" \
            && mv -f -- "${tmp}" "${path}"
    ) || { rm -f -- "${tmp}"; return 1; }
}

withdraw_authorization() {
    local path
    path="$(physical "${TRANSITION_AUTHORIZATION}")"
    [[ -n "${AUTHORIZATION_NONCE}" && -f "${path}" ]] || return 0
    [[ "$(jq -r '.nonce // ""' "${path}" 2>/dev/null)" == "${AUTHORIZATION_NONCE}" ]] || return 0
    rm -f -- "${path}"
}

# --- Rollback capsule ---------------------------------------------------------------------

capsule_path() {
    printf '%s/%s/capsule.json\n' "$(physical "${CAPSULE_ROOT}")" "${TARGET_ID}"
}

write_capsule() {
    local path
    path="$(capsule_path)"
    install -d -m 0700 "$(dirname -- "$(dirname -- "${path}")")" "$(dirname -- "${path}")"
    jq -n --arg kind "${CAPSULE_KIND}" --arg t "${TARGET_ID}" --arg state "$1" \
        --arg address "${ADDRESS}" --arg firewall "${FIREWALL_MODE}" --arg gateway "${GATEWAY_DIGESTS}" \
        --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '
        {kind: $kind, schema_version: 1, target: $t, state: $state, address: $address,
         firewall: $firewall, gateway_sha256: ($gateway | split("\n") | map(select(. != ""))),
         recorded_at: $now}' > "${path}.new"
    chmod 0600 "${path}.new"
    mv -f -- "${path}.new" "${path}"
}

set_capsule_state() {
    local path
    path="$(capsule_path)"
    [[ -f "${path}" ]] || return 0
    jq --arg state "$1" --arg now "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '.state = $state | .recorded_at = $now' \
        "${path}" > "${path}.new" && chmod 0600 "${path}.new" && mv -f -- "${path}.new" "${path}"
}

# --- Back to disabled -------------------------------------------------------------------

# return_to_disabled — the receiver's apply with a one-use DISABLE
# authorization when it recorded enabled, RateGuru's firewall rule removed, and
# the proof: nothing listens on 25, the receiver verifies, the gateway too.
return_to_disabled() {
    local failures=0 previous="${ADDRESS}"

    read_host_state
    [[ -n "${previous}" ]] || previous="${ADDRESS}"

    if [[ "${PUBLIC_STATE}" == enabled ]]; then
        authorize disable || { bad "the disable authorization could not be written"; failures=$((failures + 1)); }
        run_child "install-mail-inbound --apply (disable)" "$(bundle_script install-mail-inbound)" --apply \
            || { bad "install-mail-inbound --apply did not return the receiver to disabled"; failures=$((failures + 1)); }
        withdraw_authorization
    fi

    if [[ "${FIREWALL_MODE}" == ufw ]]; then
        close_firewall "${previous}" \
            || { bad "RateGuru's ufw rule for TCP 25 could not be removed"; failures=$((failures + 1)); }
    fi

    read_host_state
    [[ "${PUBLIC_STATE}" == disabled ]] || { bad "the receiver's recorded state is ${PUBLIC_STATE}, not disabled"; failures=$((failures + 1)); }

    local listeners
    listeners="$(port25_listeners 2>/dev/null || echo unreadable)"
    if [[ -z "${listeners}" ]]; then
        ok "nothing listens on TCP 25"
    else
        bad "something still listens on TCP 25: ${listeners//$'\n'/, }"
        failures=$((failures + 1))
    fi

    if receiver_installed; then
        receiver_verify || failures=$((failures + 1))
    fi
    gateway_verify || failures=$((failures + 1))

    (( failures == 0 ))
}

# --- Modes ------------------------------------------------------------------------------

# classify — HOST_STATE from what the host is, with every finding printed.
# Returns 0 when the state is one of the three consistent ones.
classify() {
    local failures_before="${COUNT_FAIL}"

    read_host_state
    detect_firewall

    if ! receiver_installed; then
        if [[ -z "$(port25_listeners 2>/dev/null)" ]] && ! { [[ "${FIREWALL_MODE}" == ufw ]] && ufw_rule_present "${ADDRESS:-0.0.0.0}"; }; then
            HOST_STATE=not-installed
            ok "no inbound receiver is installed on this host, and nothing listens on TCP 25"
            check_public_ports "nothing listens on a public SMTP port" || true
        else
            HOST_STATE=drift
            bad "no inbound receiver is installed, yet TCP 25 is open or RateGuru's rule for it is present"
        fi
    else
        receiver_verify || true
        check_public_ports "$(public_smtp_summary "${FS_ROOT}")" || true

        case "${PUBLIC_STATE}" in
            disabled)
                if [[ -n "$(port25_listeners 2>/dev/null)" ]]; then
                    bad "the receiver is disabled, yet something listens on TCP 25"
                fi
                ;;
            enabled)
                if [[ "${FIREWALL_MODE}" == ufw ]]; then
                    if ufw_rule_present "${ADDRESS}"; then
                        ok "RateGuru's ufw rule allows TCP 25 to ${ADDRESS}"
                    else
                        bad "public SMTP is enabled on ${ADDRESS}, but RateGuru's ufw rule for it is missing"
                    fi
                elif [[ "${FIREWALL_MODE}" == none ]]; then
                    ok "${FIREWALL_DETAIL}"
                else
                    bad "${FIREWALL_DETAIL}"
                fi
                [[ "${REQUESTED}" == true ]] \
                    || bad "public SMTP is enabled on this host, but the trusted bundle does not request it — run the inbound rollback, or restore the request"
                ;;
            *)
                bad "the receiver's recorded state is corrupt"
                ;;
        esac

        if (( COUNT_FAIL != failures_before )); then
            HOST_STATE=drift
        elif [[ "${PUBLIC_STATE}" == enabled ]]; then
            HOST_STATE=enabled-verified
        else
            HOST_STATE=installed-disabled
        fi
    fi

    (( COUNT_FAIL == failures_before ))
}

# preflight — everything that must hold before public SMTP opens.
preflight() {
    log "the proof before anything public changes"

    if ADDRESS="$(detect_address)"; then
        ok "this host's public IPv4 address is ${ADDRESS}, globally reachable"
    else
        ADDRESS=""
        bad "this host has no globally reachable IPv4 address on its route to the Internet — the receiver would bind nothing public"
    fi

    if run_child "install-mail-inbound --tls-check" "$(bundle_script install-mail-inbound)" --tls-check; then
        ok "a valid certificate covers every MX host name"
    else
        bad "no usable TLS certificate — install it as infrastructure/runbooks/mail-inbound.md describes, before activating"
    fi

    gateway_verify || true
    GATEWAY_DIGESTS="$(gateway_digests)"

    check_public_ports "nothing listens on a public SMTP port that may not" || true

    detect_firewall
    case "${FIREWALL_MODE}" in
        ufw)
            if ufw_foreign_port25; then
                bad "a ufw rule RateGuru did not write already allows TCP 25 — RateGuru's own rule must be the only way in, so its rollback really closes the port. Remove that rule"
            else
                ok "${FIREWALL_DETAIL}"
            fi
            ;;
        none) ok "${FIREWALL_DETAIL}" ;;
        *)    bad "${FIREWALL_DETAIL}" ;;
    esac

    if run_child "install-mail-inbound --check" "$(bundle_script install-mail-inbound)" --check; then
        ok "the receiver can be installed or converged: package, gateway, ownership, disk and loopback port"
    else
        bad "the receiver cannot be installed or converged on this host (above)"
    fi
}

print_operator_next() {
    log "NEXT (operator): confirm the provider's firewall outside this host allows inbound TCP 25 to ${ADDRESS} — this script cannot see it and never claims it"
    log "NEXT (operator): publish DNS in this order, only now that the receiver is active and verified — the A record first, then the MX records:"
    "$(bundle_script mail-inbound)" render-dns --target "${TARGET_ID}" --ipv4 "${ADDRESS}" 2>/dev/null \
        | jq -r '(.records | map(select(.type == "A")) + map(select(.type != "A")))[]
                 | "    \(.name)  \(.type)\(if .priority == null then "" else " \(.priority)" end)  \(.value)"' \
        || true
}

run_check() {
    load_request
    require_requested
    read_host_state

    COUNT_FAIL=0
    if classify && [[ "${HOST_STATE}" == enabled-verified ]]; then
        log "ACTIVATION CHECK: ALREADY ACTIVE — --apply would change nothing"
        result_line pass
        return 0
    fi
    COUNT_FAIL=0

    preflight

    if (( COUNT_FAIL == 0 )); then
        log "ACTIVATION CHECK: READY — --apply would install or converge the receiver, prove it live, and open TCP 25 to ${ADDRESS}"
        result_line pass
        return 0
    fi

    log "ACTIVATION CHECK: REFUSED — --apply would change nothing public (${COUNT_FAIL} problem(s) above)"
    result_line fail
    exit 1
}

run_apply() {
    require_tools flock sha256sum od
    acquire_host_lock

    load_request
    require_requested
    read_host_state

    COUNT_FAIL=0
    if receiver_installed && classify && [[ "${HOST_STATE}" == enabled-verified ]]; then
        log "ACTIVATION: ALREADY ACTIVE — the receiver listens on ${ADDRESS}:25 and verifies; nothing was changed"
        result_line pass
        return 0
    fi
    [[ "${PUBLIC_STATE}" != enabled ]] \
        || die "public SMTP is already enabled on this host but does not verify (above) — nothing was changed; --rollback closes it"
    COUNT_FAIL=0

    preflight
    (( COUNT_FAIL == 0 )) || die "the proof before activation failed (${COUNT_FAIL} problem(s) above) — nothing public was changed"

    log "installing or converging the receiver, still disabled"
    CHANGED=true
    run_child "install-mail-inbound --apply (disabled)" "$(bundle_script install-mail-inbound)" --apply \
        || die "install-mail-inbound --apply did not install the receiver — nothing public was changed"

    COUNT_FAIL=0
    receiver_verify || true
    log "the live proof on the loopback listener"
    live_proof || true
    (( COUNT_FAIL == 0 )) \
        || die "the receiver did not prove itself before public SMTP (${COUNT_FAIL} problem(s) above) — it stays installed and disabled; nothing public was changed"

    write_capsule activating
    TRANSACTION_OPEN=true

    open_firewall
    authorize enable || die "the enable authorization could not be written"
    log "enabling public SMTP on ${ADDRESS}:25: install-mail-inbound --apply"
    run_child "install-mail-inbound --apply (enable)" "$(bundle_script install-mail-inbound)" --apply \
        || die "install-mail-inbound --apply refused or failed to enable public SMTP"
    withdraw_authorization

    COUNT_FAIL=0
    read_host_state
    [[ "${PUBLIC_STATE}" == enabled ]] || bad "the receiver did not record public SMTP as enabled"
    receiver_verify || true
    check_public_ports "only ${PUBLIC_SMTP_INBOUND_UNIT} listens on TCP 25, on ${ADDRESS} alone; no other public SMTP port is open" || true
    if [[ "${FIREWALL_MODE}" == ufw ]]; then
        if ufw_rule_present "${ADDRESS}"; then ok "RateGuru's ufw rule allows TCP 25 to ${ADDRESS}"; else bad "the ufw rule for TCP 25 to ${ADDRESS} is missing"; fi
    fi
    live_proof || true
    gateway_verify || true
    gateway_unchanged || true

    (( COUNT_FAIL == 0 )) || die "public SMTP did not prove itself (${COUNT_FAIL} problem(s) above)"

    TRANSACTION_OPEN=false
    set_capsule_state activated
    HOST_STATE=enabled-verified

    log "ACTIVATION: DONE — the inbound receiver accepts mail on ${ADDRESS}:25 for exactly the reviewed recipients; the outbound gateway is unchanged"
    print_operator_next
    result_line pass
}

run_verify() {
    load_request

    COUNT_FAIL=0
    classify || true
    gateway_verify || true

    log "STATE: ${HOST_STATE}"
    if (( COUNT_FAIL == 0 )); then
        log "INBOUND VERIFY: PASS"
        result_line pass
        return 0
    fi
    [[ "${HOST_STATE}" != enabled-verified && "${HOST_STATE}" != installed-disabled ]] || HOST_STATE=drift
    log "INBOUND VERIFY: FAIL (${COUNT_FAIL} problem(s) above)"
    result_line fail
    exit 1
}

run_rollback() {
    require_tools flock sha256sum od
    acquire_host_lock

    PLAN="$("$(bundle_script mail-inbound)" render-plan 2>/dev/null)" \
        || die "mail-inbound render-plan refused the trusted bundle's inbound contract — nothing was changed"
    if [[ "$(jq -r '.receiver.public_smtp' <<<"${PLAN}")" == enabled ]]; then REQUESTED=true; else REQUESTED=false; fi

    read_host_state
    detect_firewall
    [[ "${PUBLIC_STATE}" != unknown ]] \
        || die "the receiver's recorded state is corrupt — it cannot be moved by its one-use authorization. Inspect install-mail-inbound --verify; nothing was changed"

    COUNT_FAIL=0
    if [[ "${PUBLIC_STATE}" == disabled ]] && [[ -z "$(port25_listeners 2>/dev/null)" ]] \
        && ! { [[ "${FIREWALL_MODE}" == ufw && -n "${ADDRESS}" ]] && ufw_rule_present "${ADDRESS}"; }
    then
        if receiver_installed; then HOST_STATE=installed-disabled; else HOST_STATE=not-installed; fi
        log "ROLLBACK: NOTHING TO DO — public SMTP is already closed"
        result_line pass
        return 0
    fi

    receiver_installed \
        || die "something listens on TCP 25 or RateGuru's rule for it is present, but no receiver is installed — it is not RateGuru's to close; nothing was changed"

    CHANGED=true
    if return_to_disabled; then
        ROLLED_BACK=true
        HOST_STATE=installed-disabled
        set_capsule_state rolled-back || true
        log "ROLLED BACK: public SMTP is closed, nothing listens on TCP 25, the receiver is installed and disabled, and its stored mail is kept"
        log "NEXT (operator): check the published MX records of every target in the plan — while they name this host, senders find a closed port and retry; remove them unless public SMTP is coming back"
        result_line pass
        return 0
    fi

    printf 'CRITICAL: the rollback of public SMTP could not be proved. Nothing broader was attempted.\n' >&2
    log "ROLLBACK: CRITICAL"
    result_line critical
    exit 2
}

# --- Entry point ---------------------------------------------------------------

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify|--rollback)
                [[ -z "${MODE}" ]] || die "mode given more than once"
                MODE="${1#--}"
                shift
                ;;
            --target)
                [[ -z "${TARGET_ID}" ]] || die "--target given more than once"
                [[ $# -ge 2 && -n "${2:-}" ]] || die "--target requires a value"
                TARGET_ID="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                die "unknown argument: $1"
                ;;
        esac
    done

    [[ -n "${MODE}" ]] || { usage >&2; die "a mode is required: --check, --apply, --verify or --rollback"; }
    [[ -n "${TARGET_ID}" ]] || die "--${MODE} requires --target"
    [[ "${TARGET_ID}" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]] || die "invalid target ID: ${TARGET_ID}"

    require_tools jq
    RESULT_READY=true
    trap on_exit EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 141' PIPE
    trap 'exit 143' TERM

    require_root

    case "${MODE}" in
        check)    run_check ;;
        apply)    run_apply ;;
        verify)   run_verify ;;
        rollback) run_rollback ;;
    esac
}

# Sourcing defines the functions without running anything, so the tests drive
# the shipped code rather than a copy of it.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
