#!/usr/bin/env bash
#
# install-mail-gateway — the host-global Postfix mail gateway, rendered from the
# reviewed mail routing plan.
#
#   install-mail-gateway --check          read-only: would --apply converge, and what
#   install-mail-gateway --apply          install/converge the gateway (root)
#   install-mail-gateway --verify         read-only: the authoritative contract (root)
#   install-mail-gateway --policy-digest  read-only: the SHA-256 of the policy this
#                                         bundle requests and of the one recorded
#
# WHERE THE ROUTES COME FROM. Nothing here decides where a target's mail goes.
# The dependency runs one way only:
#
#   deployment-targets.json + mail-routing.json
#       -> mail-routing validate / render-plan    (the policy, and its only judge)
#       -> install-mail-gateway                   (this file: Postfix syntax only)
#       -> /etc/postfix/main.cf, /etc/postfix/master.cf
#
# The plan is read from the mail-routing CLI shipped in the SAME bundle this
# script runs from, never from a copy, and no policy rule is restated here. What
# this file adds is Postfix: how a listener, a capture route, a held mode and a
# direct outbound route are spelled in main.cf and master.cf. A delivery mode or
# route kind it has no spelling for is a refusal, never a default.
#
# THE HOST'S OUTBOUND CONTRACT. infrastructure/config/mail-outbound.json is the
# one thing this file reads besides the plan, because it is not a target's: it
# is the host's physical delivery identity. Every brand on a host shares its
# source address, and an address has exactly one PTR name, so the name a direct
# route greets receiving servers with (the MTA hostname) belongs to the host and
# appears in no target's policy. The contract says whether direct delivery is
# enabled on this host at all, and under which name. It is judged — by
# mail-identity check-outbound, from this bundle — in every mode and before
# anything is rendered: a plan with a direct route on a host
# whose contract leaves direct delivery disabled — or enabled without a valid
# public hostname — is refused before a file or a service is touched, so
# switching a target's policy to outbound can never by itself put mail on the
# Internet.
#
# THE GATEWAY. One Postfix instance for the whole host:
#
#   * one smtpd listener per target, on the target's own loopback submission
#     endpoint — the port the message arrived on is the routing identity;
#   * capture: the listener sets a content filter naming the target's own
#     transport and its capture destination, so the message is QUEUED by Postfix
#     and then delivered to the destination — retried, not lost, while the
#     destination is down;
#   * held: the listener places every message it accepts on the HOLD queue, and
#     nothing in the configuration names a route for it;
#   * outbound, direct: the listener sets a content filter naming the target's
#     own smtp client and NO next hop. With default_filter_nexthop empty, the
#     queue manager then uses each recipient's own domain as the next hop, so
#     that client looks up the recipient domain's MX and delivers there — per
#     recipient domain, queued and retried, with STARTTLS whenever the receiving
#     server offers it, no relay host, no smart host and no SMTP AUTH. The
#     client greets with the host's MTA hostname, never a target's domain. No
#     other listener names it, and nothing else can reach it;
#   * the envelope sender must belong exactly to the target's allowed domain (or
#     be empty); anything else is refused at MAIL FROM. The sender authorizes, it
#     never selects;
#   * everything else is undeliverable: the default, relay, local and virtual
#     transports are all error(8), there is no relayhost, no destination domain,
#     no transport map, no generic smtp client and no smtp/submission/smtps
#     listener. Mail with no rendered route cannot reach the Internet: the only
#     smtp clients are the ones the plan's listeners name.
#
# SIGNING. A listener whose target is in the signing plan that
# infrastructure/scripts/mail-identity renders (render-signing-plan) hands every
# message it accepts to the host's DKIM signer before Postfix queues it — at the
# endpoint `install-mail-signing --milter-endpoint` prints, never one spelled
# here — with milter protocol 6 and a temporary failure whenever the signer cannot
# sign: a signed target's mail is deferred, never accepted unsigned. No other
# listener, and no locally submitted mail, passes through the signer. Signing
# routes nothing: a held listener still holds every message it signed.
#
# The signer signs by the message's From header, and the listener checks only
# the envelope sender — so a signed listener also has its OWN cleanup service,
# whose header_checks are the target's From policy, rendered here from the
# plan's allowed domain into /etc/postfix/rateguru-from-<target>.regexp: exactly
# one From address in that domain, or the message is refused (5.7.1) before it
# is queued. A missing From is added from the envelope sender, which the
# listener holds to that domain and never lets be empty. The policy only
# accepts or refuses; it never selects a route.
#
# Listeners on loopback only, IPv4 only, no SMTP AUTH, no TLS: the boundary is
# the host and the per-target port. Postfix itself binds nothing public — the
# firewall is never what makes this safe.
#
# INBOUND MAIL. The same Postfix also receives mail for the inbound plan, with
# one queue and one service, once the host records it — never because the
# repository asks. What it accepts is `mail-inbound render-receiver`'s, from
# this bundle; this file only spells it:
#
#   * its own listeners: one on loopback, for the activation's proof, and —
#     only while the host's applied inbound state says public SMTP is enabled —
#     one on exactly the recorded public IPv4 address, port 25, with STARTTLS
#     from the operator's certificate. Every setting that makes them a public
#     receiver is a per-service override in master.cf: recipients judged at RCPT
#     TO against the rendered table for every client, loopback included, no
#     relay, no SMTP AUTH, the reviewed limits, a queue floor of their own, and
#     their own cleanup and address rewriting services, so a bare <Postmaster>
#     is the host postmaster and no other listener changes;
#   * delivery: virtual(8) into Maildir under the store install-mail-inbound
#     owns, for exactly the plan's domains — the one main.cf change, and the
#     one transport besides the listeners' own that delivers anything.
#
# The submission listeners never reach it: each names its own content filter,
# which decides where its mail goes whatever the recipient's domain, and none
# judges recipients against the inbound table — mail an application sends to
# a domain this host receives for still leaves through its own route. Nothing
# an inbound listener accepts can leave: the default, relay and local
# transports stay error(8), so not even a bounce reaches the Internet.
#
# The host's inbound state — absent, disabled, enabled on one address — is the
# gateway's own record (applied-inbound.json), moved only by a one-use
# authorization activate-mail-inbound writes after its proof, and consumed
# here. An ordinary --apply keeps it, whatever the repository requests, and a
# bundle that no longer requests public SMTP refuses to touch a host where it
# is open: only the inbound rollback closes it.
#
# ITS NAME. Postfix calls itself (myhostname: its banner, its Received hops, a
# Message-ID it adds) by the host's reviewed MTA hostname whenever
# mail-outbound.json names one, so a delivered message names the host the
# public DNS and the HELO name. Only a host whose contract reviews no hostname —
# which the contract allows only while direct delivery is disabled — falls back
# to the non-deliverable mail-gateway.rateguru.invalid. Never DNS, the OS
# hostname or /etc/hosts.
#
# THE APPLIED POLICY. Every successful --apply records, in the same
# transaction, the complete public policy it was applied from:
# /var/lib/rateguru-mail-gateway/applied-plan.json — the whole canonical
# `mail-routing render-plan`, every target and every field, including the ones
# Postfix never reads (lifecycle, sender, bounce and reply domains) — and
# applied-outbound.json, the canonical host outbound contract. They are public,
# never a key, a key's hash, an environment file, a credential or a message.
# --verify requires both to equal what this bundle requests, so a change to any
# policy field is drift on the host, whether Postfix renders it or not. A host
# with no recorded policy may record its first one only from an inert request:
# no outbound route and direct delivery disabled.
#
# THE ACTIVATION BOUNDARY. A production target's mail crossing between held and
# outbound — in either direction, or the host's direct delivery switching on or
# off — is never an ordinary convergence. --check reports it as a conflict and
# --apply refuses it before changing anything, whoever called it: preparation,
# bootstrap, repair or a root shell. It is crossed only with a one-use
# authorization that infrastructure/scripts/activate-mail-outbound writes after
# its own proof (transition-authorization.json beside the applied policy,
# root-owned, mode 0600): bound to the target, the direction and the SHA-256 of
# the exact recorded and requested plans and host contracts, short-lived, and
# consumed — recorded in consumed-transition-authorizations and removed —
# before the transition starts, so it is never honoured twice. There is no flag
# and no override that does the same.
#
# THE PACKAGE. --apply may install Ubuntu's postfix package, and does it so the
# daemon can never run in a state RateGuru did not choose:
#
#   * debconf is preseeded "No configuration": the package writes no main.cf of
#     its own and never manages it afterwards, so until RateGuru's main.cf is in
#     place the daemon cannot start at all (its unit is conditional on main.cf),
#     and no later package configuration rewrites it;
#   * the rendered master.cf already carries every service the package's own
#     master.cf repair (`fix_master`, run on every upgrade) would append, so a
#     postfix upgrade adds nothing — in particular no working `relay` smtp
#     client, because here `relay` is the error transport;
#   * a policy-rc.d is in place for the duration of the package installation, so
#     the maintainer scripts start nothing. One that already existed is preserved
#     and put back, and one left behind by an interrupted run is recognised and
#     removed;
#   * the rendered configuration is validated by Postfix itself before it is
#     installed, and the service is enabled and started only after that.
#
# OWNERSHIP. Before the package is installed an ownership marker is written to
# /var/lib/rateguru-mail-gateway. A Postfix — or any other mail transport agent
# — present on a host WITHOUT that marker is not RateGuru's, and every mode
# fails closed on it: an existing MTA is never taken over, rewritten or removed.
# A marker in state=installing is a partial installation this installer started,
# and --apply resumes it.
#
# TRANSACTION. --apply renders into a private directory, validates, records the
# managed files and the service's boot/running state, installs complete
# candidates atomically, reloads or starts only after validation, and verifies
# the running gateway — listeners, routes, the capture destination — before it
# records the applied policy and commits. Any failure before that restores the
# previous files, the previous recorded policy and runtime state, and a
# rollback that could not finish says so and fails. Backups hold
# configuration only, under /var/backups/rateguru-mail-gateway/<timestamp>/:
# never the queue, never a message.
#
# Test overrides: every RATEGURU_MAILGW_* variable below is honoured only
# alongside RATEGURU_ALLOW_TEST_OVERRIDES=true, the gate every installer here
# uses. RATEGURU_MAILGW_FS_ROOT prefixes every host path so the real code runs
# against a simulated host.

set -Eeuo pipefail
umask 022

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd -P)"

# --- Test override gate -------------------------------------------------------

rateguru_test_overrides_allowed() {
    [[ "${RATEGURU_ALLOW_TEST_OVERRIDES:-false}" == true ]]
}

# gated_default VAR_NAME DEFAULT — the override when allowed and set, else the
# default.
gated_default() {
    local var_name="$1" default_value="$2"

    if rateguru_test_overrides_allowed && [[ -n "${!var_name:-}" ]]; then
        printf '%s\n' "${!var_name}"
    else
        printf '%s\n' "${default_value}"
    fi
}

EFFECTIVE_UID="$(gated_default RATEGURU_MAILGW_EUID "${EUID}")"
FS_ROOT="$(gated_default RATEGURU_MAILGW_FS_ROOT '')"

# The policy and its one implementation, from this bundle.
MAIL_ROUTING_CLI="$(gated_default RATEGURU_MAILGW_MAIL_ROUTING_CLI "${SCRIPT_DIR}/mail-routing")"
POLICY_FILE="$(gated_default RATEGURU_MAILGW_POLICY_FILE "${REPO_ROOT}/infrastructure/config/mail-routing.json")"
REGISTRY_FILE="$(gated_default RATEGURU_MAILGW_REGISTRY_FILE "${REPO_ROOT}/infrastructure/config/deployment-targets.json")"

# The host's own outbound contract, and its one judge, from this bundle.
OUTBOUND_FILE="$(gated_default RATEGURU_MAILGW_OUTBOUND_FILE "${REPO_ROOT}/infrastructure/config/mail-outbound.json")"
MAIL_IDENTITY_CLI="$(gated_default RATEGURU_MAILGW_MAIL_IDENTITY_CLI "${SCRIPT_DIR}/mail-identity")"

# Which targets are signed, judged by mail-identity from the reviewed identity,
# and where the signer listens, from the signer's own installer — both from this
# bundle.
IDENTITY_FILE="$(gated_default RATEGURU_MAILGW_IDENTITY_FILE "${REPO_ROOT}/infrastructure/config/mail-identity.json")"
MAIL_SIGNING_CLI="$(gated_default RATEGURU_MAILGW_MAIL_SIGNING_CLI "${SCRIPT_DIR}/install-mail-signing")"

# The reviewed inbound contract of this bundle, and its one judge: what the
# inbound listeners accept, and whether the bundle requests public SMTP.
INBOUND_FILE="$(gated_default RATEGURU_MAILGW_INBOUND_FILE "${REPO_ROOT}/infrastructure/config/mail-inbound.json")"
MAIL_INBOUND_CLI="$(gated_default RATEGURU_MAILGW_MAIL_INBOUND_CLI "${SCRIPT_DIR}/mail-inbound")"

SYSTEMCTL_BIN="$(gated_default RATEGURU_MAILGW_SYSTEMCTL_BIN systemctl)"
APT_GET_BIN="$(gated_default RATEGURU_MAILGW_APT_GET_BIN apt-get)"
DPKG_BIN="$(gated_default RATEGURU_MAILGW_DPKG_BIN dpkg)"
DPKG_QUERY_BIN="$(gated_default RATEGURU_MAILGW_DPKG_QUERY_BIN dpkg-query)"
DEBCONF_SET_SELECTIONS_BIN="$(gated_default RATEGURU_MAILGW_DEBCONF_SET_SELECTIONS_BIN debconf-set-selections)"
POSTCONF_BIN="$(gated_default RATEGURU_MAILGW_POSTCONF_BIN postconf)"
POSTFIX_BIN="$(gated_default RATEGURU_MAILGW_POSTFIX_BIN postfix)"
POSTMAP_BIN="$(gated_default RATEGURU_MAILGW_POSTMAP_BIN postmap)"
SS_BIN="$(gated_default RATEGURU_MAILGW_SS_BIN ss)"
GETENT_BIN="$(gated_default RATEGURU_MAILGW_GETENT_BIN getent)"

# Owner of every managed file. root:root on a host; the test seam lets the real
# install path run unprivileged.
FILE_OWNER="$(gated_default RATEGURU_MAILGW_FILE_OWNER root)"
FILE_GROUP="$(gated_default RATEGURU_MAILGW_FILE_GROUP root)"

# Bounded waits; anything that is not a positive integer falls back, so a stray
# variable can never disable a gate.
RUNTIME_WAIT="$(gated_default RATEGURU_MAILGW_RUNTIME_WAIT 30)"
STABILITY_WAIT="$(gated_default RATEGURU_MAILGW_STABILITY_WAIT 4)"
[[ "${RUNTIME_WAIT}" =~ ^[1-9][0-9]*$ ]] || RUNTIME_WAIT=30
[[ "${STABILITY_WAIT}" =~ ^[1-9][0-9]*$ ]] || STABILITY_WAIT=4

# --- Host contract --------------------------------------------------------------

POSTFIX_PACKAGE="postfix"
POSTFIX_DIR="/etc/postfix"
MAIN_CF="${POSTFIX_DIR}/main.cf"
MASTER_CF="${POSTFIX_DIR}/master.cf"
MANAGED_FILE_MODE="644"

# Each signed target's From policy: one file per target, named from its ID, and
# beginning with this line. A file of that name without it is not this
# installer's, and is never used or removed.
FROM_POLICY_NAME_PATTERN='^rateguru-from-[a-z0-9][a-z0-9-]{1,31}\.regexp$'
FROM_POLICY_MARKER="# RateGuru mail gateway — From policy for "

# Ubuntu runs Postfix as postfix@-.service, pulled in at boot by the
# postfix.service wrapper the package enables.
POSTFIX_UNIT="postfix.service"
POSTFIX_INSTANCE_UNIT="postfix@-.service"

STATE_DIR="/var/lib/rateguru-mail-gateway"
OWNERSHIP_MARKER="${STATE_DIR}/ownership"
PRESERVED_POLICY_RC="${STATE_DIR}/policy-rc.d.preserved"
POLICY_RC="/usr/sbin/policy-rc.d"
POLICY_RC_MARKER="# rateguru-mail-gateway: package service starts suppressed until the gateway configuration is in place"
BACKUP_ROOT="/var/backups/rateguru-mail-gateway"

# Who may listen on a public SMTP port is judged in one place: public-smtp-port,
# which also brings where the inbound receiver lives (mail-inbound-host). On 25
# only this Postfix's own public inbound listener may, once activated.
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/public-smtp-port"

# The name Postfix calls itself when the host reviews no MTA hostname: never a
# deliverable one, and never used while direct delivery is enabled.
GATEWAY_HOSTNAME="mail-gateway.rateguru.invalid"

# The complete public policy the gateway was last applied from: the host's own
# witness of what was accepted.
APPLIED_PLAN="${STATE_DIR}/applied-plan.json"
APPLIED_OUTBOUND="${STATE_DIR}/applied-outbound.json"
APPLIED_FILE_MODE="644"

# The one-use authorization activate-mail-outbound writes for a held/outbound
# transition, and the ledger of every authorization this installer consumed.
TRANSITION_AUTHORIZATION="${STATE_DIR}/transition-authorization.json"
CONSUMED_AUTHORIZATIONS="${STATE_DIR}/consumed-transition-authorizations"
AUTHORIZATION_KIND="rateguru-mail-gateway-transition-authorization"
AUTHORIZATION_MAX_LIFETIME=3600

# --- Output ---------------------------------------------------------------------

MODE=""
COUNT_PASS=0
COUNT_MISSING=0
COUNT_DRIFT=0
COUNT_CONFLICT=0
COUNT_DEFERRED=0

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

# item STATUS NAME DETAIL — one report line, the shape every bootstrap installer
# prints.
item() {
    local status="$1" name="$2" detail="$3"

    case "${status}" in
        PASS)     COUNT_PASS=$((COUNT_PASS + 1)) ;;
        MISSING)  COUNT_MISSING=$((COUNT_MISSING + 1)) ;;
        DRIFT)    COUNT_DRIFT=$((COUNT_DRIFT + 1)) ;;
        CONFLICT) COUNT_CONFLICT=$((COUNT_CONFLICT + 1)) ;;
        DEFERRED) COUNT_DEFERRED=$((COUNT_DEFERRED + 1)) ;;
        *)        fail "internal: unknown item status: ${status}" ;;
    esac

    printf '  %-8s %s — %s\n' "${status}" "${name}" "${detail}"
}

action() {
    printf 'APPLY    %s\n' "$*"
}

usage() {
    cat <<'USAGE'
Usage:
  install-mail-gateway --check
  install-mail-gateway --apply
  install-mail-gateway --verify
  install-mail-gateway --policy-digest

  --check   Read-only. Renders the gateway from the reviewed mail routing plan,
            validates it (with Postfix's own parser when Postfix is installed),
            and reports what --apply would install or change. Exit 0 when
            --apply can converge; non-zero on a conflict it must not resolve.
  --apply   Install or converge the host-global gateway (root). May install the
            postfix package, with service starts suppressed until the rendered
            configuration has been validated.
  --verify  Read-only (root). Exit 0 only when the installed gateway is exactly
            the current render, Postfix accepts it, the service is enabled and
            stably active, the listeners are exactly the plan's loopback
            endpoints, no public SMTP port is open, every capture destination is
            listening, held mail has no route, each outbound route is its
            target's own direct smtp client and nothing else's, exactly the
            signed targets' listeners hand their mail to the signer — which is
            listening — and fail temporarily without it, each through its own
            cleanup service whose From policy is exactly the current render
            and refuses every From outside the target's domain, and
            unclassified mail cannot be delivered — and the recorded applied
            policy is exactly the complete plan and host contract this bundle
            requests.
  --policy-digest
            Read-only. One JSON line: the SHA-256 of the canonical plan and host
            contract this bundle requests, of the ones recorded on this host
            (null when none), and where a transition authorization belongs.

A production target's held/outbound transition, or direct delivery switching
on or off, is refused by every mode unless activate-mail-outbound authorized
exactly that transition; there is no override.

The routes come from infrastructure/scripts/mail-routing render-plan in the same
bundle; this installer only spells them in Postfix. A direct outbound route is
refused in every mode unless infrastructure/config/mail-outbound.json enables
direct delivery on this host under a valid public MTA hostname. The signed
listeners come from mail-identity render-signing-plan, and the signer's endpoint
from install-mail-signing --milter-endpoint, in the same bundle.
USAGE
}

physical() {
    printf '%s%s\n' "${FS_ROOT}" "$1"
}

require_root() {
    [[ "${EFFECTIVE_UID}" == 0 ]] || fail "install-mail-gateway --${MODE} must run as root"
}

require_tools() {
    local tool
    for tool in "$@"; do
        command -v "${tool}" >/dev/null 2>&1 || fail "required tool not found: ${tool}"
    done
}

# --- The host's outbound contract ---------------------------------------------------
#
# mail-outbound.json is judged by infrastructure/scripts/mail-identity — the one
# judge of the host's mail identity — from this same bundle, never restated
# here: its shape and schema, a valid public MTA hostname whenever direct
# delivery is enabled, and that every direct route in the plan is on a host
# that enabled it.

# assert_outbound_contract PLAN CONTRACT — the judge's verdict on the contract
# and the plan's use of it. Its diagnostics reach stderr unchanged; a refusal
# exits before anything is rendered, so --check, --apply and --verify all stop
# here, with nothing changed.
assert_outbound_contract() {
    local plan="$1" path="$2"

    [[ -x "${MAIL_IDENTITY_CLI}" ]] \
        || fail "the mail identity CLI is not executable: ${MAIL_IDENTITY_CLI} — run from a full repository bundle; this installer never judges the host contract itself"

    "${MAIL_IDENTITY_CLI}" check-outbound --plan "${plan}" --outbound "${path}" >/dev/null \
        || fail "the host outbound contract refuses this gateway: ${path} — nothing was rendered, and nothing on the host was changed"
}

# gateway_hostname CONTRACT — the name Postfix calls itself: the reviewed MTA
# hostname whenever the contract names one, the non-deliverable fallback only
# when it names none and direct delivery is disabled; fails when direct
# delivery is enabled with no name, which the contract's judge refuses first.
gateway_hostname() {
    local contract="$1" hostname enabled

    hostname="$(jq -r '.direct.mta_hostname // ""' "${contract}" 2>/dev/null)" || return 1
    enabled="$(jq -r '.direct.enabled' "${contract}" 2>/dev/null)" || return 1

    if [[ -n "${hostname}" ]]; then
        printf '%s\n' "${hostname}"
        return 0
    fi

    [[ "${enabled}" != true ]] || return 1
    printf '%s\n' "${GATEWAY_HOSTNAME}"
}

# --- Rendering (Postfix spelling of the plan) -------------------------------------
#
# Pure: plan and outbound contract in, two files out. Both are byte-for-byte
# functions of those two, so --verify can re-render and compare. The guard
# below is not policy — the plan was judged by mail-routing — it only proves
# every value the renderer splices into Postfix syntax is a plain token, so
# nothing in the plan can become a second directive.
#
# A plan with no outbound listener renders exactly what it rendered before
# outbound routes existed: every outbound line below is conditional on one.

# The programs are single-quoted on purpose: every `$name` in them is a jq
# variable or Postfix's own `$parameter` reference, and none may ever be
# expanded by the shell.
# shellcheck disable=SC2016
RENDER_DEFINITIONS='
def token: type == "string" and test("\\A[a-z0-9][a-z0-9@._:-]*\\z");
def port: type == "number" and . == floor and . >= 1 and . <= 65535;
def endpoint: "\(.host):\(.port)";
def param: "rateguru_" + (.identity | gsub("-"; "_"));
def capture_transport: "rateguru-capture-" + .identity;
def outbound_transport: "rateguru-outbound-" + .identity;
def is_direct: .delivery_mode == "outbound" and (.route | type) == "object" and .route.kind == "direct";
def has_outbound: any(.listeners[]; .delivery_mode == "outbound");
def pad($n): . + (" " * ([$n - length, 1] | max));
def service($name; $type; $private; $unpriv; $chroot; $wakeup; $maxproc; $command):
    ($name | pad(15)) + ($type | pad(6)) + ($private | pad(8)) + ($unpriv | pad(8))
    + ($chroot | pad(8)) + ($wakeup | pad(8)) + ($maxproc | pad(8)) + $command;
def no_route: "error:5.7.1 RateGuru mail gateway: no delivery route for this mail";
def signed: .identity as $id | any($signing[0].targets[]; .target == $id);
def has_signed: any(.listeners[]; signed);
def cleanup_service: "rateguru-cleanup-" + .identity;
def from_policy_name: "rateguru-from-" + .identity + ".regexp";
def from_policy_path: "'"${POSTFIX_DIR}"'/" + from_policy_name;
'

# shellcheck disable=SC2016
PLAN_GUARD_PROGRAM="${RENDER_DEFINITIONS}"'
.schema_version == 2
and (.listeners | type == "array" and length > 0)
and all(.listeners[];
    (.identity | token) and (.identity | test("\\A[a-z0-9-]+\\z"))
    and (.listen | type == "object") and (.listen.host | token) and (.listen.port | port)
    and (.delivery_mode | token)
    and (.sender | type == "object") and (.sender.allowed_domain | token)
    and (.route == null
         or ((.route | type == "object") and (.route.kind | token)
             and (if .route.kind == "direct" then (.route | keys) == ["kind"]
                  else (.route.host | token) and (.route.port | port) end))))
'

# shellcheck disable=SC2016
MAIN_CF_PROGRAM="${RENDER_DEFINITIONS}"'
(
    "# RateGuru mail gateway — main.cf",
    "#",
    "# Rendered by infrastructure/scripts/install-mail-gateway from the plan that",
    "# infrastructure/scripts/mail-routing renders out of the reviewed",
    "# infrastructure/config/mail-routing.json. Never edit it on a host: the next",
    "# --apply replaces it, and --verify reports any difference.",
    "#",
    "# Fail closed: every transport a message could fall through to is error(8),",
    "# and there is no relayhost, no destination domain and no transport map. A",
    "# message is delivered only by the route its listener names in master.cf.",
    "",
    "compatibility_level = 3.6",
    "myhostname = \($hostname)",
    "myorigin = $myhostname",
    "smtpd_banner = $myhostname ESMTP",
    "biff = no",
    "append_dot_mydomain = no",
    "readme_directory = no",
    "",
    "# Loopback and IPv4 only. The listeners themselves are in master.cf.",
    "inet_interfaces = 127.0.0.1",
    "inet_protocols = ipv4",
    "mynetworks = 127.0.0.0/8",
    "",
    "# No destination this host delivers for, and nowhere to relay to.",
    "mydestination =",
    "relay_domains =",
    "relayhost =",
    "transport_maps =",
    "sender_dependent_relayhost_maps =",
    "sender_dependent_default_transport_maps =",
    "content_filter =",
    "alias_maps =",
    "alias_database =",
    "",
    "# Undeliverable unless a listener routed it.",
    "default_transport = \(no_route)",
    "relay_transport = \(no_route)",
    "local_transport = \(no_route)",
    (if $inbound == null then "virtual_transport = \(no_route)"
     else "virtual_transport = virtual" end),
    "",
    "# No authentication and no TLS: the boundary is the host and the port.",
    "smtpd_sasl_auth_enable = no",
    "smtp_sasl_auth_enable = no",
    "smtpd_tls_security_level = none",
    "smtp_tls_security_level = none",
    "",
    "# Loopback clients only, and an exact match on the sender domain: a",
    "# subdomain is a different identity.",
    "smtpd_client_restrictions = permit_mynetworks, reject",
    "smtpd_relay_restrictions = permit_mynetworks, reject",
    "smtpd_recipient_restrictions =",
    "parent_domain_matches_subdomains =",
    "smtpd_null_access_lookup_key = <>",
    "disable_vrfy_command = yes",
    "",
    "# Each target'"'"'s sender authorization, applied by its own listener.",
    (if has_signed then
         "# A signed listener admits no empty sender: a message without an author",
         "# in its own domain could never be signed."
     else empty end),
    (.listeners[]
        | "\(param)_sender_restrictions = check_sender_access inline:{ \(.sender.allowed_domain)=OK\(if signed then "" else ", <>=OK" end) }, reject"),
    (if has_outbound then
         "",
         "# Direct outbound. An outbound listener names its own smtp client as a",
         "# content filter with no next hop, and with this empty the queue manager",
         "# uses each recipient'"'"'s own domain as that next hop, so the client looks",
         "# up the recipient domain'"'"'s MX. The client itself, its HELO identity and",
         "# its opportunistic STARTTLS are in master.cf; nothing here routes mail.",
         "default_filter_nexthop ="
     else empty end),
    (if $inbound != null then
         "",
         "# Inbound mail: virtual(8) delivers into Maildir under the inbound store,",
         "# for exactly these domains and the recipients of the rendered table — the",
         "# one delivery route besides the listeners'"'"' own. Every other setting of the",
         "# inbound listeners is theirs alone, in master.cf. No submission listener",
         "# reaches this: each routes by its own content filter, and judges no",
         "# recipient against the table.",
         "virtual_mailbox_domains = \($inbound.domains | join(", "))",
         "virtual_mailbox_maps = regexp:\($inbound.table)",
         "virtual_mailbox_base = \($inbound.store)",
         "virtual_uid_maps = static:\($inbound.uid)",
         "virtual_gid_maps = static:\($inbound.gid)",
         "virtual_minimum_uid = \($inbound.uid)",
         "virtual_mailbox_limit = \($inbound.limits.message_size_bytes)"
     else empty end)
)
'

# The host outbound contract arrives as $outbound, already judged by
# assert_outbound_contract; the direct route refuses to render without it all
# the same.
# shellcheck disable=SC2016
MASTER_CF_PROGRAM="${RENDER_DEFINITIONS}"'
def listener:
    (
        service(.listen | endpoint; "inet"; "n"; "-"; "n"; "-"; "-"; "smtpd"),
        "  -o syslog_name=postfix/rateguru-\(.identity)",
        "  -o smtpd_delay_reject=no",
        "  -o smtpd_reject_unlisted_recipient=no",
        "  -o smtpd_sender_restrictions=$\(param)_sender_restrictions",
        if .delivery_mode == "capture" and (.route | type) == "object" and .route.kind == "capture" then
            "  -o content_filter=\(capture_transport):[\(.route.host)]:\(.route.port)"
        elif .delivery_mode == "held" and .route == null then
            "  -o smtpd_recipient_restrictions=check_client_access,static:HOLD,permit_mynetworks,reject",
            "  -o content_filter="
        elif is_direct then
            # No next hop: each recipient domain is its own, resolved by MX.
            "  -o content_filter=\(outbound_transport):"
        else
            error("no Postfix rendering is defined for delivery mode \(.delivery_mode | tojson) of \(.identity)")
        end,
        if signed then
            "  -o smtpd_milters=\($milter)",
            "  -o milter_protocol=6",
            "  -o milter_default_action=tempfail",
            "  -o cleanup_service_name=\(cleanup_service)"
        else empty end
    );

# The own cleanup service of a signed target: its From policy as header checks,
# none for attached messages, and a missing From added from the envelope sender.
def signed_cleanup:
    (
        service(cleanup_service; "unix"; "n"; "-"; "n"; "-"; "0"; "cleanup"),
        "  -o syslog_name=postfix/\(cleanup_service)",
        "  -o header_checks=regexp:\(from_policy_path)",
        "  -o nested_header_checks=",
        "  -o always_add_missing_headers=yes"
    );

def direct_helo:
    $outbound[0].direct as $direct
    | if ($direct | type) == "object" and $direct.enabled == true and ($direct.mta_hostname | token) then
          $direct.mta_hostname
      else
          error("direct outbound delivery is not enabled on this host — refusing to render a direct route")
      end;

def outbound_route:
    (
        service(outbound_transport; "unix"; "-"; "-"; "n"; "-"; "-"; "smtp"),
        "  -o syslog_name=postfix/\(outbound_transport)",
        "  -o smtp_helo_name=\(direct_helo)",
        "  -o smtp_tls_security_level=may",
        "  -o smtp_tls_loglevel=1",
        "  -o smtp_sasl_auth_enable=no",
        "  -o smtp_fallback_relay="
    );

def capture_route:
    (
        service(capture_transport; "unix"; "-"; "-"; "n"; "-"; "-"; "smtp"),
        "  -o syslog_name=postfix/\(capture_transport)",
        "  -o smtp_tls_security_level=none",
        "  -o smtp_sasl_auth_enable=no"
    );

def inbound_options:
    $inbound.limits as $limits
    | (
        "  -o smtpd_client_restrictions=",
        "  -o smtpd_helo_restrictions=",
        "  -o smtpd_sender_restrictions=",
        "  -o smtpd_relay_restrictions=reject_unauth_destination",
        "  -o smtpd_recipient_restrictions=reject_unlisted_recipient",
        "  -o smtpd_reject_unlisted_recipient=yes",
        "  -o smtpd_data_restrictions=",
        "  -o smtpd_helo_required=yes",
        "  -o smtpd_sasl_auth_enable=no",
        "  -o smtpd_milters=",
        "  -o content_filter=",
        "  -o smtpd_discard_ehlo_keywords=etrn",
        "  -o smtpd_etrn_restrictions=reject",
        "  -o smtpd_recipient_limit=\($limits.recipients_per_message)",
        "  -o smtpd_client_connection_count_limit=\($limits.connections_per_client)",
        "  -o smtpd_client_connection_rate_limit=\($limits.connection_rate_per_client)",
        "  -o smtpd_client_message_rate_limit=\($limits.message_rate_per_client)",
        "  -o smtpd_client_event_limit_exceptions=",
        "  -o message_size_limit=\($limits.message_size_bytes)",
        "  -o queue_minfree=\($limits.host_reserve_bytes)",
        "  -o myhostname=\($inbound.hostname)",
        "  -o cleanup_service_name=\($inbound.cleanup)",
        "  -o rewrite_service_name=\($inbound.rewrite)"
    );

# The inbound listeners, their own cleanup and address rewriting, and
# virtual(8): everything that makes this Postfix receive mail, and nothing a
# submission listener names.
def inbound_section:
    (
        "# --- inbound: recipients judged at RCPT TO against the rendered table, for",
        "# every client alike — loopback included — no relay, no SMTP AUTH, the",
        "# reviewed limits and a queue floor of their own; their own cleanup, which",
        "# signs nothing, and their own address rewriting, which makes a bare",
        "# <Postmaster> the host postmaster. The loopback listener is the",
        "# activation'"'"'s proof; the public one exists only while the host'"'"'s applied",
        "# inbound state enables it, on exactly the recorded address.",
        service($inbound.loopback; "inet"; "n"; "-"; "n"; "-"; "2"; "smtpd"),
        "  -o syslog_name=postfix/rateguru-inbound-loopback",
        inbound_options,
        (if $inbound.state == "enabled" then
             service("\($inbound.address):25"; "inet"; "n"; "-"; "n"; "-"; ($inbound.limits.concurrent_sessions | tostring); "smtpd"),
             "  -o syslog_name=postfix/rateguru-inbound",
             inbound_options,
             "  -o smtpd_tls_security_level=may",
             "  -o smtpd_tls_chain_files=\($inbound.tls_key),\($inbound.tls_cert)",
             "  -o smtpd_tls_protocols=>=TLSv1.2",
             "  -o smtpd_tls_mandatory_protocols=>=TLSv1.2",
             "  -o smtpd_tls_loglevel=0",
             "  -o smtpd_tls_received_header=yes"
         else empty end),
        service($inbound.cleanup; "unix"; "n"; "-"; "n"; "-"; "0"; "cleanup"),
        "  -o syslog_name=postfix/\($inbound.cleanup)",
        "  -o rewrite_service_name=\($inbound.rewrite)",
        "  -o message_size_limit=\($inbound.limits.message_size_bytes)",
        "  -o header_checks=",
        "  -o nested_header_checks=",
        "  -o body_checks=",
        service($inbound.rewrite; "unix"; "-"; "-"; "n"; "-"; "-"; "trivial-rewrite"),
        "  -o syslog_name=postfix/\($inbound.rewrite)",
        "  -o myorigin=\($inbound.host_postmaster_domain)",
        service("virtual"; "unix"; "-"; "n"; "n"; "-"; "-"; "virtual"),
        ""
    );

(
    "# RateGuru mail gateway — master.cf",
    "#",
    "# Rendered by infrastructure/scripts/install-mail-gateway from the reviewed",
    "# mail routing plan. Never edit it on a host.",
    "#",
    (if $inbound != null then
         "# The inet services are the per-target loopback listeners and the inbound",
         "# listeners below: there is no smtp, submission or smtps listener. The",
         "# delivery agents are one capture transport per capture target, one direct",
         "# outbound transport per outbound target and virtual(8) for inbound mail;",
         "# there is no generic smtp, relay, local or lmtp transport for anything to",
         "# fall through to."
     else
    "# The only inet services are the per-target loopback listeners: there is no",
    "# smtp, submission or smtps listener. The only delivery agents are one",
    (if has_outbound then
         "# capture transport per capture target and one direct outbound transport",
         "# per outbound target; there is no generic smtp, relay, local, virtual or",
         "# lmtp transport for anything to fall through to."
     else
         "# capture transport per capture target; there is no generic smtp, relay,",
         "# local, virtual or lmtp transport for anything to fall through to."
     end)
     end),
    "#",
    "# service type  private unpriv  chroot  wakeup  maxproc command + args",
    "",
    "# --- target listeners: the port is the routing identity",
    (if has_signed then
         "# A signed listener hands each message to the DKIM signer before it is",
         "# queued, and defers it when the signer cannot sign: never unsigned.",
         "# Signing routes nothing."
     else empty end),
    (.listeners[] | listener),
    "",
    "# --- capture routes: queued, then delivered to the capture destination",
    (.listeners[] | select(.delivery_mode == "capture") | capture_route),
    "",
    (if has_signed then
         "# --- signed listeners'"'"' cleanup: each target'"'"'s own From policy. A message",
         "# whose From is not exactly one address in its target'"'"'s domain is refused",
         "# before it is queued. Nothing here routes.",
         (.listeners[] | select(signed) | signed_cleanup),
         ""
     else empty end),
    (if has_outbound then
         "# --- outbound routes: queued, then delivered by the target'"'"'s own smtp client",
         "# straight to each recipient domain'"'"'s MX. No relay host, no smart host, no",
         "# SMTP AUTH; STARTTLS whenever the receiving server offers it. The HELO",
         "# name is the host'"'"'s MTA identity, never a target'"'"'s domain.",
         (.listeners[] | select(is_direct) | outbound_route),
         ""
     else empty end),
    (if $inbound != null then inbound_section else empty end),
    "# --- Postfix internal services. Every service the package master.cf repair",
    "# appends when missing is present, so a postfix upgrade adds nothing.",
    service("pickup"; "unix"; "n"; "-"; "n"; "60"; "1"; "pickup"),
    service("cleanup"; "unix"; "n"; "-"; "n"; "-"; "0"; "cleanup"),
    service("qmgr"; "unix"; "n"; "-"; "n"; "300"; "1"; "qmgr"),
    service("rewrite"; "unix"; "-"; "-"; "n"; "-"; "-"; "trivial-rewrite"),
    service("bounce"; "unix"; "-"; "-"; "n"; "-"; "0"; "bounce"),
    service("defer"; "unix"; "-"; "-"; "n"; "-"; "0"; "bounce"),
    service("trace"; "unix"; "-"; "-"; "n"; "-"; "0"; "bounce"),
    service("verify"; "unix"; "-"; "-"; "n"; "-"; "1"; "verify"),
    service("flush"; "unix"; "n"; "-"; "n"; "1000?"; "0"; "flush"),
    service("proxymap"; "unix"; "-"; "-"; "n"; "-"; "-"; "proxymap"),
    service("proxywrite"; "unix"; "-"; "-"; "n"; "-"; "1"; "proxymap"),
    service("showq"; "unix"; "n"; "-"; "n"; "-"; "-"; "showq"),
    service("error"; "unix"; "-"; "-"; "n"; "-"; "-"; "error"),
    service("retry"; "unix"; "-"; "-"; "n"; "-"; "-"; "error"),
    service("discard"; "unix"; "-"; "-"; "n"; "-"; "-"; "discard"),
    service("anvil"; "unix"; "-"; "-"; "n"; "-"; "1"; "anvil"),
    service("scache"; "unix"; "-"; "-"; "n"; "-"; "1"; "scache"),
    service("tlsmgr"; "unix"; "-"; "-"; "n"; "1000?"; "1"; "tlsmgr"),
    service("postlog"; "unix-dgram"; "n"; "-"; "n"; "-"; "1"; "postlogd"),
    "# relay is the error transport, not an smtp client: the package repair would",
    "# otherwise append a working one, and nothing here may deliver.",
    service("relay"; "unix"; "-"; "-"; "n"; "-"; "-"; "error")
)
'

# The signing plan's shape, as far as this renderer reads it: the targets it
# signs. Its policy was judged by mail-identity.
# shellcheck disable=SC2016
SIGNING_GUARD_PROGRAM='
.schema_version == 1
and (.targets | type == "array")
and all(.targets[]; (.target | type == "string") and (.target | test("\\A[a-z0-9][a-z0-9-]{1,31}\\z")))
'

# One signed target's From policy, as Postfix regexp header checks. Anchored
# whole-header patterns, case-insensitive like DNS and the signer's lookup: a
# bare address, an angle address, or an angle address after one display name —
# quoted, or plain words — and nothing else, so a list, a group, a comment or an
# address in any other domain (a subdomain or a longer name included) falls
# through to the last line. Only DUNNO and REJECT: the policy never routes.
# shellcheck disable=SC2016
FROM_POLICY_PROGRAM="${RENDER_DEFINITIONS}"'
.listeners[] | select(.identity == $identity)
| .sender.allowed_domain as $domain
| if ($domain | test("\\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+\\z") | not) then
      error("\(.identity) has no plain domain to write a From policy for: \($domain | tojson)")
  else . end
| ("[[:alnum:]._%+-]+@" + ($domain | gsub("\\."; "\\."))) as $mailbox
| "[[:alnum:]._'"'"'=?!#%&*+^{|}~-]" as $word
| "[[:alnum:][:blank:]._'"'"'=?!#%&*+^{|}~-]" as $phrase
| (
    "'"${FROM_POLICY_MARKER}"'\(.identity)",
    "#",
    "# Rendered by infrastructure/scripts/install-mail-gateway from the reviewed",
    "# mail routing plan. Never edit it on a host: the next --apply replaces it, and",
    "# --verify reports any difference. The header checks of \(cleanup_service)",
    "# alone: a message through \(.identity)'"'"'s listener carries exactly one From",
    "# address in \($domain), or it is refused before it is queued, so the DKIM",
    "# signer always finds the domain it signs for. Nothing here selects a route.",
    "",
    "/^From:[[:space:]]*\($mailbox)[[:space:]]*$/ DUNNO",
    "/^From:[[:space:]]*<\($mailbox)>[[:space:]]*$/ DUNNO",
    "/^From:[[:space:]]*\"[^\"<>@,;:\\\\]*\"[[:space:]]*<\($mailbox)>[[:space:]]*$/ DUNNO",
    "/^From:[[:space:]]*\($word)\($phrase)*<\($mailbox)>[[:space:]]*$/ DUNNO",
    "/^From:/ REJECT 5.7.1 RateGuru mail gateway: the From header must be exactly one address in the reviewed sender domain"
  )
'

# The signer's endpoint as Postfix spells a milter: on loopback, and nowhere
# else, whatever port the signer chose.
MILTER_ENDPOINT_PATTERN='^inet:127\.0\.0\.1:[1-9][0-9]{0,4}$'

# The inbound input this renderer reads — the host's inbound state, and what
# `mail-inbound render-receiver` says the listeners accept — as far as it is
# spliced into Postfix syntax: every value a plain token, number or pattern, so
# nothing in it can become a second directive. The policy was judged by
# mail-inbound.
# shellcheck disable=SC2016
INBOUND_GUARD_PROGRAM='
def token: type == "string" and test("\\A[a-z0-9][a-z0-9@._:-]*\\z");
def path: type == "string" and test("\\A/[a-z0-9/._-]+\\z");
def count: type == "number" and . == floor and . >= 0;
(.state == "disabled" or .state == "enabled")
and (if .state == "enabled" then (.address | type == "string" and test("\\A[0-9]{1,3}(\\.[0-9]{1,3}){3}\\z")) else .address == null end)
and (.loopback | type == "string" and test("\\A127\\.0\\.0\\.1:[1-9][0-9]{3,4}\\z"))
and (.hostname | token)
and (.host_postmaster_domain | token)
and (.domains | type == "array" and length > 0 and all(.[]; token))
and (.table | path) and (.store | path) and (.tls_cert | path) and (.tls_key | path)
and (.cleanup | token) and (.rewrite | token)
and (.uid | count) and (.gid | count) and .uid > 0
and (.limits | type == "object" and length > 0 and all(.[]; count))
and (.recipients | type == "array" and length > 0
     and all(.[]; (.pattern | type == "string" and test("\\A\\^[^/[:space:]]+\\$\\z"))
                  and (.mailbox | type == "string" and test("\\A[a-z0-9][a-z0-9/-]*/\\z"))))
'

# The table the inbound listeners judge recipients by and virtual(8) delivers
# by: every allowed recipient, anchored, and the mailbox under the store it is
# delivered to. Postfix regexp tables match case-insensitively.
# shellcheck disable=SC2016
INBOUND_TABLE_PROGRAM='
(
    "# RateGuru mail gateway — the recipients its inbound listeners accept, and",
    "# the Maildir under the inbound store each is delivered to.",
    "#",
    "# Rendered by infrastructure/scripts/install-mail-gateway from mail-inbound",
    "# render-receiver. Never edit it on a host: the next --apply replaces it, and",
    "# --verify reports any difference. Matching is case-insensitive.",
    "",
    (.recipients[] | "/\(.pattern)/ \(.mailbox)")
)
'

# render_gateway_config PLAN OUTBOUND SIGNING MILTER OUT_DIR [INBOUND] — judges
# the host outbound contract and the plan's use of it, then writes
# OUT_DIR/main.cf and OUT_DIR/master.cf, wiring each listener the signing plan
# names to the MILTER endpoint. INBOUND, when given, is the inbound input
# (inbound_render_input): the host's inbound listeners and delivery are then
# rendered too, with OUT_DIR/rateguru-inbound-recipients.regexp; without it
# the render is exactly what it was before inbound mail existed. Called as a
# plain statement, never inside $(...) or on the left of ||, so a refusal or a
# jq failure stops the run instead of leaving a half file.
render_gateway_config() {
    local plan="$1" outbound="$2" signing="$3" milter="$4" out="$5" inbound_file="${6:-}" inbound=null

    jq -e "${PLAN_GUARD_PROGRAM}" "${plan}" >/dev/null \
        || fail "the mail routing plan does not have the shape this renderer spells in Postfix — refusing to render around it"

    jq -e "${SIGNING_GUARD_PROGRAM}" "${signing}" >/dev/null 2>&1 \
        || fail "the signing plan does not have the shape this renderer reads — refusing to render around it"

    [[ "${milter}" =~ ${MILTER_ENDPOINT_PATTERN} ]] \
        || fail "the signer's milter endpoint is \"${milter}\", not a loopback inet endpoint — refusing to wire a listener to it"

    assert_outbound_contract "${plan}" "${outbound}"

    local hostname
    hostname="$(gateway_hostname "${outbound}")" \
        || fail "the host outbound contract enables direct delivery under no MTA hostname — a gateway never delivers as ${GATEWAY_HOSTNAME}; nothing was rendered"
    [[ "${hostname}" =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ ]] \
        || fail "the reviewed MTA hostname \"${hostname}\" is not a plain host name — refusing to splice it into main.cf"

    if [[ -n "${inbound_file}" ]]; then
        jq -e "${INBOUND_GUARD_PROGRAM}" "${inbound_file}" >/dev/null 2>&1 \
            || fail "the inbound input does not have the shape this renderer spells in Postfix — refusing to render around it"
        inbound="$(jq -c . "${inbound_file}")"
        jq -r "${INBOUND_TABLE_PROGRAM}" "${inbound_file}" > "${out}/$(basename "${MAIL_INBOUND_RECIPIENT_TABLE}")"
    fi

    jq -r --slurpfile signing "${signing}" --arg hostname "${hostname}" --argjson inbound "${inbound}" \
        "${MAIN_CF_PROGRAM}" "${plan}" > "${out}/main.cf"
    jq -r --slurpfile outbound "${outbound}" --slurpfile signing "${signing}" --arg milter "${milter}" \
        --argjson inbound "${inbound}" "${MASTER_CF_PROGRAM}" "${plan}" > "${out}/master.cf"

    local identity
    while IFS= read -r identity; do
        [[ -n "${identity}" ]] || continue
        jq -r --arg identity "${identity}" "${FROM_POLICY_PROGRAM}" "${plan}" > "${out}/rateguru-from-${identity}.regexp"
    done < <(jq -r --slurpfile signing "${signing}" '.listeners[] | select(.identity as $id | any($signing[0].targets[]; .target == $id)) | .identity' "${plan}")
}

# --- The plan -----------------------------------------------------------------------

WORK_DIR=""
PLAN_FILE=""
SIGNING_FILE=""
MILTER_ENDPOINT=""
CANDIDATE_DIR=""
APPLIED_CANDIDATE_DIR=""

cleanup_work_dir() {
    [[ -n "${WORK_DIR}" && -d "${WORK_DIR}" ]] && rm -rf "${WORK_DIR}"
    return 0
}

# prepare_candidate — the plan from mail-routing, and its Postfix rendering,
# in a private directory. mail-routing validates before it renders and prints
# nothing when the policy is invalid, so an invalid policy stops here.
prepare_candidate() {
    [[ -x "${MAIL_ROUTING_CLI}" ]] \
        || fail "the mail routing CLI is not executable: ${MAIL_ROUTING_CLI} — run from a full repository bundle; this installer never re-derives the policy"

    WORK_DIR="$(mktemp -d)"
    chmod 0700 "${WORK_DIR}"
    PLAN_FILE="${WORK_DIR}/plan.json"
    CANDIDATE_DIR="${WORK_DIR}/candidate"
    mkdir -m 0700 "${CANDIDATE_DIR}"

    "${MAIL_ROUTING_CLI}" render-plan --file "${POLICY_FILE}" --registry "${REGISTRY_FILE}" > "${PLAN_FILE}" \
        || fail "mail-routing render-plan refused the reviewed policy (diagnostics above) — nothing was rendered"

    # The host contract's own verdict comes first, so a route the host has not
    # enabled is refused for that reason and no other.
    assert_outbound_contract "${PLAN_FILE}" "${OUTBOUND_FILE}"

    SIGNING_FILE="${WORK_DIR}/signing-plan.json"
    "${MAIL_IDENTITY_CLI}" render-signing-plan \
        --identity "${IDENTITY_FILE}" --routing "${POLICY_FILE}" \
        --registry "${REGISTRY_FILE}" --outbound "${OUTBOUND_FILE}" > "${SIGNING_FILE}" \
        || fail "mail-identity render-signing-plan refused the reviewed identity (diagnostics above) — nothing was rendered"

    [[ -x "${MAIL_SIGNING_CLI}" ]] \
        || fail "the signing installer is not executable: ${MAIL_SIGNING_CLI} — run from a full repository bundle; the signer's endpoint is never spelled here"
    MILTER_ENDPOINT="$("${MAIL_SIGNING_CLI}" --milter-endpoint)" \
        || fail "install-mail-signing --milter-endpoint failed — nothing was rendered"

    # Inbound mail as the host records it, or as a pending authorization moves
    # it; nothing at all on a host that never installed it.
    resolve_inbound

    render_gateway_config "${PLAN_FILE}" "${OUTBOUND_FILE}" "${SIGNING_FILE}" "${MILTER_ENDPOINT}" "${CANDIDATE_DIR}" "${INBOUND_INPUT}"

    # The applied policy this run would record: the whole plan and the host
    # contract, canonical — keys sorted, one layout — so equal policies are
    # equal bytes and equal digests.
    APPLIED_CANDIDATE_DIR="${WORK_DIR}/applied"
    mkdir -m 0700 "${APPLIED_CANDIDATE_DIR}"
    jq -S . "${PLAN_FILE}" > "${APPLIED_CANDIDATE_DIR}/$(basename "${APPLIED_PLAN}")"
    jq -S . "${OUTBOUND_FILE}" > "${APPLIED_CANDIDATE_DIR}/$(basename "${APPLIED_OUTBOUND}")"
    if [[ "${INBOUND_STATE}" != absent ]]; then
        mail_inbound_applied_document "${INBOUND_STATE}" "${INBOUND_ADDRESS}" > "${APPLIED_CANDIDATE_DIR}/$(basename "${MAIL_INBOUND_APPLIED}")"
    fi
}

# Newline-separated plan facts, read once from the rendered plan.
plan_endpoints() {
    jq -r '.listeners[] | "\(.listen.host):\(.listen.port)"' "${PLAN_FILE}" || true
}

plan_ports() {
    jq -r '.listeners[] | .listen.port' "${PLAN_FILE}" || true
}

plan_capture_destinations() {
    jq -r '.listeners[] | select(.delivery_mode == "capture") | "\(.route.host):\(.route.port)"' "${PLAN_FILE}" || true
}

# Every smtp client the plan names: one capture transport per capture target and
# one outbound transport per outbound target. Nothing else may run smtp(8).
plan_smtp_transports() {
    jq -r '.listeners[]
        | if .delivery_mode == "capture" then "rateguru-capture-\(.identity)"
          elif .delivery_mode == "outbound" then "rateguru-outbound-\(.identity)"
          else empty end' "${PLAN_FILE}" || true
}

# The targets whose listeners hand their mail to the signer.
signed_identities() {
    jq -r '.targets[].target' "${SIGNING_FILE}" 2>/dev/null || true
}

# The signer's endpoint as host:port, the way a listening socket shows it.
milter_listen_address() {
    printf '%s\n' "${MILTER_ENDPOINT#inet:}"
}

plan_outbound_count() {
    jq '[.listeners[] | select(.delivery_mode == "outbound")] | length' "${PLAN_FILE}" 2>/dev/null || echo 0
}

# The MTA identity the host contract names; empty when direct delivery is
# disabled. Read only after assert_outbound_contract accepted the contract.
outbound_mta_hostname() {
    jq -r 'if .direct.enabled == true then .direct.mta_hostname else "" end' "${OUTBOUND_FILE}" 2>/dev/null || true
}

# --- Inbound mail: the host's record, and the transitions between its states ----------
#
# The host records whether this Postfix receives inbound mail, and whether its
# public listener is open: absent, disabled, or enabled on one address. That
# record — never the repository — is what is rendered. It moves only by one of
# three transitions, each with a one-use authorization activate-mail-inbound
# writes after its own proof and this installer consumes:
#
#   install   absent   -> disabled   the inbound loopback listener and delivery
#   enable    disabled -> enabled    the public listener, on one address
#   disable   enabled  -> disabled   the public listener closed again
#
# There is no transition back to absent: mail an inbound listener accepted may
# still wait in the queue for its store, and only virtual(8) can deliver it.

INBOUND_RECORDED=""          # absent | disabled | enabled | corrupt
INBOUND_RECORDED_ADDRESS=""
INBOUND_REQUESTED=""         # what this bundle's contract requests: enabled | disabled
INBOUND_TRANSITION=""        # the authorized transition this run makes, if any
INBOUND_PENDING_PROBLEMS=""  # why a pending authorization is not honoured
INBOUND_STATE=""             # what is rendered: absent | disabled | enabled
INBOUND_ADDRESS=""
INBOUND_INPUT=""             # the inbound input file, when INBOUND_STATE is not absent

# The authorization activate-mail-inbound writes, judged against the host's
# record and this bundle. Every reason it does not permit exactly the
# transition it names is a line; none when it does.
# shellcheck disable=SC2016
INBOUND_AUTHORIZATION_PROGRAM='
def ipv4: type == "string" and test("\\A(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\z");
def shapes: {
    install: {from: "absent", to: "disabled"},
    enable: {from: "disabled", to: "enabled"},
    disable: {from: "enabled", to: "disabled"}
};
if type != "object" then
    "it is not a JSON object"
else
    (if .kind == $kind and .schema_version == 1 then empty
     else "it is not an inbound transition authorization of schema 1" end),
    (.direction | tostring) as $direction
    | (if (shapes | has($direction)) then
         shapes[$direction] as $shape
         | (if .from.public_smtp == $shape.from and .to.public_smtp == $shape.to then empty
            else "it names \(.direction), which moves \($shape.from) to \($shape.to), not \(.from.public_smtp | tojson) to \(.to.public_smtp | tojson)" end),
           (if .from.public_smtp == $recorded and (.from.address // "") == $recorded_address then empty
            else "it was issued for a host whose inbound state is \(.from.public_smtp | tojson), and this host records \($recorded | tojson)" end),
           (if .to.public_smtp == "enabled" then
                (if (.to.address | ipv4) then empty else "it enables public SMTP on no IPv4 address" end)
            elif .to.address == null then empty
            else "it names an address for a state that has none" end),
           (if .direction == "disable" or $requested == "enabled" then empty
            else "this bundle does not request public SMTP, so it neither installs nor enables it" end)
     else
         "it authorizes \(.direction | tojson), which is not install, enable or disable"
     end),
    (if (.nonce | type) == "string" and (.nonce | test("^[0-9a-f]{32}$")) then empty
     else "it carries no nonce" end),
    (if (.created_at | type) == "number" and (.expires_at | type) == "number"
        and .created_at <= ($now + 60) and $now < .expires_at and (.expires_at - .created_at) <= $lifetime then empty
     else "it has expired, or claims a lifetime no authorization has" end)
end
'

# inbound_authorization_problems — why no pending authorization permits a
# transition from the host's record; nothing when one does.
inbound_authorization_problems() {
    local path dir meta digest ledger nonce
    path="$(physical "${MAIL_INBOUND_AUTHORIZATION}")"
    dir="$(physical "${STATE_DIR}")"
    ledger="$(physical "${MAIL_INBOUND_CONSUMED}")"

    if [[ ! -e "${path}" && ! -L "${path}" ]]; then
        printf 'no inbound transition authorization is pending\n'
        return 0
    fi

    if [[ -L "${path}" || ! -f "${path}" ]]; then
        printf '%s is not a regular file\n' "${MAIL_INBOUND_AUTHORIZATION}"
        return 0
    fi

    meta="$(file_owner_mode "${path}")"
    if [[ "${meta}" != "${FILE_OWNER}:"*" 600" ]]; then
        printf '%s is %s, not %s-owned mode 600 — an authorization anyone else could have written is never honoured\n' "${MAIL_INBOUND_AUTHORIZATION}" "${meta}" "${FILE_OWNER}"
        return 0
    fi

    meta="$(stat -c '%U %a' "${dir}" 2>/dev/null || true)"
    if [[ ! "${meta}" =~ ^[^[:space:]]+\ [0-7]{3,4}$ || "${meta%% *}" != "${FILE_OWNER}" ]] || (( (8#${meta##* } & 8#022) != 0 )); then
        printf '%s is %s, writable by someone other than %s — nothing in it is honoured\n' "${STATE_DIR}" "${meta}" "${FILE_OWNER}"
        return 0
    fi

    digest="$(sha256_of "${path}")"
    nonce="$(jq -r '.nonce // ""' "${path}" 2>/dev/null || true)"
    if [[ -f "${ledger}" ]] && { grep -q "^${digest} " "${ledger}" || { [[ -n "${nonce}" ]] && grep -q "^[0-9a-f]* ${nonce} " "${ledger}"; }; }; then
        printf 'this authorization was already used — one is consumed by the transition it permits, and never honoured twice\n'
        return 0
    fi

    jq -r \
        --arg kind "${MAIL_INBOUND_AUTHORIZATION_KIND}" \
        --arg recorded "${INBOUND_RECORDED}" --arg recorded_address "${INBOUND_RECORDED_ADDRESS}" \
        --arg requested "${INBOUND_REQUESTED}" \
        --argjson now "$(date -u '+%s')" --argjson lifetime "${AUTHORIZATION_MAX_LIFETIME}" \
        "${INBOUND_AUTHORIZATION_PROGRAM}" "${path}" 2>/dev/null \
        || printf 'it is not a JSON document\n'
}

# consume_inbound_authorization — the pending authorization, used: its digest
# and nonce recorded in the ledger, the file removed. Before the transition
# starts, so a failed transition cannot be retried with it either.
consume_inbound_authorization() {
    local path ledger
    path="$(physical "${MAIL_INBOUND_AUTHORIZATION}")"
    ledger="$(physical "${MAIL_INBOUND_CONSUMED}")"

    printf '%s %s %s %s %s\n' "$(sha256_of "${path}")" "$(jq -r '.nonce' "${path}")" "${INBOUND_TRANSITION}" "${INBOUND_ADDRESS:--}" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "${ledger}"
    chown "${FILE_OWNER}:${FILE_GROUP}" "${ledger}"
    chmod 0644 "${ledger}"
    rm -f "${path}"
}

# resolve_inbound — what this run renders for inbound mail: the host's record,
# or — in --check and --apply only — the state a pending authorization moves
# it to. --verify always judges the record itself, and reports a pending
# authorization on its own.
resolve_inbound() {
    local recorded path
    recorded="$(mail_inbound_applied "${FS_ROOT}")"
    INBOUND_RECORDED="${recorded%%$'\t'*}"
    INBOUND_RECORDED_ADDRESS=""
    [[ "${recorded}" != *$'\t'* || "${recorded#*$'\t'}" == "-" ]] || INBOUND_RECORDED_ADDRESS="${recorded#*$'\t'}"

    INBOUND_REQUESTED=disabled
    public_smtp_contract_requests_enabled "${INBOUND_FILE}" && INBOUND_REQUESTED=enabled

    INBOUND_STATE="${INBOUND_RECORDED}"
    INBOUND_ADDRESS="${INBOUND_RECORDED_ADDRESS}"
    [[ "${INBOUND_STATE}" != corrupt ]] || INBOUND_STATE=absent

    INBOUND_TRANSITION=""
    INBOUND_PENDING_PROBLEMS=""
    path="$(physical "${MAIL_INBOUND_AUTHORIZATION}")"
    if [[ -e "${path}" || -L "${path}" ]]; then
        INBOUND_PENDING_PROBLEMS="$(inbound_authorization_problems)"
        if [[ -z "${INBOUND_PENDING_PROBLEMS}" && "${INBOUND_RECORDED}" != corrupt && "${MODE}" != verify ]]; then
            INBOUND_TRANSITION="$(jq -r '.direction' "${path}")"
            INBOUND_STATE="$(jq -r '.to.public_smtp' "${path}")"
            INBOUND_ADDRESS="$(jq -r '.to.address // ""' "${path}")"
        fi
    fi

    INBOUND_INPUT=""
    [[ "${INBOUND_STATE}" != absent ]] || return 0

    [[ -x "${MAIL_INBOUND_CLI}" ]] \
        || fail "the inbound mail CLI is not executable: ${MAIL_INBOUND_CLI} — this host records inbound mail, and only mail-inbound says what it accepts"

    local receiver entry uid gid
    receiver="${WORK_DIR}/receiver.json"
    "${MAIL_INBOUND_CLI}" render-receiver --inbound "${INBOUND_FILE}" --routing "${POLICY_FILE}" \
        --registry "${REGISTRY_FILE}" --outbound "${OUTBOUND_FILE}" --identity "${IDENTITY_FILE}" > "${receiver}" \
        || fail "mail-inbound render-receiver refused the reviewed inbound contract (diagnostics above) — this host records inbound mail, so nothing was rendered"

    entry="$("${GETENT_BIN}" passwd "${MAIL_INBOUND_STORE_USER}" 2>/dev/null || true)"
    uid="$(cut -d: -f3 <<<"${entry}")"
    gid="$(cut -d: -f4 <<<"${entry}")"
    [[ "${uid}" =~ ^[1-9][0-9]*$ && "${gid}" =~ ^[0-9]+$ ]] \
        || fail "the inbound store account ${MAIL_INBOUND_STORE_USER} does not exist — install-mail-inbound --apply creates the store before inbound mail is installed; nothing was rendered"

    INBOUND_INPUT="${WORK_DIR}/inbound.json"
    jq -n --slurpfile receiver "${receiver}" \
        --arg state "${INBOUND_STATE}" --arg address "${INBOUND_ADDRESS}" \
        --argjson uid "${uid}" --argjson gid "${gid}" \
        --arg table "${MAIL_INBOUND_RECIPIENT_TABLE}" --arg store "${MAIL_INBOUND_STORE}" \
        --arg cert "${MAIL_INBOUND_TLS_CERT}" --arg key "${MAIL_INBOUND_TLS_KEY}" \
        --arg cleanup "${MAIL_INBOUND_CLEANUP_SERVICE}" --arg rewrite "${MAIL_INBOUND_REWRITE_SERVICE}" '
        $receiver[0] as $r
        | if ($r.mx_hostnames | length) == 0 then error("the inbound plan receives mail for no target") else . end
        | {
            state: $state,
            address: (if $address == "" then null else $address end),
            loopback: "127.0.0.1:\($r.loopback_port)",
            hostname: ($r.mx_hostnames | sort | .[0]),
            host_postmaster_domain: $r.host_postmaster_domain,
            domains: $r.domains,
            recipients: [$r.recipients[] | {pattern, mailbox}],
            limits: $r.limits,
            table: $table, store: $store, uid: $uid, gid: $gid,
            tls_cert: $cert, tls_key: $key,
            cleanup: $cleanup, rewrite: $rewrite
          }' > "${INBOUND_INPUT}" \
        || fail "the inbound plan cannot be rendered: it receives mail for no target — nothing was rendered"
}

# inbound_endpoints — the inbound listeners this run renders, one per line.
inbound_endpoints() {
    [[ -n "${INBOUND_INPUT}" ]] || return 0
    jq -r '.loopback, (if .state == "enabled" then "\(.address):25" else empty end)' "${INBOUND_INPUT}"
}

# --- Package and ownership state -----------------------------------------------------

# package_status — installed | absent | partial (any other dpkg state: unpacked,
# half-configured, config-files, ...).
package_status() {
    local status
    # dpkg-query's own ${field} syntax, never the shell's.
    # shellcheck disable=SC2016
    status="$("${DPKG_QUERY_BIN}" -W -f='${Status}' "${POSTFIX_PACKAGE}" 2>/dev/null || true)"

    case "${status}" in
        "install ok installed")
            printf 'installed\n'
            ;;
        ""|*" not-installed")
            printf 'absent\n'
            ;;
        *)
            printf 'partial\n'
            ;;
    esac
}

package_version() {
    # shellcheck disable=SC2016
    "${DPKG_QUERY_BIN}" -W -f='${Version}' "${POSTFIX_PACKAGE}" 2>/dev/null || true
}

# Installed packages, other than Postfix, that provide a mail transport agent.
# Installing Postfix next to one would have apt remove it.
other_mail_transport_agents() {
    # shellcheck disable=SC2016
    "${DPKG_QUERY_BIN}" -W -f='${Package}\t${Status}\t${Provides}\n' 2>/dev/null \
        | awk -F'\t' -v self="${POSTFIX_PACKAGE}" '
            $1 != self && $2 == "install ok installed" && $3 ~ /(^|[ ,])mail-transport-agent([ ,(]|$)/ { print $1 }
        ' || true
}

marker_state() {
    local marker
    marker="$(physical "${OWNERSHIP_MARKER}")"

    [[ -f "${marker}" && ! -L "${marker}" ]] || return 0
    sed -n 's/^state=//p' "${marker}" 2>/dev/null | tail -n 1 || true
}

# ownership — fresh | owned | unmanaged.
#   fresh      no marker, no package, no /etc/postfix: --apply installs it;
#   owned      the marker is present (installing or installed);
#   unmanaged  Postfix, or its configuration, exists without the marker.
ownership() {
    local state
    state="$(marker_state)"

    if [[ "${state}" == installing || "${state}" == installed ]]; then
        printf 'owned\n'
    elif [[ "$(package_status)" != absent ]] || [[ -e "$(physical "${POSTFIX_DIR}")" ]]; then
        printf 'unmanaged\n'
    else
        printf 'fresh\n'
    fi
}

write_marker() {
    local state="$1" marker tmp
    marker="$(physical "${OWNERSHIP_MARKER}")"

    install -d -o "${FILE_OWNER}" -g "${FILE_GROUP}" -m 0755 "$(physical "${STATE_DIR}")"
    tmp="${marker}.tmp.$$"
    {
        printf '# RateGuru mail gateway ownership marker. Non-secret.\n'
        printf '#\n'
        printf '# Written by install-mail-gateway before it installs the postfix package,\n'
        printf '# so a partial installation it started is recognisable and resumable, and\n'
        printf '# a Postfix without this file is never taken over. Do not edit.\n'
        printf 'owner=rateguru\n'
        printf 'component=mail-gateway\n'
        printf 'state=%s\n' "${state}"
    } > "${tmp}"
    chown "${FILE_OWNER}:${FILE_GROUP}" "${tmp}"
    chmod 0644 "${tmp}"
    mv -f "${tmp}" "${marker}"
}

# A policy-rc.d carrying our marker outlived the run that installed it — every
# package service start on the host is still suppressed.
leftover_start_suppression() {
    local path
    path="$(physical "${POLICY_RC}")"

    [[ -f "${path}" ]] && grep -qF "${POLICY_RC_MARKER}" "${path}"
}

# --- Postfix's own judgement of a configuration directory ---------------------------

# postfix_contract_problems DIR — Postfix parses DIR and reads back the values
# the fail-closed contract depends on, so what is asserted is what Postfix will
# actually use, not what a file happens to say. Prints one problem per line.
postfix_contract_problems() {
    local dir="$1" warnings value name

    if ! warnings="$("${POSTCONF_BIN}" -c "${dir}" -n 2>&1 >/dev/null)"; then
        printf 'postconf cannot parse main.cf: %s\n' "${warnings}"
        return 0
    fi
    [[ -z "${warnings}" ]] || printf 'postconf reports: %s\n' "${warnings}"

    if ! warnings="$("${POSTCONF_BIN}" -c "${dir}" -M 2>&1 >/dev/null)"; then
        printf 'postconf cannot parse master.cf: %s\n' "${warnings}"
        return 0
    fi
    [[ -z "${warnings}" ]] || printf 'postconf reports: %s\n' "${warnings}"

    for name in default_transport relay_transport local_transport; do
        value="$("${POSTCONF_BIN}" -c "${dir}" -h "${name}" 2>/dev/null || true)"
        [[ "${value}" == error:* ]] || printf '%s is "%s", not the error transport — unrouted mail could be delivered\n' "${name}" "${value}"
    done

    # virtual(8) delivers only once the host records inbound mail, and then
    # only for the inbound plan's domains (inbound_contract_problems).
    value="$("${POSTCONF_BIN}" -c "${dir}" -h virtual_transport 2>/dev/null || true)"
    if [[ -n "${INBOUND_INPUT}" ]]; then
        [[ "${value}" == virtual ]] || printf 'virtual_transport is "%s", not virtual — inbound mail would not be delivered to its store\n' "${value}"
    else
        [[ "${value}" == error:* ]] || printf 'virtual_transport is "%s", not the error transport — this host records no inbound mail\n' "${value}"
    fi

    value="$(alias_maps_value "${dir}")"
    [[ -z "${value}" ]] || printf 'virtual_alias_maps is "%s", not empty — no address is ever rewritten to another\n' "${value}"

    for name in relayhost mydestination relay_domains transport_maps content_filter sender_dependent_relayhost_maps sender_dependent_default_transport_maps; do
        value="$("${POSTCONF_BIN}" -c "${dir}" -h "${name}" 2>/dev/null || true)"
        [[ -z "${value}" ]] || printf '%s is "%s", not empty — the gateway has no global route\n' "${name}" "${value}"
    done

    # An outbound filter names no next hop, so this decides where its mail
    # goes: empty means each recipient's own domain, anything else a relay.
    value="$("${POSTCONF_BIN}" -c "${dir}" -h default_filter_nexthop 2>/dev/null || true)"
    [[ -z "${value}" ]] || printf 'default_filter_nexthop is "%s", not empty — an outbound route would deliver there instead of to the recipient domain MX\n' "${value}"

    # No global milter: only a signed listener names the signer, so locally
    # submitted mail and every other listener never reach it.
    for name in smtpd_milters non_smtpd_milters; do
        value="$("${POSTCONF_BIN}" -c "${dir}" -h "${name}" 2>/dev/null || true)"
        [[ -z "${value}" ]] || printf '%s is "%s", not empty — the signer is wired per listener, never globally\n' "${name}" "${value}"
    done

    # No global header checks: a From policy belongs to one signed target's own
    # cleanup service, and must never reach staging or local mail.
    value="$("${POSTCONF_BIN}" -c "${dir}" -h header_checks 2>/dev/null || true)"
    [[ -z "${value}" ]] || printf 'header_checks is "%s", not empty — a From policy is one signed target'"'"'s, never global\n' "${value}"

    # A cleanup service of RateGuru'"'"'s exists exactly for each signed target.
    local expected_cleanup actual_cleanup
    expected_cleanup="$(signed_identities | sed 's/^/rateguru-cleanup-/' | sort)"
    actual_cleanup="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk '$1 ~ /^rateguru-cleanup-/ { print $1 }' | sort || true)"
    [[ "${actual_cleanup}" == "${expected_cleanup}" ]] \
        || printf 'target cleanup services are [%s], the signed targets need [%s]\n' "${actual_cleanup//$'\n'/ }" "${expected_cleanup//$'\n'/ }"

    # The name it calls itself is the host's reviewed MTA identity, never a
    # name of its own choosing.
    local hostname
    hostname="$(gateway_hostname "${OUTBOUND_FILE}" 2>/dev/null || true)"
    value="$("${POSTCONF_BIN}" -c "${dir}" -h myhostname 2>/dev/null || true)"
    [[ -n "${hostname}" && "${value}" == "${hostname}" ]] \
        || printf 'myhostname is "%s", not the host'"'"'s reviewed MTA identity "%s"\n' "${value}" "${hostname}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -h inet_interfaces 2>/dev/null || true)"
    [[ "${value}" == 127.0.0.1 ]] || printf 'inet_interfaces is "%s", not 127.0.0.1\n' "${value}"
    value="$("${POSTCONF_BIN}" -c "${dir}" -h inet_protocols 2>/dev/null || true)"
    [[ "${value}" == ipv4 ]] || printf 'inet_protocols is "%s", not ipv4\n' "${value}"

    for name in smtpd_sasl_auth_enable smtp_sasl_auth_enable; do
        value="$("${POSTCONF_BIN}" -c "${dir}" -h "${name}" 2>/dev/null || true)"
        [[ "${value}" == no ]] || printf '%s is "%s" — the gateway has no SMTP AUTH\n' "${name}" "${value}"
    done

    # The inet services are exactly the plan's endpoints and the inbound
    # listeners the host records: no smtp, submission or smtps listener, and
    # no listener anything does not name.
    local expected actual
    expected="$({ plan_endpoints; inbound_endpoints; } | sort)"
    actual="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk '$2 == "inet" { print $1 }' | sort || true)"
    [[ "${actual}" == "${expected}" ]] \
        || printf 'inet services are [%s], the plan names [%s]\n' "${actual//$'\n'/ }" "${expected//$'\n'/ }"

    # The smtp clients are exactly the plan's transports: no generic smtp or
    # relay client, and no outbound transport the plan does not name.
    expected="$(plan_smtp_transports | sort)"
    actual="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk '$8 == "smtp" { print $1 }' | sort || true)"
    [[ "${actual}" == "${expected}" ]] \
        || printf 'smtp delivery agents are [%s], the plan names [%s] — no other smtp client may exist\n' "${actual//$'\n'/ }" "${expected//$'\n'/ }"

    # Each listener's route, read back per service.
    local identity endpoint mode route filter recipients transport helo
    helo="$(outbound_mta_hostname)"
    while IFS=$'\t' read -r identity endpoint mode route; do
        [[ -n "${identity}" ]] || continue
        filter="$("${POSTCONF_BIN}" -c "${dir}" -P "${endpoint}/inet/content_filter" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
        recipients="$("${POSTCONF_BIN}" -c "${dir}" -P "${endpoint}/inet/smtpd_recipient_restrictions" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"

        case "${mode}:${route}" in
            capture:*)
                [[ "${filter}" == "rateguru-capture-${identity}:[${route%:*}]:${route##*:}" ]] \
                    || printf '%s (%s) routes to "%s", not its capture destination %s\n' "${identity}" "${endpoint}" "${filter}" "${route}"
                ;;
            held:*)
                [[ -z "${filter}" ]] || printf '%s (%s) is held but names a route: %s\n' "${identity}" "${endpoint}" "${filter}"
                [[ "${recipients}" == *static:HOLD* ]] || printf '%s (%s) is held but does not place its mail on hold\n' "${identity}" "${endpoint}"
                ;;
            outbound:direct)
                # Its own transport and no next hop, so the recipient domain
                # decides; every other listener was checked against its own.
                transport="rateguru-outbound-${identity}"
                [[ "${filter}" == "${transport}:" ]] \
                    || printf '%s (%s) routes to "%s", not its own direct transport %s with no next hop\n' "${identity}" "${endpoint}" "${filter}" "${transport}:"
                [[ "${recipients}" != *static:HOLD* ]] \
                    || printf '%s (%s) is outbound but places its mail on hold\n' "${identity}" "${endpoint}"
                outbound_transport_problems "${dir}" "${identity}" "${transport}" "${helo}"
                ;;
            *)
                printf '%s has delivery mode %s with route %s, which this gateway has no spelling for\n' "${identity}" "${mode}" "${route}"
                ;;
        esac

        listener_signing_problems "${dir}" "${identity}" "${endpoint}"

        # A submission listener never judges a recipient: mail to a domain this
        # host also receives for leaves by its own route, never into the store.
        [[ "$(service_option "${dir}" "${endpoint}/inet/smtpd_reject_unlisted_recipient")" == no ]] \
            || printf '%s (%s) judges recipients against the inbound table — its mail to a domain this host receives for would be refused or kept\n' "${identity}" "${endpoint}"
    done < <(jq -r '.listeners[]
        | [.identity, "\(.listen.host):\(.listen.port)", .delivery_mode,
           (if .route == null then "-" elif .route.kind == "direct" then "direct" else "\(.route.host):\(.route.port)" end)]
        | @tsv' "${PLAN_FILE}")

    if [[ -n "${INBOUND_INPUT}" ]]; then
        inbound_contract_problems "${dir}"
    fi

    # `postfix check` also inspects ownership and permissions; root only.
    if [[ "${EFFECTIVE_UID}" == 0 ]]; then
        if ! warnings="$("${POSTFIX_BIN}" -c "${dir}" check 2>&1)"; then
            printf 'postfix check failed: %s\n' "${warnings}"
        elif [[ -n "${warnings}" ]]; then
            printf 'postfix check reports: %s\n' "${warnings}"
        fi
    fi
}

# alias_maps_value DIR — virtual_alias_maps as it takes effect: Postfix's own
# default is a reference to the empty virtual_maps, which is no table at all.
alias_maps_value() {
    local value
    value="$("${POSTCONF_BIN}" -c "$1" -h virtual_alias_maps 2>/dev/null || true)"
    # shellcheck disable=SC2016 # Postfix's own $parameter reference, never the shell's
    if [[ "${value}" == '$virtual_maps' ]]; then
        value="$("${POSTCONF_BIN}" -c "$1" -h virtual_maps 2>/dev/null || true)"
    fi
    printf '%s\n' "${value}"
}

# service_option DIR SERVICE/TYPE/PARAMETER — the per-service override Postfix
# reads from master.cf in DIR; fails, printing nothing, when there is none.
service_option() {
    local line
    line="$("${POSTCONF_BIN}" -c "$1" -P "$2" 2>/dev/null | head -n 1 || true)"
    [[ -n "${line}" ]] || return 1
    sed -n 's/^[^=]*= *//p' <<<"${line}"
}

# The inbound limits and names, read from the inbound input.
inbound_value() {
    jq -r "$1" "${INBOUND_INPUT}"
}

# inbound_listener_specs — "ENDPOINT/inet" for every inbound listener rendered.
inbound_listener_specs() {
    inbound_endpoints | sed 's#$#/inet#'
}

# inbound_expect DIR SPEC EXPECTED WHY — SPEC is explicitly overridden to
# exactly EXPECTED; a missing override is a problem even when EXPECTED is empty,
# because the main.cf value it would inherit belongs to the submission
# listeners.
inbound_expect() {
    local dir="$1" spec="$2" expected="$3" why="$4" value
    if ! value="$(service_option "${dir}" "${spec}")"; then
        printf '%s is not set on the service — it would inherit main.cf'"'"'s, which is the submission listeners'"'"' (%s)\n' "${spec}" "${why}"
    elif [[ "${value}" != "${expected}" ]]; then
        printf '%s is "%s", not "%s" (%s)\n' "${spec}" "${value}" "${expected}" "${why}"
    fi
}

# inbound_expect_listeners DIR PARAMETER EXPECTED WHY — on every inbound listener.
inbound_expect_listeners() {
    local spec
    while IFS= read -r spec; do
        [[ -n "${spec}" ]] || continue
        inbound_expect "$1" "${spec}/$2" "$3" "$4"
    done < <(inbound_listener_specs)
}

inbound_expect_main() {
    local value
    value="$("${POSTCONF_BIN}" -c "$1" -h "$2" 2>/dev/null || true)"
    [[ "${value}" == "$3" ]] || printf '%s is "%s", not "%s" (%s)\n' "$2" "${value}" "$3" "$4"
}

# The requirements of the inbound plan, as Postfix reads this configuration.
INBOUND_REQUIREMENTS=(
    recipient-allowlist postmaster-accepted relay-refused-at-rcpt no-smtp-auth
    no-relay-no-forwarding message-size-limit recipient-limit connection-limits
    queue-limits shared-queue-guard no-outbound-submission no-message-content-in-logs
    content-never-executed untrusted-sender-fields no-automatic-replies
    null-sender-accepted malformed-and-duplicate-safe disk-exhaustion-guard
    single-public-port-owner outbound-unaffected
)

# inbound_requirement_problems DIR ID — why the configuration in DIR does not
# meet requirement ID; nothing when it does. What Postfix reads, never what a
# file says.
inbound_requirement_problems() {
    local dir="$1" id="$2" table cleanup rewrite size value domain spec expected actual
    table="$(inbound_value .table)"
    cleanup="$(inbound_value .cleanup)"
    rewrite="$(inbound_value .rewrite)"
    size="$(inbound_value .limits.message_size_bytes)"

    case "${id}" in
        recipient-allowlist)
            inbound_expect_listeners "${dir}" smtpd_recipient_restrictions reject_unlisted_recipient "recipients are judged against the table at RCPT TO"
            inbound_expect_listeners "${dir}" smtpd_reject_unlisted_recipient yes "an address not in the table is refused"
            inbound_expect_main "${dir}" virtual_mailbox_maps "regexp:${table}" "the table every inbound recipient is judged by"
            inbound_expect_main "${dir}" virtual_mailbox_domains "$(inbound_value '.domains | join(", ")')" "exactly the inbound plan's domains"
            ;;
        postmaster-accepted)
            inbound_expect "${dir}" "${rewrite}/unix/myorigin" "$(inbound_value .host_postmaster_domain)" "a bare <Postmaster> is the host postmaster"
            inbound_expect_listeners "${dir}" rewrite_service_name "${rewrite}" "the inbound listeners qualify a bare address as the host postmaster"
            inbound_expect "${dir}" "${cleanup}/unix/rewrite_service_name" "${rewrite}" "the inbound cleanup qualifies it the same way"
            while IFS= read -r domain; do
                [[ -n "${domain}" ]] || continue
                value="$("${POSTMAP_BIN}" -c "${dir}" -q "postmaster@${domain}" "regexp:${dir}/$(basename "${table}")" 2>/dev/null || true)"
                [[ -n "${value}" ]] || printf 'postmaster@%s is not in the recipient table — RFC 5321 requires it at every domain received for\n' "${domain}"
            done < <(inbound_value '.domains[]')
            ;;
        relay-refused-at-rcpt)
            inbound_expect_listeners "${dir}" smtpd_relay_restrictions reject_unauth_destination "no client, loopback included, may relay"
            inbound_expect_listeners "${dir}" smtpd_client_restrictions "" "no network is trusted"
            inbound_expect_listeners "${dir}" smtpd_helo_restrictions "" "no network is trusted"
            ;;
        no-smtp-auth)
            inbound_expect_listeners "${dir}" smtpd_sasl_auth_enable no "no SMTP AUTH is offered"
            ;;
        no-relay-no-forwarding)
            for value in relayhost relay_domains transport_maps; do
                inbound_expect_main "${dir}" "${value}" "" "accepted mail never leaves the host"
            done
            value="$(alias_maps_value "${dir}")"
            [[ -z "${value}" ]] || printf 'virtual_alias_maps is "%s", not empty (no address is rewritten to another)\n' "${value}"
            ;;
        message-size-limit)
            inbound_expect_listeners "${dir}" message_size_limit "${size}" "the reviewed maximum message size, announced in SIZE"
            inbound_expect "${dir}" "${cleanup}/unix/message_size_limit" "${size}" "the inbound cleanup holds the same limit"
            inbound_expect_main "${dir}" virtual_mailbox_limit "${size}" "no stored message is larger"
            ;;
        recipient-limit)
            inbound_expect_listeners "${dir}" smtpd_recipient_limit "$(inbound_value .limits.recipients_per_message)" "the reviewed recipients per message"
            ;;
        connection-limits)
            inbound_expect_listeners "${dir}" smtpd_client_connection_count_limit "$(inbound_value .limits.connections_per_client)" "concurrent sessions per client"
            inbound_expect_listeners "${dir}" smtpd_client_connection_rate_limit "$(inbound_value .limits.connection_rate_per_client)" "new sessions per client a minute"
            inbound_expect_listeners "${dir}" smtpd_client_event_limit_exceptions "" "no client is exempt"
            if [[ "$(inbound_value .state)" == enabled ]]; then
                spec="$(inbound_value .address):25"
                value="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk -v s="${spec}" '$1 == s && $2 == "inet" { print $7 }' | head -n 1 || true)"
                expected="$(inbound_value .limits.concurrent_sessions)"
                [[ "${value}" == "${expected}" ]] || printf '%s runs at most "%s" sessions, not %s\n' "${spec}" "${value}" "${expected}"
            fi
            ;;
        queue-limits)
            inbound_expect_listeners "${dir}" queue_minfree "$(inbound_value .limits.host_reserve_bytes)" "inbound mail is refused, temporarily, while the shared queue's file system is below its reserve"
            ;;
        shared-queue-guard)
            inbound_expect_listeners "${dir}" smtpd_client_message_rate_limit "$(inbound_value .limits.message_rate_per_client)" "messages per client a minute: no sender fills the shared queue"
            ;;
        no-outbound-submission)
            inbound_expect_listeners "${dir}" content_filter "" "inbound mail is never handed to an outbound route"
            inbound_expect_listeners "${dir}" smtpd_milters "" "inbound mail is never signed"
            inbound_expect_listeners "${dir}" cleanup_service_name "${cleanup}" "the inbound cleanup, which signs and routes nothing"
            ;;
        no-message-content-in-logs)
            for value in header_checks body_checks nested_header_checks; do
                inbound_expect "${dir}" "${cleanup}/unix/${value}" "" "nothing of a message is matched or logged"
            done
            if [[ "$(inbound_value .state)" == enabled ]]; then
                inbound_expect "${dir}" "$(inbound_value .address):25/inet/smtpd_tls_loglevel" 0 "no TLS session details in the log"
            fi
            ;;
        content-never-executed)
            value="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk '$8 == "pipe" || $8 == "local" || $8 == "lmtp" || $8 == "spawn" { print $1 }' | paste -sd ' ' - || true)"
            [[ -z "${value}" ]] || printf 'master.cf runs %s — nothing may deliver to a command or a local mailbox\n' "${value}"
            inbound_expect_main "${dir}" mailbox_command "" "no command is ever run for a message"
            ;;
        untrusted-sender-fields)
            inbound_expect_listeners "${dir}" smtpd_sender_restrictions "" "the sender never authorizes or routes"
            ;;
        no-automatic-replies)
            for value in default_transport relay_transport; do
                actual="$("${POSTCONF_BIN}" -c "${dir}" -h "${value}" 2>/dev/null || true)"
                [[ "${actual}" == error:* ]] || printf '%s is "%s" — a bounce to a forged sender could leave the host\n' "${value}" "${actual}"
            done
            ;;
        null-sender-accepted)
            inbound_expect_listeners "${dir}" smtpd_sender_restrictions "" "MAIL FROM:<> is accepted"
            inbound_expect_listeners "${dir}" smtpd_data_restrictions "" "nothing refuses a delivery status notification"
            ;;
        malformed-and-duplicate-safe)
            value="$(awk '/^\// && $NF !~ /\/$/ { print $NF }' "${dir}/$(basename "${table}")" 2>/dev/null | paste -sd ' ' - || true)"
            [[ -z "${value}" ]] || printf 'the recipient table names %s, not a Maildir — every message must be a file of its own\n' "${value}"
            value="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk '$1 == "virtual" && $2 == "unix" && $8 == "virtual"' | wc -l | tr -d ' ' || true)"
            [[ "${value}" == 1 ]] || printf 'master.cf has %s virtual(8) services, not exactly one\n' "${value:-0}"
            ;;
        disk-exhaustion-guard)
            inbound_expect_main "${dir}" virtual_mailbox_base "$(inbound_value .store)" "the fixed-size inbound store, never the queue's file system"
            ;;
        single-public-port-owner)
            expected=""
            [[ "$(inbound_value .state)" != enabled ]] || expected="$(inbound_value .address):25"
            actual="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk '$2 == "inet" && $1 !~ /^127\./ { print $1 }' | paste -sd ' ' - || true)"
            [[ "${actual}" == "${expected}" ]] || printf 'the listeners off loopback are [%s], not [%s]\n' "${actual}" "${expected}"
            ;;
        outbound-unaffected)
            while IFS= read -r spec; do
                [[ -n "${spec}" ]] || continue
                for value in rewrite_service_name queue_minfree; do
                    ! service_option "${dir}" "${spec}/inet/${value}" >/dev/null \
                        || printf '%s sets %s — a submission listener takes nothing of the inbound listeners\n' "${spec}" "${value}"
                done
                [[ "$(service_option "${dir}" "${spec}/inet/cleanup_service_name" || true)" != "${cleanup}" ]] \
                    || printf '%s uses the inbound cleanup service\n' "${spec}"
            done < <(plan_endpoints)
            inbound_expect "${dir}" "${rewrite}/unix/syslog_name" "postfix/${rewrite}" "the inbound address rewriting is a service of its own"
            ;;
    esac
}

# inbound_contract_problems DIR — every inbound requirement, prefixed with its ID.
inbound_contract_problems() {
    local id problem
    for id in "${INBOUND_REQUIREMENTS[@]}"; do
        while IFS= read -r problem; do
            [[ -z "${problem}" ]] || printf '%s: %s\n' "${id}" "${problem}"
        done < <(inbound_requirement_problems "$1" "${id}")
    done
}

# listener_signing_problems DIR IDENTITY ENDPOINT — a signed target's listener
# hands its mail to exactly the signer, with protocol 6, and defers it when the
# signer cannot sign; it uses its own cleanup service, with its From policy, and
# admits no empty sender. Any other listener names no milter and no cleanup
# service of its own.
listener_signing_problems() {
    local dir="$1" identity="$2" endpoint="$3" milters action protocol cleanup restrictions
    milters="$("${POSTCONF_BIN}" -c "${dir}" -P "${endpoint}/inet/smtpd_milters" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    cleanup="$("${POSTCONF_BIN}" -c "${dir}" -P "${endpoint}/inet/cleanup_service_name" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"

    if grep -qxF "${identity}" <<<"$(signed_identities)"; then
        action="$("${POSTCONF_BIN}" -c "${dir}" -P "${endpoint}/inet/milter_default_action" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
        protocol="$("${POSTCONF_BIN}" -c "${dir}" -P "${endpoint}/inet/milter_protocol" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"

        [[ "${milters}" == "${MILTER_ENDPOINT}" ]] \
            || printf '%s (%s) is signed but hands its mail to "%s", not the signer at %s\n' "${identity}" "${endpoint}" "${milters}" "${MILTER_ENDPOINT}"
        [[ "${action}" == tempfail ]] \
            || printf '%s (%s) has milter_default_action "%s", not tempfail — a signed target'"'"'s mail would be accepted unsigned when the signer fails\n' "${identity}" "${endpoint}" "${action}"
        [[ "${protocol}" == 6 ]] \
            || printf '%s (%s) has milter_protocol "%s", not 6\n' "${identity}" "${endpoint}" "${protocol}"

        [[ "${cleanup}" == "rateguru-cleanup-${identity}" ]] \
            || printf '%s (%s) is signed but uses the cleanup service "%s", not its own rateguru-cleanup-%s — its From policy would not apply\n' "${identity}" "${endpoint}" "${cleanup}" "${identity}"

        restrictions="$("${POSTCONF_BIN}" -c "${dir}" -h "rateguru_${identity//-/_}_sender_restrictions" 2>/dev/null || true)"
        [[ "${restrictions}" != *"<>"* ]] \
            || printf '%s (%s) is signed but admits an empty sender — a message without an author in its domain could not be signed\n' "${identity}" "${endpoint}"

        signed_cleanup_problems "${dir}" "${identity}"
    else
        [[ -z "${milters}" ]] \
            || printf '%s (%s) is not signed but hands its mail to the milter "%s"\n' "${identity}" "${endpoint}" "${milters}"
        [[ -z "${cleanup}" ]] \
            || printf '%s (%s) is not signed but uses the cleanup service "%s" — a From policy is a signed target'"'"'s alone\n' "${identity}" "${endpoint}" "${cleanup}"
    fi
}

# signed_cleanup_problems DIR IDENTITY — the target's own cleanup service:
# exactly one, a cleanup(8), whose header checks are exactly its From policy,
# with none for attached messages and a missing From added; then the policy
# itself, asked through Postfix's own table lookup.
signed_cleanup_problems() {
    local dir="$1" identity="$2" service policy count value
    service="rateguru-cleanup-${identity}"
    policy="${POSTFIX_DIR}/rateguru-from-${identity}.regexp"

    count="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk -v s="${service}" '$1 == s' | wc -l | tr -d ' ' || true)"
    if [[ "${count}" != 1 ]]; then
        printf '%s has %s cleanup services named %s, not exactly one\n' "${identity}" "${count:-0}" "${service}"
        return 0
    fi

    value="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk -v s="${service}" '$1 == s { print $2 "/" $8 }' | head -n 1 || true)"
    [[ "${value}" == unix/cleanup ]] || printf '%s is "%s", not a unix cleanup service\n' "${service}" "${value}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${service}/unix/header_checks" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ "${value}" == "regexp:${policy}" ]] \
        || printf '%s has header_checks "%s", not its own From policy regexp:%s\n' "${service}" "${value}" "${policy}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${service}/unix/nested_header_checks" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ -z "${value}" ]] || printf '%s has nested_header_checks "%s", not empty\n' "${service}" "${value}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${service}/unix/always_add_missing_headers" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ "${value}" == yes ]] \
        || printf '%s has always_add_missing_headers "%s", not yes — a message without a From could pass unsigned\n' "${service}" "${value}"

    from_policy_problems "${dir}" "${identity}"
}

# from_policy_problems DIR IDENTITY — the From policy in DIR, read by Postfix:
# every ordinary single address in the target's domain passes, and every other
# From — another domain, a subdomain, a longer name, a list — is refused.
from_policy_problems() {
    local dir="$1" identity="$2" domain table header result
    domain="$(jq -r --arg id "${identity}" '.listeners[] | select(.identity == $id) | .sender.allowed_domain' "${PLAN_FILE}")"
    table="${dir}/rateguru-from-${identity}.regexp"

    if [[ ! -f "${table}" ]]; then
        printf '%s has no From policy at %s\n' "${identity}" "${POSTFIX_DIR}/rateguru-from-${identity}.regexp"
        return 0
    fi

    for header in "From: noreply@${domain}" "From: <noreply@${domain}>" \
        "From: RateGuru <noreply@${domain}>" "From: \"RateGuru\" <noreply@${domain}>"
    do
        result="$("${POSTMAP_BIN}" -c "${dir}" -q "${header}" "regexp:${table}" 2>/dev/null || true)"
        [[ "${result}" == DUNNO ]] \
            || printf '%s From policy refuses "%s" (%s) — an address in %s must pass\n' "${identity}" "${header}" "${result:-no match}" "${domain}"
    done

    for header in "From: intruder@foreign.invalid" "From: Intruder <intruder@foreign.invalid>" \
        "From: noreply@${domain}, intruder@foreign.invalid" "From: intruder@foreign.invalid, noreply@${domain}" \
        "From: Intruder <intruder@foreign.invalid>, RateGuru <noreply@${domain}>" \
        "From: RateGuru <noreply@${domain}>, Intruder <intruder@foreign.invalid>" \
        "From: noreply@mail.${domain}" "From: noreply@${domain}.foreign.invalid" "From: noreply@foreign${domain}"
    do
        result="$("${POSTMAP_BIN}" -c "${dir}" -q "${header}" "regexp:${table}" 2>/dev/null || true)"
        [[ "${result}" == "REJECT "* ]] \
            || printf '%s From policy admits "%s" (%s) — only one address in %s may pass\n' "${identity}" "${header}" "${result:-no match}" "${domain}"
    done
}

# outbound_transport_problems DIR IDENTITY TRANSPORT HELO — the target's
# direct smtp client, read back from master.cf: exactly one, greeting with the
# host's MTA identity, STARTTLS when offered and never required, no SMTP AUTH
# and no fallback relay.
outbound_transport_problems() {
    local dir="$1" identity="$2" transport="$3" helo="$4" count value

    count="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk -v t="${transport}" '$1 == t' | wc -l | tr -d ' ' || true)"
    [[ "${count}" == 1 ]] || printf '%s has %s services named %s, not exactly one\n' "${identity}" "${count:-0}" "${transport}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -M 2>/dev/null | awk -v t="${transport}" '$1 == t { print $2 "/" $8 }' | head -n 1 || true)"
    [[ "${value}" == unix/smtp ]] || printf '%s is "%s", not a unix smtp client\n' "${transport}" "${value}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${transport}/unix/smtp_helo_name" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ -n "${helo}" && "${value}" == "${helo}" ]] \
        || printf '%s greets as "%s", not the host MTA identity "%s" from mail-outbound.json\n' "${transport}" "${value}" "${helo}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${transport}/unix/smtp_tls_security_level" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ "${value}" == may ]] \
        || printf '%s has smtp_tls_security_level "%s", not may — opportunistic STARTTLS, never required\n' "${transport}" "${value}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${transport}/unix/smtp_sasl_auth_enable" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ "${value}" == no ]] || printf '%s has smtp_sasl_auth_enable "%s" — direct delivery has no SMTP AUTH\n' "${transport}" "${value}"

    value="$("${POSTCONF_BIN}" -c "${dir}" -P "${transport}/unix/smtp_fallback_relay" 2>/dev/null | sed -n 's/^[^=]*= *//p' || true)"
    [[ -z "${value}" ]] || printf '%s has a fallback relay "%s" — direct delivery has no relay\n' "${transport}" "${value}"
}

# --- Runtime --------------------------------------------------------------------------

service_property() {
    "${SYSTEMCTL_BIN}" show "$1" --property="$2" --value 2>/dev/null || true
}

service_is_running() {
    [[ "$(service_property "$1" ActiveState)" == active && "$(service_property "$1" SubState)" == running ]]
}

service_restart_count() {
    local count
    count="$(service_property "$1" NRestarts)"
    [[ "${count}" =~ ^[0-9]+$ ]] || count=0
    printf '%s\n' "${count}"
}

# wait_service_running UNIT — success once the unit is active and running.
# Only a unit still on its way there (activating, reloading) is waited for;
# inactive, failed or deactivating is already the answer, and waiting out the
# full window on it would only delay every read-only probe of a host without
# the gateway.
wait_service_running() {
    local unit="$1" waited=0 state
    while true; do
        # One reading per round: a unit that turns active between two separate
        # reads must not be judged by the stale one.
        state="$(service_property "${unit}" ActiveState)"
        [[ "${state}" == active && "$(service_property "${unit}" SubState)" == running ]] && return 0

        case "${state}" in
            activating|reloading) ;;
            *) return 1 ;;
        esac

        (( waited < RUNTIME_WAIT )) || return 1
        sleep 1
        waited=$((waited + 1))
    done
}

tcp_listeners() {
    "${SS_BIN}" -ltnH 2>/dev/null | awk '{ print $4 }' || true
}

wait_listener() {
    local endpoint="$1" waited=0
    while (( waited < RUNTIME_WAIT )); do
        grep -qxF "${endpoint}" <<<"$(tcp_listeners)" && return 0
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

# runtime_problems — the running gateway, read-only. One problem per line.
runtime_problems() {
    local listeners endpoint port local_address port_problems

    [[ "$("${SYSTEMCTL_BIN}" is-enabled "${POSTFIX_UNIT}" 2>/dev/null || true)" == enabled ]] \
        || printf '%s is not enabled for boot\n' "${POSTFIX_UNIT}"

    if ! wait_service_running "${POSTFIX_INSTANCE_UNIT}"; then
        printf '%s is not active and running (ActiveState=%s SubState=%s)\n' "${POSTFIX_INSTANCE_UNIT}" \
            "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" "$(service_property "${POSTFIX_INSTANCE_UNIT}" SubState)"
        return 0
    fi

    local before after
    before="$(service_restart_count "${POSTFIX_INSTANCE_UNIT}")"
    sleep "${STABILITY_WAIT}"
    after="$(service_restart_count "${POSTFIX_INSTANCE_UNIT}")"
    service_is_running "${POSTFIX_INSTANCE_UNIT}" \
        || printf '%s did not stay running for %ss\n' "${POSTFIX_INSTANCE_UNIT}" "${STABILITY_WAIT}"
    (( after <= before )) \
        || printf '%s restarted during the %ss stability window (NRestarts %s -> %s)\n' "${POSTFIX_INSTANCE_UNIT}" "${STABILITY_WAIT}" "${before}" "${after}"

    while IFS= read -r endpoint; do
        [[ -n "${endpoint}" ]] || continue
        wait_listener "${endpoint}" || printf 'nothing listens on the gateway endpoint %s\n' "${endpoint}"
    done < <(plan_endpoints)

    while IFS= read -r endpoint; do
        [[ -n "${endpoint}" ]] || continue
        wait_listener "${endpoint}" || printf 'nothing listens on the inbound endpoint %s\n' "${endpoint}"
    done < <(inbound_endpoints)

    listeners="$(tcp_listeners)"

    # Nothing listens on a public SMTP port that may not — judged by the one
    # judge — and no gateway port is bound anywhere but loopback.
    port_problems="$(public_smtp_problems "${FS_ROOT}" "${INBOUND_FILE}")"
    [[ -z "${port_problems}" ]] || printf '%s\n' "${port_problems}"

    while IFS= read -r local_address; do
        [[ -n "${local_address}" ]] || continue
        port="${local_address##*:}"

        if grep -qxF "${port}" <<<"$(plan_ports)" && ! grep -qxF "${local_address}" <<<"$(plan_endpoints)"; then
            printf 'gateway port %s is bound on %s, not only on loopback\n' "${port}" "${local_address}"
        fi
    done <<<"${listeners}"

    # Every capture destination is there to deliver to.
    while IFS= read -r endpoint; do
        [[ -n "${endpoint}" ]] || continue
        grep -qxF "${endpoint}" <<<"${listeners}" \
            || printf 'capture destination %s is not listening — its mail would only queue\n' "${endpoint}"
    done < <(plan_capture_destinations)

    # The signer is there to sign with: without it, a signed listener defers
    # everything it is given.
    if [[ -n "$(signed_identities)" ]]; then
        grep -qxF "$(milter_listen_address)" <<<"${listeners}" \
            || printf 'the signer is not listening on %s — every signed listener would defer its mail\n' "$(milter_listen_address)"
    fi
}

# --- Managed files ------------------------------------------------------------------------

file_owner_mode() {
    stat -c '%U:%G %a' "$1" 2>/dev/null || true
}

# managed_files — every file the current render installs: main.cf, master.cf,
# one From policy per signed target and, once inbound mail is installed, the
# inbound recipient table.
managed_files() {
    local policy
    printf '%s\n' "${MAIN_CF}" "${MASTER_CF}"
    for policy in "${CANDIDATE_DIR}"/rateguru-from-*.regexp; do
        [[ -f "${policy}" ]] || continue
        printf '%s/%s\n' "${POSTFIX_DIR}" "$(basename "${policy}")"
    done
    [[ -z "${INBOUND_INPUT}" ]] || printf '%s\n' "${MAIL_INBOUND_RECIPIENT_TABLE}"
}

# retired_policy_files — "owned|foreign<TAB>LOGICAL" for every From policy file
# on the host that the current render no longer installs. Only a file with the
# exact name shape and this installer's own first line is owned, and only an
# owned one is ever removed; nothing else under /etc/postfix is looked at.
retired_policy_files() {
    local path name
    for path in "$(physical "${POSTFIX_DIR}")"/rateguru-from-*.regexp; do
        [[ -e "${path}" || -L "${path}" ]] || continue
        name="$(basename "${path}")"
        [[ "${name}" =~ ${FROM_POLICY_NAME_PATTERN} ]] || continue
        [[ ! -e "${CANDIDATE_DIR}/${name}" ]] || continue

        if [[ -f "${path}" && ! -L "${path}" ]] && [[ "$(head -n 1 "${path}" 2>/dev/null)" == "${FROM_POLICY_MARKER}"* ]]; then
            printf 'owned\t%s/%s\n' "${POSTFIX_DIR}" "${name}"
        else
            printf 'foreign\t%s/%s\n' "${POSTFIX_DIR}" "${name}"
        fi
    done
}

# managed_file_state LOGICAL — PASS | MISSING | DRIFT, against the candidate.
managed_file_state() {
    local logical="$1" path candidate
    path="$(physical "${logical}")"
    candidate="${CANDIDATE_DIR}/$(basename "${logical}")"

    if [[ ! -e "${path}" ]]; then
        printf 'MISSING\n'
    elif [[ -L "${path}" || ! -f "${path}" ]] \
        || ! cmp -s "${candidate}" "${path}" \
        || [[ "$(file_owner_mode "${path}")" != "${FILE_OWNER}:${FILE_GROUP} ${MANAGED_FILE_MODE}" ]]
    then
        printf 'DRIFT\n'
    else
        printf 'PASS\n'
    fi
}

# --- The applied policy: what the host accepted ------------------------------------------

sha256_of() {
    sha256sum -- "$1" | cut -d ' ' -f 1
}

# recorded_policy — absent | present | corrupt: the applied policy on the host.
# Both files or neither; a half, a symlink or a document that is not a plan and
# a contract is not a witness.
recorded_policy() {
    local plan outbound
    plan="$(physical "${APPLIED_PLAN}")"
    outbound="$(physical "${APPLIED_OUTBOUND}")"

    if [[ ! -e "${plan}" && ! -L "${plan}" && ! -e "${outbound}" && ! -L "${outbound}" ]]; then
        echo absent
    elif [[ -f "${plan}" && ! -L "${plan}" && -f "${outbound}" && ! -L "${outbound}" ]] \
        && jq -e '(.listeners | type) == "array"' "${plan}" >/dev/null 2>&1 \
        && jq -e '(.direct | type) == "object"' "${outbound}" >/dev/null 2>&1
    then
        echo present
    else
        echo corrupt
    fi
}

# inert_request — this bundle's plan routes nothing outbound and its host
# contract leaves direct delivery disabled: the only state a host with no
# recorded policy may record first.
inert_request() {
    jq -e '[.listeners[] | select(.delivery_mode == "outbound")] | length == 0' "${PLAN_FILE}" >/dev/null 2>&1 \
        && jq -e '.direct.enabled == false' "${OUTBOUND_FILE}" >/dev/null 2>&1
}

# The held/outbound transition between the recorded policy and the requested
# one, as one line: "none", "activate<TAB>TARGET", "rollback<TAB>TARGET", or
# "invalid<TAB>REASON" for any other change of who delivers outbound or of the
# host's direct delivery — the shapes one guarded activation can never be.
# shellcheck disable=SC2016
POLICY_TRANSITION_PROGRAM='
def delivering($plan): [$plan.listeners[] | select(.environment_class == "production" and .delivery_mode == "outbound") | .identity] | sort;
delivering($recorded_plan[0]) as $before
| delivering($requested_plan[0]) as $after
| ($recorded_outbound[0].direct.enabled == true) as $direct_before
| ($requested_outbound[0].direct.enabled == true) as $direct_after
| ($after - $before) as $activated
| ($before - $after) as $rolled_back
| if $activated == [] and $rolled_back == [] and $direct_before == $direct_after then
      "none"
  elif ($activated | length) == 1 and $rolled_back == [] and $direct_after then
      "activate\t\($activated[0])"
  elif ($rolled_back | length) == 1 and $activated == [] and $direct_before then
      "rollback\t\($rolled_back[0])"
  else
      "invalid\toutbound delivery [\($before | join(", "))] -> [\($after | join(", "))], direct delivery \($direct_before) -> \($direct_after)"
  end
'

policy_transition() {
    jq -r -n \
        --slurpfile recorded_plan "$(physical "${APPLIED_PLAN}")" --slurpfile requested_plan "${PLAN_FILE}" \
        --slurpfile recorded_outbound "$(physical "${APPLIED_OUTBOUND}")" --slurpfile requested_outbound "${OUTBOUND_FILE}" \
        "${POLICY_TRANSITION_PROGRAM}"
}

# The policy fields that differ between two applied-policy documents, as dotted
# paths — listeners keyed by their identity, not their position.
# shellcheck disable=SC2016
POLICY_DIFFERENCE_PROGRAM='
def keyed: if (type == "object") and (.listeners | type) == "array" then .listeners |= (map({(.identity | tostring): .}) | add // {}) else . end;
($recorded[0] | keyed) as $a
| ($requested[0] | keyed) as $b
| [($a | paths(type != "object" and type != "array")), ($b | paths(type != "object" and type != "array"))]
| unique
| map(select(. as $p | ($a | getpath($p)) != ($b | getpath($p))))
| map(map(tostring) | join("."))
| if length > 8 then .[0:8] + ["..."] else . end
| join(", ")
'

policy_differences() {
    jq -r -n --slurpfile recorded "$1" --slurpfile requested "$2" "${POLICY_DIFFERENCE_PROGRAM}" 2>/dev/null || true
}

# applied_file_state LOGICAL — PASS | MISSING | DRIFT, against this bundle's
# canonical policy.
applied_file_state() {
    local logical="$1" path candidate
    path="$(physical "${logical}")"
    candidate="${APPLIED_CANDIDATE_DIR}/$(basename "${logical}")"

    if [[ ! -e "${path}" && ! -L "${path}" ]]; then
        printf 'MISSING\n'
    elif [[ -L "${path}" || ! -f "${path}" ]] \
        || ! cmp -s "${candidate}" "${path}" \
        || [[ "$(file_owner_mode "${path}")" != "${FILE_OWNER}:${FILE_GROUP} ${APPLIED_FILE_MODE}" ]]
    then
        printf 'DRIFT\n'
    else
        printf 'PASS\n'
    fi
}

# The transition authorization, as activate-mail-outbound writes it, judged
# against this transition. Every reason it does not permit exactly this one is
# a line; none when it does.
# shellcheck disable=SC2016
AUTHORIZATION_PROGRAM='
if type != "object" then
    "it is not a JSON object"
else
    (if .kind == $kind and .schema_version == 1 then empty
     else "it is not a mail gateway transition authorization of schema 1" end),
    (if .target == $target then empty
     else "it authorizes target \(.target | tojson), and this transition is for \($target)" end),
    (if .direction == $direction then empty
     else "it authorizes \(.direction | tojson), and this transition is \($direction)" end),
    (if .from.plan == $from_plan and .from.outbound == $from_outbound then empty
     else "it was issued for another recorded policy than the one this host recorded" end),
    (if .to.plan == $to_plan and .to.outbound == $to_outbound then empty
     else "it was issued for another policy than the one this bundle requests" end),
    (if (.nonce | type) == "string" and (.nonce | test("^[0-9a-f]{32}$")) then empty
     else "it carries no nonce" end),
    (if (.created_at | type) == "number" and (.expires_at | type) == "number"
        and .created_at <= ($now + 60) and $now < .expires_at and (.expires_at - .created_at) <= $lifetime then empty
     else "it has expired, or claims a lifetime no authorization has" end)
end
'

# authorization_problems DIRECTION TARGET — why no pending authorization
# permits exactly this transition; nothing when one does.
authorization_problems() {
    local direction="$1" target="$2" path dir meta digest ledger nonce
    path="$(physical "${TRANSITION_AUTHORIZATION}")"
    dir="$(physical "${STATE_DIR}")"
    ledger="$(physical "${CONSUMED_AUTHORIZATIONS}")"

    if [[ ! -e "${path}" && ! -L "${path}" ]]; then
        printf 'no transition authorization is pending\n'
        return 0
    fi

    if [[ -L "${path}" || ! -f "${path}" ]]; then
        printf '%s is not a regular file\n' "${TRANSITION_AUTHORIZATION}"
        return 0
    fi

    meta="$(file_owner_mode "${path}")"
    if [[ "${meta}" != "${FILE_OWNER}:"*" 600" ]]; then
        printf '%s is %s, not %s-owned mode 600 — an authorization anyone else could have written is never honoured\n' "${TRANSITION_AUTHORIZATION}" "${meta}" "${FILE_OWNER}"
        return 0
    fi

    meta="$(stat -c '%U %a' "${dir}" 2>/dev/null || true)"
    if [[ ! "${meta}" =~ ^[^[:space:]]+\ [0-7]{3,4}$ || "${meta%% *}" != "${FILE_OWNER}" ]] || (( (8#${meta##* } & 8#022) != 0 )); then
        printf '%s is %s, writable by someone other than %s — nothing in it is honoured\n' "${STATE_DIR}" "${meta}" "${FILE_OWNER}"
        return 0
    fi

    digest="$(sha256_of "${path}")"
    nonce="$(jq -r '.nonce // ""' "${path}" 2>/dev/null || true)"
    if [[ -f "${ledger}" ]] && { grep -q "^${digest} " "${ledger}" || { [[ -n "${nonce}" ]] && grep -q "^[0-9a-f]* ${nonce} " "${ledger}"; }; }; then
        printf 'this authorization was already used — one is consumed by the transition it permits, and never honoured twice\n'
        return 0
    fi

    jq -r \
        --arg kind "${AUTHORIZATION_KIND}" --arg target "${target}" --arg direction "${direction}" \
        --arg from_plan "$(sha256_of "$(physical "${APPLIED_PLAN}")")" \
        --arg from_outbound "$(sha256_of "$(physical "${APPLIED_OUTBOUND}")")" \
        --arg to_plan "$(sha256_of "${APPLIED_CANDIDATE_DIR}/$(basename "${APPLIED_PLAN}")")" \
        --arg to_outbound "$(sha256_of "${APPLIED_CANDIDATE_DIR}/$(basename "${APPLIED_OUTBOUND}")")" \
        --argjson now "$(date -u '+%s')" --argjson lifetime "${AUTHORIZATION_MAX_LIFETIME}" \
        "${AUTHORIZATION_PROGRAM}" "${path}" 2>/dev/null \
        || printf 'it is not a JSON document\n'
}

# consume_authorization DIRECTION TARGET — the pending authorization, used: its
# digest and nonce recorded in the ledger, the file removed. Before the
# transition starts, so a failed transition cannot be retried with it either.
consume_authorization() {
    local path ledger
    path="$(physical "${TRANSITION_AUTHORIZATION}")"
    ledger="$(physical "${CONSUMED_AUTHORIZATIONS}")"

    printf '%s %s %s %s %s\n' "$(sha256_of "${path}")" "$(jq -r '.nonce' "${path}")" "$1" "$2" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "${ledger}"
    chown "${FILE_OWNER}:${FILE_GROUP}" "${ledger}"
    chmod 0644 "${ledger}"
    rm -f "${path}"
}

# boundary_verdict — what this bundle's request means against the recorded
# policy: "establish" (none recorded, an inert request), "unwitnessed" (none
# recorded, a request that is not inert), "corrupt", "none", "activate<TAB>T",
# "rollback<TAB>T" or "invalid<TAB>REASON".
boundary_verdict() {
    case "$(recorded_policy)" in
        absent)
            if inert_request; then echo establish; else echo unwitnessed; fi
            ;;
        corrupt)
            echo corrupt
            ;;
        present)
            policy_transition
            ;;
    esac
}

# install_applied_policy — the canonical policy this run applied, recorded in
# the transaction like every other managed file.
install_applied_policy() {
    local logical path candidate tmp

    for logical in "${APPLIED_PLAN}" "${APPLIED_OUTBOUND}"; do
        [[ "$(applied_file_state "${logical}")" != PASS ]] || continue

        path="$(physical "${logical}")"
        candidate="${APPLIED_CANDIDATE_DIR}/$(basename "${logical}")"

        action "recording ${logical}"
        record_target "${path}"
        install -d -m 0755 "$(dirname "${path}")"
        tmp="${path}.rateguru-tmp.$$"
        install -o "${FILE_OWNER}" -g "${FILE_GROUP}" -m "0${APPLIED_FILE_MODE}" "${candidate}" "${tmp}"
        mv -f "${tmp}" "${path}"
    done
}

# install_inbound_record — the inbound state this configuration carries,
# recorded with it, in the transaction, before Postfix is reloaded: the judge
# of who may hold TCP 25 then reads the state that is installed, and a failure
# restores the previous record with the previous configuration. It differs
# only after an authorized transition.
install_inbound_record() {
    local path candidate tmp
    [[ "${INBOUND_STATE}" != absent ]] || return 0
    [[ "$(applied_file_state "${MAIL_INBOUND_APPLIED}")" != PASS ]] || return 0

    path="$(physical "${MAIL_INBOUND_APPLIED}")"
    candidate="${APPLIED_CANDIDATE_DIR}/$(basename "${MAIL_INBOUND_APPLIED}")"

    action "recording ${MAIL_INBOUND_APPLIED}: inbound mail ${INBOUND_STATE}${INBOUND_ADDRESS:+ on ${INBOUND_ADDRESS}:25}"
    record_target "${path}"
    install -d -m 0755 "$(dirname "${path}")"
    tmp="${path}.rateguru-tmp.$$"
    install -o "${FILE_OWNER}" -g "${FILE_GROUP}" -m "0${APPLIED_FILE_MODE}" "${candidate}" "${tmp}"
    mv -f "${tmp}" "${path}"
    FILES_CHANGED=true
}

# report_applied_policy — the recorded policy against this bundle's, and the
# activation boundary between them.
report_applied_policy() {
    local verdict kind target problems logical state differences
    verdict="$(boundary_verdict)"
    kind="${verdict%%$'\t'*}"
    target="${verdict#*$'\t'}"

    case "${kind}" in
        establish)
            item MISSING "policy:applied" "no applied policy is recorded on this host — --apply records this inert one (no outbound route, direct delivery disabled) once the gateway is proved"
            return 0
            ;;
        unwitnessed)
            item CONFLICT "policy:applied" "no applied policy is recorded on this host, and this bundle routes mail outbound or enables direct delivery — a host's first recorded policy is always the inert one: establish it with the held, direct-disabled configuration, then cross with activate-mail-outbound"
            return 0
            ;;
        corrupt)
            item CONFLICT "policy:applied" "the recorded applied policy (${APPLIED_PLAN}, ${APPLIED_OUTBOUND}) is incomplete or unreadable — it is the host's only witness of what was accepted; restore it from the gateway's backups"
            return 0
            ;;
        activate|rollback)
            local transition="${target} from held to outbound"
            [[ "${kind}" == activate ]] || transition="${target} from outbound to held"
            problems="$(authorization_problems "${kind}" "${target}")"
            if [[ "${MODE}" == check && -z "${problems}" ]]; then
                item PASS "policy:transition" "this bundle moves ${transition}, authorized by activate-mail-outbound for exactly this recorded and requested policy (one use)"
            elif [[ "${MODE}" == check ]]; then
                item CONFLICT "policy:transition" "this bundle moves ${transition} — the activation boundary, which only activate-mail-outbound crosses; ordinary --apply refuses it (${problems//$'\n'/; })"
            else
                item DRIFT "policy:transition" "the host's recorded policy and this bundle differ across the activation boundary (${transition}) — only activate-mail-outbound crosses it"
            fi
            ;;
        invalid)
            item CONFLICT "policy:transition" "${target} — no single guarded activation makes this change, so no gateway apply makes it"
            ;;
    esac

    for logical in "${APPLIED_PLAN}" "${APPLIED_OUTBOUND}"; do
        state="$(applied_file_state "${logical}")"
        case "${state}" in
            PASS)
                item PASS "file:${logical}" "the recorded policy is exactly the one this bundle requests"
                ;;
            MISSING)
                item MISSING "file:${logical}" "absent — --apply records the current policy"
                ;;
            DRIFT)
                differences="$(policy_differences "$(physical "${logical}")" "${APPLIED_CANDIDATE_DIR}/$(basename "${logical}")")"
                item DRIFT "file:${logical}" "the recorded policy differs from the one this bundle requests${differences:+ (${differences})} — --apply records the current one"
                ;;
        esac
    done
}

# report_inbound — the host's inbound state against this bundle, a pending
# transition, and — once installed — every inbound requirement by name. A host
# that never installed inbound mail, with nothing pending, reports nothing.
report_inbound() {
    local path problems
    path="$(physical "${MAIL_INBOUND_AUTHORIZATION}")"

    case "${INBOUND_RECORDED}" in
        corrupt)
            item CONFLICT "inbound:applied" "the recorded inbound state (${MAIL_INBOUND_APPLIED}) is incomplete, unreadable or on a gateway not marked installed — it is the host's only witness of what was opened; restore it from the gateway's backups"
            ;;
        disabled)
            item PASS "inbound:applied" "inbound mail is installed: the loopback inbound listener and delivery to the store; public SMTP disabled"
            ;;
        enabled)
            item PASS "inbound:applied" "public inbound SMTP is enabled on ${INBOUND_RECORDED_ADDRESS}:25"
            ;;
    esac

    if [[ -e "${path}" || -L "${path}" ]]; then
        if [[ "${MODE}" == verify ]]; then
            item DRIFT "inbound:authorization" "an unused inbound transition authorization is waiting — activate-mail-inbound writes and withdraws it"
        elif [[ -n "${INBOUND_TRANSITION}" ]]; then
            item PASS "inbound:transition" "this bundle moves inbound mail from ${INBOUND_RECORDED} to ${INBOUND_STATE}${INBOUND_ADDRESS:+ on ${INBOUND_ADDRESS}:25}, authorized by activate-mail-inbound for exactly this host (one use)"
        else
            problems="${INBOUND_PENDING_PROBLEMS:-the recorded inbound state cannot be trusted}"
            item CONFLICT "inbound:transition" "a pending inbound transition authorization is not honoured (${problems//$'\n'/; })"
        fi
    fi

    if [[ "${INBOUND_RECORDED}" == enabled && "${INBOUND_REQUESTED}" != enabled && "${INBOUND_TRANSITION}" != disable ]]; then
        item CONFLICT "inbound:request" "public inbound SMTP is open on this host, and this bundle does not request it — an ordinary apply never closes it; the inbound rollback does"
    fi

    [[ -n "${INBOUND_INPUT}" ]] || return 0

    local state
    state="$(applied_file_state "${MAIL_INBOUND_APPLIED}")"
    case "${state}" in
        PASS)    item PASS "file:${MAIL_INBOUND_APPLIED}" "the recorded inbound state is the one rendered" ;;
        MISSING) item MISSING "file:${MAIL_INBOUND_APPLIED}" "absent — --apply records it once the transition is proved" ;;
        DRIFT)   item DRIFT "file:${MAIL_INBOUND_APPLIED}" "differs from the state rendered — --apply records it once the transition is proved" ;;
    esac

    if [[ "${MODE}" == verify && "$(package_status)" == installed ]]; then
        local id
        for id in "${INBOUND_REQUIREMENTS[@]}"; do
            report_problems "inbound:requirement:${id}" "$(inbound_requirement_problems "$(physical "${POSTFIX_DIR}")" "${id}")" CONFLICT \
                "met, as Postfix reads the installed configuration"
        done
    fi
}

# --- Check and verify -----------------------------------------------------------------------

report_problems() {
    local name="$1" problems="$2" failure_status="$3" detail_pass="$4"

    if [[ -z "${problems}" ]]; then
        item PASS "${name}" "${detail_pass}"
        return 0
    fi

    local problem
    while IFS= read -r problem; do
        [[ -n "${problem}" ]] || continue
        item "${failure_status}" "${name}" "${problem}"
    done <<<"${problems}"
}

report_contract() {
    local owner package others listener_count
    owner="$(ownership)"
    package="$(package_status)"
    others="$(other_mail_transport_agents)"
    listener_count="$(jq '.listeners | length' "${PLAN_FILE}")"

    printf 'install-mail-gateway --%s\n' "${MODE}"
    item PASS "plan" "mail-routing render-plan accepted the reviewed policy (${listener_count} listener(s)); the gateway is rendered from it"

    local helo outbound_count
    helo="$(outbound_mta_hostname)"
    outbound_count="$(plan_outbound_count)"
    if [[ -n "${helo}" ]]; then
        item PASS "outbound:direct" "direct delivery enabled on this host as ${helo}; ${outbound_count} outbound route(s) in the plan"
    else
        item PASS "outbound:direct" "direct delivery disabled on this host (mail-outbound.json); ${outbound_count} outbound route(s) in the plan, and none could be rendered"
    fi

    local signed
    signed="$(signed_identities | paste -sd ',' - | sed 's/,/, /g')"
    if [[ -n "${signed}" ]]; then
        item PASS "signing" "listeners of ${signed} hand their mail to the signer at ${MILTER_ENDPOINT} (install-mail-signing --milter-endpoint), deferred when it cannot sign, each through its own cleanup service and From policy; no other listener is signed"
    else
        item PASS "signing" "no target is in the signing plan, so no listener names the signer"
    fi

    if [[ -n "${others}" ]]; then
        item CONFLICT "mta:other" "another mail transport agent is installed (${others//$'\n'/, }) — it is not RateGuru's, and installing Postfix would remove it"
    fi

    case "${owner}" in
        owned)
            item PASS "ownership" "RateGuru ownership marker present (state=$(marker_state))"
            [[ "${MODE}" == check || "$(marker_state)" == installed ]] \
                || item CONFLICT "ownership:state" "the marker says state=$(marker_state): an installation RateGuru started is unfinished — --apply resumes it"
            ;;
        fresh)
            if [[ "${MODE}" == check ]]; then
                item MISSING "ownership" "no Postfix on this host — --apply installs the postfix package with service starts suppressed"
            else
                item MISSING "ownership" "the gateway is not installed"
            fi
            ;;
        unmanaged)
            item CONFLICT "ownership" "Postfix (package ${package}, or ${POSTFIX_DIR}) exists without the RateGuru ownership marker — refusing to take over a mail transport agent RateGuru did not install"
            ;;
    esac

    if leftover_start_suppression; then
        if [[ "${MODE}" == check ]]; then
            item DRIFT "package:start-suppression" "a policy-rc.d from an interrupted run still suppresses package service starts — --apply restores the host's own"
        else
            item CONFLICT "package:start-suppression" "a policy-rc.d from an interrupted run still suppresses package service starts on this host"
        fi
    fi

    if [[ "${package}" == installed ]]; then
        item PASS "package" "${POSTFIX_PACKAGE} $(package_version) installed"
        if [[ "${MODE}" == check ]]; then
            report_problems "config:candidate" "$(postfix_contract_problems "${CANDIDATE_DIR}")" CONFLICT \
                "Postfix accepts the rendered configuration, and reads it back fail-closed"
        fi
    elif [[ "${MODE}" == check ]]; then
        item MISSING "package" "${POSTFIX_PACKAGE} is ${package} — --apply installs it with no package configuration of its own and service starts suppressed"
        item DEFERRED "config:candidate" "Postfix is not installed yet, so its own parser runs during --apply, before the configuration is installed"
    else
        item MISSING "package" "${POSTFIX_PACKAGE} is ${package}"
    fi

    local logical state
    while IFS= read -r logical; do
        state="$(managed_file_state "${logical}")"
        case "${state}" in
            PASS)    item PASS "file:${logical}" "matches the current render, ${FILE_OWNER}:${FILE_GROUP} ${MANAGED_FILE_MODE}" ;;
            MISSING) item MISSING "file:${logical}" "absent — --apply installs the current render" ;;
            DRIFT)   item DRIFT "file:${logical}" "differs from the current render (content, type, owner or mode) — --apply replaces it" ;;
        esac
    done < <(managed_files)

    while IFS=$'\t' read -r state logical; do
        [[ -n "${logical}" ]] || continue
        if [[ "${state}" == owned ]]; then
            item DRIFT "file:${logical}" "the From policy of a target that is no longer signed — --apply removes it"
        else
            item CONFLICT "file:${logical}" "named like a RateGuru From policy, but not written by this installer — never used or removed"
        fi
    done < <(retired_policy_files)

    report_applied_policy
    report_inbound

    if [[ "${MODE}" == verify ]]; then
        if [[ "${package}" == installed ]]; then
            report_problems "config:installed" "$(postfix_contract_problems "$(physical "${POSTFIX_DIR}")")" CONFLICT \
                "Postfix reads the installed configuration back fail-closed: listeners, routes and holds exactly as planned"
        fi
        report_problems "runtime" "$(runtime_problems)" CONFLICT \
            "enabled, stably running, listening on exactly the plan's loopback endpoints, no public SMTP port open, every capture destination and the signer listening"
    elif [[ "${owner}" != owned ]]; then
        # Before an install: a gateway port somebody else already holds would
        # make --apply fail after the package is in.
        local endpoint
        while IFS= read -r endpoint; do
            [[ -n "${endpoint}" ]] || continue
            grep -q ":${endpoint##*:}\$" <<<"$(tcp_listeners)" \
                && item CONFLICT "port:${endpoint}" "already in use by another process — the gateway cannot listen there"
        done < <(plan_endpoints)
    fi

    printf 'SUMMARY  pass=%d missing=%d drift=%d conflict=%d deferred=%d\n' \
        "${COUNT_PASS}" "${COUNT_MISSING}" "${COUNT_DRIFT}" "${COUNT_CONFLICT}" "${COUNT_DEFERRED}"
}

run_check() {
    require_tools jq stat
    trap cleanup_work_dir EXIT
    prepare_candidate
    report_contract

    (( COUNT_CONFLICT == 0 )) || exit 1
}

run_verify() {
    require_root
    require_tools jq stat
    trap cleanup_work_dir EXIT
    prepare_candidate
    report_contract

    (( COUNT_CONFLICT + COUNT_MISSING + COUNT_DRIFT + COUNT_DEFERRED == 0 )) || exit 1
}

# --- Apply: package start suppression ------------------------------------------------------

SUPPRESSION_INSTALLED=false

restore_start_suppression() {
    local path preserved
    path="$(physical "${POLICY_RC}")"
    preserved="$(physical "${PRESERVED_POLICY_RC}")"

    if [[ -f "${path}" ]] && grep -qF "${POLICY_RC_MARKER}" "${path}"; then
        rm -f "${path}"
    fi

    if [[ -e "${preserved}" || -L "${preserved}" ]]; then
        [[ ! -e "${path}" && ! -L "${path}" ]] \
            || fail "both a preserved policy-rc.d (${preserved}) and a live one (${path}) exist — resolve which is the host's own by hand"
        mv -f "${preserved}" "${path}"
        action "restored the host's own policy-rc.d"
    fi

    SUPPRESSION_INSTALLED=false
}

install_start_suppression() {
    local path preserved tmp
    path="$(physical "${POLICY_RC}")"
    preserved="$(physical "${PRESERVED_POLICY_RC}")"

    if [[ -e "${path}" || -L "${path}" ]]; then
        [[ ! -e "${preserved}" && ! -L "${preserved}" ]] \
            || fail "a policy-rc.d is already preserved at ${preserved} — refusing to overwrite the host's own"
        mv -f "${path}" "${preserved}"
        action "preserved the host's own policy-rc.d while the package installs"
    fi

    SUPPRESSION_INSTALLED=true
    install -d -m 0755 "$(dirname "${path}")"
    tmp="${path}.tmp.$$"
    printf '#!/bin/sh\n%s\nexit 101\n' "${POLICY_RC_MARKER}" > "${tmp}"
    chmod 0755 "${tmp}"
    mv -f "${tmp}" "${path}"
}

preseed_package() {
    # No configuration: the package writes no main.cf and never manages one, so
    # it cannot start a daemon of its own before RateGuru's configuration is in
    # place, and no later package configuration rewrites it. The other answers
    # are defense in depth for anyone who reconfigures the package by hand.
    printf '%s\n' \
        "postfix postfix/main_mailer_type select No configuration" \
        "postfix postfix/protocols select ipv4" \
        "postfix postfix/relayhost string" \
        "postfix postfix/mynetworks string 127.0.0.0/8" \
        "postfix postfix/mailname string ${GATEWAY_HOSTNAME}" \
        | "${DEBCONF_SET_SELECTIONS_BIN}"
}

install_package() {
    local status
    status="$(package_status)"
    [[ "${status}" != installed ]] || return 0

    action "installing the ${POSTFIX_PACKAGE} package (preseeded with no configuration of its own, service starts suppressed)"
    preseed_package
    install_start_suppression

    # A package an interrupted run left unpacked or half-configured is finished
    # first; apt refuses to work around it.
    if [[ "${status}" == partial ]]; then
        DEBIAN_FRONTEND=noninteractive "${DPKG_BIN}" --configure "${POSTFIX_PACKAGE}" || true
    fi

    DEBIAN_FRONTEND=noninteractive "${APT_GET_BIN}" update
    DEBIAN_FRONTEND=noninteractive "${APT_GET_BIN}" install -y \
        --no-install-recommends --no-remove \
        -o Dpkg::Options::=--force-confdef \
        -o Dpkg::Options::=--force-confold \
        "${POSTFIX_PACKAGE}"

    restore_start_suppression

    [[ "$(package_status)" == installed ]] \
        || fail "the ${POSTFIX_PACKAGE} package is not installed after apt-get install"

    # Belt and braces: the configuration that will run is not installed yet.
    if [[ "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" == active ]]; then
        action "stopping the package's own Postfix before the gateway configuration is installed"
        "${SYSTEMCTL_BIN}" stop "${POSTFIX_INSTANCE_UNIT}"
    fi
}

# --- Apply: transaction -----------------------------------------------------------------------

BACKUP_DIR=""
ROLLBACK_RESTORE=()
ROLLBACK_REMOVE=()
APPLY_COMMITTED=false
MAIN_BASHPID=""
FILES_CHANGED=false
UNIT_ENABLED_BEFORE=""
INSTANCE_ACTIVE_BEFORE=""

capture_runtime_state() {
    UNIT_ENABLED_BEFORE="$("${SYSTEMCTL_BIN}" is-enabled "${POSTFIX_UNIT}" 2>/dev/null || true)"
    [[ -n "${UNIT_ENABLED_BEFORE}" ]] || UNIT_ENABLED_BEFORE="not-found"

    INSTANCE_ACTIVE_BEFORE=inactive
    [[ "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" == active ]] && INSTANCE_ACTIVE_BEFORE=active

    action "pre-apply state: ${POSTFIX_UNIT} ${UNIT_ENABLED_BEFORE}, ${POSTFIX_INSTANCE_UNIT} ${INSTANCE_ACTIVE_BEFORE}"
}

record_target() {
    local path="$1" backup
    if [[ -e "${path}" || -L "${path}" ]]; then
        backup="${BACKUP_DIR}${path#"${FS_ROOT}"}"
        install -d -m 0700 "$(dirname "${backup}")"
        cp -a "${path}" "${backup}"
        ROLLBACK_RESTORE+=("${path}")
    else
        ROLLBACK_REMOVE+=("${path}")
    fi
}

retire_managed_file() {
    local path
    path="$(physical "$1")"

    record_target "${path}"
    rm -f "${path}"
    FILES_CHANGED=true
}

install_managed_file() {
    local logical="$1" path candidate tmp
    path="$(physical "${logical}")"
    candidate="${CANDIDATE_DIR}/$(basename "${logical}")"

    record_target "${path}"
    install -d -m 0755 "$(dirname "${path}")"
    tmp="${path}.rateguru-tmp.$$"
    install -o "${FILE_OWNER}" -g "${FILE_GROUP}" -m "0${MANAGED_FILE_MODE}" "${candidate}" "${tmp}"
    mv -f "${tmp}" "${path}"
    FILES_CHANGED=true
}

restore_runtime_state() {
    local status=0

    # The package never got as far as installing its unit: there is no service
    # state to put back.
    if [[ -z "$("${SYSTEMCTL_BIN}" is-enabled "${POSTFIX_UNIT}" 2>/dev/null || true)" ]]; then
        return 0
    fi

    case "${UNIT_ENABLED_BEFORE}" in
        enabled|enabled-runtime) "${SYSTEMCTL_BIN}" enable "${POSTFIX_UNIT}" >/dev/null 2>&1 || status=1 ;;
        disabled|not-found)      "${SYSTEMCTL_BIN}" disable "${POSTFIX_UNIT}" >/dev/null 2>&1 || status=1 ;;
        masked|masked-runtime)   "${SYSTEMCTL_BIN}" mask "${POSTFIX_UNIT}" >/dev/null 2>&1 || status=1 ;;
    esac

    if [[ "${INSTANCE_ACTIVE_BEFORE}" == active ]]; then
        # A running Postfix takes its restored configuration by a reload, so
        # undoing a change never stops mail on the other listeners; one that
        # is no longer running is started again.
        if [[ "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" == active ]]; then
            "${SYSTEMCTL_BIN}" reload "${POSTFIX_INSTANCE_UNIT}" >/dev/null 2>&1 \
                || "${SYSTEMCTL_BIN}" restart "${POSTFIX_INSTANCE_UNIT}" >/dev/null 2>&1 || true
        else
            "${SYSTEMCTL_BIN}" restart "${POSTFIX_INSTANCE_UNIT}" >/dev/null 2>&1 || true
        fi
        [[ "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" == active ]] || status=1
    else
        "${SYSTEMCTL_BIN}" stop "${POSTFIX_INSTANCE_UNIT}" >/dev/null 2>&1 || true
        [[ "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" != active ]] || status=1
    fi

    return "${status}"
}

rollback() {
    action "rolling back the managed configuration and the service state"
    local status=0 path backup

    for path in "${ROLLBACK_REMOVE[@]:-}"; do
        [[ -n "${path}" ]] || continue
        rm -f "${path}" || { action "ERROR: could not remove ${path}"; status=1; }
    done

    for path in "${ROLLBACK_RESTORE[@]:-}"; do
        [[ -n "${path}" ]] || continue
        backup="${BACKUP_DIR}${path#"${FS_ROOT}"}"
        if [[ -e "${backup}" || -L "${backup}" ]]; then
            rm -f "${path}"
            cp -a "${backup}" "${path}" || { action "ERROR: could not restore ${path}"; status=1; }
        else
            action "ERROR: no backup of ${path}; it was left as installed"
            status=1
        fi
    done

    restore_runtime_state || status=1

    if (( status != 0 )); then
        action "ERROR: rollback INCOMPLETE — the previous configuration or service state was not fully restored; backups remain in ${BACKUP_DIR}"
        return 1
    fi

    action "rollback complete: configuration and service state restored (backups in ${BACKUP_DIR})"
}

on_apply_error() {
    local code=$?

    # errtrace carries this trap into every $(...) as well; only the apply's own
    # shell may roll back, or a failing probe in a subshell would do it twice.
    [[ "${BASHPID}" == "${MAIN_BASHPID}" ]] || exit "${code}"

    trap - ERR EXIT

    # Never leave every package service start on the host suppressed.
    if [[ "${SUPPRESSION_INSTALLED}" == true ]]; then
        ( restore_start_suppression ) || action "ERROR: could not restore the host's policy-rc.d — check ${POLICY_RC} by hand"
    fi

    if [[ "${APPLY_COMMITTED}" == false && -n "${BACKUP_DIR}" ]]; then
        rollback || true
    fi

    cleanup_work_dir
    action "apply FAILED (exit ${code}); the ownership marker stays, so a re-run resumes"
    exit "${code}"
}

perform_apply() {
    require_root
    require_tools jq stat cmp install sha256sum

    trap cleanup_work_dir EXIT
    prepare_candidate

    action "validating the plan and the host before any mutation"

    local others
    others="$(other_mail_transport_agents)"
    [[ -z "${others}" ]] \
        || fail "another mail transport agent is installed (${others//$'\n'/, }) — it is not RateGuru's, and installing Postfix would remove it. Nothing was changed"

    local owner
    owner="$(ownership)"
    [[ "${owner}" != unmanaged ]] \
        || fail "Postfix (package $(package_status), or ${POSTFIX_DIR}) exists on this host without the RateGuru ownership marker — refusing to take over a mail transport agent RateGuru did not install. Nothing was changed"

    if [[ "${owner}" == fresh ]]; then
        local endpoint
        while IFS= read -r endpoint; do
            [[ -n "${endpoint}" ]] || continue
            ! grep -q ":${endpoint##*:}\$" <<<"$(tcp_listeners)" \
                || fail "gateway port ${endpoint##*:} is already in use by another process — nothing was changed"
        done < <(plan_endpoints)
    fi

    local foreign
    foreign="$(retired_policy_files | awk -F'\t' '$1 == "foreign" { print $2 }')"
    [[ -z "${foreign}" ]] \
        || fail "${foreign//$'\n'/, } is named like a RateGuru From policy but was not written by this installer — refusing to use or remove it. Nothing was changed"

    # The activation boundary, before anything changes: the recorded policy
    # against this bundle's.
    local verdict kind target problems
    verdict="$(boundary_verdict)"
    kind="${verdict%%$'\t'*}"
    target="${verdict#*$'\t'}"

    case "${kind}" in
        establish|none)
            ;;
        unwitnessed)
            fail "no applied policy is recorded on this host, and this bundle routes mail outbound or enables direct delivery — a host's first recorded policy is always the inert one. Establish it with the held, direct-disabled configuration first; crossing to outbound is activate-mail-outbound's alone. Nothing was changed"
            ;;
        corrupt)
            fail "the recorded applied policy (${APPLIED_PLAN}, ${APPLIED_OUTBOUND}) is incomplete or unreadable — it is the host's only witness of what was accepted. Restore it from the gateway's backups under ${BACKUP_ROOT}. Nothing was changed"
            ;;
        activate|rollback)
            problems="$(authorization_problems "${kind}" "${target}")"
            [[ -z "${problems}" ]] \
                || fail "this bundle moves ${target}'s mail $([[ "${kind}" == activate ]] && echo "from held to outbound" || echo "from outbound to held") — the activation boundary, which only activate-mail-outbound crosses, and ordinary install-mail-gateway --apply never does (${problems//$'\n'/; }). Nothing was changed"
            action "the ${kind} of ${target} is authorized by activate-mail-outbound for exactly this recorded and requested policy — consuming that one-use authorization"
            consume_authorization "${kind}" "${target}"
            ;;
        *)
            fail "${target} — no single guarded activation makes this change, so no gateway apply makes it. Nothing was changed"
            ;;
    esac

    # Inbound mail, before anything changes: a record that cannot be trusted
    # is never rendered around, a host with public SMTP open is never closed by
    # a bundle that no longer requests it, and a transition happens only with
    # its one-use authorization — consumed now, so it is never honoured twice.
    [[ "${INBOUND_RECORDED}" != corrupt ]] \
        || fail "the recorded inbound state (${MAIL_INBOUND_APPLIED}) is incomplete, unreadable or on a gateway not marked installed — it is the host's only witness of what was opened. Restore it from the gateway's backups under ${BACKUP_ROOT}. Nothing was changed"

    if [[ "${INBOUND_RECORDED}" == enabled && "${INBOUND_REQUESTED}" != enabled && "${INBOUND_TRANSITION}" != disable ]]; then
        fail "public inbound SMTP is open on this host on ${INBOUND_RECORDED_ADDRESS}:25, and this bundle does not request it — an ordinary apply never closes it: the inbound rollback (activate-mail-inbound --rollback) does. Nothing was changed"
    fi

    if [[ -n "${INBOUND_TRANSITION}" ]]; then
        action "the inbound ${INBOUND_TRANSITION} (${INBOUND_RECORDED} -> ${INBOUND_STATE}${INBOUND_ADDRESS:+ on ${INBOUND_ADDRESS}:25}) is authorized by activate-mail-inbound — consuming that one-use authorization"
        consume_inbound_authorization
    elif [[ -n "${INBOUND_PENDING_PROBLEMS}" && "${INBOUND_PENDING_PROBLEMS}" != "no inbound transition authorization is pending" ]]; then
        action "a pending inbound transition authorization is not honoured (${INBOUND_PENDING_PROBLEMS//$'\n'/; }) — the recorded inbound state is kept"
    fi

    # A policy-rc.d an interrupted run left behind is undone before anything
    # else, so this host's package activity is its own again.
    if leftover_start_suppression; then
        action "removing the package start suppression an interrupted run left behind"
        restore_start_suppression
    fi

    BACKUP_DIR="$(physical "${BACKUP_ROOT}")/$(date -u '+%Y%m%dT%H%M%SZ')-$$"
    install -d -m 0700 "$(physical "${BACKUP_ROOT}")" "${BACKUP_DIR}"
    action "configuration backups for this run: ${BACKUP_DIR}"

    MAIN_BASHPID="${BASHPID}"
    trap on_apply_error ERR EXIT

    capture_runtime_state

    # The marker goes down before the package does, so an installation this run
    # starts is recognisable as RateGuru's if it is interrupted.
    [[ "$(marker_state)" == installed ]] || write_marker installing

    install_package

    # Postfix judges the candidate before a single managed file is touched.
    local problems
    problems="$(postfix_contract_problems "${CANDIDATE_DIR}")"
    [[ -z "${problems}" ]] \
        || fail "Postfix does not accept the rendered gateway configuration: ${problems//$'\n'/; }"

    local logical state
    while IFS= read -r logical; do
        if [[ "$(managed_file_state "${logical}")" != PASS ]]; then
            action "installing ${logical}"
            install_managed_file "${logical}"
        fi
    done < <(managed_files)

    # A From policy the render no longer has is removed in the same
    # transaction, backed up first; one this installer did not write was
    # refused before anything changed.
    while IFS=$'\t' read -r state logical; do
        [[ "${state}" == owned ]] || continue
        action "removing ${logical} (the From policy of a target that is no longer signed)"
        retire_managed_file "${logical}"
    done < <(retired_policy_files)

    install_inbound_record

    problems="$(postfix_contract_problems "$(physical "${POSTFIX_DIR}")")"
    [[ -z "${problems}" ]] \
        || fail "the installed gateway configuration does not validate: ${problems//$'\n'/; }"

    action "enabling ${POSTFIX_UNIT} for boot"
    "${SYSTEMCTL_BIN}" enable "${POSTFIX_UNIT}" \
        || fail "could not enable ${POSTFIX_UNIT} for boot"

    if [[ "$(service_property "${POSTFIX_INSTANCE_UNIT}" ActiveState)" != active ]]; then
        action "starting ${POSTFIX_INSTANCE_UNIT}"
        "${SYSTEMCTL_BIN}" start "${POSTFIX_INSTANCE_UNIT}"
        "${SYSTEMCTL_BIN}" start "${POSTFIX_UNIT}"
    elif [[ "${FILES_CHANGED}" == true ]]; then
        action "reloading ${POSTFIX_INSTANCE_UNIT} with the new configuration"
        "${SYSTEMCTL_BIN}" reload "${POSTFIX_INSTANCE_UNIT}"
    else
        action "gateway configuration unchanged — ${POSTFIX_INSTANCE_UNIT} left running as it is"
    fi

    problems="$(runtime_problems)"
    [[ -z "${problems}" ]] \
        || fail "the running gateway is not healthy: ${problems//$'\n'/; }"

    # Only a proved gateway is recorded as applied, and in the same
    # transaction: a later failure restores the previous record with the
    # previous configuration.
    install_applied_policy

    [[ "$(marker_state)" == installed ]] || write_marker installed
    APPLY_COMMITTED=true
    trap - ERR EXIT
    cleanup_work_dir

    action "apply complete — gateway installed, validated and running; run 'install-mail-gateway --verify' or 'verify-mail-gateway --read-only' to confirm"
}

# --- Policy digest ---------------------------------------------------------------------------

# run_policy_digest — the SHA-256 of this bundle's canonical policy, of the
# recorded one, and where an authorization belongs: what activate-mail-outbound
# binds an authorization to, from the one place that canonicalizes it.
run_policy_digest() {
    require_tools jq sha256sum
    trap cleanup_work_dir EXIT
    prepare_candidate

    local recorded=null
    if [[ "$(recorded_policy)" == present ]]; then
        recorded="$(jq -c -n \
            --arg plan "$(sha256_of "$(physical "${APPLIED_PLAN}")")" \
            --arg outbound "$(sha256_of "$(physical "${APPLIED_OUTBOUND}")")" \
            '{plan: $plan, outbound: $outbound}')"
    fi

    jq -c -n \
        --arg plan "$(sha256_of "${APPLIED_CANDIDATE_DIR}/$(basename "${APPLIED_PLAN}")")" \
        --arg outbound "$(sha256_of "${APPLIED_CANDIDATE_DIR}/$(basename "${APPLIED_OUTBOUND}")")" \
        --argjson recorded "${recorded}" \
        --arg authorization "$(physical "${TRANSITION_AUTHORIZATION}")" \
        '{requested: {plan: $plan, outbound: $outbound}, recorded: $recorded, authorization: $authorization}'
}

# --- Entry point ---------------------------------------------------------------------------

parse_args() {
    [[ $# -gt 0 ]] || { usage >&2; fail "one of --check, --apply or --verify is required"; }

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--apply|--verify|--policy-digest)
                [[ -z "${MODE}" ]] || { usage >&2; fail "mode given more than once"; }
                MODE="${1#--}"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                fail "unknown argument: $1"
                ;;
        esac
    done
}

main() {
    parse_args "$@"

    case "${MODE}" in
        check)
            run_check
            ;;
        verify)
            run_verify
            ;;
        apply)
            perform_apply
            ;;
        policy-digest)
            run_policy_digest
            ;;
    esac
}

# Sourcing defines the renderer without running anything, so the tests drive the
# shipped functions rather than a copy of them.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
