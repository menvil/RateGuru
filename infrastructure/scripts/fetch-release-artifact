#!/usr/bin/env bash
#
# fetch-release-artifact — retrieve one durably archived RateGuru release
# artifact and prove it is the exact release it claims to be (Phase 7.1).
#
# The canonical counterpart of archive-release-artifact: given a release ID
# and a destination directory it downloads only
#
#     <bucket>/rateguru/artifacts/<release-id>/
#
# and re-runs the full local contract against what arrived — the three
# canonical files, the SHA-256 sidecar, release.json's project/release/commit
# identity, and the release.json frozen inside the tarball. Any mismatch,
# missing file or incomplete archive exits non-zero.
#
# All of that happens in a private staging directory; the canonical filenames
# only ever appear in the destination once the package has passed. A failed
# retrieval therefore leaves the destination untouched and is safe to retry
# into the same directory — which matters most in exactly the situation this
# exists for, where the retry follows fixing whatever went wrong.
#
# This is a retrieval primitive, not a deployment: it never contacts a
# RateGuru host, never extracts the application, never switches a release and
# never touches a target. Its output is a verified artifact package on disk,
# which is exactly what clean-host recovery will later consume.
#
# Like archive-release-artifact it is deliberately self-contained: a recovery
# host has no /home/www/rateguru/bin/common, no target registry and no
# deployment configuration at the moment this has to work.

set -Eeuo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=infrastructure/scripts/release-artifact-common
source "${SCRIPT_DIR}/release-artifact-common"

usage() {
    cat <<'USAGE'
Usage:
  fetch-release-artifact --release RELEASE_ID --destination DIR \
      --rclone-config PATH [--bucket BUCKET] [--remote NAME] \
      [--rclone-bin PATH] [--report PATH]

  --release RELEASE_ID   Canonical immutable release ID
                         (vX.Y.Z-YYYYMMDD-HHMMSS-shortsha).
  --destination DIR      Directory the verified package is written into.
                         Created when absent; must not already hold any of
                         the three canonical files.
  --rclone-config PATH   rclone configuration declaring the remote.
  --bucket BUCKET        Release-artifact bucket
                         (default: rateguru-release-artifacts).
  --remote NAME          rclone remote name
                         (default: rateguru-artifacts-b2).
  --rclone-bin PATH      rclone binary (default: /usr/bin/rclone).
  --report PATH          Write a JSON result document to PATH.
USAGE
}

RELEASE_ID=""
DESTINATION=""
RCLONE_CONFIG=""
BUCKET="${RELEASE_ARTIFACT_BUCKET_DEFAULT}"
REMOTE="${RELEASE_ARTIFACT_REMOTE_DEFAULT}"
RCLONE_BIN="${RELEASE_ARTIFACT_RCLONE_BIN_DEFAULT}"
REPORT_PATH=""

parse_fetch_args() {
    local release_seen=false destination_seen=false config_seen=false
    local bucket_seen=false remote_seen=false bin_seen=false report_seen=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release)
                [[ "${release_seen}" != true ]] || ra_fail "--release given more than once"
                ra_require_flag_value "--release" "$#" "${2-}"
                RELEASE_ID="$2"
                release_seen=true
                shift 2
                ;;
            --destination)
                [[ "${destination_seen}" != true ]] || ra_fail "--destination given more than once"
                ra_require_flag_value "--destination" "$#" "${2-}"
                DESTINATION="$2"
                destination_seen=true
                shift 2
                ;;
            --rclone-config)
                [[ "${config_seen}" != true ]] || ra_fail "--rclone-config given more than once"
                ra_require_flag_value "--rclone-config" "$#" "${2-}"
                RCLONE_CONFIG="$2"
                config_seen=true
                shift 2
                ;;
            --bucket)
                [[ "${bucket_seen}" != true ]] || ra_fail "--bucket given more than once"
                ra_require_flag_value "--bucket" "$#" "${2-}"
                BUCKET="$2"
                bucket_seen=true
                shift 2
                ;;
            --remote)
                [[ "${remote_seen}" != true ]] || ra_fail "--remote given more than once"
                ra_require_flag_value "--remote" "$#" "${2-}"
                REMOTE="$2"
                remote_seen=true
                shift 2
                ;;
            --rclone-bin)
                [[ "${bin_seen}" != true ]] || ra_fail "--rclone-bin given more than once"
                ra_require_flag_value "--rclone-bin" "$#" "${2-}"
                RCLONE_BIN="$2"
                bin_seen=true
                shift 2
                ;;
            --report)
                [[ "${report_seen}" != true ]] || ra_fail "--report given more than once"
                ra_require_flag_value "--report" "$#" "${2-}"
                REPORT_PATH="$2"
                report_seen=true
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                usage >&2
                ra_fail "unknown argument: $1"
                ;;
        esac
    done

    [[ "${release_seen}" == true ]] || { usage >&2; ra_fail "--release is required"; }
    [[ "${destination_seen}" == true ]] || { usage >&2; ra_fail "--destination is required"; }
    [[ "${config_seen}" == true ]] || { usage >&2; ra_fail "--rclone-config is required"; }

    ra_validate_release_id "${RELEASE_ID}"
    ra_validate_bucket "${BUCKET}"
    ra_validate_remote_name "${REMOTE}"
}

rclone_run() {
    "${RCLONE_BIN}" --config "${RCLONE_CONFIG}" "$@"
}

# --- staging workspace -------------------------------------------------------
#
# Nothing is ever downloaded straight into the destination. A retrieval either
# publishes a fully verified package or leaves the destination exactly as it
# found it: a failed attempt must never strand unverified bytes under the
# canonical filenames, both because an operator could mistake them for a good
# package and because the "retrieve into a clean directory" guard would then
# block the retry that fixes the problem.
#
# The staging directory lives inside the destination so publishing is a
# same-filesystem hard link rather than a second copy of a large artifact.

STAGE_DIR=""

cleanup_stage_dir() {
    # ERR/EXIT traps are inherited into $(...) subshells, so only the process
    # that created the workspace may ever remove it.
    [[ "${BASHPID:-$$}" == "$$" ]] || return 0
    [[ -n "${STAGE_DIR}" ]] || return 0

    rm -rf -- "${STAGE_DIR}"
    STAGE_DIR=""
}

# prepare_destination — a retrieval must be unambiguous: whatever this script
# reports as verified has to be what it just downloaded, never a leftover
# file that happened to already be sitting there.
prepare_destination() {
    local entry

    mkdir -p "${DESTINATION}" || ra_fail "cannot create destination directory: ${DESTINATION}"

    [[ -w "${DESTINATION}" ]] || ra_fail "destination directory is not writable: ${DESTINATION}"

    while IFS= read -r entry; do
        [[ -n "${entry}" ]] || continue

        [[ ! -e "${DESTINATION}/${entry}" ]] \
            || ra_fail "destination already contains ${entry} — retrieve into a clean directory"
    done < <(ra_expected_remote_entries "${RELEASE_ID}")

    STAGE_DIR="$(mktemp -d "${DESTINATION%/}/.fetch-release-artifact.XXXXXX")" \
        || ra_fail "cannot create a staging directory inside ${DESTINATION}"

    trap cleanup_stage_dir EXIT
}

# require_complete_remote_archive — the remote release directory must be
# exactly the three canonical objects. A partial archive is rejected here,
# before anything is downloaded, so an incomplete recovery can never be
# mistaken for a successful one.
require_complete_remote_archive() {
    local listing expected_entries

    ra_log "Checking release-artifact bucket access"

    rclone_run lsf "${REMOTE}:${BUCKET}" >/dev/null \
        || ra_fail "cannot access release-artifact bucket ${BUCKET} through remote ${REMOTE}"

    listing="$(rclone_run lsf "${REMOTE_DIR}" 2>/dev/null || true)"

    [[ -n "${listing}" ]] \
        || ra_fail "release ${RELEASE_ID} is not archived in ${BUCKET}/$(ra_remote_prefix "${RELEASE_ID}")/"

    listing="$(ra_normalize_listing <<<"${listing}")"
    expected_entries="$(ra_expected_remote_entries "${RELEASE_ID}" | LC_ALL=C sort)"

    [[ "${listing}" == "${expected_entries}" ]] \
        || ra_fail "archived release ${RELEASE_ID} is incomplete or contains unexpected objects"
}

download_release() {
    ra_log "Retrieving ${RELEASE_ID} from ${BUCKET}/$(ra_remote_prefix "${RELEASE_ID}")/"

    rclone_run copy "${REMOTE_DIR}" "${STAGE_DIR}" \
        --checksum \
        --stats-one-line \
        --stats 10s
}

# publish_release — the final boundary, and the only moment at which the
# canonical filenames appear in the destination. Runs only after the staged
# package has passed the full local contract.
#
# Each file is published with `ln`, not `mv -f`, for two reasons:
#
#   - `ln` refuses outright when the target name already exists, so a
#     canonical file that appeared during the download is never overwritten.
#     That is one atomic operation, not a test-then-move with a window
#     between the two.
#   - a hard link leaves this invocation's own copy in the staging
#     directory, so undoing a publication is a plain unlink of a name we
#     created moments earlier, with the bytes never at risk.
#
# POSIX cannot publish three files into a shared directory as one atomic
# step, so if any link fails, the links already made are removed again. A
# failed retrieval therefore never leaves a partial canonical package behind,
# and an immediate retry into the same destination succeeds.
publish_release() {
    local entry

    while IFS= read -r entry; do
        [[ -n "${entry}" ]] || continue

        if ! ln -- "${STAGE_DIR}/${entry}" "${DESTINATION%/}/${entry}" 2>/dev/null; then
            unpublish_release

            ra_fail "cannot publish ${entry} into ${DESTINATION} — nothing from this retrieval was left behind, so the same command can simply be run again"
        fi
    done < <(ra_expected_remote_entries "${RELEASE_ID}")

    cleanup_stage_dir
}

# unpublish_release — rolls back a partial publication.
#
# A destination name is removed only when it is literally this invocation's
# own staged file: `-ef` compares device and inode, which is true exactly for
# the hard links publish_release just created. A file that was already in the
# destination, or that something else replaced in between, fails that test
# and is left alone. Unrelated destination contents are never touched.
unpublish_release() {
    local entry published_path staged_path

    while IFS= read -r entry; do
        [[ -n "${entry}" ]] || continue

        published_path="${DESTINATION%/}/${entry}"
        staged_path="${STAGE_DIR}/${entry}"

        [[ -e "${published_path}" ]] || continue
        [[ -e "${staged_path}" ]] || continue
        [[ "${published_path}" -ef "${staged_path}" ]] || continue

        rm -f -- "${published_path}"
    done < <(ra_expected_remote_entries "${RELEASE_ID}")
}

# require_writable_report_path — proven before anything is downloaded and
# long before anything is published, so an unusable --report path fails the
# command while the destination is still untouched. Without this, the only
# place a report problem could surface is after publication, which is exactly
# the "command failed, package is already published" ambiguity this script
# must never produce.
require_writable_report_path() {
    local report_dir

    [[ -n "${REPORT_PATH}" ]] || return 0

    report_dir="$(dirname -- "${REPORT_PATH}")"

    [[ -d "${report_dir}" ]] || ra_fail "--report directory does not exist: ${report_dir}"
    [[ -w "${report_dir}" ]] || ra_fail "--report directory is not writable: ${report_dir}"

    if [[ -e "${REPORT_PATH}" ]]; then
        [[ -f "${REPORT_PATH}" ]] || ra_fail "--report path is not a regular file: ${REPORT_PATH}"
        [[ -w "${REPORT_PATH}" ]] || ra_fail "--report path is not writable: ${REPORT_PATH}"
    fi
}

# write_report — runs after publication, and deliberately cannot fail the
# retrieval.
#
# By the time this runs the package is published and verified on disk. A
# non-zero exit here would tell an operator — or a future recovery
# orchestrator — to discard a good, fully verified recovery package because a
# side-channel file could not be written. The exit status describes the
# retrieval, and the retrieval succeeded; a report problem is reported
# loudly instead, naming the package that is on disk.
#
# require_writable_report_path above makes this path essentially unreachable.
# The report is staged and renamed into place so a failure can never replace
# a previous good report with a truncated one.
write_report() {
    [[ -n "${REPORT_PATH}" ]] || return 0

    local staged_report

    if ! staged_report="$(mktemp "${REPORT_PATH}.XXXXXX" 2>/dev/null)"; then
        report_write_failed

        return 0
    fi

    if ! render_report > "${staged_report}" || ! mv -f -- "${staged_report}" "${REPORT_PATH}"; then
        rm -f -- "${staged_report}"
        report_write_failed

        return 0
    fi
}

report_write_failed() {
    ra_log "WARNING: ${RELEASE_ID} was retrieved and verified, but the report could not be written to ${REPORT_PATH}"
    ra_log "WARNING: the verified package is on disk at ${DESTINATION%/}/${ARTIFACT_NAME} — the retrieval itself succeeded"
}

render_report() {
    jq \
        --null-input \
        --arg project "${RELEASE_ARTIFACT_PROJECT}" \
        --arg release "${RELEASE_ID}" \
        --arg source_sha "${RA_SOURCE_SHA}" \
        --arg bucket "${BUCKET}" \
        --arg remote_path "$(ra_remote_prefix "${RELEASE_ID}")/" \
        --arg artifact "${ARTIFACT_NAME}" \
        --arg artifact_path "${DESTINATION%/}/${ARTIFACT_NAME}" \
        --arg sha256 "${RA_ARTIFACT_SHA256}" \
        --arg verify "pass" \
        --arg result "pass" \
        '{
            project: $project,
            release: $release,
            source_sha: $source_sha,
            bucket: $bucket,
            remote_path: $remote_path,
            artifact: $artifact,
            artifact_path: $artifact_path,
            sha256: $sha256,
            verify: $verify,
            result: $result
        }'
}

perform_fetch() {
    ARTIFACT_NAME="$(ra_artifact_name "${RELEASE_ID}")"
    REMOTE_DIR="$(ra_remote_dir "${REMOTE}" "${BUCKET}" "${RELEASE_ID}")"

    ra_log "Release:     ${RELEASE_ID}"
    ra_log "Artifact:    ${ARTIFACT_NAME}"
    ra_log "Remote path: ${BUCKET}/$(ra_remote_prefix "${RELEASE_ID}")/"

    ra_require_rclone "${RCLONE_BIN}" "${RCLONE_CONFIG}"
    require_writable_report_path

    prepare_destination
    require_complete_remote_archive
    download_release

    ra_log "Validating the retrieved release package"
    ra_verify_local_package "${STAGE_DIR}" "${RELEASE_ID}"

    publish_release
    write_report

    ra_log "Verified ${ARTIFACT_NAME} (sha256 ${RA_ARTIFACT_SHA256}, source_sha ${RA_SOURCE_SHA})"
    ra_log ""
    ra_log "Release ${RELEASE_ID} retrieved and verified at ${DESTINATION%/}/${ARTIFACT_NAME}"
}

main() {
    parse_fetch_args "$@"
    perform_fetch
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
