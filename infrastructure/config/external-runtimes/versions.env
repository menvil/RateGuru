# Pinned external runtime binaries — RateGuru-managed, never Ubuntu packages.
#
# This file is intentionally committed. It contains no secrets: only the
# exact upstream release of each managed runtime (rclone, yt-dlp, ffmpeg) that
# install-bootstrap-runtime is allowed to download, verify and install, the
# canonical install contract for each binary, and what proves a download is
# the release: the official release-signing key fingerprint each committed
# public key (rclone-release-signing-key.asc and yt-dlp-release-signing-key.asc,
# in this directory) must match, or, for ffmpeg, whose builds carry no
# signature, the archive's exact SHA-256. Never use "latest":
# moving a pinned version is a deliberate, reviewed repository change — this
# file is the single place the versions live.
#
# Consumed by (parsed as plain KEY=VALUE text, never sourced):
#   - infrastructure/scripts/install-bootstrap-runtime
#   - infrastructure/scripts/bootstrap-host-preflight
RCLONE_VERSION=1.75.0
RCLONE_PLATFORM=linux-amd64
RCLONE_BINARY=/usr/bin/rclone
RCLONE_OWNER=root
RCLONE_GROUP=root
RCLONE_MODE=0755
RCLONE_RELEASE_SIGNING_FINGERPRINT=FBF737ECE9F8AB18604BD2AC93935E02FF3B54FA
# yt-dlp's site support breaks as sites change, so this pin moves every few
# weeks: change YTDLP_VERSION here, then run install-bootstrap-runtime --apply.
# yt-dlp_linux is the standalone executable with its own Python. The key is
# the one yt-dlp's README names for its SHA2-256SUMS signatures (public.key in
# the yt-dlp repository).
YTDLP_VERSION=2026.11.23
YTDLP_ARTIFACT=yt-dlp_linux
YTDLP_BINARY=/usr/local/bin/yt-dlp
YTDLP_OWNER=root
YTDLP_GROUP=root
YTDLP_MODE=0755
YTDLP_RELEASE_SIGNING_FINGERPRINT=AC0CBBE6848D6A873464AF4E57CF65933B5A7581
# ffmpeg and ffprobe for the media pipeline: a static build from
# BtbN/FFmpeg-Builds (the Linux builds ffmpeg.org links to), from a month-end
# autobuild — the project keeps the last build of each month for two years,
# so the URL stays valid. The builds are not signed; FFMPEG_SHA256 is the
# archive's digest from that release's checksums.sha256, and it is what
# --apply trusts. FFMPEG_VERSION is what the binaries print after "ffmpeg
# version". To move the pin: pick a later month-end autobuild, take the
# linux64-gpl archive of the release branch you want, and update the version,
# release, artifact and digest together. CI installs the same build from these
# values (.github/workflows/ci.yml, "Install ffmpeg").
FFMPEG_VERSION=n8.1.3-27-g8dca1586f4-20261031
FFMPEG_RELEASE=autobuild-2026-10-31-12-59
FFMPEG_ARTIFACT=ffmpeg-n8.1.3-27-g8dca1586f4-linux64-gpl-8.1.tar.xz
FFMPEG_SHA256=41e9c565594c390622cf968d82fa4135d9e9a11d06c1515644288cbc844e3380
FFMPEG_BIN_DIR=/usr/local/bin
FFMPEG_OWNER=root
FFMPEG_GROUP=root
FFMPEG_MODE=0755
