# Pinned external runtime binaries — RateGuru-managed, never Ubuntu packages.
#
# This file is intentionally committed. It contains no secrets: only the
# exact upstream rclone release that install-bootstrap-runtime is allowed to
# download, verify and install, the canonical install contract for the
# binary, and the official rclone release-signing key fingerprint that the
# committed public key (rclone-release-signing-key.asc, in this directory)
# must match before it may verify anything. Never use "latest": moving the
# pinned version is a deliberate, reviewed repository change — this file is
# the single place the version lives.
#
# Consumed by (parsed as plain KEY=VALUE text, never sourced):
#   - infrastructure/scripts/install-bootstrap-runtime
#   - infrastructure/scripts/bootstrap-host-preflight
RCLONE_VERSION=1.75.0
RCLONE_PLATFORM=linux-amd64
RCLONE_BINARY=/usr/bin/rclone
RCLONE_OWNER=root
RCLONE_GROUP=root
RCLONE_MODE=0755
RCLONE_RELEASE_SIGNING_FINGERPRINT=FBF737ECE9F8AB18604BD2AC93935E02FF3B54FA
