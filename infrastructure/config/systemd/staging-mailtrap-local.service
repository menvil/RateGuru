[Unit]
Description=Staging Mailtrap Local (secondary mail-capture mirror)
Documentation=https://github.com/mailtrap/mailtrap-local
# The runbook ships from the RateGuru repository, which is the temporary source
# of truth for shared staging infrastructure.
Documentation=file:/home/www/rateguru/runbooks/mail-capture.md
# This service is independent: it must never depend on Mailpit. Mailpit
# relays a best-effort mirror to it, not the other way around.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=staging-mailtrap-local
Group=staging-mailtrap-local
# Loopback-only listeners and an explicit SQLite path inside the state dir.
# SMTP binds 127.0.0.2 (not 127.0.0.1): Mailtrap Local 0.2.0 expands a
# 127.0.0.1 SMTP bind into both 127.0.0.1 and [::1], and on hosts without IPv6
# loopback that fails with "bind: cannot assign requested address". A distinct
# IPv4 loopback address avoids the IPv6 expansion without enabling IPv6. The
# HTTP/API listener stays on 127.0.0.1. Both are loopback-only; see the runbook.
ExecStart=/usr/local/bin/staging-mailtrap-local \
    --smtp-listen 127.0.0.2:3535 \
    --http-listen 127.0.0.1:3550 \
    --db /var/lib/staging-mail-capture/mailtrap-local/mailtrap-local.sqlite3
# Non-secret storage config (max_messages) and per-user state locations.
Environment=HOME=/var/lib/staging-mail-capture/mailtrap-local
Environment=XDG_CONFIG_HOME=/var/lib/staging-mail-capture/mailtrap-local
Environment=MAILTRAP_LOCAL_CONFIG=/etc/staging-mail-capture/mailtrap-local.yml
Environment=MAILTRAP_LOCAL_SECRET_KEY_FILE=/var/lib/staging-mail-capture/mailtrap-local/secret.key
WorkingDirectory=/var/lib/staging-mail-capture/mailtrap-local
Restart=on-failure
RestartSec=2

# Logs go to journald (Mailtrap Local logs to stderr).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=staging-mailtrap-local

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# Loopback TCP only (plus AF_UNIX for internal use); no raw/netlink families.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Empty capability set: Mailtrap Local binds only high ports (>1024).
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# The persistent SQLite directory is the only writable location.
ReadWritePaths=/var/lib/staging-mail-capture/mailtrap-local

[Install]
WantedBy=multi-user.target
