    "config_env_readers": {
        "$schema_note": "config/*.php must name every environment variable it reads as a literal, so the inventory can see it. Two files legitimately read env() through a local closure that normalizes a blank value to unset; the KEY is still a literal at every call site, but the env() call itself is not. Those closures are declared here by name, so a NEW dynamic env() anywhere else fails the guard instead of quietly escaping the inventory.",
        "config/sentry.php": [
            "sentryFloat",
            "sentryString"
        ],
        "config/nightwatch.php": [
            "nightwatchBool",
            "nightwatchFloat",
            "nightwatchString"
        ]
