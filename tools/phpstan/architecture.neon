parametersSchema:
    architecture: mixed()

parameters:
    architecture:
        lowLevelDatabaseExceptions: []
        rawSqlExceptions:
            -
                class: App\Queries\Comments\CommentListQuery
                methods: [orderByRaw]
                reason: 'Comment ranking requires an arithmetic vote expression with deterministic secondary ordering.'
                bindings: literal_only
                behaviorTests: [tests/Feature/Queries/CommentListQueryTest.php]
                status: approved
            -
                class: App\Queries\Feed\FeedQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal LIKE search requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/FeedQueryTest.php]
                status: approved
            -
                class: App\Queries\Feed\FeedQuery
                methods: [orderByRaw]
                reason: 'Top feed ranking requires an arithmetic vote expression with a unique final order.'
                bindings: literal_only
                behaviorTests: [tests/Feature/Queries/FeedQueryTest.php]
                status: approved
            -
                class: App\Queries\Feed\MatchedUsersQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal user search requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/MatchedUsersQueryTest.php]
                status: approved
            -
                class: App\Queries\Posts\ModerationPostsQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over post titles and author usernames requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/ModerationPostsQueryTest.php]
                status: approved
            -
                class: App\Queries\Comments\ModerationCommentsQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over comment text, author usernames and post titles requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/ModerationCommentsQueryTest.php]
                status: approved
            -
                class: App\Queries\Reports\ModerationReportsQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over reported content, reporters, reasons and messages requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/ModerationReportsQueryTest.php]
                status: approved
            -
                class: App\Queries\Reports\ModerationReportsQuery
                methods: [selectRaw]
                reason: 'Each listed report shows how many open reports point to its target: a correlated COUNT subquery, without hydrating the sibling reports.'
                bindings: literal_only
                behaviorTests: [tests/Feature/Queries/ModerationReportsQueryTest.php]
                status: approved
            -
                class: App\Queries\Users\ModerationUsersQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over usernames, names and email addresses requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/ModerationUsersQueryTest.php]
                status: approved
            -
                class: App\Queries\Users\ModerationUsersQuery
                methods: [selectRaw]
                reason: 'Each listed person shows the reports on their posts and comments: a correlated COUNT subquery, without hydrating the reports.'
                bindings: literal_only
                behaviorTests: [tests/Feature/Queries/ModerationUsersQueryTest.php]
                status: approved
            -
                class: App\Queries\Personas\PersonasQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over Persona usernames, names, short descriptions and characters requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/PersonasQueryTest.php]
                status: approved
            -
                class: App\Queries\Studio\StudioPlansQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over publication plan titles and author usernames and names requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/StudioPlansQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\GamesQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over game titles, internal names and slugs requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/GamesQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\ComparisonPeriodsQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over the titles, internal names and slugs of the games whose traffic periods Growth → Experiments lists requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/ComparisonPeriodsQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\GamePostPickerQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over post titles and author usernames for a game round requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/GamePostPickerQueryTest.php]
                status: approved
            -
                class: App\Queries\Studio\StudioActionsQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over the Action queue by publication title and by the username and names of its Persona requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/StudioActionsQueryTest.php]
                status: approved
            -
                class: App\Queries\Media\MediaAuditIssuesQuery
                methods: [orWhereRaw, orderByRaw]
                reason: 'Literal search over audit issue paths requires an explicit ESCAPE clause and a separately bound pattern; listing the most severe first ranks the severity with a CASE over bound values.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/MediaAuditIssuesQueryTest.php]
                status: approved
            -
                class: App\Queries\Rating\RatingVoteCountsQuery
                methods: [selectRaw]
                reason: 'Grouped vote totals require an efficient COUNT aggregate without hydrating vote rows.'
                bindings: literal_only
                behaviorTests: [tests/Feature/Queries/RatingVoteCountsQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\GameMetricsQuery
                methods: [selectRaw, havingRaw]
                reason: 'A game''s figures need conditional and distinct counts of its attempts, answers, emails and events — per version, flow or content set, per device, country or country group of the recorded visits behind them, or per traffic period and version from the visitors each period assigned — and the people with more than one attempt, without hydrating the rows; every value is bound.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/GameMetricsQueryTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficReportQuery
                methods: [selectRaw, havingRaw, orderByRaw]
                reason: 'Traffic reports need conditional sums and counts of the visits of a period — per level of the tree, site or zone, campaign, stage and a game''s versions, and their sign-ups per dimension against a bound cutoff — ordered by the accounts or sign-ups they brought, without hydrating up to millions of visit rows; every value is bound and every column comes from TrafficDimension.'
                bindings: required
                behaviorTests: [tests/Feature/Traffic/TrafficReportsTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficSpendQuery
                methods: [selectRaw]
                reason: 'Reconciling spend needs, per day and origin, the sums of the visits'' prices and counted spend and of the day''s figures, and the spend no visit took, without hydrating the rows; every value is bound.'
                bindings: required
                behaviorTests: [tests/Feature/Traffic/TrafficReportsTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficReachQuery
                methods: [selectRaw]
                reason: 'Showing how many of the impressions a network billed reached RateGuru needs the network''s impressions and amount per day, campaign, site and zone, and the counts of the visits of the same slices that came, opened the page and started the game, without hydrating up to millions of visit rows; every value is bound.'
                bindings: required
                behaviorTests: [tests/Feature/Traffic/TrafficReachTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficChanceSampleQuery
                methods: [selectRaw]
                reason: 'Working out the chances of an account needs, per game, source, channel, device, country and rounds answered, conditional counts of the visits that reached each step and of those that became accounts, without hydrating up to millions of visit rows; every value is bound.'
                bindings: required
                behaviorTests: [tests/Feature/Traffic/TrafficWorthTest.php]
                status: approved
            -
                class: App\Queries\Analytics\AnalyticsVisitsQuery
                methods: [selectRaw, orderByRaw, fromRaw]
                reason: 'Growth → Analytics counts people, not visits: conditional COUNT(DISTINCT CASE WHEN … THEN visitor_hash END) and sums over a period''s visits — per source, campaign, creative, landing, device, country, city, game or version with the people past the top groups, or too few to list, counted together and those of no value counted apart or left out when asked, per value asked for, per group of a dimension''s columns among values of its first — the five campaign tags of the sessions of some campaigns —, per pair of two dimensions'' values, per day, per hour or per block of days between bound boundaries — ordered by the people of each group; the sums of what the paid clicks cost per dimension or nested dimensions; the first day each value came on; and the result shares of the attempts played on them, without hydrating up to millions of visit rows; and, where the cells of each day''s people fit a read, the same figures, splits and lists as the size of the union of the cells'' roaring bitmaps (rb_cardinality(rb_or_agg(…))) and their sums, the people who came back as a recursive fold of the period''s days (WITH RECURSIVE, rb_or and rb_and a day) read through fromRaw, and what the figures leave out from every paid click''s sums the cells keep; every value is bound and every grouping column comes from AnalyticsDimension.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/AnalyticsVisitsQueryTest.php, tests/Feature/Analytics/AnalyticsCellsTest.php]
                status: approved
            -
                class: App\Queries\Analytics\AnalyticsCellsQuery
                methods: [selectRaw, groupByRaw]
                reason: 'The cells of a day''s people are read from that day''s rows in one pass apiece, for RefreshAnalyticsCellsAction to insert: GROUPING SETS over every level of detail, each step''s people a roaring bitmap built of the browsers'' numbers (rb_build_agg … FILTER), the sums beside them and every paid click''s, its page run or not; and the next numbers given to the day''s new browsers by ROW_NUMBER() over them — inserted with insertUsing, PostgreSQL with the roaringbitmap extension only; every value is bound and every column comes from AnalyticsCellLevel.'
                bindings: required
                behaviorTests: [tests/Feature/Analytics/AnalyticsCellsTest.php]
                status: approved
            -
                class: App\Queries\Analytics\AnalyticsContentQuery
                methods: [selectRaw, havingRaw, orderByRaw]
                reason: 'Site engagement counts the posts a period''s visits opened: conditional COUNT(DISTINCT CASE WHEN … THEN visitor_hash END) and sums over the rows each visit keeps of its posts — in all, per source, and per post with only the posts opened at all, the most opened first — and the different browsers of the accounts whose session first opened each post, without hydrating up to millions of rows; every value is bound and every column of the visit comes from AnalyticsDimension.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/AnalyticsContentQueryTest.php]
                status: approved
            -
                class: App\Queries\Analytics\TrafficSegmentsQuery
                methods: [selectRaw, whereRaw]
                reason: 'A paid source''s segments are conditions on its clicks'' parameters: which segment each click is in, every segment''s conditions bound once in a CASE, then all the source''s people, each segment''s and those of no segment as conditional COUNT(DISTINCT CASE WHEN … THEN visitor_hash END) and sums over those flags in one read, and the people a draft''s conditions catch — without hydrating up to millions of visit rows; every value is bound and every column comes from SegmentParameter or AnalyticsDimension.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/TrafficSegmentsQueryTest.php]
                status: approved
            -
                class: App\Queries\Analytics\RetentionQuery
                methods: [selectRaw]
                reason: 'Retention follows new accounts in weekly cohorts: per source and game, conditional SUM(CASE WHEN … THEN 1 ELSE 0 END) of the confirmed accounts that signed up between each week''s bound boundaries, of those of them that came back on day 1, day 7, day 30 and any of days 1–7, of those inside the period, and of the period''s, over one read of the accounts, without hydrating a row per account or doing arithmetic on dates; every value is bound and every column of the visit comes from AnalyticsDimension.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/RetentionQueryTest.php]
                status: approved
            -
                class: App\Queries\Analytics\TrackingLinksQuery
                methods: [whereRaw, orWhereRaw]
                reason: 'Literal search over tracking links'' names, sources, campaigns, contents and terms requires an explicit ESCAPE clause and separately bound patterns.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/TrackingLinksQueryTest.php]
                status: approved
            -
                class: App\Queries\Translations\TranslationAiUsageQuery
                methods: [selectRaw]
                reason: 'Translation AI usage needs conditional sums by status, a UTC hour or day bucket per engine, and per provider and model a call count conditional on a period beside MAX(completed_at), without hydrating call rows; every value is bound.'
                bindings: required
                behaviorTests: [tests/Feature/Queries/TranslationAiUsageQueryTest.php]
                status: approved
        paginationBoundaries:
            -
                class: App\Queries\Traffic\TrafficLogsQuery
                method: clicks
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Traffic/TrafficReportsTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficLogsQuery
                method: milestones
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Traffic/TrafficReportsTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficLogsQuery
                method: postbacks
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Traffic/TrafficReportsTest.php]
                status: approved
            -
                class: App\Queries\Traffic\TrafficLogsQuery
                method: blocks
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Traffic/TrafficReportsTest.php]
                status: approved
            -
                class: App\Queries\Feed\FeedQuery
                method: paginate
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Queries/FeedQueryTest.php]
                status: approved
            -
                class: App\Queries\SavedPosts\SavedPostsQuery
                method: forUser
                uniqueOrder: [posts.id]
                behaviorTests: [tests/Feature/Queries/SavedPostsQueryTest.php]
                status: approved
            -
                class: App\Queries\UserPublicPostsQuery
                method: forProfile
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Domain/UserPublicPostsQueryTest.php]
                status: approved
            -
                class: App\Queries\Posts\RecentlyDeletedPostsQuery
                method: forOwner
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Queries/RecentlyDeletedPostsQueryTest.php]
                status: approved
            -
                class: App\Queries\Translations\TranslationAiUsageQuery
                method: recentCalls
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Queries/TranslationAiUsageQueryTest.php]
                status: approved
            -
                class: App\Queries\Media\MediaAuditIssuesQuery
                method: paginate
                uniqueOrder: [media_audit_issues.id]
                behaviorTests: [tests/Feature/Queries/MediaAuditIssuesQueryTest.php]
                status: approved
            -
                class: App\Queries\Personas\PersonasQuery
                method: paginate
                uniqueOrder: [users.id]
                behaviorTests: [tests/Feature/Queries/PersonasQueryTest.php]
                status: approved
            -
                class: App\Queries\Studio\StudioPlansQuery
                method: paginate
                uniqueOrder: [studio_plans.id]
                behaviorTests: [tests/Feature/Queries/StudioPlansQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\GamesQuery
                method: paginate
                uniqueOrder: [games.id]
                behaviorTests: [tests/Feature/Queries/GamesQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\ComparisonPeriodsQuery
                method: paginate
                uniqueOrder: [game_traffic_periods.id]
                behaviorTests: [tests/Feature/Queries/ComparisonPeriodsQueryTest.php]
                status: approved
            -
                class: App\Queries\Games\GamePostPickerQuery
                method: paginate
                uniqueOrder: [posts.id]
                behaviorTests: [tests/Feature/Queries/GamePostPickerQueryTest.php]
                status: approved
            -
                class: App\Queries\Studio\StudioActionsQuery
                method: paginate
                uniqueOrder: [studio_plan_actions.id]
                behaviorTests: [tests/Feature/Queries/StudioActionsQueryTest.php]
                status: approved
            -
                class: App\Queries\Studio\StudioActionsQuery
                method: forPlan
                uniqueOrder: [id]
                behaviorTests: [tests/Feature/Queries/StudioActionsQueryTest.php]
                status: approved
            -
                class: App\Queries\Users\ModerationUsersQuery
                method: paginate
                uniqueOrder: [users.id]
                behaviorTests: [tests/Feature/Queries/ModerationUsersQueryTest.php]
                status: approved
            -
                class: App\Queries\Reports\ModerationReportsQuery
                method: paginate
                uniqueOrder: [reports.id]
                behaviorTests: [tests/Feature/Queries/ModerationReportsQueryTest.php]
                status: approved
            -
                class: App\Queries\Comments\ModerationCommentsQuery
                method: paginate
                uniqueOrder: [comments.id]
                behaviorTests: [tests/Feature/Queries/ModerationCommentsQueryTest.php]
                status: approved
            -
                class: App\Queries\Posts\ModerationPostsQuery
                method: paginate
                uniqueOrder: [posts.id]
                behaviorTests: [tests/Feature/Queries/ModerationPostsQueryTest.php]
                status: approved

services:
    -
        class: RateGuru\PHPStan\Rules\NoInlineControllerValidationRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoControllerValidatorFacadeRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoControllerValidatorHelperRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoUnvalidatedControllerInputRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoDirectControllerPermissionCheckRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoPhysicalUserDeletionRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoPresentationModelMutationRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoControllerEloquentQueryRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\NoReadOnlyLayerMutationRule
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\RegisteredPaginationBoundaryRule
        arguments:
            boundaries: %architecture.paginationBoundaries%
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\RestrictedDatabaseFacadeRule
        arguments:
            exceptions: %architecture.lowLevelDatabaseExceptions%
        tags: [phpstan.rules.rule]

    -
        class: RateGuru\PHPStan\Rules\RestrictedRawQueryRule
        arguments:
            exceptions: %architecture.rawSqlExceptions%
        tags: [phpstan.rules.rule]
